	-- ask ScriptBlox for the best + most popular scripts. Starts by itself (and again when you tap the grey text after an error)
	local loadingBest = false
	local function loadBest()
		if loadingBest or not alive then
			return
		end
		loadingBest = true
		barStatus.Text = "Finding the best scripts..."
		barStatus.Visible = true
		task.spawn(function()
			local waited = 0
			while not bridge.getBest and waited < 20 and alive do -- the cloud block is built a moment after this one
				task.wait(0.25)
				waited = waited + 0.25
			end
			local list, _unused, reason
			if bridge.getBest and alive then
				local ok, a, b, c = pcall(bridge.getBest)
				if ok then
					list, _unused, reason = a, b, c
				else
					reason = tostring(a)
				end
			else
				reason = "the Cloud Scripts page is not available"
			end
			loadingBest = false
			if not alive or not bar.Parent then
				return
			end
			if list and #list > 0 then
				local entries = {}
				for _, d in ipairs(list) do
					entries[#entries + 1] = { Title = d.title, Desc = bridge.describe(d), Live = d }
				end
				setCards(entries)
				barStatus.Visible = false
				bestTitle.Text = "Best Scripts"
			else
				setCards({})
				barStatus.Visible = true
				barStatus.Text = list and "No scripts found. Tap to try again" or "Couldn't load scripts. Tap to try again"
				bestTitle.Text = "Best Scripts"
				if not list then
					logWarn(
						"Best Scripts could not load: " .. tostring(reason),
						"no internet, ScriptBlox is down / rate limiting, or this executor has no request() / game:HttpGet",
						"tap the grey message on the Best Scripts card to try again"
					)
				end
			end
