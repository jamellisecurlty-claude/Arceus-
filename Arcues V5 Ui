	local byEnglish, exact, patterns = {}, {}, {}
	for _, row in ipairs(RAW) do
		local en = row[1]
		byEnglish[en] = row
		if string.find(en, "{1}", 1, true) then
			local pat = string.gsub(en, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")
			pat = string.gsub(pat, "{1}", "(.+)")
			patterns[#patterns + 1] = { pat = "^" .. pat .. "$", row = row }
		else
			exact[en] = row
		end
	end

	local current = 1 -- 1 = English ... 14 = Thai (same as the LANGS order)
	local token = 0
	local tracked = setmetatable({}, { __mode = "k" }) -- instance -> { prop, orig (English), shown (what is on screen) }

	local function translateText(text, idx)
		if type(text) ~= "string" or text == "" or not idx or idx <= 1 then
			return nil
		end
		local row = exact[text]
		if row then
			return row[idx]
		end
		for _, p in ipairs(patterns) do
			local cap = string.match(text, p.pat)
			if cap then
				local capRow = exact[cap]
				local capText = capRow and capRow[idx] or cap
				return (string.gsub(p.row[idx], "{1}", function()
					return capText
				end))
			end
		end
		return nil
	end

	function UiLang.tr(text)
		return translateText(text, current) or text
	end

	function UiLang.fmt(text, value)
		local row = byEnglish[text]
		local template = (row and current > 1 and row[current]) or text
		return (string.gsub(template, "{1}", function()
			return tostring(value)
		end))
	end

	local function apply(inst, rec)
		local out = rec.orig
		if current > 1 then
			out = translateText(rec.orig, current) or rec.orig
		end
		if inst[rec.prop] ~= out then
			inst[rec.prop] = out
		end
		rec.shown = out
	end

	local function register(inst)
		if tracked[inst] then
			return
		end
		local isBox = inst:IsA("TextBox")
		if not (isBox or inst:IsA("TextLabel") or inst:IsA("TextButton")) then
			return
		end
		if inst:GetAttribute("NoTranslate") then
			return
		end
		local prop = isBox and "PlaceholderText" or "Text" -- what you type in a box is never translated
		local text = inst[prop]
		local rec = { prop = prop, orig = text, shown = text }
		tracked[inst] = rec
		if current > 1 and text ~= "" then
			apply(inst, rec)
		end
	end

	function UiLang.skip(inst)
		if inst then
			inst:SetAttribute("NoTranslate", true)
			tracked[inst] = nil
		end
	end

	function UiLang.set(index, englishName)
		current = tonumber(index) or 1
		UiLang.index = current
		ArcyAI.Language = (current > 1 and englishName) or nil -- the AI answers in this language
		token += 1
		local mine = token
		local list = {}
		for inst in pairs(tracked) do
			list[#list + 1] = inst
		end
		task.spawn(function()
			for i, inst in ipairs(list) do
				if mine ~= token or not alive then
					return
				end
				local rec = tracked[inst]
				if rec then
					local now = inst[rec.prop]
					if now ~= rec.shown then
						rec.orig = now -- the UI changed this text since we looked: that is the new original
					end
					if rec.orig ~= "" then
						apply(inst, rec)
					end
				end
				if i % 300 == 0 then
					task.wait() -- spread a big UI over a few frames
				end
			end
		end)
	end

	for _, d in ipairs(gui:GetDescendants()) do
		register(d)
	end
	gui.DescendantAdded:Connect(register)

	-- texts the UI changes later (status lines, toasts, cards) are caught here while another language is on
	task.spawn(function()
		while alive do
			task.wait(windowState == "hidden" and 1.5 or 0.4) -- sleeps while the window is hidden
			if current > 1 then
				for inst, rec in pairs(tracked) do
					local now = inst[rec.prop]
					if now ~= rec.shown then
						rec.orig = now
						apply(inst, rec)
					end
				end
			end
		end
	end)
end

