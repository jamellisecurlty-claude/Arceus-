	-- swipe the carousel: the cards follow your finger, then spring to the new focus
	keepConn(UserInputService.InputChanged:Connect(function(input)
		if not swipe or not (input == swipe.input or input.UserInputType == Enum.UserInputType.MouseMovement) then
			return
		end
		local dx = input.Position.X - swipe.startX
		if not swipeMoved and math.abs(dx) > 10 then
			swipeMoved = true
			for _, c in ipairs(cards) do
				if c.tw then
					c.tw:Cancel() -- stop any slide still running so the finger takes over
				end
			end
		end
		if swipeMoved then
			local shift = dx / math.max(bar.AbsoluteSize.X, 1)
			if (focus == 1 and dx > 0) or (focus == #cards and dx < 0) then
				shift = shift * 0.35 -- rubber band at the first / last card
			end
			for i, c in ipairs(cards) do
				local goal = slotFor(i)
				c.button.Position = UDim2.fromScale(goal.Position.X.Scale + shift * 0.9, 0.5)
			end
		end
	end))
	keepConn(UserInputService.InputEnded:Connect(function(input)
		if swipe and (input == swipe.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
			local startX = swipe.startX
			swipe = nil
			if swipeMoved then
				local dx = input.Position.X - startX
				local need = bar.AbsoluteSize.X * 0.1
				if dx <= -need then
					focus = math.min(focus + 1, #cards)
				elseif dx >= need then
					focus = math.max(focus - 1, 1)
				end
				layoutCards(true) -- snap (or spring back) with the animation
			end
		end
	end))

	---------------- Arcy chat card ----------------
	-- "Let's talk / Hello! I'm Arcy!" card (source: AIPanelBackground).
	-- The glow is NOT a texture id in the source: it is painted live into an EditableImage
	-- (swirling palette + pulse), the same trick the loading screen uses. The orb is painted the same way.
	-- If Roblox blocks EditableImage in your game, the card falls back to a rotating gradient + pulse.
