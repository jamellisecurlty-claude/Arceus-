	new("ImageLabel", {
		Name = "HubLogo",
		Image = A.HubIcon,
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.08),
		Size = UDim2.fromScale(0.6, 0.56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = hubInner,
	})
	label({
		Name = "HubName",
		Text = "Arceus Hub",
		FontFace = FONT.Title,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.7),
		Size = UDim2.fromScale(0.86, 0.2),
		Parent = hubInner,
	})
	local hubTap = new("TextButton", {
		Name = "HubTap",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
		Parent = hubTile,
	})
	local hubScale = hubInner:FindFirstChild("PressScale")
	hubTap.InputBegan:Connect(function(input)
		if isTap(input) then
			tween(hubScale, 0.08, { Scale = 0.92 })
		end
	end)
	hubTap.InputEnded:Connect(function(input)
		if isTap(input) then
			tween(hubScale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		end
