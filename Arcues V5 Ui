		local function insertArcyResponse(answer, at)
			answer = tostring(answer or ""):gsub("\r\n?", "\n")
			local current = codeBox.Text
			at = math.clamp(tonumber(at) or (#current + 1), 1, #current + 1)
			setCode(current:sub(1, at - 1) .. answer .. current:sub(at))
			pcall(function()
				codeBox.CursorPosition = at + #answer
			end)
		end
		homeRefs.insertArcyResponse = insertArcyResponse

		local previousOnAI = Hooks.OnAI
		Hooks.OnAI = function(prompt)
			if previousOnAI then
				pcall(previousOnAI, prompt)
			end
			if not string.find(tostring(prompt or ""), "%S") then
				return
			end
			task.spawn(function()
				if arcyBusy then
					if homeRefs.finishInstantReasoning then
						homeRefs.finishInstantReasoning()
					end
					waitForPromptToClose()
					showToast({ style = "info", title = "Arcy", text = "Arcy is still answering your previous question." })
					return
				end
				arcyBusy = true
				local result, err = ArcyAI.Ask(prompt, "Editor", codeBox.Text)
				arcyBusy = false
				if not alive then
					return
				end
				if homeRefs.finishInstantReasoning then -- the prompt's text box was showing "Reasoning..." - the answer is here, close it
					homeRefs.finishInstantReasoning()
				end
				waitForPromptToClose()
				if not result then
					showToast({ style = "error", title = "Arcy", text = tostring(err or "Both AI providers failed. Please try again.") })
					return
				end

				if type(result.actions) == "table" and #result.actions > 0 and homeRefs.runArcyActions then
					local okRun, consumed = pcall(homeRefs.runArcyActions, result)
					if okRun and (consumed or not result.code) then
						return -- a tab was opened or the code went into a new Editor file
					end
				end

				if result.noInsert then -- a command answer (Cmds): show it, nothing goes into the script
					showToast({ style = "info", title = "Arcy", text = string.sub(tostring(result.text or ""), 1, 900) })
					return
				end

				local insertion = result.code or result.text
				local preview = tostring(result.text)
				if #preview > 900 then
					preview = string.sub(preview, 1, 900) .. "..."
				end
				showToast({
					style = "confirm",
					title = "Arcy",
					text = preview .. "\n\n" .. UiLang.tr("Confirm to insert this response into the Editor."),
					onConfirm = function()
						insertArcyResponse(insertion, arcyInsertAt)
						pcall(glowWindow)
					end,
				})
			end)
		end

