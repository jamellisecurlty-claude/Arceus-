		----------------------------------------------------------------
		-- CHAT BRAIN (Hooks.OnChat first, a few built-in Roblox answers when the hook gives nothing)
		----------------------------------------------------------------
		local function esc(s)
			s = string.gsub(tostring(s), "&", "&amp;")
			s = string.gsub(s, "<", "&lt;")
			s = string.gsub(s, ">", "&gt;")
			return s
		end

		-- EMOJI FIX. The answer label has a UIGradient (it tints everything, emoji too) and the Black font has no emoji of its own, so a
		-- fallback emoji got the wrong width and sat on top of the words next to it ("Hi [emoji] How"). Now:
		--   * the gradient label hides every emoji (transparent) and leaves extra room for it
		--   * a second label on top (same size, same wrapping, no gradient) shows ONLY the emoji, in their own colours
		-- EMOJI_PAD is the room left on each side of an emoji: make it longer if an emoji still touches a word, shorter if the gap is too big.
		local EMOJI_PAD = "  "
		local function isEmojiCp(cp)
			return (cp >= 0x1F000 and cp <= 0x1FAFF)
				or (cp >= 0x2600 and cp <= 0x27BF)
				or (cp >= 0x2B05 and cp <= 0x2B07)
				or cp == 0x2B1B or cp == 0x2B1C or cp == 0x2B50 or cp == 0x2B55
				or cp == 0x231A or cp == 0x231B or (cp >= 0x23E9 and cp <= 0x23F3) or (cp >= 0x23F8 and cp <= 0x23FA)
				or cp == 0x203C or cp == 0x2049 or cp == 0x2122 or cp == 0x2139 or cp == 0x24C2
				or cp == 0x25B6 or cp == 0x25C0 or cp == 0x2934 or cp == 0x2935
				or cp == 0x3030 or cp == 0x303D or cp == 0x3297 or cp == 0x3299
				or cp == 0xFE0F or cp == 0x200D or cp == 0x20E3
				or (cp >= 0xE0020 and cp <= 0xE007F)
		end

		-- raw text -> { { text = "...", emoji = bool }, ... } (a flag / family / skin tone stays ONE emoji segment)
		local function splitEmoji(text)
			local segs = {}
			local ok = pcall(function()
				local buffer, bufferEmoji = {}, nil
				local function flush()
					if #buffer > 0 then
						segs[#segs + 1] = { text = table.concat(buffer), emoji = bufferEmoji == true }
						buffer = {}
					end
				end
				for _, cp in utf8.codes(text) do
					local isE = isEmojiCp(cp)
					if bufferEmoji ~= nil and isE ~= bufferEmoji then
						flush()
					end
					bufferEmoji = isE
					buffer[#buffer + 1] = utf8.char(cp)
				end
				flush()
			end)
			if not ok then
				return { { text = text, emoji = false } }
			end
			return segs
		end

		-- raw text -> (text for the gradient label, text for the emoji label, has emoji)
		local function emojiLayers(text)
			text = tostring(text or "")
			local segs = splitEmoji(text)
			local hasEmoji = false
			for _, seg in ipairs(segs) do
				if seg.emoji then
					hasEmoji = true
					break
				end
			end
			if not hasEmoji then
				return esc(text), "", false
			end
			-- spaces / tabs right next to an emoji are replaced by the pad (new lines stay)
			for i, seg in ipairs(segs) do
				if seg.emoji then
					local prev, nxt = segs[i - 1], segs[i + 1]
					if prev and not prev.emoji then
						prev.text = string.gsub(prev.text, "[ \t]+$", "")
					end
					if nxt and not nxt.emoji then
						nxt.text = string.gsub(nxt.text, "^[ \t]+", "")
					end
				end
			end
			local base, over = {}, {}
			for i, seg in ipairs(segs) do
				if seg.emoji then
					local prev, nxt = segs[i - 1], segs[i + 1]
					local padL = (prev and not string.find(prev.text, "\n$")) and EMOJI_PAD or ""
					local padR = (nxt and not string.find(nxt.text, "^\n")) and EMOJI_PAD or ""
					base[#base + 1] = '<font transparency="1">' .. padL .. seg.text .. padR .. "</font>"
					over[#over + 1] = '<font transparency="1">' .. padL .. "</font>" .. seg.text .. '<font transparency="1">' .. padR .. "</font>"
				elseif seg.text ~= "" then
					base[#base + 1] = esc(seg.text)
					over[#over + 1] = '<font transparency="1">' .. esc(seg.text) .. "</font>"
				end
			end
			return table.concat(base), table.concat(over), true
		end

		local function humanoidCode(line)
			local char = 'game:GetService("Players").LocalPlayer.Character'
			return "local h = " .. char .. " and " .. char .. ':FindFirstChildOfClass("Humanoid")\nif h then ' .. line .. " end"
		end

		local function offlineAnswer(prompt)
			local p = string.lower(prompt)
			local function has(...)
				for _, word in ipairs({ ... }) do
					if string.find(p, word, 1, true) then
						return true
					end
				end
				return false
			end
			local n = tonumber(string.match(p, "%d+%.?%d*"))
			if n then
				n = math.clamp(n, 0, 10000)
			end
			local reset = has("reset", "normal", "default", "restore", "back to")

			if has("walk", "speed") then
				if reset or not n then
					return { text = UiLang.tr("To reset your walk speed to normal in Roblox, you can use the following script:"), code = humanoidCode("h.WalkSpeed = 16") }
				end
				return { text = UiLang.fmt("To set your walk speed to {1} in Roblox, you can use the following script:", n), code = humanoidCode("h.WalkSpeed = " .. n) }
			elseif has("jump") then
				if reset or not n then
					return { text = UiLang.tr("To reset your jump power to normal in Roblox, you can use the following script:"), code = humanoidCode("h.UseJumpPower = true h.JumpPower = 50") }
				end
				return { text = UiLang.fmt("To set your jump power to {1} in Roblox, you can use the following script:", n), code = humanoidCode("h.UseJumpPower = true h.JumpPower = " .. n) }
			elseif has("gravity") then
				if reset or not n then
					return { text = UiLang.tr("To reset the gravity to normal in Roblox, you can use the following script:"), code = "workspace.Gravity = 196.2" }
				end
				return { text = UiLang.fmt("To set the gravity to {1} in Roblox, you can use the following script:", n), code = "workspace.Gravity = " .. n }
			end
			return {
				text = UiLang.tr("I can answer walk speed, jump power and gravity questions on my own. To let me answer anything else, connect your own AI in Hooks.OnChat."),
			}
		end

		-- Arcy's action tags (<<OPEN:Tab>> / <<EDITOR:Name>>): switch tabs, or put the answer's code into the Editor as a new file.
		-- Returns true when the code went to the Editor (then nobody needs to ask "Allow Arcy to execute?": Play asks by itself).
		homeRefs.runArcyActions = function(reply)
			local actions = type(reply) == "table" and reply.actions or nil
			if type(actions) ~= "table" then
				return false
			end
			local editorAct, openAct
			for _, act in ipairs(actions) do
				if act.type == "editor" and not editorAct then
					editorAct = act
				elseif act.type == "open" and not openAct then
					openAct = act
				end
			end
			if editorAct and type(reply.code) == "string" and string.find(reply.code, "%S") and homeRefs.openInEditor then
				local name = (editorAct.name and editorAct.name ~= "") and editorAct.name or "Arcy Script"
				if pcall(homeRefs.openInEditor, name, reply.code) then
					return true
				end
			end
			if openAct and openAct.tab then
				callHook("OnTab", openAct.tab)
			end
			return false
		end

		local function ask(prompt)
			local called, result = callHook("OnChat", prompt)
			if called and result ~= nil then
				if type(result) == "string" then
					return { text = result }
				elseif type(result) == "table" then
					return { text = tostring(result.text or ""), code = type(result.code) == "string" and result.code or nil, actions = type(result.actions) == "table" and result.actions or nil }
				end
			end
			return offlineAnswer(prompt)
		end

		local function setResponseText(text) -- raw text in: the gradient label gets the words, the emoji label gets the emoji
			local base, over, hasEmoji = emojiLayers(text)
			response.Text = base
			emojiLayer.Text = over
			emojiLayer.Visible = hasEmoji
		end

		local function showReply(text)
			responseIsDefault = false
			setResponseText(text)
			response.TextTransparency = 1
			emojiLayer.TextTransparency = 1
			response.Position = UDim2.fromScale(0.5, 0.05)
			tween(response, 0.45, { TextTransparency = 0.45 })
			tween(emojiLayer, 0.45, { TextTransparency = 0.2 })
			tween(response, 0.55, { Position = UDim2.fromScale(0.5, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			scroll.CanvasPosition = Vector2.zero
		end

		local busy = false
		local function submitPrompt(prompt) -- the text typed in the "Instant code with Arcy" search bar
			prompt = string.match(tostring(prompt or ""), "^%s*(.-)%s*$") or ""
			if prompt == "" or busy then
				return
			end
			busy = true
			response.TextTransparency = 0.45
			setResponseText(T("reasoning"))
			task.spawn(function()
				local reply = ask(prompt)
				busy = false
				if not alive then
					return
				end
				local text = string.gsub(reply.text or "", "%s", "")
				if text == "" then
					showReply(UiLang.tr("Arceus Intelligence is not available, please try again later"))
					return
				end
				showReply(reply.text)
				pcall(glowWindow) -- the whole window lights up while Arcy answers (source: BackgroundGlow)
				local sentToEditor = false
				if type(reply.actions) == "table" and #reply.actions > 0 then
					for _, act in ipairs(reply.actions) do
						if act.type == "editor" and reply.code then
							sentToEditor = true
						end
					end
					task.delay(0.7, function() -- a moment to read the answer, then the tab opens / the code lands in the Editor
						if alive and homeRefs.runArcyActions then
							pcall(homeRefs.runArcyActions, reply)
						end
					end)
				end
				if not sentToEditor and reply.code and string.find(reply.code, "%S") then
					local code = reply.code
					showToast({
						style = "confirm",
						title = T("allow"),
						text = string.sub(code, 1, 50),
						onConfirm = function()
							callHook("OnRun", "Arcy", code)
						end,
					})
				end
			end)
		end

		-- tapping the "Teach me how to..." box opens the "Instant code with Arcy" search bar (the same glowing prompt the Editor's Arcy orb opens)
		boxTap.Activated:Connect(function()
			if busy or not openInstantCode then
				return
			end
			openInstantCode({
				placeholder = T("placeholder"),
				onSubmit = submitPrompt,
			})
		end)

		----------------------------------------------------------------
		-- TRANSLATE (Translate -> pick a language -> Translate to XX -> confirm)
		----------------------------------------------------------------
		for _, inst in ipairs({ tipsSub, tipsTitle, tipsText, translateBtn, hello, box, response, emojiLayer, trackArtist }) do
			UiLang.skip(inst) -- this page translates these itself (the TR tables); the UI translator leaves them alone
		end

		local function applyLanguage()
			UiLang.set(langIndex, LANGS[langIndex].label[1]) -- every other page + the AI answers
			tipsSub.Text = T("tips_sub")
			tipsTitle.Text = T("tips_title")
			tipsText.Text = T("tips_text")
			paintTranslateButton()
			for i, btn in ipairs(langButtons) do
				btn.Text = LANGS[i].label[langIndex] or LANGS[i].label[1]
			end
			if trackIsHint then
				trackArtist.Text = T("track_hint")
			end
			hello.Text = T("hello")
			box.PlaceholderText = T("placeholder")
			if responseIsDefault then
				setResponseText(T("default_resp"))
			end
			callHook("OnTranslate", LANGS[langIndex].code, langIndex) -- translate the rest of your UI here
		end

		local function showPicker()
			state = "pick"
			pickedLang = nil
			tween(tipsText, 0.25, { TextTransparency = 1 })
			task.delay(0.3, function()
				if state ~= "idle" then
					tipsText.Visible = false
				end
			end)
			picker.Visible = true
			picker.CanvasPosition = Vector2.zero
			for i, btn in ipairs(langButtons) do -- the buttons pop in one after another
				btn.BackgroundTransparency = 1
				btn.TextTransparency = 1
				task.delay((i - 1) * 0.025, function()
					tween(btn, 0.3, { BackgroundTransparency = 0.5, TextTransparency = 0.1 })
				end)
			end
			paintTranslateButton()
		end

		local function hidePicker()
			picker.Visible = false
			tipsText.Visible = true
			tween(tipsText, 0.3, { TextTransparency = 0.35 })
		end

		local function shake()
			local base = translateBtn.Position
			task.spawn(function()
				for _, dx in ipairs({ -0.02, 0.02, -0.012, 0.012, 0 }) do
					tween(translateBtn, 0.04, { Position = UDim2.new(base.X.Scale + dx, base.X.Offset, base.Y.Scale, base.Y.Offset) })
					task.wait(0.045)
				end
			end)
		end

		translateBtn.Activated:Connect(function()
			if state == "idle" then
				showPicker()
			elseif state == "pick" then
				shake() -- pick a language first
			else
				local chosen = pickedLang
				showToast({
					style = "confirm",
					title = T("translate"),
					text = T("translate_q"),
					onConfirm = function()
						langIndex = chosen
						state = "idle"
						hidePicker()
						applyLanguage()
					end,
				})
			end
		end)

		----------------------------------------------------------------
		-- LIVE PARTS (idle while the page / window is hidden)
		----------------------------------------------------------------
		local overlayUpdate = nil
		do
			local W, H = 128, 28 -- same resolution the Home card's glow uses
			local ok, editable = pcall(function()
				return AssetService:CreateEditableImage({ Size = Vector2.new(W, H) })
			end)
			if ok and editable then
				local set = pcall(function()
					overlay.ImageContent = Content.fromObject(editable)
				end)
				if set then
					local floor, sqrt, abs, sin = math.floor, math.sqrt, math.abs, math.sin
					local cr = math.min(W, H) * 0.155 -- source: CornerRadiusRatio .155
					local reach = 255 * (math.min(W, H) / 128) -- source: InnerGlowRadius 255 at 128
					local rx, ry = math.max(W / 2 - cr, 0), math.max(H / 2 - cr, 0)
					local size = Vector2.new(W, H)
					local buf = buffer.create(W * H * 4)
					local base = floor(0.45 * 255 + 0.5) -- source: BackgroundAlpha .45 * 255
					local offs, bases, count = {}, {}, 0
					for y = 0, H - 1 do
						for x = 0, W - 1 do
							local cx, cy = (x + 0.5) - W / 2, (y + 0.5) - H / 2
							local dx, dy = abs(cx) - rx, abs(cy) - ry
							local outside = sqrt(math.max(dx, 0) ^ 2 + math.max(dy, 0) ^ 2)
							local inside = math.min(math.max(dx, dy), 0)
							local d = abs(outside + inside - cr)
							local f = 0
							if d < reach then
								f = 1 - d / reach
							end
							local b = f ^ 30 -- source: GlowSoftnessExponent 30
							local o = (y * W + x) * 4
							buffer.writeu32(buf, o, base * 16777216) -- black, 45% opaque
							if b * 1.5 * 50 >= 0.5 then -- pixels that can never change are skipped
								count = count + 1
								offs[count] = o
								bases[count] = b
							end
						end
					end
					overlayUpdate = function(phase)
						local pulse = 1 + 0.5 * sin(phase * math.pi * 2) -- source: GlowPulseAmplitude .5, Duration 2.5
						for k = 1, count do
							local fade = bases[k] * pulse
							if fade > 1 then
								fade = 1
							end
							local a = floor(base + fade * 50 + 0.5) -- source: GlowExtraAlpha 50
							if a > 255 then
								a = 255
							end
							buffer.writeu32(buf, offs[k], a * 16777216)
						end
						editable:WritePixelsBuffer(Vector2.zero, size, buf)
					end
					local first = pcall(overlayUpdate, 0)
					if first then
						overlay.BackgroundTransparency = 1
					else
						overlayUpdate = nil
					end
				else
					pcall(function()
						editable:Destroy()
					end)
				end
				gui.Destroying:Once(function()
					pcall(function()
						editable:Destroy()
					end)
				end)
			end
		end

		local glassTimer, glassStart = 0, os.clock()
		keepConn(RunService.Heartbeat:Connect(function(dt)
			if not alive or not page.Visible or not main.Visible or windowState == "hidden" then
				return
			end
			if sound.Playing or sound.TimeLength == 0 then
				refreshTime() -- the bar and the 00:31 / 03:35 time follow the song
			end
			if overlayUpdate then
				glassTimer = glassTimer + dt
				if glassTimer >= (1 / 15) * Theme.Perf.scale then
					glassTimer = 0
					local ok = pcall(overlayUpdate, ((os.clock() - glassStart) / 2.5) % 1)
					if not ok then
						overlayUpdate = nil
						overlay.BackgroundTransparency = 0.55
					end
				end
			end
		end))

		intelRefs.pieces = { tips, playerCard, chat }
		intelRefs.onShow = function()
			refreshTime()
			setPlayIcon()
		end
		refreshTime()
		setPlayIcon()
	end
	buildIntelligencePage()
end

----------------------------------------------------------------
-- EXTENSIONS PAGE (the plug icon = the "Extensions" tab)
----------------------------------------------------------------
-- Source: Page "Extensions" (ExtensionPage / ExtensionHome / ExtensionContent / ExtensionBackButton / ExtensionDetachButton / ExtensionObj).
--   * "Discover / Extensions" title, the Install pill (top right) and a grid of extension tiles (picture + name under it).
--   * Install opens the source's InputToast (blue title "Install extension", hint "Extension url", blue glow behind the pill). Paste a link (a whole
--     loadstring(game:HttpGet("...")) line works too; GitHub / Gist / Pastebin page links are turned into raw links). The link must open a JSON file -
--     JSON is the ONLY format that installs (a plain Luau file or a web page is refused with a message). Like this (id and icon are optional;
--     name / code / script also work, and "source" may itself be a url or a list of lines):
--         { "id": "my_ext", "title": "My Extension", "icon": "rbxassetid://123", "source": "-- Luau code of the extension" }
--     The url is remembered in ArcyScripts/_extensions.json, so the extension comes back the next time the UI starts.
--   * Tap a tile = the extension opens inside the page. The red Back pill goes back to the grid. The blue Detach pill turns it into its own
--     draggable window with the hub look (logo + name, centre title, expand and red x - tap its tile again, or the x, to bring it back). HOLD a tile = a menu: Rename / Change image / Delete (Delete asks first; every extension can be deleted - only the built-in Arceus Hub has no Delete).
--   * Arceus Hub (the first tile) is built in and matches the reference screenshot: its own icon column (aimbot / fly), the red title line and the setting rows
--     (switch, UP / DOWN, speed box, mode dropdown). It is interface only - Hooks.OnHub(setting, value) is called for every change and homeRefs.hub holds the values.
--   * The "source" of an extension is Luau code. It runs once, the first time you open it, with ONE argument: the extension api.
--         local api = ...
--         api.Frame                         an empty transparent Frame that fills the extension area - build your UI inside it
--         api.Id / api.Title
--         api.Notify(title, text, style)    a toast ("info" | "success" | "error")
--         api.Run(name, source, opts)       runs a script like the Editor's play button (Hooks.OnRun)
--         api.HttpGet(url)                  returns the body, or nil + a reason
--         api.Close() / api.Detach() / api.Attach()
--         api.Library                       the Arceus Hub's look as a toolkit - an extension built with it IS a hub like the Arceus Hub:
--                                           icon column of tabs, scrolling rows with toggles / dropdowns / buttons / sliders / inputs, red-lined section
--                                           titles. Start with  local win = api.Library:CreateWindow({ Title = "My Hub" })  - see HUB LIBRARY.
--     Extensions written for the original Arceus X framework (framework.*) need that framework and cannot run here.
--   * Hooks.OnHub(setting, value) is called when something is changed inside the Arceus Hub.
--   * Hooks.OnExtension(action, info) is called after "open" | "install" | "uninstall" | "rename" | "image" (info = { id, title, url }).
do
	local function buildExtensionsPage()
		local HttpService = game:GetService("HttpService")
		local WHITE = Color3.new(1, 1, 1)
		local CENTER = Vector2.new(0.5, 0.5)
		local SAVE_FILE = "ArcyScripts/_extensions.json"
		local TILE_WIDTH = 0.15 -- tile width (fraction of the grid width) - source: .15
		local CELL_RATIO = 1.3 -- cell height / tile width: the tile is a square, its name sits under it
		local LIST_Y = 0.285 -- where the grid starts (fraction of the window height)
		local PLUGIN_Y = 0.12 -- where an open extension starts (just under the window's drag strip; the Back / Detach pills sit in the top row above it)
		local INSTALL_BLUE = Color3.fromHex("#2B5780") -- source: the Install pill
		local BACK_RED = Color3.fromHex("#FF0000") -- source: ExtensionBackButton
		local BACK_COLOR = Theme.sh.back -- Back pill (Primary Color: Red = 150, 9, 7 sampled from the reference screenshot)
		local DETACH_COLOR = Color3.fromRGB(59, 98, 137) -- Detach pill (sampled from the reference screenshot)

		local page = new("Frame", {
			Name = "Extensions",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = content,
		})
		local ext = { page = page }
		homeRefs.ext = ext

		----------------------------------------------------------------
		-- LIST VIEW: Discover / Extensions / Install + the tile grid
		----------------------------------------------------------------
		local list = new("Frame", { Name = "ExtensionPage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = page })

		local header = new("Frame", {
			Name = "Header",
			Position = UDim2.fromScale(0, 0.12),
			Size = UDim2.fromScale(1, 0.165),
			BackgroundTransparency = 1,
			Parent = list,
		})
		label({
			Name = "Discover",
			Text = "Discover",
			FontFace = FONT.Description,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTransparency = 0.25,
			Position = UDim2.fromScale(0.03, 0.14),
			Size = UDim2.fromScale(0.3, 0.24),
			Parent = header,
		})
		label({
			Name = "Title",
			Text = "Extensions",
			FontFace = FONT.Black,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromScale(0.03, 0.42),
			Size = UDim2.fromScale(0.3, 0.38),
			Parent = header,
		})

		local installLabel = label({
			Name = "InstallText",
			Text = "Install",
			FontFace = FONT.Body,
			AnchorPoint = CENTER,
			Position = UDim2.fromScale(0.625, 0.5),
			Size = UDim2.fromScale(1, 0.55),
		})
		local installBtn = new("TextButton", {
			Name = "InstallButton",
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(0.981, 0.36),
			Size = UDim2.fromScale(0.15, 0.45),
			BackgroundColor3 = INSTALL_BLUE,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			Parent = header,
		}, {
			corner(0.35),
			new("ImageLabel", {
				Name = "Plus",
				Image = A.NewIcon,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0.1, 0.5),
				Size = UDim2.fromScale(0.6, 0.6),
				BackgroundTransparency = 1,
			}, { ratio(1) }),
			installLabel,
		})
		pressFx(installBtn)

		local grid = new("ScrollingFrame", {
			Name = "ExtensionHome",
			Position = UDim2.fromScale(0, LIST_Y),
			Size = UDim2.fromScale(1, 0.97 - LIST_Y),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = PRIMARY,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ClipsDescendants = true,
			Parent = list,
		}, {
			new("UIPadding", { PaddingLeft = UDim.new(0.03, 0), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }),
		})
		local gridLayout = new("UIGridLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Parent = grid,
		})
		local function updateGrid()
			local width = grid.AbsoluteSize.X
			if width < 20 then
				return
			end
			local tile = math.floor(width * TILE_WIDTH)
			gridLayout.CellSize = UDim2.fromOffset(tile, math.floor(tile * CELL_RATIO))
			gridLayout.CellPadding = UDim2.fromOffset(math.floor(tile * 0.3), math.floor(tile * 0.12))
		end
		grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateGrid)
		updateGrid()

		----------------------------------------------------------------
		-- OPEN VIEW: Back + Detach pills and the area the extension builds its UI in
		----------------------------------------------------------------
		local contentFrame = new("Frame", {
			Name = "ExtensionContent",
			Position = UDim2.fromScale(0, PLUGIN_Y),
			Size = UDim2.fromScale(1, 0.975 - PLUGIN_Y),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Visible = false,
			Parent = page,
		})
		-- the pills sit in the window's top row like the screenshot, so they are parented to the window (above its drag strip), not to the page
		local mainFrame = content.Parent
		local function pill(name, text, color, pos, size)
			local btn = new("TextButton", {
				Name = name,
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Position = pos,
				Size = size,
				Visible = false,
				ZIndex = 60, -- above the drag strip (40)
				Parent = mainFrame,
			}, {
				corner(0.3),
				label({
					Text = text,
					FontFace = FONT.Title,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(0.9, 0.5),
				}),
			})
			pressFx(btn)
			return btn
		end
		local backBtn = pill("ExtensionBackButton", "‹	Back", BACK_COLOR, UDim2.fromScale(0.1505, 0.0279), UDim2.fromScale(0.1047, 0.0598))
		local detachBtn = pill("ExtensionDetachButton", " 🔗  Detach", DETACH_COLOR, UDim2.fromScale(0.284, 0.0279), UDim2.fromScale(0.1238, 0.0598))

		----------------------------------------------------------------
		-- STORAGE + HTTP
		----------------------------------------------------------------
		-- An executor function, however this system exposes it: a plain global, getgenv(), or the script's own environment.
		-- (Arceus X, Delta, Fluxus, Wave ... do not all put them in the same place. Studio has none of them - then nil comes back.)
		local function findFn(name, literal)
			if literal then
				local okLit, fnLit = pcall(literal)
				if okLit and type(fnLit) == "function" then
					return fnLit
				end
			end
			for _, lookup in ipairs({
				function() return getgenv() end,
				function() return getfenv(0) end,
				function() return getfenv(1) end,
				function() return _G end,
				function() return shared end,
			}) do
				local okEnv, env = pcall(lookup)
				if okEnv and type(env) == "table" then
					local okVal, fn = pcall(function()
						return env[name]
					end)
					if okVal and type(fn) == "function" then
						return fn
					end
				end
			end
			return nil
		end
		local fs = {
			isfile = findFn("isfile", function() return isfile end),
			readfile = findFn("readfile", function() return readfile end),
			writefile = findFn("writefile", function() return writefile end),
			isfolder = findFn("isfolder", function() return isfolder end),
			makefolder = findFn("makefolder", function() return makefolder end),
		}

		-- where the list lives. The source keeps it in "plugins.ax" with OS_CONFIGS.HIDE_PREFIX in front: a hidden file ("." prefix) on every
		-- system except iOS, where hidden names are not used. A system that refuses the hidden name gets the plain one, and the file of the
		-- older versions (SAVE_FILE) is still read once so nobody loses the extensions they already installed.
		local IS_IOS = false
		pcall(function()
			IS_IOS = game:GetService("UserInputService"):GetPlatform() == Enum.Platform.IOS
		end)
		local HIDE_PREFIX = IS_IOS and "" or "."
		local SAVE_DIR = "ArcyScripts"
		local SAVE_PATHS = {
			SAVE_DIR .. "/" .. HIDE_PREFIX .. "plugins.json",
			SAVE_DIR .. "/plugins.json",
		}

		local savedUrls = {} -- urls of the installed extensions (kept in ArcyScripts/plugins.json)
		local function addSaved(url)
			if type(url) ~= "string" or url == "" then
				return false
			end
			for _, known in ipairs(savedUrls) do
				if known == url then
					return false
				end
			end
			savedUrls[#savedUrls + 1] = url
			return true
		end
		do
			-- the first file that exists and holds a list wins (new names first, the older version's file last)
			for _, path in ipairs({ SAVE_PATHS[1], SAVE_PATHS[2], SAVE_FILE }) do
				local ok, data = pcall(function()
					if not fs.readfile then
						return nil
					end
					if fs.isfile and not fs.isfile(path) then
						return nil
					end
					return HttpService:JSONDecode(fs.readfile(path))
				end)
				if ok and type(data) == "table" then
					for _, url in ipairs(data) do
						addSaved(url)
					end
					break
				end
			end
		end
		-- returns true when the list reached a file (false = this system has no file access, the extensions only live until the UI closes)
		local function writeSaved()
			local wrote = false
			pcall(function()
				if not fs.writefile then
					return
				end
				if fs.makefolder then
					local exists = false
					if fs.isfolder then
						local okDir, has = pcall(fs.isfolder, SAVE_DIR)
						exists = okDir and has == true
					end
					if not exists then
						pcall(fs.makefolder, SAVE_DIR)
					end
				end
				local json = HttpService:JSONEncode(savedUrls)
				for _, path in ipairs(SAVE_PATHS) do
					if pcall(fs.writefile, path, json) then
						wrote = true
					end
				end
			end)
			return wrote
		end

		-- GET a url on ANY system: every executor request() that exists (the first one may be there but broken, so each is tried), then
		-- game:HttpGet in its two spellings, then HttpService. Returns the body, or nil + a reason
		local function httpGet(url)
			local reason = "no HTTP function is available here"
			local candidates = {}
			local function addCandidate(fn)
				if type(fn) ~= "function" then
					return
				end
				for _, known in ipairs(candidates) do
					if known == fn then
						return
					end
				end
				candidates[#candidates + 1] = fn
			end
			for _, getter in ipairs({
				function() return request end,
				function() return http_request end,
				function() return syn.request end,
				function() return http.request end,
				function() return fluxus.request end,
			}) do
				local okGet, fn = pcall(getter)
				if okGet then
					addCandidate(fn)
				end
			end
			addCandidate(findFn("request")) -- a system that only keeps it in getgenv() / the script environment
			addCandidate(findFn("http_request"))
			for _, requestFn in ipairs(candidates) do
				local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
				if ok and type(res) == "table" then
					local code = tonumber(res.StatusCode or res.Status)
					if type(res.Body) == "string" and (code == nil or (code >= 200 and code < 300)) then
						return res.Body
					end
					reason = "HTTP " .. tostring(code or res.StatusMessage or "error")
				elseif not ok then
					reason = tostring(res)
				end
			end
			for _, call in ipairs({
				function() return game:HttpGet(url) end,
				function() return game:HttpGet(url, true) end, -- some mobile executors only answer with the second argument
				function() return game:HttpGetAsync(url) end,
				function() return HttpService:GetAsync(url) end,
				function()
					local res = HttpService:RequestAsync({ Url = url, Method = "GET" })
					if res and res.Success then
						return res.Body
					end
				end,
			}) do
				local okCall, body = pcall(call)
				if okCall and type(body) == "string" then
					return body
				end
			end
			return nil, reason
		end

		-- turns what was pasted into a plain download url. A whole  loadstring(game:HttpGet("https://..."))()  line works too,
		-- the link may leave out https://, and GitHub / Gist / Pastebin PAGE links become their raw links
		local function cleanUrl(text)
			text = tostring(text or "")
			local found = string.match(text, "https?://[^%s\"'%)%]]+")
			if not found then
				local bare = string.match(text, "^%s*([%w%-%.]+%.%a+/%S*)%s*$")
				if bare then
					found = "https://" .. bare
				end
			end
			if not found then
				return nil
			end
			found = string.gsub(found, "[,;]+$", "")
			local user, repo, rest = string.match(found, "^https?://github%.com/([^/]+)/([^/]+)/blob/(.+)$")
			if not user then
				user, repo, rest = string.match(found, "^https?://github%.com/([^/]+)/([^/]+)/raw/(.+)$")
			end
			if user then
				return "https://raw.githubusercontent.com/" .. user .. "/" .. repo .. "/" .. rest
			end
			local gistUser, gistId = string.match(found, "^https?://gist%.github%.com/([^/]+)/(%x+)/?$")
			if gistUser then
				return "https://gist.githubusercontent.com/" .. gistUser .. "/" .. gistId .. "/raw"
			end
			local paste = string.match(found, "^https?://pastebin%.com/(%w+)/?$")
			if paste then
				return "https://pastebin.com/raw/" .. paste
			end
			return found
		end

		local function shortHash(text)
			local h = 5381
			for i = 1, #text do
				h = (h * 33 + string.byte(text, i)) % 4294967296
			end
			return string.format("%x", h)
		end

		-- a name for an extension that has none: "-- Title: ..." / "-- Name: ..." in its first lines, else the file name of the url
		local function guessTitle(source, url)
			local head = string.sub(tostring(source or ""), 1, 1500)
			local t = string.match(head, "%-%-%s*[Tt][Ii][Tt][Ll][Ee]%s*[:=]%s*([^\r\n]+)")
				or string.match(head, "%-%-%s*[Nn][Aa][Mm][Ee]%s*[:=]%s*([^\r\n]+)")
				or string.match(head, "%-%-@[Tt]itle%s+([^\r\n]+)")
			if not t then
				local path = string.match(tostring(url or ""), "^[^?#]+") or ""
				local file = string.match(path, "([^/]+)$") or ""
				file = string.gsub(file, "%.%w+$", "")
				if file == "" or string.lower(file) == "raw" then
					file = string.match(path, "^https?://([^/]+)") or "Extension"
				end
				t = string.gsub(file, "[_%-%+]+", " ")
			end
			t = string.match(t, "^%s*(.-)%s*$") or t
			if t == "" then
				t = "Extension"
			end
			t = string.upper(string.sub(t, 1, 1)) .. string.sub(t, 2)
			return string.sub(t, 1, 28)
		end

		local function pick(data, ...)
			for _, key in ipairs({ ... }) do
				local v = data[key]
				if v ~= nil and v ~= "" then
					return v
				end
			end
			return nil
		end

		-- downloads + checks one extension. ONLY JSON installs:
		--   { "id": "my_ext", "title": "My Extension", "icon": "rbxassetid://123", "source": "-- Luau code of the extension" }
		--   (id and icon are optional; also name / code / script / lua / main, and "source" may be a url or a list of lines)
		-- A plain Luau file or a web page is refused with a message that says what to use.
		-- Returns the table, or nil + a reason
		local function fetchExtension(url)
			local body, reason = httpGet(url)
			if not body then
				return nil, reason
			end
			body = (string.gsub(body, "^\239\187\191", "")) -- a byte order mark at the start breaks JSON and loadstring
			if not string.find(body, "%S") then
				return nil, "the url returned an empty file"
			end

			if not string.match(body, "^%s*{") then -- JSON only: a Luau file / web page / anything else is refused
				if string.match(body, "^%s*<") then
					return nil, "the link opens a web page, not a JSON file - use the file's Raw link"
				end
				if string.match(body, "^%s*%[") then
					return nil, "the JSON must be one object { \"title\": ..., \"source\": ... }, not a list"
				end
				return nil, "only JSON extensions can be installed - the link must open a .json file"
			end
			local data
			local okJson, decoded = pcall(function()
				return HttpService:JSONDecode(body)
			end)
			if okJson and type(decoded) == "table" then
				data = decoded
			end
			if not data then
				return nil, "the file is not valid JSON (check the commas and quotes)"
			end

			if data then
				if type(data.extension) == "table" then
					data = data.extension
				elseif type(data.plugin) == "table" then
					data = data.plugin
				end
				local source = pick(data, "source", "Source", "code", "Code", "script", "Script", "lua", "Lua", "main", "content")
				if type(source) == "table" then -- the code as a list of lines
					local lines = {}
					for _, line in ipairs(source) do
						lines[#lines + 1] = tostring(line)
					end
					source = table.concat(lines, "\n")
				end
				if type(source) == "string" and string.match(source, "^%s*https?://%S+%s*$") then
					local sub, subReason = httpGet(cleanUrl(source) or source)
					if not sub then
						return nil, "the extension's source url failed (" .. tostring(subReason) .. ")"
					end
					source = (string.gsub(sub, "^\239\187\191", ""))
				end
				if type(source) ~= "string" or not string.find(source, "%S") then
					return nil, "the JSON has no \"source\" text (the Luau code of the extension)"
				end
				return {
					id = pick(data, "id", "Id", "ID"),
					title = pick(data, "title", "Title", "name", "Name") or guessTitle(source, url),
					icon = pick(data, "icon", "Icon", "image", "Image", "thumbnail", "logo"),
					source = source,
					url = url,
				}
			end

			return nil, "only JSON extensions can be installed - the link must open a .json file"
		end

		local function iconOf(value)
			if type(value) == "number" then
				return "rbxassetid://" .. tostring(math.floor(value))
			end
			if type(value) == "string" and value ~= "" then
				if string.match(value, "^%d+$") then
					return "rbxassetid://" .. value
				end
				return value
			end
			return A.Logo
		end

		----------------------------------------------------------------
		-- EXTENSION NAMES + PICTURES (hold a tile: Rename / Change image / Delete)
		----------------------------------------------------------------
		-- What the person changed on a tile is kept per extension id in ArcyScripts/plugin_meta.json (hidden name on every system but iOS, like the list of
		-- installed extensions):  { ["Plugin_ab12"] = { title = "My name", image = "rbxassetid://123" or "https://.../icon.png" } }
		-- A picture link is downloaded once (ArcyScripts/ext_images, needs writefile + getcustomasset) and the cached file is used from then on.
		local META_PATHS = {
			SAVE_DIR .. "/" .. HIDE_PREFIX .. "plugin_meta.json",
			SAVE_DIR .. "/plugin_meta.json",
		}
		local IMAGE_DIR = SAVE_DIR .. "/ext_images"
		local pluginMeta = {}
		do
			for _, path in ipairs(META_PATHS) do
				local ok, data = pcall(function()
					if not fs.readfile then
						return nil
					end
					if fs.isfile and not fs.isfile(path) then
						return nil
					end
					return HttpService:JSONDecode(fs.readfile(path))
				end)
				if ok and type(data) == "table" then
					pluginMeta = data
					break
				end
			end
		end

		local function ensureFolder(dir)
			if not fs.makefolder then
				return
			end
			local exists = false
			if fs.isfolder then
				local okDir, has = pcall(fs.isfolder, dir)
				exists = okDir and has == true
			end
			if not exists then
				pcall(fs.makefolder, dir)
			end
		end

		local function saveMeta()
			pcall(function()
				if not fs.writefile then
					return
				end
				ensureFolder(SAVE_DIR)
				local json = HttpService:JSONEncode(pluginMeta)
				for _, path in ipairs(META_PATHS) do
					pcall(fs.writefile, path, json)
				end
			end)
		end

		local function metaOf(id) -- the record of one extension (made when asked for)
			local rec = pluginMeta[id]
			if type(rec) ~= "table" then
				rec = {}
				pluginMeta[id] = rec
			end
			return rec
		end

		local function isLink(value)
			return type(value) == "string" and string.match(value, "^%s*https?://") ~= nil
		end

		-- a picture a tile can show. value = an image id (123456 / rbxassetid://123 / rbxthumb://...) or a link to a PNG / JPG.
		-- allowDownload = false never touches the network (a link is only used when its file is already cached).
		-- Returns the image string, or nil + a reason. A download yields - call it from task.spawn.
		local function resolveImage(value, allowDownload)
			if type(value) == "number" then
				return "rbxassetid://" .. tostring(math.floor(value))
			end
			if type(value) ~= "string" then
				return nil, "no picture"
			end
			value = string.match(value, "^%s*(.-)%s*$") or value
			if value == "" then
				return nil, "no picture"
			end
			if string.match(value, "^%d+$") then
				return "rbxassetid://" .. value
			end
			if string.match(value, "^rbxassetid://") or string.match(value, "^rbxthumb://") or string.match(value, "^rbxasset://") then
				return value
			end
			if not isLink(value) then
				return nil, "use an image id (123456) or a link to a PNG / JPG"
			end
			local url = cleanUrl(value) or value
			local assetFn = findFn("getcustomasset", function() return getcustomasset end)
				or findFn("getsynasset", function() return getsynasset end)
			if not (assetFn and fs.writefile) then
				return nil, "this system cannot show a picture from a link (needs writefile + getcustomasset) - use an image id"
			end
			local key = shortHash(url)
			for _, kind in ipairs({ "png", "jpg" }) do -- already downloaded?
				local path = IMAGE_DIR .. "/" .. key .. "." .. kind
				local okFile, has = pcall(function()
					return fs.isfile and fs.isfile(path)
				end)
				if okFile and has then
					local okAsset, asset = pcall(assetFn, path)
					if okAsset and type(asset) == "string" and asset ~= "" then
						return asset
					end
				end
			end
			if not allowDownload then
				return nil, "not downloaded yet"
			end
			local body, reason = httpGet(url)
			if not body then
				return nil, "download failed (" .. tostring(reason) .. ")"
			end
			local kind
			if string.sub(body, 1, 4) == "\137PNG" then
				kind = "png"
			elseif string.sub(body, 1, 3) == "\255\216\255" then
				kind = "jpg"
			end
			if not kind then
				return nil, "the link is not a PNG / JPG picture"
			end
			ensureFolder(SAVE_DIR)
			ensureFolder(IMAGE_DIR)
			local path = IMAGE_DIR .. "/" .. key .. "." .. kind
			if not pcall(fs.writefile, path, body) then
				return nil, "could not save the picture file"
			end
			local okAsset, asset = pcall(assetFn, path)
			if okAsset and type(asset) == "string" and asset ~= "" then
				return asset
			end
			return nil, "the picture could not be loaded"
		end
		----------------------------------------------------------------
		-- EXTENSIONS (tile, area, start / open / close / detach / remove)
		----------------------------------------------------------------
		local plugins = {} -- { id, title, icon, url, source | builder, order, frame, tile, loaded, detached, float, protected }
		-- Built-in hubs that can never be deleted. Every other extension (installed from a link or added with homeRefs.ext.add) can be.
		local PROTECTED_IDS = { AXS_Hub = true } -- the Arceus Hub
		local function isProtected(entry)
			return entry ~= nil and (entry.protected == true or PROTECTED_IDS[entry.id] == true)
		end
		local ordinal = 0
		local current = nil -- the extension that is open in the page
		local openPlugin, closePlugin, detachPlugin, attachPlugin, removePlugin

		local function info(entry)
			return { id = entry.id, title = entry.title, url = entry.url }
		end

		-- an extension can ask to be told every time its content appears (opened in the page or detached): api.OnShown(function() ... end)
		local function playShown(entry)
			if entry.onShown then
				task.defer(function()
					pcall(entry.onShown)
				end)
			end
		end

		----------------------------------------------------------------
		-- HUB LIBRARY (api.Library) - the Arceus Hub look as a toolkit
		----------------------------------------------------------------
		-- Every extension gets api.Library. It builds the same screen as the Arceus Hub: the icon column on the left (the open tab sits on a dark red
		-- tile), a scrolling page of rows (dark glass plate, white title, the control on the right) and red-lined section headers.
		--
		--     local api = ...
		--     local win = api.Library:CreateWindow({ Title = "Test" })
		--     local shop = win:AddTab({ Title = "Seed Shop", Icon = "home" })   -- Icon: rbxassetid, number, or "home" / "executor" / "cloud" / "settings" ...
		--     shop:AddSection("Seed Shop")                                       -- no Icon = the first letter of the title
		--     local seed = shop:AddDropdown({ Title = "Choose Seed", Options = { "None", "Carrot", "Tomato" }, Default = "None", Callback = function(v) end })
		--     shop:AddToggle({ Title = "Auto Buy Seed", Default = false, Callback = function(on) end })
		--     shop:AddButton({ Title = "Buy now", ButtonText = "Buy", Callback = function() end })
		--     shop:AddSlider({ Title = "Amount", Min = 1, Max = 50, Step = 1, Default = 5, Callback = function(n) end })
		--     shop:AddInput({ Title = "Player", Placeholder = "name", Callback = function(text) end })
		--     shop:AddLabel("Any text")
		--     seed:Set("Carrot")  seed:SetOptions({ "None", "Pea" })  win.Flags["Choose Seed"]   -- Set / Get / Flags (Flag = "name" picks the key, the title is the default)
		--
		-- Elements: AddSection, AddToggle, AddDropdown (Multi = true gives a list of picks), AddButton, AddSlider (= AddStepper), AddInput, AddLabel.
		-- Options may be written like other hub libraries do (Name / Text for Title, CurrentValue / Value for Default, Values / List for Options,
		-- CreateTab / MakeTab, CreateToggle ... all work), and "tab:AddToggle(title, default, callback)" works too. Both ":" and "." calls work.
		-- Callbacks run protected: an error inside one is reported in the Output window and never breaks the page.
		local function makeLibrary(api)
			local RED = Theme.sh.bright -- switch, buttons, + / - (Primary Color: Red = 254, 0, 0 sampled from the Hub screenshot)
			local TILE_RED = Theme.sh.tile -- the open tab's tile
			local LINE_RED = Theme.sh.line -- the line under a section title
			local OFF_GREY = Color3.fromRGB(85, 85, 85) -- switch OFF
			local EDGE = Color3.fromRGB(42, 42, 42) -- thin outline of the boxes / dropdown / switch
			local PLATE = Color3.fromRGB(12, 12, 12) -- box / dropdown fill
			-- SWITCH / DROPDOWN LOOK (from the reference picture): dark plate + thick grey rim + white rounded knob; ON = solid red with a dark red rim
			local SWITCH_OFF = Color3.fromRGB(14, 14, 14) -- switch OFF fill
			local RIM_OFF = Color3.fromRGB(68, 64, 64) -- thick grey rim of the switch (OFF) and of the dropdown
			local RIM_ON = Theme.sh.rim -- rim of the switch when ON
			-- BUTTON LOOK: UP / DOWN, the library Button, - / + and the number box all read this table, so they always match
			local BTN = {
				H = 0.52, -- height (fraction of the row)
				CORNER = 0.22, -- corner roundness
				PAD = 0.27, -- text padding inside a button
				RIGHT = 0.976, -- right edge of the buttons (fraction of the row)
				PRESS = Theme.sh.press, -- red while held
				RIM = RIM_OFF, -- rim of the number box (same grey as the dropdown / switch)
				RIMW = 2.5, -- rim thickness
			}
			local KNOB_SIZE, KNOB_PRESS = 0.78, 0.62 -- knob height (fraction of the switch) at rest / while the finger is down
			local KNOB_OFF_X, KNOB_ON_X = 0.3, 0.7 -- where the knob sits (fraction of the switch width)
			Theme.onChange(function(theme) -- Settings > Primary Color: the hub's shades follow the chosen colour (what is already on screen is repainted by Theme.repaint)
				local sh = theme.sh
				RED, TILE_RED, LINE_RED, RIM_ON, BTN.PRESS = sh.bright, sh.tile, sh.line, sh.rim, sh.press
			end)
			local function switchLook(track, on, animate)
				local stroke = track:FindFirstChildOfClass("UIStroke")
				local fill = on and RED or SWITCH_OFF
				local rim = on and RIM_ON or RIM_OFF
				local shade = on and 0 or 0.1
				if animate then
					tween(track, 0.25, { BackgroundColor3 = fill, BackgroundTransparency = shade })
					if stroke then
						tween(stroke, 0.25, { Color = rim })
					end
				else
					track.BackgroundColor3 = fill
					track.BackgroundTransparency = shade
					if stroke then
						stroke.Color = rim
					end
				end
			end
			local HUB_RATIO = (0.925 * 16) / ((0.975 - PLUGIN_Y) * 9) -- same proportions as the Hub, also in the detached window
			local ROW_X, ROW_W = 0.0859, 0.893
			local TAB_X, TAB_SIZE, TAB_STEP, TAB_Y = 0.0378, 0.0594, 0.1306, 0.1289
			local ROW_H, SECTION_H, LABEL_H, GAP = 0.15, 0.1, 0.11, 0.022 -- fractions of the window height
			local MAX_LIST = 5 -- a dropdown shows this many options, the rest scrolls
			local ICONS = {
				home = A.Home, executor = A.Executor, script = A.Executor, editor = A.Executor, cloud = A.ScriptHub, scripthub = A.ScriptHub,
				intelligence = A.Intelligence, extensions = A.Extensions, plugin = A.Extensions, settings = A.Settings, logo = A.Logo, hub = A.HubIcon,
			}

			local lib = {}
			local window = nil -- the extension's window (a second CreateWindow replaces the first)

			-- first value that is set (false counts) under any of the names
			local function field(o, ...)
				for _, key in ipairs({ ... }) do
					local v = o[key]
					if v ~= nil then
						return v
					end
				end
				return nil
			end

			-- ("Title", default, callback) / ("Title", { options }, "default", callback) -> the same table as { Title =, Default =, Options =, Callback = }
			local function norm(first, ...)
				if type(first) == "table" then
					return first
				end
				local o = { Title = first }
				local extra = table.pack(...)
				for i = 1, extra.n do
					local v = extra[i]
					if type(v) == "function" then
						o.Callback = v
					elseif type(v) == "table" then
						o.Options = v
					elseif o.Default == nil and v ~= nil then
						o.Default = v
					end
				end
				return o
			end

			-- makes obj:Method(x) and obj.Method(x) the same call
			local function method(obj, fn)
				return function(first, ...)
					if first == obj then
						return fn(...)
					end
					return fn(first, ...)
				end
			end

			local function fire(callback, ...)
				if type(callback) ~= "function" then
					return
				end
				local ok, err = pcall(callback, ...)
				if not ok then
					logWarn(
						"Extension '" .. tostring(api.Title) .. "' callback failed: " .. tostring(err),
						"the function you gave to a hub element raised an error",
						"fix the callback in the extension's source"
					)
				end
			end

			local function assetOf(value)
				if type(value) == "number" then
					return "rbxassetid://" .. string.format("%.0f", value)
				end
				if type(value) == "string" and value ~= "" then
					local named = ICONS[string.lower(value)]
					if named then
						return named
					end
					if string.match(value, "^%d+$") then
						return "rbxassetid://" .. value
					end
					if string.find(value, "://", 1, true) then
						return value
					end
				end
				return nil
			end

			local function firstChar(text)
				local ok, cut = pcall(function()
					return utf8.offset(text, 2)
				end)
				local last = ok and cut and (cut - 1) or 1
				local char = string.sub(text, 1, last)
				return char ~= "" and string.upper(char) or "?"
			end

			local function createWindow(first, ...)
				local wo = norm(first, ...)
				if window and window.Frame and window.Frame.Parent then
					pcall(function()
						window.Frame:Destroy() -- a second window replaces the first
					end)
				end

				local stage = new("Frame", {
					Name = "HubLibraryStage",
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Parent = api.Frame,
				}, { new("UIAspectRatioConstraint", { AspectRatio = HUB_RATIO }) })

				local win = { Frame = stage, Flags = {}, Tabs = {}, Title = tostring(field(wo, "Title", "Name", "Text") or api.Title or "") }
				window = win
				local tabs = win.Tabs
				local current = nil
				local openList = nil -- the function that closes the dropdown list that is open

				-- a tap anywhere outside the open dropdown list closes it
				local catcher = new("TextButton", {
					Name = "ListCatcher",
					Text = "",
					AutoButtonColor = false,
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1),
					ZIndex = 40,
					Visible = false,
					Parent = stage,
				})
				local function closeList()
					if openList then
						local close = openList
						openList = nil
						pcall(close)
					end
					catcher.Visible = false
				end
				catcher.Activated:Connect(closeList)

				-- rows are as tall as a fraction of the window: their pixel height follows the window when it is resized
				local function unit()
					local h = stage.AbsoluteSize.Y
					if h < 10 then
						h = 300
					end
					return h
				end
				local function applySizes()
					local h = unit()
					for _, tab in ipairs(tabs) do
						tab.layout.Padding = UDim.new(0, math.floor(h * GAP))
						for _, item in ipairs(tab.items) do
							if item.frame.Parent then
								item.frame.Size = UDim2.new(1, 0, 0, math.max(8, math.floor(h * item.h)))
							end
						end
					end
				end
				stage:GetPropertyChangedSignal("AbsoluteSize"):Connect(applySizes)

				-- icon column: the tiles share the height, so a long list of tabs shrinks them a little
				local function layoutTabs()
					local n = #tabs
					local step = TAB_STEP
					if n > 1 then
						step = math.min(TAB_STEP, (0.9 - TAB_Y) / (n - 1))
					end
					local k = math.min(1, step / TAB_STEP)
					for i, tab in ipairs(tabs) do
						tab.tile.Position = UDim2.fromScale(TAB_X, TAB_Y + (i - 1) * step)
						tab.tile.Size = UDim2.fromScale(TAB_SIZE * k, 0.1143 * k)
					end
				end

				-- the page's intro: the plates fade in one after another
				local function playTab(tab)
					tab.scroll.CanvasPosition = Vector2.new(0, 0)
					for i, item in ipairs(tab.items) do
						if item.alpha < 1 then
							item.frame.BackgroundTransparency = 1
							task.delay(math.min((i - 1) * 0.05, 0.5), function()
								if item.frame.Parent then
									tween(item.frame, 0.4, { BackgroundTransparency = item.alpha })
								end
							end)
						end
					end
				end

				local function showTab(tab, animate)
					if current == tab then
						return
					end
					closeList()
					current = tab
					for _, other in ipairs(tabs) do
						local on = other == tab
						other.scroll.Visible = on
						tween(other.tile, 0.25, { BackgroundTransparency = on and 0 or 1 })
					end
					if api.SetSubtitle then
						api.SetSubtitle(tab.Header) -- the grey title in the middle of the detached window
					end
					if animate then
						playTab(tab)
					end
				end

				local function addTab(first, ...)
					local to = norm(first, ...)
					local title = tostring(field(to, "Title", "Name", "Text") or ("Tab " .. (#tabs + 1)))
					local tab = { Title = title, Header = tostring(field(to, "Header", "Subtitle") or title), items = {}, order = 0 }

					local layout = new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) })
					local scroll = new("ScrollingFrame", {
						Name = "Page_" .. title,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Position = UDim2.fromScale(ROW_X, 0.03),
						Size = UDim2.fromScale(ROW_W, 0.94),
						CanvasSize = UDim2.new(0, 0, 0, 0),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ScrollingDirection = Enum.ScrollingDirection.Y,
						ScrollBarThickness = 3,
						ScrollBarImageColor3 = Color3.fromRGB(150, 150, 150),
						Visible = false,
						Parent = stage,
					}, { layout })
					tab.scroll, tab.layout = scroll, layout

					local tile = new("TextButton", {
						Name = "Tab_" .. title,
						Text = "",
						AutoButtonColor = false,
						AnchorPoint = CENTER,
						Position = UDim2.fromScale(TAB_X, TAB_Y),
						Size = UDim2.fromScale(TAB_SIZE, 0.1143),
						BackgroundColor3 = TILE_RED,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Parent = stage,
					}, { corner(0.22), ratio(1) })
					local asset = assetOf(field(to, "Icon", "Image"))
					if asset then
						new("ImageLabel", {
							Name = "Icon",
							Image = asset,
							ScaleType = Enum.ScaleType.Fit,
							AnchorPoint = CENTER,
							Position = UDim2.fromScale(0.5, 0.5),
							Size = UDim2.fromScale(0.62, 0.62),
							BackgroundTransparency = 1,
							Parent = tile,
						})
					else
						label({
							Name = "Letter",
							Text = firstChar(title),
							FontFace = FONT.Black,
							TextColor3 = WHITE,
							AnchorPoint = CENTER,
							Position = UDim2.fromScale(0.5, 0.5),
							Size = UDim2.fromScale(0.5, 0.5),
							Parent = tile,
						})
					end
					pressFx(tile)
					tab.tile = tile
					tile.Activated:Connect(function()
						showTab(tab, true)
					end)

					-- a row (plate = true) or a bare line (section / label) in the page
					local function newItem(h, plate)
						tab.order = tab.order + 1
						local frame = new("Frame", {
							Name = "Item_" .. tab.order,
							BackgroundColor3 = Color3.new(0, 0, 0),
							BackgroundTransparency = plate and 0.7 or 1, -- source: SettingToggle plate (#000, .7)
							BorderSizePixel = 0,
							LayoutOrder = tab.order,
							Size = UDim2.new(1, 0, 0, math.max(8, math.floor(unit() * h))),
							Parent = scroll,
						})
						if plate then
							corner(0.22).Parent = frame
						end
						tab.items[#tab.items + 1] = { frame = frame, h = h, alpha = plate and 0.7 or 1 }
						return frame
					end

					local function rowTitle(frame, title, desc)
						if type(desc) == "string" and desc ~= "" then
							label({
								Name = "Title",
								Text = title,
								FontFace = FONT.Body,
								TextXAlignment = Enum.TextXAlignment.Left,
								TextYAlignment = Enum.TextYAlignment.Bottom,
								Position = UDim2.fromScale(0.024, 0.08),
								Size = UDim2.fromScale(0.5, 0.4),
								Parent = frame,
							})
							label({
								Name = "Description",
								Text = desc,
								FontFace = FONT.Description,
								TextXAlignment = Enum.TextXAlignment.Left,
								TextYAlignment = Enum.TextYAlignment.Top,
								TextTransparency = 0.5, -- source: description at .5
								AnchorPoint = Vector2.new(0, 1),
								Position = UDim2.fromScale(0.024, 0.86),
								Size = UDim2.fromScale(0.55, 0.27),
								Parent = frame,
							})
						else
							label({
								Name = "Title",
								Text = title,
								FontFace = FONT.Body,
								TextXAlignment = Enum.TextXAlignment.Left,
								AnchorPoint = Vector2.new(0, 0.5),
								Position = UDim2.fromScale(0.024, 0.5),
								Size = UDim2.fromScale(0.5, 0.5),
								Parent = frame,
							})
						end
					end

					local function titleOf(o)
						return tostring(field(o, "Title", "Name", "Text", "Label") or "")
					end

					----------------------------------------------------------------
					-- ELEMENTS
					----------------------------------------------------------------
					local function addSection(first, ...)
						local o = norm(first, ...)
						local frame = newItem(SECTION_H, false)
						label({
							Name = "Title",
							Text = titleOf(o),
							FontFace = FONT.Title,
							TextXAlignment = Enum.TextXAlignment.Left,
							AnchorPoint = Vector2.new(0, 1),
							Position = UDim2.fromScale(0.01, 0.8),
							Size = UDim2.fromScale(0.6, 0.55),
							Parent = frame,
						})
						new("Frame", {
							Name = "Line",
							AnchorPoint = Vector2.new(0, 1),
							Position = UDim2.fromScale(0, 1),
							Size = UDim2.new(1, 0, 0, 2),
							BackgroundColor3 = LINE_RED,
							BorderSizePixel = 0,
							Parent = frame,
						})
						return {}
					end

					local function addLabel(first, ...)
						local o = norm(first, ...)
						local frame = newItem(LABEL_H, true)
						label({
							Name = "Text",
							Text = titleOf(o),
							FontFace = FONT.Description,
							TextXAlignment = Enum.TextXAlignment.Left,
							AnchorPoint = CENTER,
							Position = UDim2.fromScale(0.5, 0.5),
							Size = UDim2.fromScale(0.94, 0.5),
							Parent = frame,
						})
						local el = {}
						el.Set = method(el, function(text)
							local shown = frame:FindFirstChild("Text")
							if shown then
								shown.Text = tostring(text or "")
							end
						end)
						return el
					end

					local function addToggle(first, ...)
						local o = norm(first, ...)
						local title = titleOf(o)
						local frame = newItem(ROW_H, true)
						rowTitle(frame, title, field(o, "Description", "Desc", "Content"))
						local on = field(o, "Default", "CurrentValue", "Value", "Enabled") == true
						local callback = field(o, "Callback", "OnChange", "Changed")
						local flag = tostring(field(o, "Flag", "Id") or title)
						win.Flags[flag] = on

						local track = new("TextButton", {
							Name = "Toggle",
							Text = "",
							AutoButtonColor = false,
							AnchorPoint = Vector2.new(1, 0.5),
							Position = UDim2.fromScale(0.975, 0.5),
							Size = UDim2.fromScale(0.1, 0.58),
							BackgroundColor3 = on and RED or SWITCH_OFF,
							BackgroundTransparency = on and 0 or 0.1,
							BorderSizePixel = 0,
							Parent = frame,
						}, { corner(0.4), new("UIStroke", { Color = on and RIM_ON or RIM_OFF, Thickness = 2.5 }), ratio(1.45) })
						local knob = new("Frame", {
							Name = "Knob",
							AnchorPoint = CENTER,
							Position = UDim2.fromScale(on and KNOB_ON_X or KNOB_OFF_X, 0.5),
							Size = UDim2.fromScale(KNOB_SIZE, KNOB_SIZE),
							BackgroundColor3 = WHITE,
							BorderSizePixel = 0,
							Parent = track,
						}, { corner(0.4), ratio(1) })
						pressFx(track)
						-- the knob squeezes while the finger is down and springs back when it lets go
						track.InputBegan:Connect(function(input)
							if isTap(input) then
								tween(knob, 0.1, { Size = UDim2.fromScale(KNOB_PRESS, KNOB_PRESS) })
							end
						end)
						track.InputEnded:Connect(function(input)
							if isTap(input) then
								tween(knob, 0.25, { Size = UDim2.fromScale(KNOB_SIZE, KNOB_SIZE) }, Enum.EasingStyle.Back)
							end
						end)

						local function set(value, silent)
							value = value == true
							if value == on then
								return
							end
							on = value
							win.Flags[flag] = on
							tween(knob, 0.3, { Position = UDim2.fromScale(on and KNOB_ON_X or KNOB_OFF_X, 0.5) }, Enum.EasingStyle.Back)
							switchLook(track, on, true)
							if not silent then
								fire(callback, on)
							end
						end
						track.Activated:Connect(function()
							set(not on)
						end)

						local el = {}
						el.Set = method(el, function(value)
							set(value, true) -- set from code: the callback is not called
						end)
						el.Get = method(el, function()
							return on
						end)
						return el
					end

					local function addButton(first, ...)
						local o = norm(first, ...)
						local frame = newItem(ROW_H, true)
						rowTitle(frame, titleOf(o), field(o, "Description", "Desc", "Content"))
						local callback = field(o, "Callback", "OnClick", "Clicked")
						local button = new("TextButton", {
							Name = "Action",
							Text = tostring(field(o, "ButtonText", "Button", "Action") or "Run"),
							FontFace = FONT.Title,
							TextColor3 = WHITE,
							TextScaled = true,
							AutoButtonColor = false,
							AnchorPoint = Vector2.new(1, 0.5),
							Position = UDim2.fromScale(BTN.RIGHT, 0.5),
							Size = UDim2.fromScale(0.2, BTN.H),
							BackgroundColor3 = RED,
							BorderSizePixel = 0,
							Parent = frame,
						}, { corner(BTN.CORNER), new("UIPadding", { PaddingTop = UDim.new(BTN.PAD, 0), PaddingBottom = UDim.new(BTN.PAD, 0) }) })
						pressFx(button)
						button.Activated:Connect(function()
							fire(callback)
						end)
						local el = {}
						el.SetText = method(el, function(text)
							button.Text = tostring(text or "")
						end)
						return el
					end

					-- [-] [ 5 ] [+]
					local function addStepper(first, ...)
						local o = norm(first, ...)
						local title = titleOf(o)
						local frame = newItem(ROW_H, true)
						rowTitle(frame, title, field(o, "Description", "Desc", "Content"))
						local min = tonumber(field(o, "Min", "Minimum")) or 0
						local max = tonumber(field(o, "Max", "Maximum")) or 100
						local step = tonumber(field(o, "Step", "Increment")) or 1
						if step <= 0 then
							step = 1
						end
						local callback = field(o, "Callback", "OnChange", "Changed")
						local flag = tostring(field(o, "Flag", "Id") or title)
						local value = math.clamp(tonumber(field(o, "Default", "CurrentValue", "Value")) or min, min, max)
						win.Flags[flag] = value

						local box = new("TextBox", {
							Name = "Value",
							Text = tostring(value),
							FontFace = FONT.Body,
							TextColor3 = WHITE,
							TextScaled = true,
							ClearTextOnFocus = false,
							AnchorPoint = CENTER,
							Position = UDim2.fromScale(0.8383, 0.5),
							Size = UDim2.fromScale(0.1807, BTN.H),
							BackgroundColor3 = Color3.fromRGB(10, 10, 10),
							BorderSizePixel = 0,
							Parent = frame,
						}, {
							corner(BTN.CORNER),
							new("UIPadding", { PaddingTop = UDim.new(BTN.PAD, 0), PaddingBottom = UDim.new(BTN.PAD, 0) }),
						})
						local function set(v, silent)
							v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
							v = math.floor(v * 1000000 + 0.5) / 1000000 -- no 0.30000000000000004
							box.Text = tostring(v)
							if v ~= value then
								value = v
								win.Flags[flag] = value
								if not silent then
									fire(callback, value)
								end
							end
						end
						box.FocusLost:Connect(function()
							local typed = tonumber(string.match(box.Text, "%-?%d+%.?%d*"))
							set(typed or value)
						end)
						local function square(text, x, delta)
							local button = new("TextButton", {
								Name = text == "+" and "Plus" or "Minus",
								Text = text,
								FontFace = FONT.Title,
								TextColor3 = WHITE,
								TextScaled = true,
								AutoButtonColor = false,
								AnchorPoint = Vector2.new(1, 0.5),
								Position = UDim2.fromScale(x, 0.5),
								Size = UDim2.fromScale(0.5, BTN.H), -- the aspect ratio makes it a square as tall as UP / DOWN
								BackgroundColor3 = RED,
								BorderSizePixel = 0,
								Parent = frame,
							}, {
								corner(BTN.CORNER),
								ratio(1),
								new("UIPadding", { PaddingTop = UDim.new(BTN.PAD, 0), PaddingBottom = UDim.new(BTN.PAD, 0), PaddingLeft = UDim.new(BTN.PAD, 0), PaddingRight = UDim.new(BTN.PAD, 0) }),
							})
							pressFx(button)
							button.Activated:Connect(function()
								set(value + delta)
							end)
						end
						square("-", 0.737, -step)
						square("+", BTN.RIGHT, step)

						local el = {}
						el.Set = method(el, function(v)
							set(tonumber(v) or value, true)
						end)
						el.Get = method(el, function()
							return value
						end)
						return el
					end

					local function addInput(first, ...)
						local o = norm(first, ...)
						local title = titleOf(o)
						local frame = newItem(ROW_H, true)
						rowTitle(frame, title, field(o, "Description", "Desc", "Content"))
						local callback = field(o, "Callback", "OnChange", "Changed")
						local flag = tostring(field(o, "Flag", "Id") or title)
						local text = tostring(field(o, "Default", "CurrentValue", "Value") or "")
						win.Flags[flag] = text
						local box = new("TextBox", {
