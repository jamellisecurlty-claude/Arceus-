		-- behaviour ------------------------------------------------------------------------
		local busy = false
		local function shake()
			task.spawn(function()
				local base = box.Position
				for _, dx in ipairs({ -0.012, 0.012, -0.007, 0.007, 0 }) do
					if not alive() then
						return
					end
					tween(box, TweenInfo.new(0.04), { Position = UDim2.new(base.X.Scale + dx, base.X.Offset, base.Y.Scale, base.Y.Offset) })
					task.wait(0.045)
				end
			end)
		end

		local function submit()
			if busy or self._licenseOk then
				return
			end
			local email = string.gsub(box.Text, "^%s*(.-)%s*$", "%1")
			if email == "" then
				say("Enter your email first.", true)
				shake()
				return
			end
			if not string.match(email, EMAIL_PATTERN) then
				say("Invalid email format.", true)
				shake()
				return
			end
			busy = true
			say("Checking...", false)
			task.spawn(function()
				local accepted, reply = checkLicense(email)
				if type(L.Validate) == "function" then
					local called, a, b = pcall(L.Validate, email)
					if called then
						accepted, reply = a == true, b
					else
						accepted, reply = false, "Could not check the license."
						warn("[ArcyHome] LICENSE.Validate raised an error: " .. tostring(a))
					end
				end
				if not alive() then
					return
				end
				busy = false
				if accepted then
					writeLicenseFile(email)
					pcall(function()
						if type(L.OnAccepted) == "function" then
							L.OnAccepted(email)
						end
					end)
					say(type(reply) == "string" and reply ~= "" and reply or "Welcome!", false)
					self._glowBoost = 1 -- the glow flashes brighter for a moment
					self._licenseOk = true
				else
					say(type(reply) == "string" and reply ~= "" and reply or "License not accepted.", true)
					shake()
				end
			end)
		end

		----------------------------------------------------------------------------
		-- INSTANT CODE WITH ARCY (tap the Email box)
		-- The source's AI prompt (what the Arcy orb opens): a black shade from the top, the gradient title, a glass pill with the hint text and the
		-- pulsing glow texture behind it (1.96x the pill wide, 4x its height, ImageTransparency 0 <-> 0.5 every 1.5 s). Type the email, press Done /
		-- Enter or tap outside the pill: the text goes into the Email box and the licence texts fade back in. Then tap START.
		----------------------------------------------------------------------------
		local promptOpen = false
		local function openPrompt()
			if promptOpen or busy or self._licenseOk or not alive() then
				return
			end
			promptOpen = true
			local closing = false
			local glowLoop
			local WHITE = Color3.new(1, 1, 1)
			local function unit()
				local w, h = screenSize()
				return math.max(4, math.min(w, h) * (6 / 720)) -- the source's "padding" unit: 6 px on a 720 px tall screen
			end
			local u = unit()
			local soft = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
			local quick = TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

			-- the licence texts fade away while the prompt is open
			pcall(function()
				box:ReleaseFocus()
			end)
			box.PlaceholderText = ""
			tween(message, TweenInfo.new(0.2), { TextTransparency = 1 })
			fade(false, 0.3)

			local overlay = new("Frame", {
				Name = "InstantCodeOverlay",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true, -- blocks taps from reaching the licence screen behind it
				ZIndex = 800,
				Parent = gui,
			})
			local shade = new("Frame", {
				Name = "Shade",
