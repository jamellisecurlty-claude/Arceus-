		---------------- start ----------------
		local glowEditable = makeEditable(CFG.GlowW, CFG.GlowH, arcyBtn)
		local orbEditable = makeEditable(CFG.OrbSize, CFG.OrbSize, orb)
		homeRefs.orbEditable = orbEditable -- the Intelligence page's music-player orb shows this same live picture
		local glowUpdate = glowEditable and buildGlow(glowEditable) or nil
		local orbUpdate = orbEditable and buildOrb(orbEditable) or nil

		if not glowUpdate then
			cardFallback()
		end
		if not orbUpdate then
			orbFallback()
		end
		if not glowUpdate and not orbUpdate then
			logWarn(
				"Arcy card is using the simple glow (no EditableImage)",
				"EditableImage is not enabled / allowed for this game or account",
				"enable Editable Images for the experience to get the full animated glow"
			)
		end

		if glowUpdate or orbUpdate then
			local t0 = os.clock()
			local glowTimer, orbTimer = 0, 0
			local glowStep, orbStep = 1 / CFG.GlowFps, 1 / CFG.OrbFps

			local function step()
				local now = os.clock() - t0
				if glowUpdate and glowTimer >= glowStep * Theme.Perf.scale then
					glowTimer = 0
					glowUpdate((now / CFG.GlowCycle) % 1)
				end
				if orbUpdate and orbTimer >= orbStep * Theme.Perf.scale then
					orbTimer = 0
					orbUpdate((now / CFG.OrbCycle) % 1)
				end
			end

			glowTimer, orbTimer = glowStep, orbStep -- draw the first frame right away
			local okFirst, errFirst = pcall(step)

			local conn
			local function failed(err)
				if conn then
					conn:Disconnect()
				end
				logWarn(
					"The Arcy card glow stopped: " .. tostring(err),
					"the EditableImage could not be written to",
					"the card now uses the simple glow instead"
				)
				cardFallback()
				orbFallback()
			end

			if not okFirst then
				failed(errFirst)
			else
				conn = keepConn(RunService.Heartbeat:Connect(function(dt)
					if not alive or windowState == "hidden" or not (homePage.Visible or (intelRefs.page and intelRefs.page.Visible)) then
						return -- window hidden behind the floating button, or another tab is open: stop repainting the glow
					end
					glowTimer = glowTimer + dt
					orbTimer = orbTimer + dt
					local ok, err = pcall(step)
					if not ok then
						failed(err)
					end
				end))
			end
		end

		-- free the EditableImages when the window is destroyed
		gui.Destroying:Once(function()
			if glowEditable then
				pcall(function()
					glowEditable:Destroy()
				end)
			end
			if orbEditable then
				pcall(function()
					orbEditable:Destroy()
				end)
			end
		end)
	end

