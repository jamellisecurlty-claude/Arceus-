				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = pill,
			})
			local glow = new("ImageLabel", {
				Name = "PromptGlow",
				Image = LICENSE_ASSETS.PromptGlow,
				ImageTransparency = 1, -- fades to 0, then pulses 0 <-> 0.5
				ScaleType = Enum.ScaleType.Stretch,
				AnchorPoint = Vector2.new(0.5, 0),
				Size = UDim2.fromScale(0.85 * 1.96, 0.115 * 4),
				Position = UDim2.fromScale(0.5, 0.25 - (0.115 * 4 - 0.115) / 3),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = overlay,
