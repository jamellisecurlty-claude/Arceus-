		----------------------------------------------------------------
		-- HOME "BEST SCRIPTS" BRIDGE
		-- The Home page carousel (built earlier in this file) shows the best and most popular ScriptBlox scripts (not tied to your game). It talks to this
		-- page through homeRefs.bridge: it asks for the list (getBest), downloads the pictures (queueImage), shares the favourites
		-- (isFav / toggleFav) and opens the same script card as the Cloud Scripts page (openCard).
		----------------------------------------------------------------
		local bridge = homeRefs.bridge
		local HOME_BEST_COUNT = 8 -- cards in the Home carousel

		-- returns: list of normalized scripts (the best + most popular ScriptBlox scripts, whatever game you are in), or nil + a reason when every request failed.
		-- The second value is always nil (kept so the Home page code does not change): the card is no longer tied to the game you are playing.
		-- It tries these in order and tops the list up until HOME_BEST_COUNT cards are found:
		--   1. popular   = free, verified, not patched, most viewed
		--   2. verified  = verified, not patched, most viewed
		--   3. all       = anything not patched, most viewed
		--   4. trending  = what ScriptBlox shows as trending right now
		local BEST_SOURCES = { "popular", "verified", "all", "trending" }

		bridge.getBest = function()
			local out, seen = {}, {}
			local lastReason, gotAnswer = nil, false

			for _, spec in ipairs(BEST_SOURCES) do
				if #out >= HOME_BEST_COUNT then
					break
				end
				local result, reason = fetchResult(buildUrl(spec, "", 1, HOME_BEST_COUNT * 2))
				if result and type(result.scripts) == "table" then
					gotAnswer = true
					for _, scr in ipairs(result.scripts) do
						if type(scr) == "table" and not scr.isPatched then
							local data = normalize(scr)
							if data and not seen[data.slug] then
								seen[data.slug] = true
								out[#out + 1] = data
								if #out >= HOME_BEST_COUNT then
									break
								end
							end
						end
					end
				else
					lastReason = reason
				end
			end

			if #out == 0 and not gotAnswer then
				return nil, nil, lastReason or "no answer"
			end
			return out, nil
		end

