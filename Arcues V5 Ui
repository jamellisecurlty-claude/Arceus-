				-- re-measuring and re-laying out the text on every frame of the animation
				task.wait(0.25)
				if not alive or id ~= run then return end
				local textSize = math.max(8, math.floor(nameBox.AbsoluteSize.Y * 0.66)) -- same letter size as before, now with room for the tails
