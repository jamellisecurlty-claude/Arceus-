		-- SIZES (text and file rows follow the window size; UIScale is divided out so the pop animation does not matter)
		----------------------------------------------------------------
		local function unscaled(guiObject)
			return guiObject.AbsoluteSize / math.max(popScale.Scale, 0.05)
		end

		-- Settings > Editor Text Size (8..32): the number IS the text size in pixels (16 = the default), so what you pick is what you see.
		-- This runs before any window-size check, so it also works while the Editor page is hidden.
		local function applyTextSize()
			local size = math.clamp(math.floor((tonumber(Theme.prefs.EditorTextSize) or Theme.TEXT_SIZE.Default) + 0.5), Theme.TEXT_SIZE.Min, Theme.TEXT_SIZE.Max)
			EDITOR_TEXT_SIZE = size
			lineNums.TextSize = size
			codeView.TextSize = size
			codeBox.TextSize = size
			return size
		end

		local function updateSizes()
			local textSize = applyTextSize()
			local e, f = unscaled(editor), unscaled(files)
			if e.Y < 10 or f.Y < 10 then
				return
			end
			local gutter = math.ceil(textSize * 0.5 * 3) + 2 -- Inconsolata digits are 0.5 em wide: the line numbers get wider / narrower with the text (room for 3 digits)
			lineNums.Position = UDim2.fromOffset(e.X * 0.02, e.Y * 0.035)
			lineNums.Size = UDim2.fromOffset(gutter, 0)
			codeView.Position = UDim2.fromOffset(e.X * 0.04 + gutter, e.Y * 0.035)
			codeBox.Position = codeView.Position
			codeView.Size = UDim2.fromOffset(e.X * 0.78, e.Y * 0.45)
			codeBox.Size = codeView.Size
			rowH = math.floor(f.Y * 0.083 + 0.5)
			listLayout.Padding = UDim.new(0, math.floor(f.Y * 0.0185 + 0.5))
			for _, slot in ipairs(list:GetChildren()) do
				if slot:IsA("Frame") then
					slot.Size = UDim2.new(1, 0, 0, rowH)
				end
			end
		end
		editor:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSizes)
		files:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSizes)
		Theme.onPref("EditorTextSize", function() -- Settings > Editor Text Size: the editor text changes at once
			updateSizes()
		end)
		updateSizes() -- apply the saved size right now (not only when the window first changes size)
		-- guard: if the editor text ever differs from the Settings value (a missed signal, a reopened window), it is put right within 0.25 s
		task.spawn(function()
			while alive do
				task.wait((main.Visible and page.Visible) and 0.25 or 1) -- slow while the Editor is not on screen
				local want = math.clamp(math.floor((tonumber(Theme.prefs.EditorTextSize) or Theme.TEXT_SIZE.Default) + 0.5), Theme.TEXT_SIZE.Min, Theme.TEXT_SIZE.Max)
				if codeView.TextSize ~= want or codeBox.TextSize ~= want or lineNums.TextSize ~= want then
					pcall(updateSizes)
				end
			end
		end)


		----------------------------------------------------------------
		-- TABS + PAGE CHANGE (the Executor tab shows this page; the sidebar glow follows the selected tab)
		----------------------------------------------------------------
		local indicator = sidebar:FindFirstChild("Indicator")
		local rest = {} -- resting Position / BackgroundTransparency of every panel a page change slides in
		local pageTweens = {}
		local currentTab, currentIndex = nil, nil

		-- the panels that slide in one after another when a page is shown (nil entries are skipped)
		local function pagePieces(name)
			if name == "Executor" then
				return { editor, files }
			elseif name == "Home" then
				return { homeRefs.profile, homeRefs.best, homePage:FindFirstChild("AIPanelBackground"), homeRefs.sliders, homeRefs.hubTile }
			elseif name == "ScriptHub" then
				return { cloudRefs.pill, cloudRefs.scroll }
			elseif name == "Intelligence" then
				return intelRefs.pieces or {}
			elseif name == "Extensions" then
				return (homeRefs.ext and homeRefs.ext.pieces) or {}
			elseif name == "Settings" then
				return (homeRefs.settings and homeRefs.settings.pieces) or {}
			end
			return {}
		end

		-- remember where every panel belongs (nothing has been moved yet at this point)
		for _, pageName in ipairs({ "Home", "Executor", "ScriptHub", "Intelligence", "Extensions", "Settings" }) do
			local pieces = pagePieces(pageName)
			for i = 1, 5 do
				local p = pieces[i]
				if p then
					rest[p] = { pos = p.Position, bg = p.BackgroundTransparency }
				end
			end
		end

		-- the panels start a little below (or above) their spot and glide in one after another; the Editor panels also fade in
		local function showPage(name, animate, direction)
			local pieces = pagePieces(name)
			for i = 1, 5 do
				local p = pieces[i]
				local r = p and rest[p]
				if r then
					if pageTweens[p] then
						pageTweens[p]:Cancel()
						pageTweens[p] = nil
					end
					if animate then
						p.Position = UDim2.new(r.pos.X.Scale, r.pos.X.Offset, r.pos.Y.Scale + PAGE_SLIDE * direction, r.pos.Y.Offset)
						local goal = { Position = r.pos }
						if name == "Executor" and r.bg < 1 then
							p.BackgroundTransparency = 1
							goal.BackgroundTransparency = r.bg
						end
						pageTweens[p] = FX.play(p, 0.55, goal, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, (i - 1) * 0.07)
					else
						p.Position = r.pos
						p.BackgroundTransparency = r.bg
					end
				end
			end
		end

		local function selectTab(name)
			local index = nil
			for i, tab in ipairs(TABS) do
				if tab.Name == name then
					index = i
				end
			end
			if not index or name == currentTab then
				return
			end
			local animate = currentTab ~= nil and main.Visible and windowState == "open"
			local direction = (currentIndex and index < currentIndex) and -1 or 1
			currentTab, currentIndex = name, index

			homePage.Visible = name == "Home"
			page.Visible = name == "Executor"
			if cloudRefs.page then
				cloudRefs.page.Visible = name == "ScriptHub"
			end
			if intelRefs.page then
				intelRefs.page.Visible = name == "Intelligence"
			end
			if homeRefs.ext and homeRefs.ext.page then
				homeRefs.ext.page.Visible = name == "Extensions"
			end
			if homeRefs.settings and homeRefs.settings.page then
				homeRefs.settings.page.Visible = name == "Settings"
			end
			showPage(name, animate, direction)
			if name == "Executor" then
				updateSizes() -- the editor text size (Settings) and the layout are right the moment the page shows
			end
			if name == "Intelligence" and intelRefs.onShow then
				pcall(intelRefs.onShow) -- the music time / bar are up to date the moment the page shows
			end
			if name == "Extensions" and homeRefs.ext and homeRefs.ext.onShow then
				pcall(homeRefs.ext.onShow) -- the tile grid is sized the moment the page shows
			end
			if name == "Settings" and homeRefs.settings and homeRefs.settings.onShow then
				pcall(homeRefs.settings.onShow) -- the Primary Color pill shows the chosen colour
			end
			if name == "ScriptHub" and cloudRefs.onShow then
				task.spawn(cloudRefs.onShow) -- first open starts the ScriptBlox downloads
			end

			if indicator then
				local goal = UDim2.fromScale(0.05, TAB_START_Y - 0.03 + (index - 1) * TAB_STEP)
				if animate then
					FX.play(indicator, 0.5, { Position = goal }, Enum.EasingStyle.Back)
				else
					indicator.Position = goal
				end
			end

			-- the chosen sidebar icon pops
			local sideBtn = sidebar:FindFirstChild("SideBtn_" .. name)
			local sideIcon = sideBtn and sideBtn:FindFirstChildOfClass("ImageLabel")
			if sideIcon and animate then
				sideIcon.Size = UDim2.fromScale(0.6, 0.6)
				FX.play(sideIcon, 0.5, { Size = UDim2.fromScale(0.85, 0.85) }, Enum.EasingStyle.Back)
			end
		end

		local previousOnTab = Hooks.OnTab
