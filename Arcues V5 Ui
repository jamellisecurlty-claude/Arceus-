function ArcyAI.ResolveTab(word)
	local key = string.gsub(string.lower(aiTrim(word)), "[%s_%-]+", "")
	return TAB_ALIASES[key]
end

-- "open settings", "go to the editor tab", "please show me extensions" -> "Settings" / "Executor" / "Extensions". Anything longer or unclear -> nil (the AI decides).
function ArcyAI.LocalIntent(prompt)
	local lower = string.lower(aiTrim(prompt))
	lower = string.gsub(lower, "[%.!%?,]", " ")
	lower = aiTrim((string.gsub(lower, "%s+", " ")))
	for _, lead in ipairs({ "^please ", "^pls ", "^can you ", "^could you ", "^will you ", "^arcy " }) do
		lower = string.gsub(lower, lead, "")
	end
	for _, tail in ipairs({ " please$", " pls$", " for me$", " now$" }) do
		lower = string.gsub(lower, tail, "")
	end
	local verb, rest = string.match(lower, "^(%a+) (.+)$")
	if not verb or not OPEN_VERBS[verb] then
		return nil
	end
	for _, lead in ipairs({ "^to ", "^me to ", "^me ", "^the ", "^my ", "^up " }) do
		rest = string.gsub(rest, lead, "")
	end
	for _, lead in ipairs({ "^the " }) do
		rest = string.gsub(rest, lead, "")
	end
	for _, tail in ipairs({ " tab$", " page$", " menu$", " section$", " screen$" }) do
		rest = string.gsub(rest, tail, "")
	end
	if #rest > 24 then
		return nil
	end
	return ArcyAI.ResolveTab(rest)
end

-- takes the <<OPEN:..>> / <<EDITOR:..>> tags out of an answer. Returns the clean text and the list of actions.
function ArcyAI.ExtractActions(answer)
	local actions = {}
	local text = string.gsub(tostring(answer or ""), "<<%s*(%a+)%s*:%s*([^<>\n]-)%s*>>", function(kind, arg)
		kind = string.upper(kind)
		if kind == "OPEN" then
			local tab = ArcyAI.ResolveTab(arg)
			if tab then
				actions[#actions + 1] = { type = "open", tab = tab }
			end
			return ""
		elseif kind == "EDITOR" then
			actions[#actions + 1] = { type = "editor", name = aiTrim(arg) }
			return ""
		end
	end)
	return aiTrim(text), actions
end

function ArcyAI.ActionText(actions)
	for _, act in ipairs(actions) do
		if act.type == "editor" then
			return "I wrote the script into the Editor as a new file. Press Play when you want to run it."
		end
	end
	for _, act in ipairs(actions) do
		if act.type == "open" then
			return "Opening " .. (TAB_LABEL[act.tab] or act.tab) .. "..."
		end
	end
	return "Done."
end

local placeNameCache -- nil = not asked yet, false = asked (or failed), string = the game's real name
-- one short paragraph about the user, built fresh for every request
function ArcyAI.PlayerContext()
	local lp = PlayersService.LocalPlayer
	if not lp then
		return ""
	end
	if placeNameCache == nil and game.PlaceId ~= 0 then
		placeNameCache = false
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(game.PlaceId)
			end)
			if ok and type(info) == "table" and type(info.Name) == "string" then
				placeNameCache = info.Name
			end
		end)
	end
	local parts = {}
	parts[#parts + 1] = string.format(
		"USER INFO: the user's Roblox username is %s (display name: %s, UserId: %d). Call them by their display name when it feels natural, and if they ask who they are or what their name is, answer from this.",
		lp.Name, lp.DisplayName, lp.UserId
	)
	parts[#parts + 1] = string.format("They are playing '%s' (PlaceId %d).", tostring(placeNameCache or game.Name), game.PlaceId)
	if ArcyAI.Config.ShareServerPlayers then
		local all = PlayersService:GetPlayers()
		local names = {}
		for _, p in ipairs(all) do
			if p ~= lp then
				names[#names + 1] = (p.Name == p.DisplayName) and p.Name or (p.Name .. " (" .. p.DisplayName .. ")")
				if #names >= ArcyAI.Config.MaxPlayersListed then
					break
				end
			end
		end
		parts[#parts + 1] = string.format(
			"Players in this server right now (%d including the user), username (display name): %s. This is a snapshot taken when the question was asked; if the user gives a partial name, match it to this list.",
			#all, #names > 0 and table.concat(names, ", ") or "nobody else"
		)
	end
	return table.concat(parts, " ")
end

local function aiProviderRequest(provider, prompt, context, editorSource)
	local cfg = ArcyAI.Config[provider]
	if not cfg or cfg.Key == "" then
		return nil, provider .. " API key is missing", 0
	end

	local system = AI_SYSTEM[context] or AI_SYSTEM.Intelligence
	if type(ArcyAI.Language) == "string" and ArcyAI.Language ~= "" then -- set by the Translate button (UiLang.set)
		system = system .. " Always write your replies in " .. ArcyAI.Language .. " (keep Luau code, identifiers and API names in English)."
	end
	do -- who the user is + what the AI may do to this UI (fresh on every request)
		local okCtx, ctx = pcall(ArcyAI.PlayerContext)
		if okCtx and type(ctx) == "string" and ctx ~= "" then
			system = system .. " " .. ctx
		end
		system = system .. " " .. AI_ACTIONS
	end
	local messages = {
		{ role = "system", content = system },
	}
	local history = ArcyAI.History[context] or ArcyAI.History.Intelligence
	for _, message in ipairs(history) do
		messages[#messages + 1] = message
	end

	local userText = prompt
	if context == "Editor" and aiTrim(editorSource) ~= "" then
		local source = tostring(editorSource)
		if #source > ArcyAI.Config.EditorContextChars then
			source = string.sub(source, 1, ArcyAI.Config.EditorContextChars) .. "\n-- [Editor context truncated]"
		end
		userText = "Current Editor code:\n--[[\n" .. source .. "\n]]\n\nUser request:\n" .. prompt
	end
	messages[#messages + 1] = { role = "user", content = userText }

	local response, transportError = aiPost(cfg.Url, {
		["Content-Type"] = "application/json",
		Accept = "application/json",
		Authorization = "Bearer " .. cfg.Key,
	}, {
		model = cfg.Model,
		messages = messages,
		stream = false,
		temperature = 0.2,
		max_tokens = ArcyAI.Config.MaxTokens,
	})
	if not response then
		return nil, transportError or "request failed", 0
	end

	local status = tonumber(response.StatusCode or response.Status or response.status) or 200
	local body = response.Body or response.body
	if type(body) ~= "string" then
		body = tostring(body or "")
	end
	if status < 200 or status >= 300 or response.Success == false then
		local detail = aiErrorText(body)
		return nil, "HTTP " .. status .. (detail ~= "" and (": " .. detail) or ""), status
	end

	local data = aiDecode(body)
	local content = aiContent(data)
	content = content and aiClean(content)
	if not content or content == "" then
		return nil, "empty or invalid AI response", status
	end
	return content
end

local function aiCooldown(provider, status)
	if status == 402 or status == 429 then
		return 120 -- usage limit / rate limit: switch away, then retry later
	elseif status == 401 or status == 403 then
		return 300
	elseif status == 404 then
		return 60
	elseif status >= 500 then
		return 20
	end
	return 15
end

local function aiRemember(context, prompt, answer)
	local history = ArcyAI.History[context]
	history[#history + 1] = { role = "user", content = prompt }
	history[#history + 1] = { role = "assistant", content = answer }
	while #history > ArcyAI.Config.HistoryMessages do
		table.remove(history, 1)
	end
end

function ArcyAI.ExtractCode(answer)
	if type(answer) ~= "string" then
		return nil
	end
	local code
	-- the answer's code block is --[[ code ]] : take everything between the first --[[ and the last ]]
	-- (so a ]] or a --[[ comment inside the code does not cut it short)
	local _, openEnd = string.find(answer, "--[[", 1, true)
	if openEnd then
		local closeAt, from = nil, openEnd + 1
		while true do
			local found = string.find(answer, "]]", from, true)
			if not found then
				break
			end
			closeAt = found
			from = found + 1
		end
		code = string.sub(answer, openEnd + 1, (closeAt or (#answer + 1)) - 1)
	end
	-- fallback: a markdown fence the model slipped in
	code = code
		or string.match(answer, "```[%w_+%-]*[ \t]*\r?\n(.-)```")
		or string.match(answer, "```[%w_+%-]*[ \t]*(.-)```")
	code = aiTrim(code)
	if code == "" then
		return nil
	end
	return code
end

-- ----------------------------------------------------------------
-- CHAT COMMANDS: Cmds / Open <tab>
-- ----------------------------------------------------------------
--   Cmds              shows every command
--   Open <tab>        opens a tab at once (ArcyAI.LocalIntent above; no AI request)
-- Commands are answered here, in the Intelligence chat and in the Editor's Arcy prompt.
local COMMAND_WORDS = { cmds = "cmds", commands = "cmds" }

-- "Cmds", "/cmds" -> command name (lower case) and the rest of the text. Anything else -> nil.
function ArcyAI.ParseCommand(prompt)
	local head, rest = string.match(aiTrim(prompt), "^[/!]?(%a+)%s*[:%-]?%s*(.-)$")
	if not head then
		return nil
	end
	local name = COMMAND_WORDS[string.lower(head)]
	if name == "cmds" then
		if string.find(rest, "%w") then -- "commands for walk speed" is a normal question, not the command
			return nil
		end
		return "cmds", ""
	end
	return nil
end

function ArcyAI.CommandsText()
	return table.concat({
		"Arcy commands:",
		"Cmds - shows this list.",
		"Open <tab> - opens a tab: Home, Editor, Cloud Scripts, Intelligence, Extensions or Settings. Example: Open Settings",
	}, "\n")
end

-- Returns { text, code }, error, provider. Chat histories remain separate.
function ArcyAI.Ask(prompt, context, editorSource)
	prompt = aiTrim(prompt)
	context = context == "Editor" and "Editor" or "Intelligence"
	if prompt == "" then
		return nil, "the prompt is empty"
	end

	-- chat command: "Cmds" (the list). No chat history, no player info.
	local cmd, cmdRest = ArcyAI.ParseCommand(prompt)
	if cmd == "cmds" then
		return { text = ArcyAI.CommandsText(), noInsert = true }, nil, "local"
	end

	-- "open settings" and friends: answered here at once, no AI request (instant, nothing to wait for)
	local quickTab = ArcyAI.LocalIntent(prompt)
	if quickTab then
		local quick = { { type = "open", tab = quickTab } }
		return { text = ArcyAI.ActionText(quick), actions = quick }, nil, "local"
	end

	local now = os.clock()
	local order = { "ainame", "ainame" }
	-- Available providers keep their normal priority; cooling providers go last.
	table.sort(order, function(a, b)
		local aCooling = (ArcyAI.CooldownUntil[a] or 0) > now
		local bCooling = (ArcyAI.CooldownUntil[b] or 0) > now
		if aCooling ~= bCooling then
			return not aCooling
		end
		return a == "ainame"
	end)

	local errors = {}
	for _, provider in ipairs(order) do
		local answer, err, status = aiProviderRequest(provider, prompt, context, editorSource)
		if answer then
			ArcyAI.CooldownUntil[provider] = 0
			ArcyAI.LastProvider = provider
			aiRemember(context, prompt, answer)
			local shownText, actions = ArcyAI.ExtractActions(answer)
			local code = ArcyAI.ExtractCode(shownText)
			if not code then -- an EDITOR tag without a code block has nothing to put in the Editor
				for i = #actions, 1, -1 do
					if actions[i].type == "editor" then
						table.remove(actions, i)
					end
				end
			end
			if shownText == "" and #actions > 0 then
				shownText = ArcyAI.ActionText(actions)
			end
			return { text = shownText, code = code, actions = actions }, nil, provider
		end
		ArcyAI.CooldownUntil[provider] = os.clock() + aiCooldown(provider, tonumber(status) or 0)
		errors[#errors + 1] = provider .. ": " .. tostring(err or "failed")
	end
	return nil, table.concat(errors, " | ")
end
end

