		{ Name = "Jump", Icon = A.Jump, Def = 7.2, Min = 0, Max = 250, X = 0.5 },
		{ Name = "Speed", Icon = A.Speed, Def = 16, Min = 0, Max = 500, X = 0.78 },
	}

	local activeDrag -- { input = InputObject, setFromY = fn, release = fn }
	local SLIDER_SPRING = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	for _, s in ipairs(SLIDERS) do
		local pct = math.clamp((s.Def - s.Min) / (s.Max - s.Min), 0, 1)
		local enabled = false

		local track = new("CanvasGroup", {
			Name = "Slider_" .. s.Name,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(s.X, 0.067),
			Size = UDim2.fromScale(0.219, 0.606),
			BackgroundColor3 = Color3.fromRGB(60, 0, 0),
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Parent = sliderPanel,
		}, { corner(0.35) })

		local fill = new("Frame", {
			Name = "Slider_" .. s.Name .. "_Bar",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.fromScale(1, pct),
			BackgroundColor3 = dim(PRIMARY),
			BorderSizePixel = 0,
			Parent = track,
		})

		new("ImageLabel", { -- glassy track overlay
			Name = "TrackImage",
			Image = A.SliderTrack,
			ImageColor3 = PRIMARY,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = track,
		})

		local pctLabel = label({
			Name = "Percent",
			Text = string.format("%d%%", math.floor(pct * 100 + 0.5)),
			FontFace = FONT.Title,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.05),
			Size = UDim2.fromScale(0.75, 0.085),
			ZIndex = 5,
			Parent = track,
		})

		local icon = new("ImageLabel", {
			Name = "Icon",
			Image = s.Icon,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.825),
			Size = UDim2.fromScale(0.65, 0.25),
			BackgroundTransparency = 1,
			ZIndex = 3,
			Parent = track,
		}, { ratio(1) })
		local iconScale = new("UIScale", { Parent = icon })
		local pctScale = new("UIScale", { Parent = pctLabel })

		local catcher = new("TextButton", {
			Name = "Catcher",
			Text = "",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 10,
			Parent = track,
		})

		-- toggle dot + glow
		local dot = new("TextButton", {
			Name = "SliderToggle_" .. s.Name,
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(s.X, 0.778),
			Size = UDim2.fromScale(0.08, 0.06),
			BackgroundColor3 = dim(PRIMARY),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = sliderPanel,
		}, { corner(0.5), ratio(1) }) -- ratio(1): stays a round dot at full screen (the panel is no longer 16:9 there)
		local glow = new("ImageLabel", {
			Image = A.Glow,
			ImageColor3 = dim(PRIMARY),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(4, 4),
			BackgroundTransparency = 1,
			Parent = dot,
		})

		label({
			Name = s.Name .. "Label",
			Text = s.Name,
			FontFace = FONT.Heading,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(s.X, 0.907),
			Size = UDim2.fromScale(0.23, 0.055),
			Parent = sliderPanel,
		})

		local function value()
			return s.Min + pct * (s.Max - s.Min)
		end

		local function paint()
			local c = enabled and PRIMARY or dim(PRIMARY)
			tween(fill, 0.15, { BackgroundColor3 = c })
			tween(dot, 0.15, { BackgroundColor3 = c })
			tween(glow, 0.15, { ImageColor3 = c })
		end

		local shownPercent = math.floor(pct * 100 + 0.5)
		local function setFromY(y)
			local newPct = math.clamp(1 - (y - track.AbsolutePosition.Y) / track.AbsoluteSize.Y, 0, 1)
			if newPct == pct then
				return -- the finger did not move (touch events fire very often): nothing to redraw
			end
			pct = newPct
			-- PERFORMANCE: set the bar directly. It used to create a new tween on every single touch event.
			fill.Size = UDim2.fromScale(1, pct)
			local percent = math.floor(pct * 100 + 0.5)
			if percent ~= shownPercent then
				shownPercent = percent
				pctLabel.Text = percent .. "%"
			end
			callHook("OnSlider", s.Name, value(), enabled)
		end

		-- locked feedback: a short side-to-side shake so it is clear the dot must be turned on first
		local shaking = false
		local function denyShake()
			if shaking then
				return
			end
			shaking = true
			task.spawn(function()
				for _, dx in ipairs({ -0.012, 0.012, -0.008, 0.008, 0 }) do
					if not alive then
						return
					end
					tween(track, 0.05, { Position = UDim2.fromScale(s.X + dx, 0.067) }, Enum.EasingStyle.Sine)
					task.wait(0.05)
				end
				shaking = false
			end)
		end

		catcher.InputBegan:Connect(function(input)
			if isTap(input) then
				if LOCK_SLIDER_WHEN_OFF and not enabled then
					denyShake() -- red dot is OFF: the bar cannot be slid
					return
				end
				local function release() -- let go: icon and percent spring back
					TweenService:Create(iconScale, SLIDER_SPRING, { Scale = 1 }):Play()
					TweenService:Create(pctScale, SLIDER_SPRING, { Scale = 1 }):Play()
				end
				activeDrag = { input = input, setFromY = setFromY, release = release, name = s.Name }
				tween(iconScale, 0.12, { Scale = 1.25 }) -- grabbed: icon and percent grow
				tween(pctScale, 0.12, { Scale = 1.2 })
				setFromY(input.Position.Y)
			end
		end)

		-- JUMP: clicking the red dot makes it do a SMALL hop. The dot never changes size (no stretch, no glow flare):
		-- it just pops up a little and drops back with a tiny bounce. Clicking again mid-hop restarts it from where it is.
		local DOT_Y = 0.778
		local DOT_POS = UDim2.fromScale(s.X, DOT_Y)
		local HOP_HEIGHT = DOT_HOP_HEIGHT -- see LOOK SETTINGS (height + speed of the hop)
		local hopId, hopTween = 0, nil

		local function jump()
			hopId = hopId + 1
			local id = hopId
			if hopTween then
				hopTween:Cancel() -- a new click takes over from wherever the dot is
			end
			hopTween = tween(dot, DOT_HOP_UP_TIME, { Position = UDim2.fromScale(s.X, DOT_Y - HOP_HEIGHT) }, Enum.EasingStyle.Quad) -- up (slows toward the top)
			hopTween.Completed:Once(function(state)
				if id == hopId and state == Enum.PlaybackState.Completed then
					hopTween = tween(dot, DOT_HOP_DOWN_TIME, { Position = DOT_POS }, Enum.EasingStyle.Bounce) -- back down, slow soft bounce
				end
			end)
		end

		dot.Activated:Connect(function()
			enabled = not enabled
			if LOCK_SLIDER_WHEN_OFF and not enabled and activeDrag and activeDrag.name == s.Name then
				local held = activeDrag -- switched off mid-drag: let go of the bar
				activeDrag = nil
				held.release()
			end
			jump()
			paint()
			callHook("OnSlider", s.Name, value(), enabled)
		end)
		pressFx(dot)
	end

	keepConn(UserInputService.InputChanged:Connect(function(input)
		if activeDrag and (input == activeDrag.input or input.UserInputType == Enum.UserInputType.MouseMovement) then
			activeDrag.setFromY(input.Position.Y)
		end
	end))
	keepConn(UserInputService.InputEnded:Connect(function(input)
		if activeDrag and (input == activeDrag.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
			local finished = activeDrag
			activeDrag = nil
			if finished.release then
				finished.release()
			end
		end
	end))

	---------------- Arceus Hub tile (tap = go to the Extensions tab) ----------------
	-- Fills the gap between the Welcome card and the right edge of Best Scripts, like the reference screenshot: the same glass card as
	-- Welcome, the Arceus Hub logo (A.HubIcon - the same picture as the Arceus Hub tile on the Extensions page) and its name.
	-- Tapping it opens the Extensions tab, where the Arceus Hub lives (same hook call as the sidebar tab).
	local hubTile = panel("ArceusHubPanelBackground", UDim2.fromScale(0.421, 0.15), UDim2.fromScale(0.159, 0.2), 0.28, homePage)
	new("UIGradient", {
		Name = "HubGradient",
		Rotation = 0,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(135, 138, 155)),
		}),
		Parent = hubTile,
	})
	local hubInner = new("Frame", { -- everything inside shrinks a little while the finger is down
		Name = "HubInner",
		AnchorPoint = Vector2.new(0.5, 0.5),
