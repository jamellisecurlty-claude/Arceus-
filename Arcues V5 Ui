					-- "None v": the list opens under the button (above it when there is no room) and scrolls after MAX_LIST options
					local function addDropdown(first, ...)
						local o = norm(first, ...)
						local title = titleOf(o)
						local frame = newItem(ROW_H, true)
						rowTitle(frame, title, field(o, "Description", "Desc", "Content"))
						local multi = field(o, "Multi", "Multiple", "MultiSelect") == true
						local callback = field(o, "Callback", "OnChange", "Changed")
						local flag = tostring(field(o, "Flag", "Id") or title)
						local placeholder = tostring(field(o, "Placeholder", "PlaceholderText") or "None")
						if placeholder == "" then
							placeholder = "None"
						end

						local options = {}
						local function setOptionsList(list)
							options = {}
							for _, v in ipairs(type(list) == "table" and list or {}) do
								options[#options + 1] = tostring(v)
							end
						end
						setOptionsList(field(o, "Options", "Values", "List", "Items"))

						local default = field(o, "Default", "CurrentValue", "Value", "CurrentOption")
						local selected = {} -- multi: the set of picked names
						local single = nil -- single: the picked name
						if multi then
							if type(default) == "table" then
								for _, v in ipairs(default) do
									if tostring(v) ~= "" then
										selected[tostring(v)] = true
									end
								end
							elseif default ~= nil and tostring(default) ~= "" then
								selected[tostring(default)] = true
							end
						else
							if type(default) == "table" then
								default = default[1]
							end
							if default ~= nil and tostring(default) ~= "" then -- "" (Default = "" / CurrentOption = {""}) means nothing is picked yet: the pill shows the placeholder
								single = tostring(default)
							end
						end

						local function valueNow()
							if not multi then
								return single
							end
							local out = {}
							for _, name in ipairs(options) do
								if selected[name] then
									out[#out + 1] = name
								end
							end
							return out
						end
						local function shownText()
							if multi then
								local picked = valueNow()
								return #picked == 0 and placeholder or table.concat(picked, ", ")
							end
							return single or placeholder
						end
						win.Flags[flag] = valueNow()

						local button = new("TextButton", {
							Name = "Dropdown",
							Text = "",
							AutoButtonColor = false,
							AnchorPoint = Vector2.new(1, 0.5),
							Position = UDim2.fromScale(0.979, 0.5),
							Size = UDim2.fromScale(0.26, 0.62),
							BackgroundColor3 = PLATE,
							BackgroundTransparency = 0.2,
							BorderSizePixel = 0,
							Parent = frame,
						}, { corner(0.35), new("UIStroke", { Color = RIM_OFF, Thickness = 2.5 }) })
						local shown = label({
							Name = "Selected",
							Text = shownText(),
							FontFace = FONT.Title,
							TextXAlignment = Enum.TextXAlignment.Left,
							Position = UDim2.fromScale(0.08, 0.27),
							Size = UDim2.fromScale(0.62, 0.46),
							Parent = button,
						})
						local arrow = label({
							Name = "Arrow",
							Text = "v",
							FontFace = FONT.Black,
							TextColor3 = RED,
							AnchorPoint = CENTER,
							Position = UDim2.fromScale(0.86, 0.5),
							Size = UDim2.fromScale(0.16, 0.34),
							Parent = button,
						})
						pressFx(button)

						-- the list lives in the window (not in the row) so the scrolling page never cuts it.
						-- Same look as the Settings colour list: black plate, thin white scroll bar, plain white names (the picked one in the theme colour).
						-- Every option has a real pixel height (set in open()), so the names are always drawn.
						local list = new("ScrollingFrame", {
							Name = "DropList",
							Visible = false,
							BackgroundColor3 = Color3.fromRGB(0, 0, 0),
							BackgroundTransparency = 0.03,
							BorderSizePixel = 0,
							CanvasSize = UDim2.new(0, 0, 0, 0),
							AutomaticCanvasSize = Enum.AutomaticSize.Y,
							ScrollBarThickness = 3,
							ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255),
							ScrollBarImageTransparency = 0.15,
							ScrollingDirection = Enum.ScrollingDirection.Y,
							ClipsDescendants = true,
							ZIndex = 50,
							Parent = stage,
						}, {
							corner(0.12),
							new("UIStroke", { Color = RIM_OFF, Thickness = 2 }),
							new("UIPadding", {
								PaddingTop = UDim.new(0, 3),
								PaddingBottom = UDim.new(0, 3),
								PaddingLeft = UDim.new(0, 4),
								PaddingRight = UDim.new(0, 6),
							}),
							new("UIListLayout", {
								SortOrder = Enum.SortOrder.LayoutOrder,
								HorizontalAlignment = Enum.HorizontalAlignment.Center,
								Padding = UDim.new(0, 2),
							}),
						})
						local buttons = {}
						local function mark()
							for name, item in pairs(buttons) do
								local on = multi and selected[name] == true or (not multi and name == single)
								item.TextColor3 = on and RED or WHITE
							end
						end
						local function choose(name)
							if multi then
								selected[name] = (not selected[name]) or nil
								shown.Text = shownText()
								mark()
								win.Flags[flag] = valueNow()
								fire(callback, valueNow())
							else
								single = name
								shown.Text = shownText()
								mark()
								win.Flags[flag] = single
								closeList()
								fire(callback, single)
							end
						end
						local function rebuild()
							for _, item in pairs(buttons) do
								item:Destroy()
							end
							buttons = {}
							for i, name in ipairs(options) do
								local item = new("TextButton", {
									Name = name,
									Text = name,
									FontFace = FONT.Body,
									TextColor3 = WHITE,
									TextScaled = true,
									AutoButtonColor = false,
									BackgroundTransparency = 1,
									BorderSizePixel = 0,
									LayoutOrder = i,
									Size = UDim2.new(1, 0, 0, 24), -- the real height (in pixels) is set in open()
									ZIndex = 51,
									Parent = list,
								}, { new("UIPadding", { PaddingTop = UDim.new(0.22, 0), PaddingBottom = UDim.new(0.22, 0) }) })
								pressFx(item)
								item.Activated:Connect(function()
									choose(name)
								end)
								buttons[name] = item
							end
							mark()
						end
						rebuild()

						local function open()
							closeList()
							if #options == 0 then
								return
							end
							local sa, sp = stage.AbsoluteSize, stage.AbsolutePosition
							local bs, bp = button.AbsoluteSize, button.AbsolutePosition
							if sa.X < 4 or sa.Y < 4 then
								return
							end
							local k = Theme.uiScaleOf(stage) -- UIScales around the window multiply every pixel offset
							local optionH = math.max(14, math.floor(bs.Y * 0.95 / k)) -- each option is about as tall as the dropdown pill
							for _, item in pairs(buttons) do
								item.Size = UDim2.new(1, 0, 0, optionH)
							end
							local count = #options > MAX_LIST and (MAX_LIST - 0.5) or #options -- a half option shows that the list scrolls
							local w = bs.X * 1.1
							local h = math.min((optionH * count + 2 * math.max(math.ceil(count) - 1, 0) + 6) * k, sa.Y - 8)
							local x = bp.X + bs.X - w - sp.X
							local y = bp.Y + bs.Y + 4 - sp.Y
							if y + h > sa.Y then
								y = bp.Y - sp.Y - h - 4 -- no room under the button: the list opens upward
							end
							y = math.max(0, y)
							list.Position = UDim2.fromScale(x / sa.X, y / sa.Y)
							list.Size = UDim2.fromScale(w / sa.X, h / sa.Y)
							list.CanvasPosition = Vector2.new(0, 0)
							list.BackgroundTransparency = 1
							list.Visible = true
							tween(list, 0.15, { BackgroundTransparency = 0.05 })
							tween(arrow, 0.25, { Rotation = 180 }, Enum.EasingStyle.Back)
							catcher.Visible = true
							openList = function()
								list.Visible = false
								tween(arrow, 0.25, { Rotation = 0 }, Enum.EasingStyle.Back)
							end
						end
						button.Activated:Connect(open)

						local el = {}
						el.Set = method(el, function(v)
							if multi then
								selected = {}
								if type(v) == "table" then
									for _, x in ipairs(v) do
										selected[tostring(x)] = true
									end
								elseif v ~= nil then
									selected[tostring(v)] = true
								end
							else
								if type(v) == "table" then
									v = v[1]
								end
								single = (v ~= nil and tostring(v) ~= "") and tostring(v) or nil
							end
							shown.Text = shownText()
							mark()
							win.Flags[flag] = valueNow()
						end)
						el.Get = method(el, function()
							return valueNow()
						end)
						-- a new list of options (a pick that is no longer in it is dropped); the callback is not called
						el.SetOptions = method(el, function(list2)
							setOptionsList(list2)
							local present = {}
							for _, name in ipairs(options) do
								present[name] = true
							end
							if multi then
								for name in pairs(selected) do
									if not present[name] then
										selected[name] = nil
									end
								end
							elseif single and not present[single] then
								single = nil
							end
							rebuild()
							shown.Text = shownText()
							win.Flags[flag] = valueNow()
						end)
						el.Refresh = el.SetOptions
						return el
					end

					local ADDERS = {
						{ addSection, "AddSection", "CreateSection", "Section" },
						{ addLabel, "AddLabel", "CreateLabel", "AddParagraph", "Label" },
						{ addToggle, "AddToggle", "CreateToggle", "Toggle" },
						{ addButton, "AddButton", "CreateButton", "Button" },
						{ addStepper, "AddSlider", "AddStepper", "CreateSlider", "Slider" },
						{ addInput, "AddInput", "AddTextbox", "CreateInput", "Input" },
						{ addDropdown, "AddDropdown", "CreateDropdown", "Dropdown" },
					}
					for _, def in ipairs(ADDERS) do
						local fn = method(tab, def[1])
						for i = 2, #def do
							tab[def[i]] = fn
						end
					end
					tab.Select = method(tab, function()
						showTab(tab, true)
					end)

					tabs[#tabs + 1] = tab
					layoutTabs()
					applySizes()
					if #tabs == 1 then
						showTab(tab, false)
					end
					return tab
				end

				local addTabFn = method(win, addTab)
				for _, name in ipairs({ "AddTab", "CreateTab", "MakeTab", "NewTab" }) do
					win[name] = addTabFn
				end
				win.SelectTab = method(win, function(which)
					for i, tab in ipairs(tabs) do
						if tab == which or i == which or tab.Title == which then
							showTab(tab, true)
							return
						end
					end
				end)
				win.Notify = method(win, function(title, text, style)
					api.Notify(title, text, style)
				end)
				win.Destroy = method(win, function()
					closeList()
					pcall(function()
						stage:Destroy()
					end)
					if window == win then
						window = nil
					end
				end)

				-- every time the extension appears (opened in the page, or detached) its page plays the intro again
				api.OnShown(function()
					if current then
						playTab(current)
					end
				end)
				if win.Title ~= "" and api.SetSubtitle then
					api.SetSubtitle(win.Title)
				end
				return win
			end

			lib.CreateWindow = method(lib, createWindow)
			for _, name in ipairs({ "MakeWindow", "NewWindow", "Window", "New" }) do
				lib[name] = lib.CreateWindow
			end
			lib.Notify = method(lib, function(title, text, style)
				api.Notify(title, text, style)
			end)
			return lib
		end

		local function makeApi(entry)
			local api = {
				Id = entry.id,
				Title = entry.title,
				Frame = entry.frame,
				HttpGet = httpGet,
				Notify = function(title, text, style)
					showToast({ style = style or "info", title = tostring(title or entry.title), text = tostring(text or "") })
				end,
				Run = function(name, source, opts)
					local called, ok = callHook("OnRun", tostring(name or entry.title), tostring(source or ""), opts)
					return called and ok
				end,
				Close = function()
					if current == entry then
						closePlugin()
					end
				end,
				Detach = function()
					detachPlugin(entry)
				end,
				Attach = function()
					attachPlugin(entry)
				end,
				SetSubtitle = function(text) -- the grey title in the middle of the detached window's title bar (fades in when it changes)
					local newText = text ~= nil and tostring(text) or nil
					local changedText = newText ~= entry.subtitle
					entry.subtitle = newText
					local lbl = entry.subtitleLabel
					if lbl and lbl.Parent then
						lbl.Text = entry.subtitle or ""
						if changedText then
							lbl.TextTransparency = 1
							tween(lbl, 0.3, { TextTransparency = 0 })
						end
					end
				end,
				OnShown = function(fn) -- called every time the extension's content appears (opened or detached); use it to replay an intro animation
					entry.onShown = type(fn) == "function" and fn or nil
				end,
			}
			api.Library = makeLibrary(api) -- the Hub's look as a toolkit: tabs, sections, toggles, dropdowns ... (see HUB LIBRARY above)
			return api
		end

		local function failPlugin(entry, err)
			entry.loaded = false
			logWarn(
				"Extension '" .. tostring(entry.title) .. "' failed: " .. tostring(err),
				"the extension's code does not compile or raised an error",
				"fix the extension's source - tap its tile again to retry"
			)
			pcall(function()
				entry.frame:ClearAllChildren()
			end)
			if current == entry then
				closePlugin()
			end
			showToast({ style = "error", title = entry.title, text = string.sub(tostring(err), 1, 140) })
		end

		-- runs the extension the first time it is opened
		local function startPlugin(entry)
			if entry.loaded then
				return
			end
			entry.loaded = true
			if entry.builder then
				local ok, err = pcall(entry.builder, makeApi(entry))
				if not ok then
					failPlugin(entry, err)
				end
				return
			end
			local ls = Sys.getLoadstring()
			if not ls then
				failPlugin(entry, "loadstring is not available in this environment (normal Roblox clients block it)")
				return
			end
			local called, fn, err = pcall(ls, entry.source or "", "=" .. entry.title)
			if not called then
				called, fn, err = pcall(ls, entry.source or "")
			end
			if not called or type(fn) ~= "function" then
				failPlugin(entry, "syntax error: " .. tostring(called and err or fn))
				return
			end
			task.spawn(function()
				local okRun, runErr = pcall(fn, makeApi(entry))
				if not okRun then
					failPlugin(entry, runErr)
				end
			end)
		end

		-- Detach: the extension becomes its own draggable window - same look as the Arceus Hub reference screenshot:
		--   [logo] Title                 centre title                 [expand] [x]
		-- expand = bigger / smaller window, x = back into the page (tap its tile again to bring it back too)
		local function openFloat(entry)
			local WIN_RATIO = 1.788 -- window width / height (measured from the screenshot: 835 x 468)
			local BAR_H = 0.124 -- title bar height (fraction of the window)
			local BODY_Y = 0.07 -- the extension area starts here, under the title bar's lower edge (like the screenshot)
			local SMALL_SIZE = UDim2.fromScale(0.52, 0.66)
			local BIG_SIZE = UDim2.fromScale(0.86, 0.92)
			local EXIT_RED = Theme.sh.exit -- the red X follows the primary colour (Red = 235, 28, 36)

			local win = new("Frame", {
				Name = "ExtensionWindow",
				AnchorPoint = CENTER,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = SMALL_SIZE,
				BackgroundColor3 = BG_BASE_COLOR,
				BackgroundTransparency = 1, -- fades in with the pop animation below
				BorderSizePixel = 0,
				Active = true,
				ClipsDescendants = true,
				ZIndex = 700,
				Parent = gui,
			}, {
				corner(0.03),
				new("UIAspectRatioConstraint", { AspectRatio = WIN_RATIO }),
				new("UIScale", { Name = "PopScale", Scale = 0.86 }),
			})
			local popScale = win.PopScale

			-- window art: asset 99545577607819 (same glow picture as the main window), tinted dark, with its own rounded corners
			local winArt = new("ImageLabel", {
				Name = "BackgroundImage",
				Image = A.Background,
				ImageColor3 = BG_TINT,
				ImageTransparency = 1, -- fades in with the pop animation below
				ScaleType = Enum.ScaleType.Stretch,
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ZIndex = 700,
				Parent = win,
			}, { corner(0.03) })

			-- the extension area (under the title bar)
			local body = new("Frame", {
				Name = "Body",
				Position = UDim2.fromScale(0, BODY_Y),
				Size = UDim2.fromScale(1, 1 - BODY_Y),
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				ZIndex = 701,
				Parent = win,
			})

			-- title bar (drag handle)
			local bar = new("Frame", {
				Name = "TitleBar",
				Size = UDim2.fromScale(1, BAR_H),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ZIndex = 702,
				Parent = win,
			})
			entry.floatLogo = new("ImageLabel", {
				Name = "Logo",
				Image = entry.icon,
				ScaleType = Enum.ScaleType.Fit,
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0.028, 0.5),
				Size = UDim2.fromScale(0.06, 0.6),
				ZIndex = 703,
				Parent = bar,
			}, { ratio(1) })
			entry.floatTitle = label({
				Name = "Title",
				Text = entry.title,
				FontFace = FONT.Title,
				TextColor3 = Color3.fromRGB(205, 205, 210),
				TextXAlignment = Enum.TextXAlignment.Left,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0.084, 0.5),
				Size = UDim2.fromScale(0.22, 0.38),
				ZIndex = 703,
				Parent = bar,
			})
			entry.subtitleLabel = label({
				Name = "Subtitle",
				Text = entry.subtitle or "",
				FontFace = FONT.Body,
				TextColor3 = Color3.fromRGB(170, 170, 176),
				TextXAlignment = Enum.TextXAlignment.Center,
				AnchorPoint = CENTER,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.34, 0.34),
				ZIndex = 703,
				Parent = bar,
			})

			-- bare icon buttons (no plate), same spots as the screenshot
			local function iconButton(name, x)
				local btn = new("TextButton", {
					Name = name,
					Text = "",
					AutoButtonColor = false,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(x, 0.5),
					Size = UDim2.fromScale(0.06, 0.8),
					ZIndex = 703,
					Parent = bar,
				}, { ratio(1) })
				pressFx(btn)
				local glyph = new("Frame", {
					Name = "Glyph",
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(0.5, 0.5),
					BackgroundTransparency = 1,
					ZIndex = 704,
					Parent = btn,
				}, { ratio(1) })
				return btn, glyph
			end
			local function bar_(parent, color, cx, cy, w, h, rot)
				return new("Frame", {
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(cx, cy),
					Size = UDim2.fromScale(w, h),
					Rotation = rot or 0,
					BackgroundColor3 = color,
					BorderSizePixel = 0,
					ZIndex = 705,
					Parent = parent,
				}, { corner(1) })
			end

			-- expand: diagonal double arrow
			local expandBtn, expandGlyph = iconButton("Expand", 0.899)
			local ARROW = Color3.fromRGB(215, 215, 220)
			bar_(expandGlyph, ARROW, 0.5, 0.5, 1.1, 0.11, -45)
			bar_(expandGlyph, ARROW, 0.72, 0.11, 0.34, 0.11) -- top-right head
			bar_(expandGlyph, ARROW, 0.89, 0.28, 0.11, 0.34)
			bar_(expandGlyph, ARROW, 0.28, 0.89, 0.34, 0.11) -- bottom-left head
			bar_(expandGlyph, ARROW, 0.11, 0.72, 0.11, 0.34)

			-- close: red X
			local closeBtn, closeGlyph = iconButton("Close", 0.959)
			bar_(closeGlyph, EXIT_RED, 0.5, 0.5, 1.2, 0.16, 45)
			bar_(closeGlyph, EXIT_RED, 0.5, 0.5, 1.2, 0.16, -45)

			local big = false
			expandBtn.Activated:Connect(function()
				big = not big
				tween(win, 0.38, { Size = big and BIG_SIZE or SMALL_SIZE }, Enum.EasingStyle.Quint)
			end)

			-- close: the window shrinks and fades away, then the extension goes back into the page
			local closing = false
			closeBtn.Activated:Connect(function()
				if closing then
					return
				end
				closing = true
				tween(popScale, 0.2, { Scale = 0.88 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
				tween(win, 0.2, { BackgroundTransparency = 1 })
				tween(winArt, 0.2, { ImageTransparency = 1 })
				task.delay(0.2, function()
					if entry.float == win then
						attachPlugin(entry)
					end
				end)
			end)

			-- drag by the title bar
			bar.InputBegan:Connect(function(input)
				if not isTap(input) then
					return
				end
				local startMouse, startPos = input.Position, win.Position
				local moveConn, endConn
				moveConn = UserInputService.InputChanged:Connect(function(move)
					if move == input or move.UserInputType == Enum.UserInputType.MouseMovement then
						local d = move.Position - startMouse
						win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
					end
				end)
				endConn = UserInputService.InputEnded:Connect(function(done)
					if done == input or done.UserInputType == Enum.UserInputType.MouseButton1 then
						moveConn:Disconnect()
						endConn:Disconnect()
					end
				end)
			end)

			entry.frame.Parent = body
			entry.frame.Visible = true
			entry.float = win

			-- pop in: the window grows from slightly smaller while the dark background fades up
			tween(popScale, 0.34, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(win, 0.28, { BackgroundTransparency = BG_BASE_TRANSPARENCY })
			tween(winArt, 0.28, { ImageTransparency = BG_IMAGE_TRANSPARENCY })
			playShown(entry)
		end

		attachPlugin = function(entry)
			if not entry.detached then
				return
			end
			entry.detached = false
			entry.frame.Parent = contentFrame -- first move it out, then drop the window
			entry.frame.Visible = false
			if entry.float then
				entry.float:Destroy()
				entry.float = nil
				entry.subtitleLabel = nil
			end
		end

		detachPlugin = function(entry)
			if entry.detached then
				return
			end
			entry.detached = true
			openFloat(entry)
			if current == entry then
				closePlugin()
			end
		end

		openPlugin = function(entry)
			if entry.detached then
				attachPlugin(entry)
			end
			current = entry
			for _, other in ipairs(plugins) do
				if not other.detached then
					other.frame.Visible = other == entry
				end
			end
			list.Visible = false
			contentFrame.Visible = true
			backBtn.Visible = true
			detachBtn.Visible = true
			startPlugin(entry)
			playShown(entry)
			callHook("OnExtension", "open", info(entry))
		end

		closePlugin = function()
			if current and not current.detached then
				current.frame.Visible = false
			end
			current = nil
			contentFrame.Visible = false
			backBtn.Visible = false
			detachBtn.Visible = false
			list.Visible = true
		end

		removePlugin = function(entry)
			if isProtected(entry) then -- the Arceus Hub is never removed, whoever asks
				return false
			end
			if current == entry then
				closePlugin()
			end
			if entry.float then
				entry.float:Destroy()
				entry.float = nil
				entry.subtitleLabel = nil
			end
			for i, p in ipairs(plugins) do
				if p == entry then
					table.remove(plugins, i)
					break
				end
			end
			if entry.tile then
				entry.tile:Destroy()
			end
			entry.frame:Destroy()
			if entry.url then
				for i = #savedUrls, 1, -1 do
					if savedUrls[i] == entry.url then
						table.remove(savedUrls, i)
					end
				end
				writeSaved()
			end
			if pluginMeta[entry.id] ~= nil then
				pluginMeta[entry.id] = nil
				saveMeta()
			end
			callHook("OnExtension", "uninstall", info(entry))
			return true
		end

		-- the picture on a tile. The grey plate and the picture are two separate objects, so the plate's white -> #404040 gradient no longer tints the picture
		-- (that is what made every icon look washed out). The built-in / fallback picture sits inside the plate; a picture that was chosen fills the whole tile.
		local function stylePic(entry)
			local pic = entry.pic
			if pic and pic.Parent then
				pic.Image = entry.icon
				if entry.customImage then
					pic.ScaleType = Enum.ScaleType.Crop
					pic.Size = UDim2.fromScale(1, 1)
				else
					pic.ScaleType = Enum.ScaleType.Fit
					pic.Size = UDim2.fromScale(0.84, 0.84)
				end
			end
			local logo = entry.floatLogo -- the little logo in the detached window's title bar
			if logo and logo.Parent then
				logo.Image = entry.icon
			end
		end

		local function setIcon(entry, image, custom)
			entry.icon = image
			entry.customImage = custom == true
			stylePic(entry)
		end

		local function pulseTile(entry) -- a small bounce on the tile after a change
			local plate = entry.plate
			local press = plate and plate:FindFirstChild("PressScale")
			if press then
				press.Scale = 0.82
				tween(press, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end

		-- start-up picture: the extension's own link (JSON "icon" / "image" as https://...) and the picture the person picked (kept in plugin_meta.json).
		-- Ids show at once; a link shows as soon as it is downloaded (cached files at once).
		local function applyStartImage(entry, jsonIcon, meta)
			entry.baseIcon = entry.icon -- what "Change image" with an empty box goes back to
			entry.baseCustom = entry.customImage == true
			local function load(value, isMine)
				local function apply(image)
					if not alive or not (entry.tile and entry.tile.Parent) then
						return
					end
					if isMine then
						entry.picked = true
						setIcon(entry, image, true)
					else
						entry.baseIcon, entry.baseCustom = image, true
						if not entry.picked then
							setIcon(entry, image, true)
						end
					end
				end
				local image = resolveImage(value, false)
				if image then
					apply(image)
				else
					task.spawn(function()
						local got = resolveImage(value, true)
						if got then
							apply(got)
						end
					end)
				end
			end
			if isLink(jsonIcon) then
				load(jsonIcon, false)
			end
			if type(meta) == "table" and type(meta.image) == "string" and meta.image ~= "" then
				load(meta.image, true)
			end
		end

		local function renameEntry(entry, text)
			text = string.match(tostring(text or ""), "^%s*(.-)%s*$") or ""
			if text == "" then
				return
			end
			local okCut, cut = pcall(utf8.offset, text, 29) -- 28 letters at most (whole letters, never half of one)
			if okCut and cut then
				text = string.sub(text, 1, cut - 1)
			end
			entry.title = text
			if entry.nameLabel and entry.nameLabel.Parent then
				entry.nameLabel.Text = text
			end
			if entry.floatTitle and entry.floatTitle.Parent then
				entry.floatTitle.Text = text
			end
			metaOf(entry.id).title = text
			saveMeta()
			pulseTile(entry)
			callHook("OnExtension", "rename", info(entry))
		end

		local function changeImage(entry, text)
			text = string.match(tostring(text or ""), "^%s*(.-)%s*$") or ""
			if text == "" then -- an empty box = back to the extension's own picture
				local rec = metaOf(entry.id)
				rec.image = nil
				if next(rec) == nil then
					pluginMeta[entry.id] = nil
				end
				saveMeta()
				entry.picked = false
				setIcon(entry, entry.baseIcon or A.Logo, entry.baseCustom == true)
				pulseTile(entry)
				callHook("OnExtension", "image", info(entry))
				return
			end
			task.spawn(function()
				local image, reason = resolveImage(text, true)
				if not alive then
					return
				end
				if not image then
					showToast({
						style = "error",
						title = UiLang.tr("Change image"),
						text = "Could not use that picture: " .. string.sub(tostring(reason), 1, 120),
					})
					return
				end
				metaOf(entry.id).image = text
				saveMeta()
				entry.picked = true
				setIcon(entry, image, true)
				pulseTile(entry)
				callHook("OnExtension", "image", info(entry))
			end)
		end

		-- HOLD a tile = this menu: Rename / Change image / Delete (every extension can be deleted; the built-in Arceus Hub (AXS_Hub) cannot, so it has no Delete)
		local function openTileMenu(entry)
			if not alive or not (entry.tile and entry.tile.Parent) then
				return
			end
			local old = gui:FindFirstChild("ExtensionTileMenu")
			if old then
				old:Destroy()
			end
			local root = new("Frame", {
				Name = "ExtensionTileMenu",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ZIndex = 1300,
				Parent = gui,
			})
			local rs = root.AbsoluteSize
			if rs.X < 10 or rs.Y < 10 then
				rs = gui.AbsoluteSize
			end
			local rp = root.AbsolutePosition
			local minDim = math.max(1, math.min(rs.X, rs.Y))
			local rowH = math.max(30, math.floor(minDim * 0.075))
			local menuW = math.floor(math.max(160, minDim * 0.4))
			local textMax = math.max(12, math.floor(rowH * 0.4))

			local items = {
				{ key = "rename", text = "Rename" },
				{ key = "image", text = "Change image" },
			}
			if not isProtected(entry) then -- every extension can be deleted, only the Arceus Hub cannot
				items[#items + 1] = { key = "delete", text = "Delete", danger = true }
			end
			local headerH = math.floor(rowH * 0.8)
			local menuH = headerH + rowH * #items

			-- the menu sits next to the tile (right of it, or left when there is no room), always inside the screen
			local tp, ts = entry.tile.AbsolutePosition, entry.tile.AbsoluteSize
			local x = tp.X - rp.X + ts.X + 8
			if x + menuW > rs.X - 8 then
				x = tp.X - rp.X - menuW - 8
			end
			x = math.clamp(x, 8, math.max(8, rs.X - menuW - 8))
			local y = math.clamp(tp.Y - rp.Y, 8, math.max(8, rs.Y - menuH - 8))

			local backdrop = new("TextButton", {
				Name = "Backdrop",
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 1,
				Parent = root,
			})
			tween(backdrop, 0.18, { BackgroundTransparency = 0.6 })

			local menu = new("Frame", {
				Name = "Menu",
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(menuW, menuH),
				BackgroundColor3 = Color3.fromRGB(18, 18, 20),
				BackgroundTransparency = 0.05,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				ZIndex = 2,
				Parent = root,
			}, {
				corner(0.12),
				new("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.86, Thickness = 1 }),
			})
			local pop = new("UIScale", { Scale = 0.85, Parent = menu })
			tween(pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)

			local closed = false
			local openedAt = os.clock()
			local function closeMenu(instant)
				if closed then
					return
				end
				closed = true
				if instant then
					root:Destroy()
					return
				end
				tween(backdrop, 0.12, { BackgroundTransparency = 1 })
				tween(pop, 0.12, { Scale = 0.88 })
				task.delay(0.13, function()
					if root.Parent then
						root:Destroy()
					end
				end)
			end
			backdrop.Activated:Connect(function()
				if os.clock() - openedAt < 0.3 then
					return -- the finger that opened the menu is still coming up
				end
				closeMenu(false)
			end)

			local header = label({
				Name = "Header",
				Text = entry.title,
				FontFace = FONT.Heading,
				TextColor3 = Color3.fromRGB(150, 150, 156),
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0.07, 0, 0, 0),
				Size = UDim2.new(0.86, 0, 0, headerH),
				ZIndex = 3,
			})
			header:SetAttribute("NoTranslate", true) -- a name the person chose is never translated (set before it joins the menu)
			header.Parent = menu
			new("UITextSizeConstraint", { MaxTextSize = math.max(10, math.floor(textMax * 0.8)), Parent = header })

			local list = new("Frame", {
				Name = "Rows",
				Position = UDim2.new(0, 0, 0, headerH),
				Size = UDim2.new(1, 0, 0, rowH * #items),
				BackgroundTransparency = 1,
				ZIndex = 3,
				Parent = menu,
			}, {
				new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			for i, item in ipairs(items) do
				local row = new("TextButton", {
					Name = item.key,
					LayoutOrder = i,
					Text = "",
					AutoButtonColor = false,
					Size = UDim2.new(1, 0, 0, rowH),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = 3,
					Parent = list,
				})
				new("Frame", { -- thin line above the row
					Name = "Line",
					Position = UDim2.fromScale(0.05, 0),
					Size = UDim2.new(0.9, 0, 0, 1),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BackgroundTransparency = 0.9,
					BorderSizePixel = 0,
					ZIndex = 4,
					Parent = row,
				})
				local text = label({
					Name = "Text",
					Text = item.text,
					FontFace = FONT.Body,
					TextColor3 = item.danger and Color3.fromRGB(255, 72, 72) or TEXT,
					TextXAlignment = Enum.TextXAlignment.Left,
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.fromScale(0.07, 0.5),
					Size = UDim2.fromScale(0.86, 0.5),
					ZIndex = 4,
					Parent = row,
				})
				new("UITextSizeConstraint", { MaxTextSize = textMax, Parent = text })
				row.InputBegan:Connect(function(input)
					if isTap(input) then
						tween(row, 0.08, { BackgroundTransparency = 0.88 })
					end
				end)
				row.InputEnded:Connect(function(input)
					if isTap(input) then
						tween(row, 0.15, { BackgroundTransparency = 1 })
					end
				end)
				row.Activated:Connect(function()
					closeMenu(true)
					if item.key == "rename" then
						if openInstantCode then
							openInstantCode({
								title = UiLang.tr("Rename"),
								placeholder = UiLang.tr("New name"),
								text = entry.title,
								style = "info", -- the same blue prompt as Install extension
								hideGui = true,
								onSubmit = function(typed)
									renameEntry(entry, typed)
								end,
							})
						end
					elseif item.key == "image" then
						if openInstantCode then
							openInstantCode({
								title = UiLang.tr("Change image"),
								placeholder = UiLang.tr("Image id or link"),
								style = "info",
								hideGui = true,
								allowEmpty = true, -- empty = back to the extension's own picture
								onSubmit = function(typed)
									changeImage(entry, typed)
								end,
							})
						end
					elseif item.key == "delete" then
						showToast({
							style = "confirm",
							title = UiLang.tr("Delete"),
							text = UiLang.fmt("Delete {1}?", entry.title),
							onConfirm = function()
								removePlugin(entry)
							end,
						})
					end
				end)
			end
		end

		-- the tile (source: ExtensionObj): grey plate with the white -> #404040 gradient, the picture on top of it and the name under it.
		-- Tap = open. HOLD = the menu (Rename / Change image / Delete). The small trash button is gone.
		local HOLD_TIME = 0.45 -- seconds a tile is held before its menu opens
		local function makeTile(entry)
			local cell = new("Frame", { Name = "Ext_" .. entry.id, BackgroundTransparency = 1, LayoutOrder = entry.order, Parent = grid })
			local press = new("UIScale", { Name = "PressScale" })
			local plate = new("ImageButton", {
				Name = "Icon",
				Image = "",
				AutoButtonColor = false,
				BackgroundColor3 = Color3.fromRGB(163, 162, 165),
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1 / CELL_RATIO),
				Parent = cell,
			}, {
				corner(0.2),
				new("UIGradient", {
					Rotation = -45,
					Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromHex("#404040")),
				}),
				press,
			})
			entry.plate = plate
			entry.pic = new("ImageLabel", {
				Name = "Picture",
				AnchorPoint = CENTER,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.84, 0.84),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Image = entry.icon,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 2,
				Parent = plate,
			}, { corner(0.2) })
			stylePic(entry)
			entry.nameLabel = label({
				Name = "Name",
				Text = entry.title,
				FontFace = FONT.Body,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 1 / CELL_RATIO + 0.04),
				Size = UDim2.fromScale(1.1, 0.17),
				Parent = cell,
			})

			-- tap = open, hold = menu (moving the finger = scrolling the grid, so it cancels the hold)
			local held = false
			local pressId = 0
			plate.Activated:Connect(function()
				if held then
					held = false
					return
				end
				openPlugin(entry)
			end)
			plate.InputBegan:Connect(function(input)
				if not isTap(input) then
					return
				end
				held = false
				pressId = pressId + 1
				local mine = pressId
				local from = input.Position
				tween(press, 0.35, { Scale = 0.9 })
				task.delay(HOLD_TIME, function()
					if pressId ~= mine or not alive or not plate.Parent then
						return
					end
					local state = input.UserInputState
					if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
						return -- let go already
					end
					if (input.Position - from).Magnitude > 12 then
						return -- the finger moved: that was a scroll
					end
					held = true
					tween(press, 0.15, { Scale = 1 })
					openTileMenu(entry)
				end)
			end)
			plate.InputEnded:Connect(function(input)
				if isTap(input) then
					pressId = pressId + 1
					tween(press, 0.12, { Scale = 1 })
				end
			end)

			-- pop in
			local scale = new("UIScale", { Scale = 0.6, Parent = cell })
			tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			entry.tile = cell
		end
		-- adds an extension: info = { id?, title, icon?, source | builder, url? }. Returns the entry, or nil when that id is already there
		local function addPlugin(data)
			if type(data) ~= "table" then
				return nil
			end
			local title = tostring(data.title or "Extension")
			-- source: id = info.id or "Plugin_" .. loaded. With a url the number is the url's hash, so the id is the same every start
			local id = tostring(data.id or ("Plugin_" .. (data.url and shortHash(tostring(data.url)) or tostring(ordinal + 1))))
			for _, p in ipairs(plugins) do
				if p.id == id then
					return nil
				end
			end
			local meta = pluginMeta[id] -- a name / picture the person gave this extension (hold its tile)
			if type(meta) == "table" and type(meta.title) == "string" and meta.title ~= "" then
				title = meta.title
			end
			ordinal = ordinal + 1
			local entry = {
				id = id,
				title = title,
				icon = iconOf(not isLink(data.icon) and data.icon or nil), -- a link is downloaded by applyStartImage below
				customImage = data.url ~= nil and data.icon ~= nil and not isLink(data.icon), -- an installed extension's own picture fills the tile
				url = data.url,
				source = type(data.source) == "string" and data.source or nil,
				builder = type(data.builder) == "function" and data.builder or nil,
				order = ordinal,
				loaded = false,
				detached = false,
				protected = data.protected == true or PROTECTED_IDS[id] == true,
			}
			entry.frame = new("Frame", {
				Name = "Plugin_" .. id,
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Visible = false,
				Parent = contentFrame,
			})
			plugins[#plugins + 1] = entry
			makeTile(entry)
			applyStartImage(entry, data.icon, meta)
			return entry
		end
		ext.remove = function(id) -- homeRefs.ext.remove("Plugin_ab12"); the Arceus Hub (AXS_Hub) is refused
			for _, p in ipairs(plugins) do
				if p.id == tostring(id) then
					return removePlugin(p)
				end
			end
			return false
		end
		ext.add = addPlugin -- other code of yours can register an extension: homeRefs.ext.add({ title = "...", icon = "rbxassetid://...", source = "..." })

		backBtn.Activated:Connect(function()
			closePlugin()
		end)
		detachBtn.Activated:Connect(function()
			if current then
				detachPlugin(current)
			end
		end)
		-- another tab selected while an extension is open = the pills go away with the page, and come back with it
		page:GetPropertyChangedSignal("Visible"):Connect(function()
			local show = page.Visible and current ~= nil
			backBtn.Visible = show
			detachBtn.Visible = show
		end)

		----------------------------------------------------------------
		-- INSTALL (the prompt asks for the url, then the extension is downloaded)
		----------------------------------------------------------------
		local installing = false
		local function installFromUrl(text)
			if installing or not string.find(tostring(text or ""), "%S") then
				return
			end
			local url = cleanUrl(text) -- also understands a pasted loadstring(game:HttpGet("...")) line and GitHub / Pastebin page links
			if not url then
				showToast({ style = "error", title = "Install", text = "Paste the extension link (it starts with https://)" })
				return
			end
			for _, saved in ipairs(savedUrls) do
				if saved == url then
					showToast({ style = "info", title = "Install", text = "That extension is already installed." })
					return
				end
			end
			installing = true
			installLabel.Text = "..."
			task.spawn(function()
				local okFetch, data, reason = pcall(fetchExtension, url)
				if not okFetch then
					data, reason = nil, data -- fetchExtension raised an error: the message is in the second slot
				end
				installing = false -- always let go, so the Install button works again whatever happened
				if not alive then
					return
				end
				installLabel.Text = "Install"
				if not data then
					logWarn(
						"Extension install failed: " .. tostring(reason),
						"wrong url, no internet, or the link is not a JSON extension file",
						"the link has to open a JSON { \"title\": ..., \"source\": ... } file in a browser (use the Raw link of GitHub / Pastebin files); plain Luau files are not accepted"
					)
					showToast({ style = "error", title = "Install", text = "Could not install: " .. string.sub(tostring(reason), 1, 120) })
					return
				end
				local entry = addPlugin(data)
				if not entry then
					showToast({ style = "info", title = "Install", text = "An extension with that id is already installed." })
					return
				end
				addSaved(url)
				local wrote = writeSaved() -- false on a system with no file access: the extension then lives until the UI closes
				local note = Sys.getLoadstring() and " installed - tap it to open." or " installed, but it needs loadstring to run."
				if not wrote then
					note = note .. " (not saved: no file access here)"
				end
				showToast({ style = "success", title = "Install", text = entry.title .. note })
				callHook("OnExtension", "install", info(entry))
			end)
		end

		installBtn.Activated:Connect(function()
			if not openInstantCode then
				return
			end
			openInstantCode({
				title = "Install extension",
				placeholder = "Extension url",
				style = "info", -- source: InputToast (blue), not the pink Arcy prompt
				hideGui = true,
				onSubmit = installFromUrl,
			})
		end)

		----------------------------------------------------------------
		-- ARCEUS HUB (built in)
		----------------------------------------------------------------
		-- Source of the look: the reference screenshot (all numbers are measured from it). The window area is split into
		--   * the hub's own icon column (aimbot / fly; the active one sits on a dark red tile),
		--   * the page title with the red line under it,
		--   * the setting rows (dark glass plate, white title, grey description, the control on the right).
		-- Fly and Aimbot really work (see LIVE FEATURES below); every change also calls Hooks.OnHub(setting, value) and is kept in homeRefs.hub.
		local function buildHub(api)
			local HUB_AIM_ICON = "rbxassetid://72933494617424" -- aimbot tab icon (set nil to go back to the drawn crosshair)
			local HUB_FLY_ICON = "rbxassetid://89392728850427" -- fly (fling) tab icon (set nil to go back to the drawn feather)
			local RED = Theme.sh.bright -- switch, UP / DOWN, + / - (Primary Color: Red = 254, 0, 0 sampled from the screenshot)
			local TILE_RED = Theme.sh.tile -- the active icon tile
			local LINE_RED = Theme.sh.line -- the line under the page title
			local OFF_GREY = Color3.fromRGB(85, 85, 85) -- switch OFF (source: #555)
			local EDGE = Color3.fromRGB(42, 42, 42) -- thin outline of the speed box / dropdown / switch
			local PLATE = Color3.fromRGB(12, 12, 12) -- speed box / dropdown fill
			-- SWITCH / DROPDOWN LOOK (from the reference picture): dark plate + thick grey rim + white rounded knob; ON = solid red with a dark red rim
			local SWITCH_OFF = Color3.fromRGB(14, 14, 14) -- switch OFF fill
			local RIM_OFF = Color3.fromRGB(68, 64, 64) -- thick grey rim of the switch (OFF) and of the dropdown
			local RIM_ON = Theme.sh.rim -- rim of the switch when ON
			-- BUTTON LOOK: UP / DOWN, the library Button, - / + and the number box all read this table, so they always match
			local BTN = {
				H = 0.52, -- height (fraction of the row)
				CORNER = 0.22, -- corner roundness
				PAD = 0.27, -- text padding inside a button
				RIGHT = 0.976, -- right edge of the buttons (fraction of the row)
				PRESS = Theme.sh.press, -- red while held
				RIM = RIM_OFF, -- rim of the number box (same grey as the dropdown / switch)
				RIMW = 2.5, -- rim thickness
			}
			local KNOB_SIZE, KNOB_PRESS = 0.78, 0.62 -- knob height (fraction of the switch) at rest / while the finger is down
			local KNOB_OFF_X, KNOB_ON_X = 0.3, 0.7 -- where the knob sits (fraction of the switch width)
			Theme.onChange(function(theme) -- Settings > Primary Color: the hub's shades follow the chosen colour (what is already on screen is repainted by Theme.repaint)
				local sh = theme.sh
				RED, TILE_RED, LINE_RED, RIM_ON, BTN.PRESS = sh.bright, sh.tile, sh.line, sh.rim, sh.press
			end)
			local function switchLook(track, on, animate)
				local stroke = track:FindFirstChildOfClass("UIStroke")
				local fill = on and RED or SWITCH_OFF
				local rim = on and RIM_ON or RIM_OFF
				local shade = on and 0 or 0.1
				if animate then
					tween(track, 0.25, { BackgroundColor3 = fill, BackgroundTransparency = shade })
					if stroke then
						tween(stroke, 0.25, { Color = rim })
					end
				else
					track.BackgroundColor3 = fill
					track.BackgroundTransparency = shade
					if stroke then
						stroke.Color = rim
					end
				end
			end

			-- the stage keeps the screenshot's proportions (in the detached window too); every number below is a fraction of it
			local HUB_RATIO = (0.925 * 16) / ((0.975 - PLUGIN_Y) * 9)
			local ROW_X, ROW_W = 0.0859, 0.893
			local ROW_Y, ROW_STEP, ROW_H = 0.1368, 0.1551, 0.1357
			local TAB_X, TAB_SIZE = 0.0378, 0.0594
			local TITLE_X, TITLE_Y, LINE_Y = 0.1071, 0.0592, 0.1126

			local state = {
				Fly = false, FlyUp = false, FlyDown = false, Speed = 5, FlyMode = "Default",
				Aimbot = false, TeamCheck = false, Fov = 120,
			}
			homeRefs.hub = state
			-- LIVE FEATURES: Fly + Aimbot (client side). changed() below feeds every toggle / button / stepper into features.apply(name, value),
			-- so the Arceus Hub controls really do something now. Hooks.OnHub is still called afterwards.
			--   Fly:    Fly switch, Fly UP / DOWN (hold), Speed (x FLY_SPEED_UNIT studs per second), Fly Mode (Default = BodyVelocity + BodyGyro,
			--           CFrame = moves the root part directly, Velocity = sets the root part's velocity every frame).
			--           Move with the thumbstick / WASD (flies where the camera looks); on keyboard Space / E = up, LeftCtrl / Q = down.
			--   Aimbot: Aimbot switch, Team check, FOV (radius of the ring in pixels). Pulls the camera onto the head of the player closest to the
			--           middle of the screen, inside the FOV ring.
			local features = (function()
				local Players = game:GetService("Players")
				local RunService = game:GetService("RunService")
				local UserInputService = game:GetService("UserInputService")
				local Workspace = game:GetService("Workspace")

				local FLY_SPEED_UNIT = 10 -- hub Speed 1..500 x this = studs per second (default 5 = 50 studs/s)
				local AIM_SMOOTH = 0.6 -- how hard the camera is pulled onto the target each frame (1 = snap, lower = softer)
				local AIM_PART = "Head" -- falls back to HumanoidRootPart
				local AIM_BIND = "ArcyHubAimbot"

				local S = {
					Fly = false, FlyUp = false, FlyDown = false, Speed = 5, FlyMode = "Default",
					Aimbot = false, TeamCheck = false, Fov = 120,
				}
				local fly = { conn = nil, mover = nil, gyro = nil }
				local aim = { bound = false, ringGui = nil, ring = nil }

				----------------------------------------------------------------
				-- FLY
				----------------------------------------------------------------
				local controls -- nil = not looked up yet, false = not available (the humanoid's MoveDirection is used instead)
				local function getControls()
					if controls == nil then
						local ok, result = pcall(function()
							local scripts = player:FindFirstChild("PlayerScripts")
							local module = scripts and scripts:FindFirstChild("PlayerModule")
							return module and require(module):GetControls()
						end)
						controls = (ok and result) or false
					end
					return controls
				end

				local function flatLook(cam, root)
					local look = cam.CFrame.LookVector
					local flat = Vector3.new(look.X, 0, look.Z)
					if flat.Magnitude < 0.01 then
						look = root.CFrame.LookVector
						flat = Vector3.new(look.X, 0, look.Z)
						if flat.Magnitude < 0.01 then
							flat = Vector3.new(0, 0, -1)
						end
					end
					return flat.Unit
				end

				local function flyDirection(hum, cam)
					local dir = Vector3.zero
					local c = getControls()
					if c then
						local ok, mv = pcall(function()
							return c:GetMoveVector() -- camera space: looking up / down while pushing forward flies up / down
						end)
						if ok and typeof(mv) == "Vector3" then
							dir = cam.CFrame:VectorToWorldSpace(mv)
						end
					else
						dir = hum.MoveDirection
					end
					local typing = UserInputService:GetFocusedTextBox() ~= nil
					local up = S.FlyUp or (not typing and (UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E)))
					local down = S.FlyDown or (not typing and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q)))
					if up then
						dir += Vector3.yAxis
					end
					if down then
						dir -= Vector3.yAxis
					end
					if dir.Magnitude > 1 then
						dir = dir.Unit
					end
					return dir
				end

				local function releaseMovers()
					if fly.mover then
						fly.mover:Destroy()
						fly.mover = nil
					end
					if fly.gyro then
						fly.gyro:Destroy()
						fly.gyro = nil
					end
				end

				local function flyStep(dt)
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local root = char and ((hum and hum.RootPart) or char:FindFirstChild("HumanoidRootPart"))
					local cam = Workspace.CurrentCamera
					if not (hum and root and cam) or hum.Health <= 0 then
						return -- respawning: the movers are rebuilt on the next frame that has a character
					end
					hum.PlatformStand = true
					local velocity = flyDirection(hum, cam) * (S.Speed * FLY_SPEED_UNIT)
					local flat = flatLook(cam, root)
					local mode = S.FlyMode
					if mode == "CFrame" then
						releaseMovers()
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
						local pos = root.Position + velocity * dt
						root.CFrame = CFrame.lookAt(pos, pos + flat)
					elseif mode == "Velocity" then
						releaseMovers()
						root.AssemblyLinearVelocity = velocity + Vector3.new(0, Workspace.Gravity * dt, 0) -- cancels the gravity of this frame
						root.AssemblyAngularVelocity = Vector3.zero
						root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
					else -- Default
						if not (fly.mover and fly.mover.Parent == root and fly.gyro and fly.gyro.Parent == root) then
							releaseMovers()
							fly.mover = new("BodyVelocity", {
								Name = "ArcyFlyVelocity",
								MaxForce = Vector3.new(1e9, 1e9, 1e9),
								Velocity = Vector3.zero,
								Parent = root,
							})
							fly.gyro = new("BodyGyro", {
								Name = "ArcyFlyGyro",
								MaxTorque = Vector3.new(1e9, 1e9, 1e9),
								P = 9e4,
								D = 1e3,
								CFrame = root.CFrame,
								Parent = root,
							})
						end
						fly.mover.Velocity = velocity
						fly.gyro.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
					end
				end

				local function setFly(on)
					if on then
						if not fly.conn then
							fly.conn = RunService.Heartbeat:Connect(flyStep)
						end
					else
						if fly.conn then
							fly.conn:Disconnect()
							fly.conn = nil
						end
						releaseMovers()
						local char = player.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						local root = char and char:FindFirstChild("HumanoidRootPart")
						if hum then
							hum.PlatformStand = false
						end
						if root then
							root.AssemblyLinearVelocity = Vector3.zero
						end
					end
				end

				----------------------------------------------------------------
				-- AIMBOT
				----------------------------------------------------------------
				local function pickTarget(cam)
					local center = cam.ViewportSize / 2
					local best, bestDist
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= player and not (S.TeamCheck and plr.Team ~= nil and plr.Team == player.Team) then
							local char = plr.Character
							local hum = char and char:FindFirstChildOfClass("Humanoid")
							local part = char and (char:FindFirstChild(AIM_PART) or char:FindFirstChild("HumanoidRootPart"))
							if hum and part and hum.Health > 0 then
								local pos, onScreen = cam:WorldToViewportPoint(part.Position)
								if onScreen then
									local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
									if d <= S.Fov and (bestDist == nil or d < bestDist) then
										best, bestDist = part, d
									end
								end
							end
						end
					end
					return best
				end

				local function aimStep(dt)
					local cam = Workspace.CurrentCamera
					if not cam then
						return
					end
					local part = pickTarget(cam)
					if part then
						local cf = cam.CFrame
						local alpha = 1 - (1 - AIM_SMOOTH) ^ (math.max(dt, 1 / 240) * 60) -- same pull at any frame rate
						cam.CFrame = cf:Lerp(CFrame.lookAt(cf.Position, part.Position), alpha)
					end
				end

				local function setAim(on)
					if on then
						if not aim.ringGui then
							aim.ringGui = new("ScreenGui", {
								Name = "ArcyAimFov",
								ResetOnSpawn = false,
								IgnoreGuiInset = true, -- same origin as WorldToViewportPoint, so the ring is exactly on the aim centre
								ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
								DisplayOrder = 60,
								Parent = gui.Parent,
							})
							aim.ring = new("Frame", {
								Name = "Ring",
								AnchorPoint = Vector2.new(0.5, 0.5),
								Position = UDim2.fromScale(0.5, 0.5),
								Size = UDim2.fromOffset(S.Fov * 2, S.Fov * 2),
								BackgroundTransparency = 1,
								BorderSizePixel = 0,
								Parent = aim.ringGui,
							}, {
								corner(0.5),
								new("UIStroke", { Thickness = 2, Transparency = 0.35, Color = Theme.sh.bright }),
							})
						end
						if not aim.bound then
							aim.bound = true
							RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 1, aimStep) -- right after the camera script
						end
					else
						if aim.bound then
							aim.bound = false
							pcall(function()
								RunService:UnbindFromRenderStep(AIM_BIND)
							end)
						end
						if aim.ringGui then
							aim.ringGui:Destroy()
							aim.ringGui, aim.ring = nil, nil
						end
					end
				end

				----------------------------------------------------------------
				local api = {}
				function api.apply(name, value)
					S[name] = value
					if name == "Fly" then
						setFly(value == true)
					elseif name == "Aimbot" then
						setAim(value == true)
					elseif name == "Fov" and aim.ring then
						aim.ring.Size = UDim2.fromOffset(S.Fov * 2, S.Fov * 2)
					end
				end
				function api.stop()
					setFly(false)
					setAim(false)
				end
				return api
			end)()
			gui.Destroying:Once(features.stop) -- the UI is gone: let go of the character and the camera

			local function changed(name, value)
				state[name] = value
				features.apply(name, value) -- Fly / Aimbot really run now
				callHook("OnHub", name, value)
			end

			local stage = new("Frame", {
				Name = "HubStage",
				AnchorPoint = CENTER,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Parent = api.Frame,
			}, { new("UIAspectRatioConstraint", { AspectRatio = HUB_RATIO }) })

			----------------------------------------------------------------
			-- PAGE + ROW + CONTROLS
			----------------------------------------------------------------
			local function newPage(name, title)
				local pg = new("Frame", { Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = stage })
				label({
					Name = "PageTitle",
					Text = title,
					FontFace = FONT.Title,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.fromScale(TITLE_X, TITLE_Y),
					Size = UDim2.fromScale(0.5, 0.036),
					Parent = pg,
				})
				new("Frame", {
					Name = "TitleLine",
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.fromScale(ROW_X, LINE_Y),
					Size = UDim2.new(ROW_W, 0, 0, 2),
					BackgroundColor3 = LINE_RED,
					BorderSizePixel = 0,
					Parent = pg,
				})
				return pg
			end

			local function newRow(pg, index, title, desc)
				local r = new("Frame", {
					Name = "Row_" .. index,
					Position = UDim2.fromScale(ROW_X, ROW_Y + (index - 1) * ROW_STEP),
					Size = UDim2.fromScale(ROW_W, ROW_H),
					BackgroundColor3 = Color3.new(0, 0, 0),
					BackgroundTransparency = 0.7, -- source: SettingToggle plate (#000, .7)
					BorderSizePixel = 0,
					Parent = pg,
				}, { corner(0.22) })
				label({
					Name = "Title",
					Text = title,
					FontFace = FONT.Body,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Bottom,
					Position = UDim2.fromScale(0.024, 0.08),
					Size = UDim2.fromScale(0.6, 0.4),
					Parent = r,
				})
				label({
					Name = "Description",
					Text = desc,
					FontFace = FONT.Description,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextTransparency = 0.5, -- source: description at .5
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromScale(0.024, 0.86),
					Size = UDim2.fromScale(0.7, 0.27),
					Parent = r,
				})
				return r
			end

			-- the red switch (white knob slides, the plate turns grey when OFF)
			local function addToggle(r, initial, onChange)
				local on = initial
				local track = new("TextButton", {
					Name = "Toggle",
					Text = "",
					AutoButtonColor = false,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.fromScale(0.975, 0.5),
					Size = UDim2.fromScale(0.1, 0.58),
					BackgroundColor3 = on and RED or SWITCH_OFF,
					BackgroundTransparency = on and 0 or 0.1,
					BorderSizePixel = 0,
					Parent = r,
				}, { corner(0.4), new("UIStroke", { Color = on and RIM_ON or RIM_OFF, Thickness = 2.5 }), ratio(1.45) })
				local knob = new("Frame", {
					Name = "Knob",
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(on and KNOB_ON_X or KNOB_OFF_X, 0.5),
					Size = UDim2.fromScale(KNOB_SIZE, KNOB_SIZE),
					BackgroundColor3 = WHITE,
					BorderSizePixel = 0,
					Parent = track,
				}, { corner(0.4), ratio(1) })
				pressFx(track)
				-- the knob squeezes while the finger is down and springs back when it lets go
				track.InputBegan:Connect(function(input)
					if isTap(input) then
						tween(knob, 0.1, { Size = UDim2.fromScale(KNOB_PRESS, KNOB_PRESS) })
					end
				end)
				track.InputEnded:Connect(function(input)
					if isTap(input) then
						tween(knob, 0.25, { Size = UDim2.fromScale(KNOB_SIZE, KNOB_SIZE) }, Enum.EasingStyle.Back)
					end
				end)
				track.Activated:Connect(function()
					on = not on
					tween(knob, 0.3, { Position = UDim2.fromScale(on and KNOB_ON_X or KNOB_OFF_X, 0.5) }, Enum.EasingStyle.Back)
					switchLook(track, on, true)
					onChange(on)
				end)
			end

			-- UP / DOWN: red buttons that are "held" while the finger is down
			local function addHold(r, text, onHold)
				local held = false
				local b = new("TextButton", {
					Name = text,
					Text = text,
					FontFace = FONT.Title,
					TextColor3 = WHITE,
					TextScaled = true,
					AutoButtonColor = false,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.fromScale(BTN.RIGHT, 0.5),
					Size = UDim2.fromScale(0.127, BTN.H),
					BackgroundColor3 = RED,
					BorderSizePixel = 0,
					Parent = r,
				}, { corner(BTN.CORNER), new("UIPadding", { PaddingTop = UDim.new(BTN.PAD, 0), PaddingBottom = UDim.new(BTN.PAD, 0) }) })
				pressFx(b)
				local function release()
					if held then
						held = false
						tween(b, 0.1, { BackgroundColor3 = RED })
						onHold(false)
					end
				end
				b.InputBegan:Connect(function(input)
					if isTap(input) and not held then
						held = true
						tween(b, 0.08, { BackgroundColor3 = BTN.PRESS })
						onHold(true)
						local conn
						conn = input:GetPropertyChangedSignal("UserInputState"):Connect(function()
							if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
								conn:Disconnect()
								release()
							end
						end)
					end
				end)
			end

			-- [-] [ 5 ] [+]
			local function addStepper(r, initial, min, max, step, onChange)
				local value = initial
				local box = new("TextBox", {
					Name = "Value",
					Text = tostring(value),
					FontFace = FONT.Body,
					TextColor3 = WHITE,
					TextScaled = true,
					ClearTextOnFocus = false,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.8383, 0.5),
					Size = UDim2.fromScale(0.1807, BTN.H),
					BackgroundColor3 = Color3.fromRGB(10, 10, 10),
					BorderSizePixel = 0,
					Parent = r,
				}, {
					corner(BTN.CORNER),
					new("UIPadding", { PaddingTop = UDim.new(BTN.PAD, 0), PaddingBottom = UDim.new(BTN.PAD, 0) }),
				})
				local function set(v)
					v = math.clamp(math.floor(v + 0.5), min, max)
					box.Text = tostring(v)
					if v ~= value then
						value = v
						onChange(v)
					end
				end
				box.FocusLost:Connect(function()
					local typed = tonumber(string.match(box.Text, "%d+%.?%d*"))
					set(typed or value)
				end)
				local function square(text, x, delta)
					local b = new("TextButton", {
						Name = text == "+" and "Plus" or "Minus",
						Text = text,
						FontFace = FONT.Title,
						TextColor3 = WHITE,
						TextScaled = true,
						AutoButtonColor = false,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.fromScale(x, 0.5),
						Size = UDim2.fromScale(0.5, BTN.H), -- the aspect ratio makes it a square as tall as UP / DOWN
						BackgroundColor3 = RED,
						BorderSizePixel = 0,
						Parent = r,
					}, { corner(BTN.CORNER), ratio(1), new("UIPadding", { PaddingTop = UDim.new(BTN.PAD, 0), PaddingBottom = UDim.new(BTN.PAD, 0), PaddingLeft = UDim.new(BTN.PAD, 0), PaddingRight = UDim.new(BTN.PAD, 0) }) })
					pressFx(b)
					b.Activated:Connect(function()
						set(value + delta)
					end)
				end
				square("-", 0.737, -step)
				square("+", BTN.RIGHT, step)
			end

			-- the "Default v" dropdown (the list opens upward so the window never cuts it)
			local function addDropdown(r, options, initial, onChange)
				local btn = new("TextButton", {
					Name = "Dropdown",
					Text = "",
					AutoButtonColor = false,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.fromScale(0.979, 0.5),
					Size = UDim2.fromScale(0.158, 0.64),
					BackgroundColor3 = PLATE,
					BackgroundTransparency = 0.2,
					BorderSizePixel = 0,
					Parent = r,
				}, { corner(0.35), new("UIStroke", { Color = RIM_OFF, Thickness = 2.5 }) })
				local shown = label({
					Name = "Selected",
					Text = initial,
					FontFace = FONT.Title,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.fromScale(0.11, 0.29),
					Size = UDim2.fromScale(0.6, 0.42),
					Parent = btn,
				})
				local arrow = label({
					Name = "Arrow",
					Text = "v",
					FontFace = FONT.Black,
					TextColor3 = RED,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.84, 0.5),
					Size = UDim2.fromScale(0.2, 0.3),
					Parent = btn,
				})
				local list = new("Frame", {
					Name = "List",
					Visible = false,
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.fromScale(1, -0.12),
					Size = UDim2.fromScale(1.1, #options * 0.9),
					BackgroundColor3 = PLATE,
					BackgroundTransparency = 0.05,
					BorderSizePixel = 0,
					ZIndex = 20,
					Parent = btn,
				}, { corner(0.2), new("UIStroke", { Color = EDGE, Thickness = 1.5 }), new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })
				pressFx(btn)
				local items = {}
				local listScale = new("UIScale", { Scale = 1, Parent = list })
				local listStroke = list:FindFirstChildOfClass("UIStroke")
				local isOpen = false
				-- the list grows out of the button (opens upward) and fades; closing is the same backwards
				local function setOpen(open)
					isOpen = open
					tween(arrow, 0.25, { Rotation = open and 180 or 0 }, Enum.EasingStyle.Back)
					if open then
						list.Visible = true
						listScale.Scale = 0.8
						list.BackgroundTransparency = 1
						if listStroke then
							listStroke.Transparency = 1
							tween(listStroke, 0.2, { Transparency = 0 })
						end
						for _, item in pairs(items) do
							item.TextTransparency = 1
							tween(item, 0.22, { TextTransparency = 0 })
						end
						tween(listScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Back)
						tween(list, 0.2, { BackgroundTransparency = 0.05 })
					else
						tween(listScale, 0.15, { Scale = 0.85 })
						tween(list, 0.15, { BackgroundTransparency = 1 })
						if listStroke then
							tween(listStroke, 0.15, { Transparency = 1 })
						end
						for _, item in pairs(items) do
							tween(item, 0.12, { TextTransparency = 1 })
						end
						task.delay(0.16, function()
							if not isOpen then
								list.Visible = false
							end
						end)
					end
				end
				local function mark(choice)
					for name, item in pairs(items) do
						item.TextColor3 = name == choice and RED or WHITE
					end
				end
				for i, option in ipairs(options) do
					local item = new("TextButton", {
						Name = option,
						Text = option,
						FontFace = FONT.Body,
						TextColor3 = WHITE,
						TextScaled = true,
						AutoButtonColor = false,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						LayoutOrder = i,
						Size = UDim2.new(1, 0, 1 / #options, 0),
						ZIndex = 21,
						Parent = list,
					}, { new("UIPadding", { PaddingTop = UDim.new(0.27, 0), PaddingBottom = UDim.new(0.27, 0) }) })
					items[option] = item
					pressFx(item)
					item.Activated:Connect(function()
						shown.Text = option
						mark(option)
						setOpen(false)
						onChange(option)
					end)
				end
				mark(initial)
				btn.Activated:Connect(function()
					setOpen(not isOpen)
				end)
			end

			----------------------------------------------------------------
			-- ICON COLUMN (the aimbot crosshair and the fly feather, drawn with shapes - see HUB_AIM_ICON / HUB_FLY_ICON)
			----------------------------------------------------------------
			local function drawAim(tile)
				if HUB_AIM_ICON then
					new("ImageLabel", { Name = "AimIcon", Image = HUB_AIM_ICON, ScaleType = Enum.ScaleType.Fit, AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.8), BackgroundTransparency = 1, Parent = tile })
					return
				end
				local box = new("Frame", { Name = "Crosshair", AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.78, 0.78), BackgroundTransparency = 1, Parent = tile }, { ratio(1) })
				new("Frame", { Name = "Ring", AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.64, 0.64), BackgroundTransparency = 1, Parent = box }, { corner(1), new("UIStroke", { Color = WHITE, Thickness = 2 }) })
				for _, t in ipairs({ { 0.5, 0.12, 0.08, 0.26 }, { 0.5, 0.88, 0.08, 0.26 }, { 0.12, 0.5, 0.26, 0.08 }, { 0.88, 0.5, 0.26, 0.08 } }) do
					new("Frame", { AnchorPoint = CENTER, Position = UDim2.fromScale(t[1], t[2]), Size = UDim2.fromScale(t[3], t[4]), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = box }, { corner(1) })
				end
				new("Frame", { Name = "Dot", AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.2, 0.2), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = box }, { corner(1), ratio(1) })
			end

			local function drawFeather(tile)
				if HUB_FLY_ICON then
					new("ImageLabel", { Name = "FlyIcon", Image = HUB_FLY_ICON, ScaleType = Enum.ScaleType.Fit, AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.8), BackgroundTransparency = 1, Parent = tile })
					return
				end
				local box = new("Frame", { Name = "Feather", AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.74, 0.74), BackgroundTransparency = 1, Parent = tile }, { ratio(1) })
				local function feather(w, h, rotation, x, y)
					local f = new("Frame", { AnchorPoint = CENTER, Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h), Rotation = rotation, BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = box }, { corner(1) })
					new("Frame", { Name = "Vein", AnchorPoint = CENTER, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.86, 0, 0, 1), BackgroundColor3 = TILE_RED, BorderSizePixel = 0, Parent = f })
				end
				feather(0.95, 0.36, -32, 0.55, 0.43)
				feather(0.6, 0.26, -14, 0.34, 0.66)
			end

			local pages = {} -- name = { page, tile, rows }
			local activeTab = nil

			-- the page's intro: the title fades in, the red line draws itself, the rows glide up one after another
			local function playPage(pageInfo)
				local title = pageInfo.page:FindFirstChild("PageTitle")
				if title then
					title.TextTransparency = 1
					tween(title, 0.4, { TextTransparency = 0 })
				end
				local line = pageInfo.page:FindFirstChild("TitleLine")
				if line then
					line.Size = UDim2.new(0, 0, 0, 2)
					tween(line, 0.6, { Size = UDim2.new(ROW_W, 0, 0, 2) }, Enum.EasingStyle.Quint)
				end
				for i, r in ipairs(pageInfo.rows) do
					local rest = UDim2.fromScale(ROW_X, ROW_Y + (i - 1) * ROW_STEP)
					r.Position = rest + UDim2.fromScale(0, 0.07)
					task.delay((i - 1) * 0.06, function()
						if r.Parent then
							tween(r, 0.5, { Position = rest }, Enum.EasingStyle.Quint)
						end
					end)
				end
			end

			-- the icon on a tab springs when it is tapped
			local function popIcon(tile)
				for _, child in ipairs(tile:GetChildren()) do
					if child:IsA("GuiObject") then
						local sc = child:FindFirstChild("PopScale") or new("UIScale", { Name = "PopScale", Parent = child })
						sc.Scale = 0.75
						tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
						break
					end
				end
			end

			local function showTab(name, animate)
				if activeTab == name then
					return
				end
				activeTab = name
				for key, info in pairs(pages) do
					local on = key == name
					info.page.Visible = on
					tween(info.tile, 0.25, { BackgroundTransparency = on and 0 or 1 })
					if on and api.SetSubtitle then
						api.SetSubtitle(info.header) -- shown in the middle of the detached window title bar
					end
					if on and animate then
						playPage(info)
					end
				end
			end

			local function newTab(name, centerY, draw, pg, rows, header)
				local tile = new("TextButton", {
					Name = "Tab_" .. name,
					Text = "",
					AutoButtonColor = false,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(TAB_X, centerY),
					Size = UDim2.fromScale(TAB_SIZE, 0.1143),
					BackgroundColor3 = TILE_RED,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Parent = stage,
				}, { corner(0.22), ratio(1) })
				draw(tile)
				pressFx(tile)
				tile.Activated:Connect(function()
					popIcon(tile)
					showTab(name, true)
				end)
				pages[name] = { page = pg, tile = tile, rows = rows, header = header }
			end

			----------------------------------------------------------------
			-- AIMBOT PAGE (placeholder rows in the same style - send the aimbot screenshot and it gets matched too)
			----------------------------------------------------------------
			local aimPg = newPage("AimPage", "Universal aimbot")
			local aimRows = {}
			aimRows[1] = newRow(aimPg, 1, "Aimbot", "Locks onto the nearest player")
			addToggle(aimRows[1], false, function(v)
				changed("Aimbot", v)
			end)
			aimRows[2] = newRow(aimPg, 2, "Team check", "Ignores your teammates")
			addToggle(aimRows[2], false, function(v)
				changed("TeamCheck", v)
			end)
			aimRows[3] = newRow(aimPg, 3, "FOV", "Size of the aim circle")
			addStepper(aimRows[3], 120, 10, 500, 10, function(v)
				changed("Fov", v)
			end)

			----------------------------------------------------------------
			-- FLY PAGE (the screenshot)
			----------------------------------------------------------------
			local flyPg = newPage("FlyPage", "Universal mobile fly")
			local flyRows = {}
			flyRows[1] = newRow(flyPg, 1, "Fly", "Universal fly")
			addToggle(flyRows[1], false, function(v)
				changed("Fly", v)
			end)
			flyRows[2] = newRow(flyPg, 2, "Fly UP", "Moves you upward")
			addHold(flyRows[2], "UP", function(down)
				changed("FlyUp", down)
			end)
			flyRows[3] = newRow(flyPg, 3, "Fly DOWN", "Moves you downward")
			addHold(flyRows[3], "DOWN", function(down)
				changed("FlyDown", down)
			end)
			flyRows[4] = newRow(flyPg, 4, "Speed", "Flight speed")
			addStepper(flyRows[4], 5, 1, 500, 1, function(v)
				changed("Speed", v)
			end)
			flyRows[5] = newRow(flyPg, 5, "Fly Mode", "Different modes for games compatibility")
			addDropdown(flyRows[5], { "Default", "CFrame", "Velocity" }, "Default", function(v)
				changed("FlyMode", v)
			end)

			-- icon column: crosshair on top, the feather under it (centers measured from the screenshot)
			newTab("Aim", 0.1289, drawAim, aimPg, aimRows, "Universal Aimbot")
			newTab("Fly", 0.2595, drawFeather, flyPg, flyRows, "Universal Mobile Fly")
			showTab("Fly", false)

			-- every time the hub appears (opened in the page, or detached into its window) its current page plays the intro again
			api.OnShown(function()
				local current = pages[activeTab]
				if current then
					playPage(current)
				end
			end)
		end

		-- built-in extensions (the Hub is one): { id, title, icon, builder = function(api) end } or { ..., source = "luau code" }
		local BUILTIN = {
			{ id = "AXS_Hub", title = "Arceus Hub", icon = A.HubIcon, builder = buildHub, protected = true },
		}
		for _, data in ipairs(BUILTIN) do
			addPlugin(data)
		end

		-- the installed ones come back from their urls. All downloads run side by side, but the tiles are added in the order they were
		-- installed (the source adds its saved list in order) - a slow link no longer jumps the queue.
		local startupUrls = {}
		for _, url in ipairs(savedUrls) do
			startupUrls[#startupUrls + 1] = url
		end
		local startupDone = {} -- [i] = { data, reason } once download i has finished
		local startupSkipped = {} -- [i] = true when the queue gave up waiting for it (it is added whenever it arrives)
		local function startupFailed(url, reason)
			logWarn(
				"Installed extension could not be loaded: " .. url .. " (" .. tostring(reason) .. ")",
				"no internet, or the url changed / was removed",
				"it stays in your list and is tried again the next time the UI starts - or uninstall it by installing it again after fixing the url"
			)
		end
		for i, url in ipairs(startupUrls) do
			task.spawn(function()
				local okFetch, data, reason = pcall(fetchExtension, url)
				if not okFetch then
					data, reason = nil, data -- fetchExtension raised an error: the message is in the second slot
				end
				startupDone[i] = { data = data, reason = reason }
				if startupSkipped[i] and alive then -- the queue already moved on: add it now
					if data then
						addPlugin(data)
					else
						startupFailed(url, reason)
					end
				end
			end)
		end
		task.spawn(function()
			for i, url in ipairs(startupUrls) do
				local waited = 0
				while not startupDone[i] and alive and waited < 20 do
					task.wait(0.1)
					waited = waited + 0.1
				end
				if not alive then
					return
				end
				local done = startupDone[i]
				if not done then
					startupSkipped[i] = true
				elseif done.data then
					addPlugin(done.data)
				else
					startupFailed(url, done.reason)
				end
			end
		end)

		ext.pieces = { header, grid } -- the panels a page change slides in
		ext.onShow = updateGrid
		task.defer(updateGrid)
	end

	local okExt, errExt = pcall(buildExtensionsPage)
	if not okExt then
		logWarn(
			"The Extensions page could not be built: " .. tostring(errExt),
			"a part of the UI it uses changed",
			"the other pages keep working - the Extensions tab stays empty"
		)
	end
end

----------------------------------------------------------------
-- SETTINGS PAGE (the gear icon = the "Settings" tab)
----------------------------------------------------------------
-- Reference: "Configure / Settings" header and the rows under it (bold title, grey description, the control on the right).
-- Rows: Primary Color (a pill + colour list: the whole UI is recoloured at once, see PRIMARY COLOR near the top of the script), FPS Cap (a pill + list, needs the
-- executor's setfpscap), Editor Text Size (- 16 +, 8..32) and Disable Intro (a switch). Every choice is remembered (ArcyScripts/_settings.json).
-- To add a row: addRow(...) and then addDropdown / addStepper / addSwitch below.
do
	local function buildSettingsPage()
		local LIST_Y = 0.285 -- where the rows start (fraction of the window height) - same as the Extensions grid
		local ROW_PITCH = 0.28 -- one row = this fraction of the visible list (about 19% of the window, like the reference)

		local page = new("Frame", {
			Name = "Settings",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = content,
		})
		local set = { page = page }
		homeRefs.settings = set

		----------------------------------------------------------------
		-- HEADER: Configure / Settings
		----------------------------------------------------------------
		local header = new("Frame", {
			Name = "Header",
			Position = UDim2.fromScale(0, 0.12),
			Size = UDim2.fromScale(1, 0.165),
			BackgroundTransparency = 1,
			Parent = page,
		})
		label({
			Name = "Configure",
			Text = "Configure",
			FontFace = FONT.Description,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTransparency = 0.25,
			Position = UDim2.fromScale(0.03, 0.14),
			Size = UDim2.fromScale(0.3, 0.24),
			Parent = header,
		})
		label({
			Name = "Title",
			Text = "Settings",
			FontFace = FONT.Black,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromScale(0.03, 0.42),
			Size = UDim2.fromScale(0.3, 0.38),
			Parent = header,
		})

		----------------------------------------------------------------
		-- ROWS (a scrolling list: every row is the same height, more rows just make it scroll)
		----------------------------------------------------------------
		local rows = new("ScrollingFrame", {
			Name = "Rows",
			Position = UDim2.fromScale(0, LIST_Y),
			Size = UDim2.fromScale(1, 0.97 - LIST_Y),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = PRIMARY,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			CanvasSize = UDim2.fromScale(0, 1),
			ClipsDescendants = true,
			Parent = page,
		})
		local rowList = {}
		local function layoutRows()
			local canvasY = math.max(1, #rowList * ROW_PITCH)
			rows.CanvasSize = UDim2.fromScale(0, canvasY)
			for i, row in ipairs(rowList) do
				row.Position = UDim2.fromScale(0, (i - 1) * ROW_PITCH / canvasY)
				row.Size = UDim2.fromScale(1, ROW_PITCH / canvasY)
			end
		end
		local function addRow(name, title, description)
			local row = new("Frame", {
				Name = "Row_" .. name,
				BackgroundTransparency = 1,
				Parent = rows,
			})
			label({
				Name = "Title",
				Text = title,
				FontFace = FONT.Body,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromScale(0.05, 0.1),
				Size = UDim2.fromScale(0.55, 0.38),
				Parent = row,
			})
			label({
				Name = "Description",
				Text = description,
				FontFace = FONT.Description,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTransparency = 0.5,
				Position = UDim2.fromScale(0.05, 0.5),
				Size = UDim2.fromScale(0.6, 0.24),
				Parent = row,
			})
			rowList[#rowList + 1] = row
			layoutRows()
			return row
		end

		----------------------------------------------------------------
		-- THE CONTROLS the rows use: DROPDOWN (pill + black list), STEPPER (- 16 +) and SWITCH. Every control adds its "show the value again" function
		-- to `refreshers`, so a colour change or opening the page makes them all show the real values.
		----------------------------------------------------------------
		local OPTION_GAP = 4 -- px between two options of a list
		local SHOWN_OPTIONS = 4.5 -- a list is this many options tall: four and a half, so you see there is more to scroll
		local refreshers = {}
		local activeClose = nil -- closes the list that is open (only one list is open at a time)

		-- one blocker for every list: a tap anywhere outside the open list closes it
		local blocker = new("TextButton", {
			Name = "ListBlocker",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 25,
			Visible = false,
			Parent = page,
		})
		local function closeActive()
			if activeClose then
				local close = activeClose
				activeClose = nil
				blocker.Visible = false
				close()
			end
		end
		blocker.Activated:Connect(closeActive)
		set.closeMenu = closeActive

		-- DROPDOWN = the source's SettingDropdown (and the reference picture):
		--   * the pill is the primary colour itself at 0.85 transparency (source: Colors_Primary BackgroundColor3, BackgroundTransparency .85) with the text in white
		--   * the list is a black ScrollingFrame (0.15 transparency, round corners, thin white scroll bar) under the pill, right edges lined up; every option is just
		--     white text, no boxes (source: TextButton, TextScaled, Fonts_Body). The list lives on the page (not inside the scrolling rows) so nothing clips it.
		--   entries = the texts of the options, current() = the text the pill shows, pick(index) is called with the option that was tapped
		local function addDropdown(row, name, entries, current, pick)
			local drop = {}
			local pill = new("TextButton", {
				Name = name .. "Button",
				Text = current(),
				FontFace = FONT.Body,
				TextColor3 = TEXT,
				TextScaled = true,
				AutoButtonColor = false,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(0.935, 0.5),
				Size = UDim2.fromScale(0.225, 0.46),
				BackgroundColor3 = PRIMARY,
				BackgroundTransparency = 0.85,
				BorderSizePixel = 0,
				Parent = row,
			}, {
				corner(0.35),
				new("UIPadding", { PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) }),
			})
			pressFx(pill)

			-- NoTheme: the list is only black + white, the repaint must never touch it
			local menu = new("ScrollingFrame", {
				Name = name .. "Menu",
				Visible = false,
				AnchorPoint = Vector2.new(1, 0),
				BackgroundColor3 = Color3.fromRGB(0, 0, 0), -- source: Color3.fromHex("#000")
				BackgroundTransparency = 0.15,
				BorderSizePixel = 0,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255), -- the thin white bar of the picture
				ScrollBarImageTransparency = 0.1,
				ClipsDescendants = true,
				ZIndex = 30,
				Parent = page,
			}, {
				corner(0.15),
				new("UIPadding", {
					PaddingTop = UDim.new(0.05, 0),
					PaddingBottom = UDim.new(0.05, 0),
					PaddingLeft = UDim.new(0.05, 0),
					PaddingRight = UDim.new(0.05, 0),
				}),
				new("UIListLayout", {
					FillDirection = Enum.FillDirection.Vertical,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, OPTION_GAP),
				}),
				new("UIScale", { Name = "Pop", Scale = 1 }),
			})
			menu:SetAttribute("NoTheme", true)
			local menuScale = menu.Pop
			local isOpen = false

			local options = {}
			for i, text in ipairs(entries) do
				local option = new("TextButton", {
					Name = "Option_" .. i,
					Text = text,
					FontFace = FONT.Body,
					TextColor3 = TEXT,
					TextScaled = true,
					AutoButtonColor = false,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 30), -- the real height is set when the list opens (it follows the pill)
					LayoutOrder = i,
					ZIndex = 31,
					Parent = menu,
				}, {
					new("UIPadding", { PaddingTop = UDim.new(0.17, 0), PaddingBottom = UDim.new(0.17, 0) }), -- the text is a bit smaller than the option
				})
				pressFx(option)
				options[#options + 1] = option
				option.Activated:Connect(function()
					closeActive()
					pick(i)
					drop.refresh()
				end)
			end

			function drop.refresh() -- the pill shows the chosen text (and the colour of the theme)
				pill.Text = current()
				pill.BackgroundColor3 = PRIMARY
			end

			local function hide()
				isOpen = false
				tween(menuScale, 0.1, { Scale = 0.88 })
				task.delay(0.1, function()
					if not isOpen then
						menu.Visible = false
					end
				end)
			end

			local function show()
				local pageAt, pageSize = page.AbsolutePosition, page.AbsoluteSize
				local pillAt, pillSize = pill.AbsolutePosition, pill.AbsoluteSize
				if pageSize.X < 10 or pageSize.Y < 10 then
					return
				end
				local k = Theme.uiScaleOf(page) -- the window's own UIScale: pixel sizes inside the window are multiplied by it
				local optionH = math.max(14, math.floor(pillSize.Y * 0.95 / k)) -- every option is as tall as the pill, so its text is about the pill's text size
				for _, option in ipairs(options) do
					option.Size = UDim2.new(1, 0, 0, optionH)
				end
				local shown = math.min(#options, SHOWN_OPTIONS)
				local top = math.max(0, (pillAt.Y + pillSize.Y - pageAt.Y) / pageSize.Y + 0.012)
				local wanted = ((optionH * shown + OPTION_GAP * math.max(math.ceil(shown) - 1, 0)) * k / pageSize.Y) / 0.9 -- (the list keeps 5% padding at the top and bottom)
				menu.Position = UDim2.fromScale((pillAt.X + pillSize.X - pageAt.X) / pageSize.X, top) -- right edge lines up with the pill
				menu.Size = UDim2.fromScale(math.clamp(pillSize.X * 1.05 / pageSize.X, 0.15, 0.6), math.clamp(wanted, 0.12, math.max(0.12, 0.97 - top)))
				menu.CanvasPosition = Vector2.new(0, 0)
				drop.refresh()
				isOpen = true
				activeClose = hide
				menuScale.Scale = 0.88
				menu.Visible = true
				blocker.Visible = true
				tween(menuScale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
			end

			pill.Activated:Connect(function()
				if isOpen then
					closeActive()
				else
					closeActive()
					show()
				end
			end)
			refreshers[#refreshers + 1] = drop.refresh
			return drop
		end

		-- STEPPER = the source's SettingNumeric: a "-" button, the number and a "+" button (the buttons are the primary colour).
		-- A tap changes the value by one step; keep a finger on a button and it repeats.
		local function addStepper(row, name, getValue, minValue, maxValue, stepValue, setValue)
			local box = new("Frame", {
				Name = name,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(0.935, 0.5),
				Size = UDim2.fromScale(0.3, 0.5),
				BackgroundTransparency = 1,
				Parent = row,
			})
			local function stepButton(text, x)
				return new("TextButton", {
					Name = name .. "Button",
					Text = text,
					FontFace = FONT.Black,
					TextColor3 = TEXT,
					TextScaled = true,
					AutoButtonColor = false,
					Position = UDim2.fromScale(x, 0),
					Size = UDim2.fromScale(0.3, 1),
					BackgroundColor3 = PRIMARY,
					BorderSizePixel = 0,
					Parent = box,
				}, {
					corner(0.5),
					new("UIPadding", { PaddingTop = UDim.new(0.14, 0), PaddingBottom = UDim.new(0.14, 0) }),
				})
			end
			local down = stepButton("-", 0)
			local up = stepButton("+", 0.7)
			local valueLabel = label({
				Name = "Value",
				Text = tostring(getValue()),
				FontFace = FONT.Black,
				Position = UDim2.fromScale(0.32, 0.1),
				Size = UDim2.fromScale(0.36, 0.8),
				Parent = box,
			})
			pressFx(down)
			pressFx(up)
			for _, part in ipairs({ down, up, valueLabel }) do
				part:SetAttribute("NoTextScale", true) -- the control that sets the size keeps its own size
			end

			local function refresh()
				local v = getValue()
				valueLabel.Text = tostring(v)
				down.BackgroundColor3 = PRIMARY
				up.BackgroundColor3 = PRIMARY
				down.BackgroundTransparency = v <= minValue and 0.55 or 0 -- a button that cannot go further looks dimmer
				up.BackgroundTransparency = v >= maxValue and 0.55 or 0
			end
			-- false when the value is already at its limit
			local function step(delta)
				local v = math.clamp(getValue() + delta, minValue, maxValue)
				if v == getValue() then
					return false
				end
				setValue(v)
				refresh()
				return true
			end
			local function holdable(button, delta)
				local pressId = 0
				local repeated = false
				button.InputBegan:Connect(function(input)
					if not isTap(input) then
						return
					end
					pressId = pressId + 1
					repeated = false
					local mine = pressId
					task.delay(0.45, function()
						local count = 0
						while pressId == mine and count < 60 do -- (60 = a safety stop: the loop never runs on if the release was missed)
							repeated = true
							count = count + 1
							if not step(delta) then
								break
							end
							task.wait(0.09)
						end
					end)
				end)
				button.InputEnded:Connect(function(input)
					if isTap(input) then
						pressId = pressId + 1
					end
				end)
				button.Activated:Connect(function()
					if repeated then
						repeated = false -- the hold already stepped: the release is not one more tap
						return
					end
					step(delta)
				end)
			end
			holdable(down, -stepValue)
			holdable(up, stepValue)
			refreshers[#refreshers + 1] = refresh
			refresh()
		end

		-- SWITCH = the source's SettingToggle: ON = a primary colour plate with the white knob on the right, OFF = dark plate with a grey rim, knob on the left
		local SWITCH_OFF = Color3.fromRGB(14, 14, 14)
		local SWITCH_RIM_OFF = Color3.fromRGB(68, 64, 64)
		local function addSwitch(row, name, getState, setState)
			local track = new("TextButton", {
				Name = name,
				Text = "",
				AutoButtonColor = false,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(0.935, 0.5),
				Size = UDim2.fromScale(0.2, 0.5),
				BorderSizePixel = 0,
				Parent = row,
			}, {
				corner(0.5),
				ratio(1.9),
				new("UIStroke", { Thickness = 2.5, Color = SWITCH_RIM_OFF, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }), -- (Border: a stroke on a TextButton would outline its text)
			})
			local stroke = track:FindFirstChildOfClass("UIStroke")
			local knob = new("Frame", {
				Name = "Knob",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromScale(0.78, 0.78),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = track,
			}, { corner(0.5), ratio(1) })
			pressFx(track)

			local function look(animate)
				local on = getState()
				local fill = on and PRIMARY or SWITCH_OFF
				local rim = on and Theme.sh.rim or SWITCH_RIM_OFF
				local knobAt = UDim2.fromScale(on and 0.7 or 0.3, 0.5)
				local shade = on and 0 or 0.1
				if animate then
					tween(track, 0.2, { BackgroundColor3 = fill, BackgroundTransparency = shade })
					tween(knob, 0.2, { Position = knobAt }, Enum.EasingStyle.Back)
					if stroke then
						tween(stroke, 0.2, { Color = rim })
					end
				else
					track.BackgroundColor3 = fill
					track.BackgroundTransparency = shade
					knob.Position = knobAt
					if stroke then
						stroke.Color = rim
					end
				end
			end
			track.Activated:Connect(function()
				setState(not getState())
				look(true)
			end)
			refreshers[#refreshers + 1] = function()
				look(false)
			end
			look(false)
		end

		----------------------------------------------------------------
		-- THE ROWS (same order and descriptions as the source)
		----------------------------------------------------------------
		-- ROW 1: PRIMARY COLOR - the whole UI is recoloured at once (see PRIMARY COLOR near the top of the script)
		local colorNames = {}
		for i, entry in ipairs(Theme.COLORS) do
			colorNames[i] = entry.Name
		end
		addDropdown(addRow("PrimaryColor", "Primary Color", "Choose the primary color theme"), "Color", colorNames, function()
			return Theme.cur.name
		end, function(index)
			Theme.apply(Theme.COLORS[index].Name)
		end)

		-- ROW 2: FPS CAP - 30 / 60 / 120 / 144 / 240 / Unlimited (= 1000, like the source). Needs setfpscap, a function of the executor.
		local fpsNames = {}
		for i, choice in ipairs(Theme.FPS_CHOICES) do
			fpsNames[i] = choice.Name
		end
		local warnedFps = false
		addDropdown(addRow("FpsCap", "FPS Cap", "Choose the maximum FPS limit"), "Fps", fpsNames, function()
			for _, choice in ipairs(Theme.FPS_CHOICES) do
				if choice.Value == Theme.prefs.FpsCap then
					return choice.Name
				end
			end
			return tostring(Theme.prefs.FpsCap) .. " Fps" -- a value somebody saved by hand
		end, function(index)
			Theme.setPref("FpsCap", Theme.FPS_CHOICES[index].Value) -- the listener of Theme.onPref("FpsCap") applies it with setfpscap
			if not Theme.applyFps(Theme.prefs.FpsCap) and not warnedFps then
				warnedFps = true
				logWarn(
					"FPS Cap could not be applied",
					"this executor has no setfpscap function",
					"the choice is saved and is applied as soon as an executor with setfpscap runs the script"
				)
			end
		end)

		-- ROW 3: EDITOR TEXT SIZE - 8 .. 32, 16 = the normal size (the editor follows at once, see updateSizes in the Editor page)
		addStepper(addRow("EditorTextSize", "Editor Text Size", "Set the size of the editor text and the UI text"), "TextSize", function()
			return Theme.prefs.EditorTextSize
		end, Theme.TEXT_SIZE.Min, Theme.TEXT_SIZE.Max, Theme.TEXT_SIZE.Step, function(value)
			Theme.setPref("EditorTextSize", value)
		end)

		-- ROW 4: DISABLE INTRO - the loading screen is skipped the next time the script starts (it is read at the very start of the script)
		addSwitch(addRow("DisableIntro", "Disable Intro", "Skip the intro when starting"), "IntroSwitch", function()
			return Theme.prefs.DisableIntro
		end, function(state)
			Theme.setPref("DisableIntro", state)
		end)

		page:GetPropertyChangedSignal("Visible"):Connect(function()
			if not page.Visible then
				closeActive()
			end
		end)
		page:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() -- window resized / full screen: an open list would be in the wrong place
			closeActive()
		end)

		function set.refresh() -- every control shows the real value again
			rows.ScrollBarImageColor3 = PRIMARY
			for _, fn in ipairs(refreshers) do
				fn()
			end
		end
		Theme.onChange(function() -- the colour was changed from somewhere else (your own code: Theme.apply)
			set.refresh()
		end)

		set.refresh()
		set.pieces = { header, rows } -- the panels a page change slides in
		set.onShow = set.refresh
	end

	local okSettings, errSettings = pcall(buildSettingsPage)
	if not okSettings then
		logWarn(
			"The Settings page could not be built: " .. tostring(errSettings),
			"a part of the UI it uses changed",
			"the other pages keep working - the Settings tab stays empty"
		)
	end
end

