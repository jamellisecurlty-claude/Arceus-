	local function readLicenseFile()
		local data
		pcall(function()
			local L = LoadingScreen.LICENSE
			if readfile and isfile and isfile(L.File) then
				data = game:GetService("HttpService"):JSONDecode(readfile(L.File))
			end
		end)
		return type(data) == "table" and data or {}
	end

	local function writeLicenseFile(email)
		pcall(function()
			if not writefile then
				return
			end
			if makefolder and isfolder and not isfolder("ArcyScripts") then
				makefolder("ArcyScripts")
			end
			writefile(
				LoadingScreen.LICENSE.File,
				game:GetService("HttpService"):JSONEncode({ email = email, issuedAt = os.time() })
			)
		end)
	end

	-- true when RememberHours > 0 and a saved START is still fresh (then the license screen is skipped)
	function LoadingScreen.LicenseStillValid()
		local hours = tonumber(LoadingScreen.LICENSE.RememberHours) or 0
		if hours <= 0 then
			return false
		end
		local saved = readLicenseFile()
		return type(saved.email) == "string"
			and string.match(saved.email, EMAIL_PATTERN) ~= nil
			and type(saved.issuedAt) == "number"
			and (os.time() - saved.issuedAt) < hours * 3600
	end

	local function openLink(url)
		local opened = pcall(function()
			game:GetService("GuiService"):OpenBrowserWindow(url)
		end)
		if opened then
			return "Opening the link..."
		end
		local copied = false
		for _, name in ipairs({ "setclipboard", "toclipboard" }) do
			local fn = (getgenv and getgenv()[name]) or (_G and _G[name])
			if not fn and name == "setclipboard" then
				fn = setclipboard
			elseif not fn and name == "toclipboard" then
				fn = toclipboard
			end
			if type(fn) == "function" and pcall(fn, url) then
				copied = true
				break
			end
		end
		return copied and "Link copied - paste it in your browser." or url
	end

