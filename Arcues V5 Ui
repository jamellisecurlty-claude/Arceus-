		local PAL = { { 255, 0, 0 }, { 255, 56, 105 }, { 244, 115, 236 }, { 21, 166, 254 }, { 255, 56, 105 }, { 255, 0, 0 } }
		local LUT = 256
		local lutR, lutG, lutB = {}, {}, {}
		for i = 0, LUT do
			local seg = (i / LUT) * #PAL
			local i1 = floor(seg) % #PAL
			local i2 = (i1 + 1) % #PAL
			local frac = seg - floor(seg)
			local c1, c2 = PAL[i1 + 1], PAL[i2 + 1]
			lutR[i + 1] = c1[1] * (1 - frac) + c2[1] * frac
			lutG[i + 1] = c1[2] * (1 - frac) + c2[2] * frac
			lutB[i + 1] = c1[3] * (1 - frac) + c2[3] * frac
