--------------------------------------------------------------------------------
-- Defaults (override per screen via LoadingScreen.new({ ... }))
--------------------------------------------------------------------------------
local DEFAULTS = {
	Title = "Arceus X",
	LaunchText = "Launching",
	LoadingText = "Loading",
	DoneText = "Loaded",

	LaunchTime = 2,        -- seconds spent on "Launching..."
	Cooldown = 3,          -- minimum seconds spent on "Loading..."
	WaitForFinish = false, -- false: auto-finish when the cooldown ends; true: wait for :Finish()
	DoneHold = 0.8,        -- seconds "Loaded" stays up before fading out

	DotInterval = 0.4,     -- seconds per dot step (0 -> 1 -> 2 -> 3 dots)
	GlowCycle = 4,         -- seconds for one full colour swirl (calmer than the source's 2.5)
	GlowBreath = 2.6,      -- seconds for one brightness pulse ("breathing"); a different length than the swirl, so the glow never looks like a short loop
	GlowFps = 30,          -- glow redraw rate. It slows itself down (to 12 at the lowest) when a redraw is slow and speeds up again, so it is safe; lower it if you like
	GlowW = 192,           -- glow resolution in pixels (the source uses 128 x 72, which looks soft when it is stretched over the whole screen)
	GlowH = 108,

	DisplayOrder = 10000,
	Parent = nil,          -- defaults to LocalPlayer.PlayerGui
}

--------------------------------------------------------------------------------
-- Look constants (copied from the source's BackgroundOverlay / Shade / text props)
--------------------------------------------------------------------------------
local BG_TRANSPARENCY = 0.4

-- Glow (source: "INIT BACKGROUND ANIMATION" settings)
local GLOW_W, GLOW_H = 128, 72
local CORNER_RADIUS_RATIO = 0.035
local INNER_GLOW_RADIUS = 255      -- in 128px base units, scaled by min(w,h)/128
local GLOW_EXPONENT = 30
local GLOW_EXTRA_ALPHA = 33
local BACKGROUND_ALPHA = 0.5 * 255
local PULSE_AMPLITUDE = 0.5
local PULSE_FREQUENCY = 1
local ACTIVE_THRESHOLD = 4         -- skip pixels that could never reach 4/255 (invisible)

local PALETTE = {
	{ 255, 0, 0 },
	{ 255, 56, 105 },
	{ 244, 115, 236 },
	{ 21, 166, 254 },
	{ 255, 56, 105 },
	{ 255, 0, 0 },
}
local LUT_SIZE = 512

local TWO_PI = math.pi * 2
local MAX_DOTS = 3

local FADE_IN = Enum.EasingStyle.Sine
local FADE_DIR = Enum.EasingDirection.In

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------
local function tween(inst, info, props)
	local t = TweenService:Create(inst, info, props)
	t:Play()
	return t
end

local function sine(duration, delay)
	return TweenInfo.new(duration, FADE_IN, FADE_DIR, 0, false, delay or 0)
end

-- "Launching" + visible dots + invisible padding dots, so the word never shifts
-- sideways while the dots cycle (RichText <font transparency>).
local function buildStatus(base, dots)
	if dots >= MAX_DOTS then
		return base .. string.rep(".", MAX_DOTS)
	end
	return base
		.. string.rep(".", dots)
		.. '<font transparency="1">'
		.. string.rep(".", MAX_DOTS - dots)
		.. "</font>"
end

local function buildPaletteLUT()
	local r, g, b = table.create(LUT_SIZE + 1), table.create(LUT_SIZE + 1), table.create(LUT_SIZE + 1)
	local n = #PALETTE
	for i = 0, LUT_SIZE do
		local seg = (i / LUT_SIZE) * n
		local i1 = math.floor(seg) % n
		local i2 = (i1 + 1) % n
		local frac = seg - math.floor(seg)
		local c1, c2 = PALETTE[i1 + 1], PALETTE[i2 + 1]
		r[i + 1] = c1[1] * (1 - frac) + c2[1] * frac
		g[i + 1] = c1[2] * (1 - frac) + c2[2] * frac
		b[i + 1] = c1[3] * (1 - frac) + c2[3] * frac
	end
	return r, g, b
end

--------------------------------------------------------------------------------
-- Glow A: EditableImage (matches the source pixel-for-pixel)
--------------------------------------------------------------------------------
local function createEditableGlow(container, glowW, glowH)
	local GLOW_W, GLOW_H = glowW or GLOW_W, glowH or GLOW_H -- this glow's own resolution (the loading / licence screen asks for a finer one)
	local ok, editable = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(GLOW_W, GLOW_H) })
	end)
	if not ok or not editable then
		return nil
	end

	local image = Instance.new("ImageLabel")
	image.Name = "GlowImage"
	image.BackgroundTransparency = 1
	image.ImageTransparency = 1
	image.AnchorPoint = Vector2.new(0.5, 0.5)
	image.Position = UDim2.fromScale(0.5, 0.5)
	image.Size = UDim2.fromScale(1, 1)
	image.ScaleType = Enum.ScaleType.Stretch

	local okSet = pcall(function()
		image.ImageContent = Content.fromObject(editable)
	end)
	if not okSet then
		image:Destroy()
		editable:Destroy()
		return nil
	end
	image.Parent = container

	-- Per-pixel values that never change between frames are computed once.
	local cornerRadius = math.min(GLOW_W, GLOW_H) * CORNER_RADIUS_RATIO
	local glowRadius = INNER_GLOW_RADIUS * (math.min(GLOW_W, GLOW_H) / 128)
	local rx = math.max(GLOW_W / 2 - cornerRadius, 0)
	local ry = math.max(GLOW_H / 2 - cornerRadius, 0)
	local pulseMax = 1 + PULSE_AMPLITUDE * 2.6 -- room for the brighter flash (boost) when the licence is accepted

	local size = Vector2.new(GLOW_W, GLOW_H)
	local buf = buffer.create(GLOW_W * GLOW_H * 4)
	local interior = math.floor(BACKGROUND_ALPHA + 0.5) * 16777216 -- rgb 0, alpha ~50%

	local offsets, bases, angles = {}, {}, {}
	local count = 0

	for y = 0, GLOW_H - 1 do
		for x = 0, GLOW_W - 1 do
			local cx = (x + 0.5) - GLOW_W / 2
			local cy = (y + 0.5) - GLOW_H / 2
			local dx = math.abs(cx) - rx
			local dy = math.abs(cy) - ry
			local outside = math.sqrt(math.max(dx, 0) ^ 2 + math.max(dy, 0) ^ 2)
			local inside = math.min(math.max(dx, dy), 0)
			local d = math.abs(outside + inside - cornerRadius)

			local factor = 0
			if d < glowRadius then
				factor = 1 - d / glowRadius
			end
			local base = factor ^ GLOW_EXPONENT
			local offset = (y * GLOW_W + x) * 4

			buffer.writeu32(buf, offset, interior)
			if base * pulseMax * 255 >= ACTIVE_THRESHOLD then
				count = count + 1
				offsets[count] = offset
				bases[count] = base
				angles[count] = math.atan2(cy, cx) / TWO_PI
			end
		end
	end

	local lutR, lutG, lutB = buildPaletteLUT()
	local floor = math.floor
	local writeu32 = buffer.writeu32

	local glow = {}

	-- phase: 0..1 over one GlowCycle (the colour swirl); breath: 0..1 over one GlowBreath (the brightness pulse); boost: 0..1 = extra pulse strength
	function glow.Update(phase, breath, boost)
		local amp = PULSE_AMPLITUDE * (1 + (boost or 0) * 1.6)
		local pulse = 1 + amp * math.sin(PULSE_FREQUENCY * (breath or phase) * TWO_PI)
		for k = 1, count do
			local fade = bases[k] * pulse
			if fade > 1 then
				fade = 1
			end
			local idx = floor(((angles[k] + phase) % 1) * LUT_SIZE) + 1
			local r = floor(lutR[idx] * fade + 0.5)
			local g = floor(lutG[idx] * fade + 0.5)
			local b = floor(lutB[idx] * fade + 0.5)
			local a = floor(BACKGROUND_ALPHA + fade * GLOW_EXTRA_ALPHA + 0.5)
			if a > 255 then
				a = 255
			end
			writeu32(buf, offsets[k], r + g * 256 + b * 65536 + a * 16777216)
		end
		editable:WritePixelsBuffer(Vector2.zero, size, buf)
	end

	function glow.FadeTo(info, transparency)
		return tween(image, info, { ImageTransparency = transparency })
	end

	function glow.Destroy()
		pcall(function()
			editable:Destroy()
		end)
	end

	glow.Update(0)
	return glow
end

--------------------------------------------------------------------------------
-- Glow B: fallback (no EditableImage) - layered UIStroke + rotating UIGradient
--------------------------------------------------------------------------------
local function createFallbackGlow(container)
	local group = Instance.new("CanvasGroup")
	group.Name = "GlowFallback"
	group.BackgroundTransparency = 1
	group.GroupTransparency = 1
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.Position = UDim2.fromScale(0.5, 0.5)
	group.Size = UDim2.fromScale(1, 1)
	group.Parent = container

	-- the ~50% black vignette fill the source bakes into the image's interior
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Color3.new(0, 0, 0)
	fill.BackgroundTransparency = 0.5
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = group

	local keypoints = {}
	for i, c in ipairs(PALETTE) do
		keypoints[i] = ColorSequenceKeypoint.new((i - 1) / (#PALETTE - 1), Color3.fromRGB(c[1], c[2], c[3]))
	end
	local colors = ColorSequence.new(keypoints)

	local gradients = {}
	-- {stroke thickness (px), stroke transparency}: wide+faint to thin+strong = soft falloff
	for _, layer in ipairs({ { 44, 0.88 }, { 28, 0.74 }, { 16, 0.55 }, { 7, 0.3 } }) do
		local frame = Instance.new("Frame")
		frame.BackgroundTransparency = 1
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.new(1, -layer[1], 1, -layer[1])
		frame.Parent = group

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = layer[1]
		stroke.Transparency = layer[2]
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Parent = frame

		local gradient = Instance.new("UIGradient")
		gradient.Color = colors
		gradient.Parent = stroke
		gradients[#gradients + 1] = gradient
	end

	local glow = {}

	function glow.Update(phase, breath, boost)
		local pulse = 1 + PULSE_AMPLITUDE * (1 + (boost or 0)) * math.sin(PULSE_FREQUENCY * (breath or phase) * TWO_PI)
		for _, gradient in ipairs(gradients) do
			gradient.Rotation = (phase * 360) % 360
		end
		-- gentle brightness pulse via the fill's opacity
		fill.BackgroundTransparency = math.clamp(1 - (BACKGROUND_ALPHA / 255) * (0.9 + 0.1 * pulse), 0, 1)
	end

	function glow.FadeTo(info, transparency)
		return tween(group, info, { GroupTransparency = transparency })
	end

	function glow.Destroy() end

	glow.Update(0)
	return glow
end

--------------------------------------------------------------------------------
-- Bottom red shade (source "Shade" component: Frame + UIGradient)
--------------------------------------------------------------------------------
local function createShade(name, parent, position, rotation)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(0.5, 0.5)
	frame.Position = position
	frame.Parent = parent

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1, 0),
		NumberSequenceKeypoint.new(0.2, 1, 0),
		NumberSequenceKeypoint.new(1, 0.35, 0),
	})
	gradient.Parent = frame

	return frame
end

--------------------------------------------------------------------------------
-- LoadingScreen
--------------------------------------------------------------------------------
local LoadingScreen = {}
LoadingScreen.__index = LoadingScreen

function LoadingScreen.new(config)
	local self = setmetatable({}, LoadingScreen)

	local cfg = {}
	for k, v in pairs(DEFAULTS) do
		cfg[k] = v
	end
	for k, v in pairs(config or {}) do
		cfg[k] = v
	end
	self.Config = cfg

	self._started = false
	self._destroyed = false
	self._finishRequested = false
	self._dotsActive = false
	self._dotStep = -1
	self._dotEpoch = 0
	self._statusBase = ""
	self._cooldownStart = nil

	local finished = Instance.new("BindableEvent")
	self._finishedEvent = finished
	self.Finished = finished.Event

	-- ScreenGui ---------------------------------------------------------------
	local gui = Instance.new("ScreenGui")
	gui.Name = "ArcyHomeUiLoading"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = cfg.DisplayOrder
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None -- cover notch / cutout areas too
	end)
	self._gui = gui

	-- Background (ImageButton so it also sinks input while loading) -----------
	local background = Instance.new("ImageButton")
	background.Name = "Background"
	background.AutoButtonColor = false
	background.Active = true
	background.BorderSizePixel = 0
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BackgroundTransparency = 1
	background.AnchorPoint = Vector2.new(0.5, 0.5)
	background.Position = UDim2.fromScale(0.5, 0.5)
	background.Size = UDim2.fromScale(1, 1)
	background.Parent = gui
	self._background = background

	local overlay = Instance.new("Frame")
	overlay.Name = "BackgroundOverlay"
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.AnchorPoint = Vector2.new(0.5, 0.5)
	overlay.Position = UDim2.fromScale(0.5, 0.5)
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.Parent = background

	-- Glow ----------------------------------------------------------------------
	self._glow = createEditableGlow(overlay, cfg.GlowW, cfg.GlowH) or createFallbackGlow(overlay)

	-- Shades --------------------------------------------------------------------
	self._shades = {
		createShade("BottomShadeLeft", overlay, UDim2.fromScale(0, 0.5), 80),
		createShade("BottomShadeRight", overlay, UDim2.fromScale(0.5, 0.5), 100),
	}

	-- Text ----------------------------------------------------------------------
	local title = Instance.new("TextLabel")
	title.Name = "ShadeTitle"
	title.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.85)
	title.Size = UDim2.fromScale(0.25, 0.075)
	title.BackgroundTransparency = 1
	title.TextTransparency = 1
	title.TextScaled = true
	title.Text = cfg.Title
	title.Parent = overlay
	self._title = title

	local status = Instance.new("TextLabel")
	status.Name = "ShadeText"
	status.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	status.TextColor3 = Color3.fromRGB(220, 220, 220)
	status.AnchorPoint = Vector2.new(0.5, 0.5)
	status.Position = UDim2.fromScale(0.5, 0.915)
	status.Size = UDim2.fromScale(0.25, 0.035)
	status.BackgroundTransparency = 1
	status.TextTransparency = 1
	status.TextScaled = true
	status.RichText = true
	status.Text = ""
	status.Parent = overlay
	self._status = status

	-- Heartbeat: glow redraw + dot cycle (both time-based, so they stay smooth at any FPS)
	local baseStep = 1 / math.max(cfg.GlowFps, 1)
	local glowStep = baseStep
	local t0 = os.clock()
	local lastGlow = 0
	local lastBeat = t0
	self._connection = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local dt = now - lastBeat
		lastBeat = now

		-- the "accepted" flash fades back to the normal pulse
		local boost = self._glowBoost or 0
		if boost > 0 then
			boost = math.max(0, boost - dt * 0.9)
			self._glowBoost = boost
		end

		if now - lastGlow >= glowStep - 0.004 then
			lastGlow = now
			local clock = now - t0
			self._glow.Update((clock % cfg.GlowCycle) / cfg.GlowCycle, (clock % cfg.GlowBreath) / cfg.GlowBreath, boost)
			-- self-tuning redraw rate: a slow redraw (weak phone) lowers the rate, a fast one brings it back up
			local cost = os.clock() - now
			if cost > 0.012 then
				glowStep = math.min(glowStep * 1.3, 1 / 12)
			elseif cost < 0.005 and glowStep > baseStep then
				glowStep = math.max(baseStep, glowStep * 0.92)
			end
		end

		-- the Arceus art floats gently (licence screen only)
		local art = self._art
		if art and art.Parent then
			art.Position = UDim2.fromScale(0.5, 1 + math.sin((now - t0) * 1.3) * 0.008)
		end

		if self._dotsActive then
			local step = math.floor((now - self._dotEpoch) / cfg.DotInterval) % (MAX_DOTS + 1)
			if step ~= self._dotStep then
				self._dotStep = step
				status.Text = buildStatus(self._statusBase, step)
			end
		end
	end)

	gui.Parent = cfg.Parent or Players.LocalPlayer:WaitForChild("PlayerGui")
	return self
end

-- Switch the status line. animated = true starts the dot cycle from 0 dots.
function LoadingScreen:_setStatus(base, animated)
	self._statusBase = base
	if animated then
		self._dotEpoch = os.clock()
		self._dotStep = 0
		self._dotsActive = true
		self._status.Text = buildStatus(base, 0)
	else
		self._dotsActive = false
		self._status.Text = base
	end
end

function LoadingScreen:Start()
	if self._started or self._destroyed then
		return self
	end
	self._started = true
	task.spawn(function()
		self:_run()
	end)
	return self
end

-- Ask the screen to finish. Honoured only after the cooldown has elapsed.
function LoadingScreen:Finish()
	self._finishRequested = true
	return self
end

function LoadingScreen:GetCooldownRemaining()
	if not self._cooldownStart then
		return self.Config.Cooldown
	end
	return math.max(0, self.Config.Cooldown - (os.clock() - self._cooldownStart))
end

function LoadingScreen:IsCoolingDown()
	return self:GetCooldownRemaining() > 0
end

function LoadingScreen:_run()
	local cfg = self.Config
	local function alive()
		return not self._destroyed
	end

	-- 1) Intro: backdrop, glow, bottom shade fade in
	tween(self._background, sine(1.5), { BackgroundTransparency = BG_TRANSPARENCY })
	self._glow.FadeTo(sine(1, 0.3), 0)
	for _, shade in ipairs(self._shades) do
		tween(shade, sine(1, 0.6), { BackgroundTransparency = 0 })
	end
	task.wait(1.2)
	if not alive() then
		return
	end

	-- 1b) License screen: shown first, on the same glow, before "Launching..." / "Loading..." (see LICENSE SCREEN below)
	if cfg.License then
		self:_runLicense()
		if not alive() then
			return
		end
	end

	if cfg.SkipLoading then
		-- Settings > Disable Intro: no "Launching / Loading" text, the cooldown counts as done so the UI is built right away
		self._cooldownStart = os.clock() - cfg.Cooldown
	else
		-- 2) "Launching..."
		self:_setStatus(cfg.LaunchText, true)
		tween(self._title, sine(1), { TextTransparency = 0 })
		tween(self._status, sine(1), { TextTransparency = 0 })
		task.wait(cfg.LaunchTime)
		if not alive() then
			return
		end

		-- 3) "Loading..." + cooldown
		self:_setStatus(cfg.LoadingText, true)
		self._cooldownStart = os.clock()
		while alive() do
			local cooled = (os.clock() - self._cooldownStart) >= cfg.Cooldown
			if cooled and (not cfg.WaitForFinish or self._finishRequested) then
				break
			end
			task.wait(0.05)
		end
		if not alive() then
			return
		end

		-- 4) "Loaded"
		self:_setStatus(cfg.DoneText, false)
		task.wait(cfg.DoneHold)
		if not alive() then
			return
		end
	end

	-- 5) Fade everything out, then clean up
	local out = sine(1)
	tween(self._background, out, { BackgroundTransparency = 1 })
	self._glow.FadeTo(out, 1)
	tween(self._title, out, { TextTransparency = 1 })
	tween(self._status, out, { TextTransparency = 1 })
	for _, shade in ipairs(self._shades) do
		tween(shade, out, { BackgroundTransparency = 1 })
	end
	task.wait(1.1)

	self:Destroy()
end

function LoadingScreen:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true

	if self._connection then
		self._connection:Disconnect()
	end
	if self._glow then
		self._glow.Destroy()
	end
	if self._gui then
		self._gui:Destroy()
	end
	self._finishedEvent:Fire()
end

