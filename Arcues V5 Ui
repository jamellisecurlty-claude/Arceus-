local function new(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(scale)
	return new("UICorner", { CornerRadius = UDim.new(scale, 0) })
end

local function ratio(r)
	return new("UIAspectRatioConstraint", { AspectRatio = r })
end

local function label(props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.TextColor3 = props.TextColor3 or TEXT
	props.TextScaled = true
	return new("TextLabel", props)
end

local function tween(inst, time, goal, style, dir)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		goal
	)
	tw:Play()
	return tw
end

local function isTap(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function pressFx(button)
	local scale = new("UIScale", { Parent = button })
	button.InputBegan:Connect(function(input)
		if isTap(input) then
			tween(scale, 0.08, { Scale = 0.9 })
		end
	end)
	button.InputEnded:Connect(function(input)
		if isTap(input) then
			tween(scale, 0.12, { Scale = 1 })
		end
	end)
end

local function dim(c)
	-- source: disabled color = rgb * 2/5
	return Color3.fromRGB(c.R * 255 * 0.4, c.G * 255 * 0.4, c.B * 255 * 0.4)
end

