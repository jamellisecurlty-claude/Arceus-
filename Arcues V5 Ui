-- the Arceus Hub (switches, buttons, + / -, the line under a title, the open tab's tile, the Back pill) uses a few shades of the primary colour
local function themeShades(name, c)
	if name == "Red" then
		return { -- the numbers sampled from the reference screenshots
			bright = Color3.fromRGB(254, 0, 0),
			tile = Color3.fromRGB(145, 12, 16),
			line = Color3.fromRGB(225, 12, 22),
			press = Color3.fromRGB(190, 0, 0),
			rim = Color3.fromRGB(150, 16, 16),
			back = Color3.fromRGB(150, 9, 7),
			close = Color3.fromRGB(255, 45, 45), -- the red close button on top of the window (source: CloseButton has Colors_Primary)
			exit = Color3.fromRGB(235, 28, 36), -- the red X of an extension window
		}
	end
	local h, s = c:ToHSV()
	s = math.clamp(s, 0.7, 1)
	return {
		bright = Color3.fromHSV(h, s, 1),
		tile = Color3.fromHSV(h, s * 0.92, 0.57),
		line = Color3.fromHSV(h, s * 0.95, 0.88),
		press = Color3.fromHSV(h, s, 0.75),
		rim = Color3.fromHSV(h, s * 0.9, 0.59),
		back = Color3.fromHSV(h, s * 0.94, 0.59),
		close = Color3.fromHSV(h, s * 0.82, 1), -- same relation as Red (255, 45, 45) to Red
		exit = Color3.fromHSV(h, s * 0.88, 0.92),
	}
end

local function themeState(entry)
	return { name = entry.Name, color = entry.Color, dim = themeDim(entry.Color), sh = themeShades(entry.Name, entry.Color) }
