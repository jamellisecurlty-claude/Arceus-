		local rowOf = {} -- [item] = { slot = ..., row = ... } for the rows that are on screen

		----------------------------------------------------------------
		-- ANIMATION HELPERS (used by the tiles, rows, orb and page changes below)
		----------------------------------------------------------------
		function FX.play(inst, time, goal, style, dir, delay)
			local tw = TweenService:Create(
				inst,
				TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out, 0, false, delay or 0),
				goal
			)
			tw:Play()
			return tw
		end

		-- soft round glow made of stacked circles: needs no image id, so it always shows and it can take any colour
		function FX.glow(parent, name, size, z)
			local holder = new("Frame", {
				Name = name,
				AnchorPoint = CENTER,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(size, size),
				BackgroundTransparency = 1,
				ZIndex = z,
				Parent = parent,
			}, { new("UIScale", { Name = "Grow" }) })
			local layers = {}
			for i = 1, 9 do
				local s = 1 - (i - 1) * 0.09
				layers[i] = new("Frame", {
					Name = "Layer" .. i,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(s, s),
					BackgroundColor3 = WHITE,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = z,
					Parent = holder,
				}, { corner(0.5) })
			end
			return { holder = holder, layers = layers, token = 0 }
		end

		-- strength 0..1 (0 = invisible). The circles add up toward the middle, so the glow is brightest in the centre.
		function FX.setGlow(g, color, strength)
			local transparency = 1 - math.clamp(strength, 0, 1) * 0.07
			for _, layer in ipairs(g.layers) do
				if color then
					layer.BackgroundColor3 = color
				end
				layer.BackgroundTransparency = transparency
			end
		end

		-- one glow flash: it grows while it fades out
		function FX.burst(g, color, peak)
			g.token = g.token + 1
			local mine = g.token
			local grow = g.holder:FindFirstChild("Grow")
			if grow then
				grow.Scale = 0.75
				FX.play(grow, 0.45, { Scale = 1 })
			end
			local value = Instance.new("NumberValue")
			value.Value = peak or 0.6
			FX.setGlow(g, color, value.Value)
			local conn = value.Changed:Connect(function(v)
				if g.token == mine then
					FX.setGlow(g, nil, v)
				end
			end)
			FX.play(value, 0.65, { Value = 0 }, Enum.EasingStyle.Quad).Completed:Once(function()
				conn:Disconnect()
				value:Destroy()
				if g.token == mine then
					FX.setGlow(g, nil, 0)
				end
			end)
		end

		-- quick left-right wobble of a GuiObject (base = its resting Position)
		function FX.shake(inst, base, power)
			task.spawn(function()
				for i = 1, 5 do
					if not alive then
						return
					end
					local push = power * (1 - (i - 1) / 5) * ((i % 2 == 0) and 1 or -1)
					local goal = { Position = UDim2.new(base.X.Scale, base.X.Offset + push, base.Y.Scale, base.Y.Offset) }
					FX.play(inst, 0.05, goal, Enum.EasingStyle.Sine).Completed:Wait()
				end
				FX.play(inst, 0.06, { Position = base }, Enum.EasingStyle.Sine)
			end)
		end

		-- little twist-and-settle of an icon (the trash can)
		function FX.wiggle(inst)
			task.spawn(function()
