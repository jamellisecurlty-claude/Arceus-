-- true when the executor has setfpscap (the cap itself is applied by the executor, Roblox has no such function)
function Theme.applyFps(value)
	local applied = false
	pcall(function()
		local fn = setfpscap or set_fps_cap
		if not fn and getgenv then
			local env = getgenv()
			fn = env.setfpscap or env.set_fps_cap
		end
		if fn then
			fn(value)
			applied = true
		end
	end)
	return applied
end

function Theme.onPref(name, fn)
	local list = Theme.prefListeners[name]
	if not list then
		list = {}
		Theme.prefListeners[name] = list
	end
	list[#list + 1] = fn
end

function Theme.setPref(name, value)
	if Theme.prefs[name] == value then
		return
	end
	Theme.prefs[name] = value
	Theme.data[name] = value
	Theme.save()
	for _, fn in ipairs(Theme.prefListeners[name] or {}) do
		pcall(fn, value)
	end
	callHook("OnSetting", name, value)
end

Theme.onPref("FpsCap", Theme.applyFps)
