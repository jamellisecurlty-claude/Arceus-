		----------------------------------------------------------------
		-- FIND SERVER (the Server view of the pill's dropdown)
		-- Cards: the game's picture, "N Plrs" and the game's name. Popular / Trending and the search box decide what is listed; a tap asks
		-- "Confirm to join the server" and then teleports you there (Hooks.OnServerSideGame is called first - return true from it to join your own way).
		-- The list comes from Hooks.GetServerSideGames(page, sort, search). While that hook returns nothing the built-in finder fills it from Roblox's
		-- web api, through the same request() / HttpGet as Cloud Scripts:
		--   * no search: Popular / Trending = the rows of the same name on Roblox's Discover page (explore-api), else the old sort list (games/list)
		--   * search:    omni-search, else the old keyword list. Popular puts the busiest games first, Trending keeps Roblox's own order
		----------------------------------------------------------------
		local serverMemo = {}
		local serverTokens = {} -- page number -> the token Roblox gave for that page
		local serverSession = HttpService:GenerateGUID(false)
		local serverSorts = {} -- the sort lists, downloaded once
		resetServerMemo = function()
			serverMemo = {}
			serverTokens = {}
			serverSession = HttpService:GenerateGUID(false)
		end

		local DEMO_PLAYERS = { 66, 48, 31, 27, 22, 18, 12, 9, 4 }
		local SERVER_PER_PAGE = 24
		local SORT_WORDS = { -- words in a sort's name that mean Popular / Trending
			popular = { "popular", "top playing", "playing now", "most played" },
			trending = { "trend", "up-and-coming", "up and coming", "rising" },
		}

		local function fmtId(n)
			return string.format("%.0f", n)
		end

		-- the number of players of a game row, whatever name Roblox's lists use for it (number or numeric text). nil = the row has none
		local function playersOf(item)
			for _, key in ipairs({ "playerCount", "playing", "players", "plrs", "ccu", "concurrentPlayers", "activePlayers" }) do
				local n = tonumber(item[key])
				if n and n == n and n >= 0 and n < 1e12 then
					return math.floor(n + 0.5)
				end
			end
			return nil
		end

		-- "N Plrs" text: exact up to 9999 (like the source), then 12.3K / 1.2M so a busy game never overflows its card
		local function fmtPlayers(n)
			n = math.max(0, math.floor((tonumber(n) or 0) + 0.5))
			if n < 10000 then
				return tostring(n)
			end
			local value, suffix
			if n < 999950 then
				value, suffix = math.floor(n / 100 + 0.5) / 10, "K"
			else
				value, suffix = math.floor(n / 100000 + 0.5) / 10, "M"
			end
			return (value % 1 == 0 and string.format("%d", value) or string.format("%.1f", value)) .. suffix
		end

		local function getJson(url)
			local body, reason = httpGet(url)
			if not body then
				return nil, reason or "no answer"
			end
			local ok, data = pcall(function()
				return HttpService:JSONDecode(body)
			end)
			if ok and type(data) == "table" then
				return data
			end
			return nil, "Roblox answered with something unexpected"
		end

		-- the sort whose name means Popular / Trending (allowFirst: use the first sort when no name matches)
		local function pickSort(sorts, key, allowFirst)
			for _, word in ipairs(SORT_WORDS[key] or {}) do
				for _, s in ipairs(sorts) do
					if type(s) == "table" then
						local name = string.lower(tostring(s.sortDisplayName or s.displayName or s.name or s.sortId or ""))
						if string.find(name, word, 1, true) then
							return s
						end
					end
				end
			end
			if allowFirst then
				for _, s in ipairs(sorts) do
					if type(s) == "table" then
						return s
					end
				end
			end
			return nil
		end

		-- game rows of any Roblox answer -> { placeId, universeId, name, plrs }
		local function gamesFrom(items)
			local out = {}
			for _, item in ipairs(items or {}) do
				if type(item) == "table" and (item.contentType == nil or item.contentType == "Game") then
					local placeId = tonumber(item.rootPlaceId or item.placeId)
					local universeId = tonumber(item.universeId or item.contentId)
					if placeId or universeId then
						local count = playersOf(item)
						out[#out + 1] = {
							placeId = placeId,
							universeId = universeId,
							name = type(item.name) == "string" and item.name or nil,
							plrs = count or 0,
							plrsMissing = count == nil, -- the list did not say: asked from Roblox's game api below (fillPlayers)
						}
					end
				end
			end
			return out
		end

		-- The live number of players, the same one Roblox shows on the game's page (games.roblox.com/v1/games -> "playing"), for a whole
		-- page in a few requests. Roblox's lists are cached and some of them leave the number out, which showed up as a wrong / 0 count.
		-- onlyMissing = only rows that came without a number (your own Hooks list). Nothing here can break the list: on any problem the
		-- numbers the list came with stay.
		local function fillPlayers(list, onlyMissing)
			local ids, byId = {}, {}
			for _, g in ipairs(list) do
				if g.universeId and (not onlyMissing or g.plrsMissing) then
					local key = fmtId(g.universeId)
					if not byId[key] then
						byId[key] = {}
						ids[#ids + 1] = key
					end
					table.insert(byId[key], g)
				end
			end
			for first = 1, #ids, 50 do
				local chunk = {}
				for i = first, math.min(first + 49, #ids) do
					chunk[#chunk + 1] = ids[i]
				end
				local okReq, data = pcall(getJson, "https://games.roblox.com/v1/games?universeIds=" .. table.concat(chunk, ","))
				if okReq and type(data) == "table" and type(data.data) == "table" then
					for _, row in ipairs(data.data) do
						if type(row) == "table" then
							local live = tonumber(row.playing)
							local owners = live and live >= 0 and byId[fmtId(tonumber(row.id) or 0)]
							if owners then
								for _, g in ipairs(owners) do
									g.plrs = math.floor(live + 0.5)
									g.plrsMissing = false
								end
							end
						end
					end
				end
			end
		end

		local function nextTokenOf(data)
			if type(data.nextPageToken) == "string" and data.nextPageToken ~= "" then
				return data.nextPageToken
			end
			return nil
		end

		-- the built-in finder. Returns games, more  or  nil, reason
		local function findServers(sortKey, query, pageNo, tokens, session)
			local reasons = {}
			local function fail(reason)
				reasons[#reasons + 1] = tostring(reason)
			end
			local startRow = (pageNo - 1) * SERVER_PER_PAGE
			local pageToken = HttpService:UrlEncode(tokens[pageNo] or "")

			if query ~= "" then
				-- the search box: omni-search first, then the old keyword list
				local data, reason = getJson(
					"https://apis.roblox.com/search-api/omni-search?searchQuery=" .. HttpService:UrlEncode(query)
						.. "&pageToken=" .. pageToken .. "&sessionId=" .. session .. "&pageType=all"
				)
				if data and type(data.searchResults) == "table" then
					local list = {}
					for _, group in ipairs(data.searchResults) do
						if type(group) == "table" and type(group.contents) == "table" then
							for _, g in ipairs(gamesFrom(group.contents)) do
								list[#list + 1] = g
							end
						end
					end
					local following = nextTokenOf(data)
					if following then
						tokens[pageNo + 1] = following
					end
					return list, following ~= nil
				end
				fail(reason or "omni-search answered with something unexpected")

				local data2, reason2 = getJson(
					"https://games.roblox.com/v1/games/list?model.keyword=" .. HttpService:UrlEncode(query)
						.. "&model.startRows=" .. tostring(startRow) .. "&model.maxRows=" .. tostring(SERVER_PER_PAGE)
				)
				if data2 and type(data2.games) == "table" then
					return gamesFrom(data2.games), #data2.games >= SERVER_PER_PAGE
				end
				fail(reason2 or "the keyword list answered with something unexpected")
				return nil, table.concat(reasons, " / ")
			end

			-- Popular / Trending: the rows of Roblox's Discover page first ...
			local explore = serverSorts.explore
			if not explore then
				local data, reason = getJson("https://apis.roblox.com/explore-api/v1/get-sorts?sessionId=" .. session .. "&device=phone&country=all")
				if data and type(data.sorts) == "table" then
					explore = data.sorts
					serverSorts.explore = explore
				else
					fail(reason or "the Discover rows answered with something unexpected")
				end
			end
			if explore then
				local sort = pickSort(explore, sortKey, false)
				local sortId = sort and (sort.sortId or sort.id)
				if sortId then
					local data, reason = getJson(
						"https://apis.roblox.com/explore-api/v1/get-sort-content?sessionId=" .. session
							.. "&sortId=" .. HttpService:UrlEncode(tostring(sortId)) .. "&pageToken=" .. pageToken .. "&device=phone&country=all"
					)
					if data and type(data.games) == "table" then
						local following = nextTokenOf(data)
						if following then
							tokens[pageNo + 1] = following
						end
						return gamesFrom(data.games), following ~= nil
					end
					fail(reason or "the Discover row answered with something unexpected")
				else
					fail("no " .. sortKey .. " row on the Discover page")
				end
			end

			-- ... then the old sort list
			local legacy = serverSorts.legacy
			if not legacy then
				local data, reason = getJson("https://games.roblox.com/v1/games/sorts?model.gameSortsContext=GamesDefaultSorts")
				if data and type(data.sorts) == "table" then
					legacy = data.sorts
					serverSorts.legacy = legacy
				else
					fail(reason or "the sort list answered with something unexpected")
				end
			end
			if legacy then
				local sort = pickSort(legacy, sortKey, sortKey == "popular")
				if sort and sort.token then
					local data, reason = getJson(
						"https://games.roblox.com/v1/games/list?model.sortToken=" .. HttpService:UrlEncode(tostring(sort.token))
							.. "&model.startRows=" .. tostring(startRow) .. "&model.maxRows=" .. tostring(SERVER_PER_PAGE)
					)
					if data and type(data.games) == "table" then
						return gamesFrom(data.games), #data.games >= SERVER_PER_PAGE
					end
					fail(reason or "the game list answered with something unexpected")
				else
					fail("no " .. sortKey .. " sort in the game list")
				end
			end
			return nil, table.concat(reasons, " / ")
		end

		-- one answer per page, shared by the carousel and the grid (the second one waits for the first)
		serverPage = function(pageNo)
			local entry = serverMemo[pageNo]
			if entry then
				while not entry.done and alive do
					task.wait(0.05)
				end
				return entry.list, entry.more, entry.err
			end
			entry = { done = false, list = {}, more = false }
			serverMemo[pageNo] = entry

			local sortKey, query = serverSort, serverSearch
			local okHook, games, more = callHook("GetServerSideGames", pageNo, sortKey, query)
			local list = {}

			local function add(g, raw)
				local image = g.image
				if type(image) == "number" then
					image = "rbxassetid://" .. fmtId(image)
				end
				if type(image) ~= "string" and g.universeId then
					image = "rbxthumb://type=GameIcon&id=" .. fmtId(g.universeId) .. "&w=256&h=256" -- the game's own icon
				end
				local id = g.placeId or g.universeId
				list[#list + 1] = {
					slug = "srv_" .. (id and fmtId(id) or tostring(pageNo * 1000 + #list + 1)),
					id = id,
					name = g.name,
					plrs = g.plrs or 0,
					image = type(image) == "string" and image or nil,
					raw = raw or g, -- what Hooks.OnServerSideGame receives
				}
			end

			if okHook and type(games) == "table" then
				local rows = {}
				for _, raw in ipairs(games) do
					if type(raw) == "table" then
						local count = playersOf(raw)
						rows[#rows + 1] = {
							g = {
								placeId = tonumber(raw.placeId or raw.id),
								universeId = tonumber(raw.universeId),
								name = type(raw.name) == "string" and raw.name or nil,
								plrs = count or 0,
								plrsMissing = count == nil,
								image = raw.image,
							},
							raw = raw,
						}
					end
				end
				local gs = {}
				for _, row in ipairs(rows) do
					gs[#gs + 1] = row.g
				end
				fillPlayers(gs, true) -- only the rows your hook gave without a number
				for _, row in ipairs(rows) do
					add(row.g, row.raw)
				end
				entry.more = more == true and #list > 0
			else
				local found, moreOrReason = findServers(sortKey, query, pageNo, serverTokens, serverSession)
				if found then
					fillPlayers(found) -- the real number of players before the order and the cards use it
					if query ~= "" and sortKey == "popular" then
						for i, g in ipairs(found) do
							g.order = i
						end
						table.sort(found, function(a, b)
							if a.plrs ~= b.plrs then
								return a.plrs > b.plrs
							end
							return a.order < b.order -- equal numbers keep Roblox's own order
						end)
					end
					for _, g in ipairs(found) do
						add(g)
					end
					entry.more = moreOrReason == true and #list > 0
				else
					entry.err = tostring(moreOrReason or "no answer")
					logWarn(
						"The server list could not load: " .. entry.err,
						"no internet, Roblox's web api is down / rate limiting, or this executor has no request() / game:HttpGet",
						"tap the grey message on the page to try again, or fill in Hooks.GetServerSideGames with your own list"
					)
					if SERVER_SIDE_DEMO and okHook and pageNo == 1 then
						entry.err = nil
						for i, plrs in ipairs(DEMO_PLAYERS) do
							list[#list + 1] = { slug = "srv_demo" .. i, plrs = plrs, demo = true, raw = { demo = true, plrs = plrs } }
						end
					end
				end
			end
			entry.list = list
			entry.done = true
			return entry.list, entry.more, entry.err
		end

		-- a game name that fits under its card's title
		local function shortName(name)
			if type(name) ~= "string" or name == "" then
				return nil
			end
			local len = utf8.len(name)
			if len and len > 22 then
				local cut = utf8.offset(name, 22)
				if cut then
					return string.sub(name, 1, cut - 1) .. "..."
				end
			end
			return name
		end

		-- join: Hooks.OnServerSideGame first (return true = you did it), else teleport to the game / server
		local function joinServer(info)
			info = type(info) == "table" and info or {}
			local called, handled = callHook("OnServerSideGame", info)
			if called and handled == true then
				return
			end
			if info.demo then
				if showToast then
					showToast({ style = "info", title = "Server", text = "That is a sample card - there is no server to join." })
				end
				return
			end
			task.spawn(function()
				local placeId = tonumber(info.placeId or info.id)
				local universeId = tonumber(info.universeId)
				if not placeId and universeId then -- a search result only gave the universe: ask Roblox for its start place
					local data = getJson("https://games.roblox.com/v1/games?universeIds=" .. fmtId(universeId))
					local first = data and type(data.data) == "table" and data.data[1]
					placeId = first and tonumber(first.rootPlaceId) or nil
				end
				if not placeId then
					logWarn(
						"Could not join: no place id for this server",
						"the card has no placeId (the list you return from Hooks.GetServerSideGames needs placeId or universeId)",
						"add placeId = 123 to the game table"
					)
					if showToast then
						showToast({ style = "error", title = "Join Server", text = "Could not find that server." })
					end
					return
				end
				if showToast then
					showToast({ style = "info", title = "Join Server", text = "Joining..." })
				end
				local ok, err = pcall(function()
					local TeleportService = game:GetService("TeleportService")
					if info.jobId then
						TeleportService:TeleportToPlaceInstance(placeId, tostring(info.jobId), Players.LocalPlayer)
					else
						TeleportService:Teleport(placeId, Players.LocalPlayer)
					end
				end)
				if not ok then
					logWarn(
						"Could not join the server: " .. tostring(err),
						"the game is private / unavailable, or teleporting is blocked here",
						"try another server"
					)
					if showToast then
						showToast({ style = "error", title = "Join Server", text = "Could not join: " .. string.sub(tostring(err), 1, 100) })
					end
				end
			end)
		end

