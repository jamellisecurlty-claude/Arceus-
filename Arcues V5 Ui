				local overflow = nick.AbsoluteSize.X - nameBox.AbsoluteSize.X
				while alive and id == run and overflow > 0 and nick.Parent do
					task.wait(1.2)
					if not alive or id ~= run then break end
					local dur = overflow / 45 + 0.3
					tween(nick, dur, { Position = UDim2.new(0, -overflow - 6, 0.5, 0) }, Enum.EasingStyle.Linear).Completed:Wait()
					task.wait(0.8)
					if not alive or id ~= run then break end
					tween(nick, dur, { Position = UDim2.new(0, 0, 0.5, 0) }, Enum.EasingStyle.Linear).Completed:Wait()
				end
			end)
		end
		nameBox:GetPropertyChangedSignal("AbsoluteSize"):Connect(restart)
