-- DRAG THE WINDOW. Source: MainFrame:SetDraggable(true) + utils.AddSlimeEffect on the same frame.
-- You can grab the window by the top strip OR by any empty part of it (buttons, sliders, cards and scroll lists keep their own
-- taps because they sit on top and take the input first). The window follows your finger 1:1 and its size never changes;
-- the "slime" part (everything inside lags behind and springs back) is the DRAG EFFECT block at the bottom of the script.
-- Full screen = nothing to move (source: main:SetDraggable(not isFull)).
do
	local handle = new("Frame", {
		Name = "DragHandle",
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 0.12), -- the buttons (ZIndex 50+) sit above it
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 40,
		Parent = main,
	})
	local dragInput, startPos, startMouse
	local pressConn -- watches the pressed input itself (source: input.Changed -> End), so letting go outside the window can never leave it stuck to the finger / mouse

	local function endDrag()
		dragInput = nil
		if pressConn then
			pressConn:Disconnect()
			pressConn = nil
		end
	end

	local function beginDrag(input)
		if isFull or dragInput or not isTap(input) then
			return -- nothing to move in full screen / already dragging
		end
		dragInput = input
		startMouse = input.Position
		startPos = main.Position
		pressConn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
				endDrag()
			end
		end)
	end

	handle.InputBegan:Connect(beginDrag)
	main.InputBegan:Connect(beginDrag) -- the rest of the window (source: frame.InputBegan on MainFrame)

	keepConn(UserInputService.InputChanged:Connect(function(input)
		if dragInput and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
			if isFull then
				endDrag() -- the window went full screen while the finger was down: nothing left to move
				return
			end
			local d = input.Position - startMouse
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	keepConn(UserInputService.InputEnded:Connect(function(input)
		if dragInput and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
			endDrag()
		end
	end))
end

----------------------------------------------------------------
-- FLOATING BUTTON
-- Only exists after the red close button. Tap = reopen the window, hold = fan out every tab icon
-- (hold again = tuck them back in), drag = move it anywhere.
--
-- LOOK: the Arcy deer floats on the Glowing Effect texture (FLOAT_GLOW_ID in LOOK SETTINGS). The old red disc / background,
-- the two halos and every stroke are gone. Every tab icon (Settings too) has the same glow behind it. The glow keeps the
-- colors of its own texture, so every animation (breathing, hold wind-up, flare, drag lift) is in that same color.
-- Set FLOAT_GLOW_TINT in LOOK SETTINGS if you ever want to recolor it.
----------------------------------------------------------------
do
	local LOGO_SIZE, SUB_SIZE = 0.62, 0.48 -- deer / tab icon size (in button sizes)
	local HALO_MAIN, HALO_SUB = 3.2, 3.0 -- glow size: behind the deer (button sizes) / behind each tab icon (tab icon sizes)
	local OPEN_TIME, CLOSE_TIME, STAGGER = 0.6, 0.32, 0.45 -- seconds to fan out / tuck in, and how much the icons follow each other
	local SPIN = math.rad(-220) -- the icons swirl in from this angle while they fan out
	local DRAG_THRESHOLD = 10 -- pixels of finger travel before a press counts as a drag

	local floatShown = false
	local press = nil -- the finger / mouse press currently on the button
	local radialT, radialGoal = 0, 0 -- tab icon fan: 0 = tucked in, 1 = fully out
	local charge, kick, lift = 0, 0, 0 -- hold wind-up, flare when the icons fan out, lift while dragging

	local function easeOutBack(x)
		local c1 = 1.3
		return 1 + (c1 + 1) * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
	end

	local function easeOutExpo(x)
		return x >= 1 and 1 or 1 - 2 ^ (-10 * x)
	end

	----------------------------------------------------------------
	-- glow builder (the Glowing Effect texture; pulsed from the animation loop below)
	----------------------------------------------------------------
	local function glowLabel(name, size, z, parent)
		local glow = new("ImageLabel", {
			Name = name,
			Image = FLOAT_GLOW_ID,
			ImageTransparency = 0.35,
			ScaleType = Enum.ScaleType.Stretch,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(size, size),
			BackgroundTransparency = 1,
			ZIndex = z,
			Parent = parent,
		})
		if FLOAT_GLOW_TINT then
			glow.ImageColor3 = FLOAT_GLOW_TINT
		end
		return glow
	end

	----------------------------------------------------------------
	-- main button
	----------------------------------------------------------------
	local float = new("Frame", {
		Name = "FloatingButton",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = FLOAT_START,
		Size = UDim2.fromScale(FLOAT_SIZE, FLOAT_SIZE),
		BackgroundTransparency = 1,
		Visible = false, -- shown only after the red close button
		ZIndex = 200,
		Parent = gui,
	}, {
		ratio(1), -- always square, in landscape and portrait
		new("UIScale", { Name = "PopScale", Scale = 0 }), -- pop in / suck back in (the tab icons are children, so they follow)
	})
	local floatPop = float.PopScale

	local glow = glowLabel("Glow", HALO_MAIN, 1, float)

	local logo = new("ImageLabel", {
		Name = "Logo",
		Image = FLOAT_LOGO,
		ImageTransparency = 0.05,
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(LOGO_SIZE, LOGO_SIZE),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = float,
	}, { new("UIScale", { Name = "Squash" }) })
	local logoScale = logo.Squash

	-- invisible hit area on top: this is what you tap, hold and drag (a bit bigger than the small button so it is easy to hit)
	local hit = new("ImageButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.4, 1.4),
		ZIndex = 20,
		Parent = float,
	})

	-- one icon per sidebar tab, each with its own pulsing glow (Settings included)
	local subs = {}
	for i, tab in ipairs(TABS) do
		local holder = new("Frame", {
			Name = "Tab_" .. tab.Name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(SUB_SIZE, SUB_SIZE),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 6,
			Parent = float,
		}, { new("UIScale", { Name = "Pop", Scale = 0 }) })

		local subGlow = glowLabel("Glow", HALO_SUB, 1, holder)
		new("ImageLabel", {
			Name = "Icon",
			Image = tab.Icon,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.85, 0.85),
			BackgroundTransparency = 1,
			ZIndex = 3,
			Parent = holder,
		})
		local btn = new("ImageButton", {
			Name = "Button",
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1.3, 1.3), -- a bit bigger than the icon so it is easy to hit
			ZIndex = 4,
			Parent = holder,
		})
		pressFx(btn)
		btn.Activated:Connect(function()
			if floatShown and radialGoal == 1 then
				openWindow(tab.Name)
			end
		end)

		-- clockwise from the upper right, Home first (same arrangement as the reference screenshot)
		subs[i] = { holder = holder, pop = holder.Pop, glow = subGlow, angle = math.rad(-40 + (i - 1) * 60) }
	end

	-- smooth glow colour: an eased blend between neighbouring colours, wrapping around (clock driven, so it is smooth at any FPS)
	local function glowColorAt(t)
		local n = #FLOAT_GLOW_COLORS
		local x = ((t / FLOAT_GLOW_CYCLE_TIME) % 1) * n
		local i = math.floor(x)
		local f = x - i
		f = f * f * (3 - 2 * f) -- smoothstep: no sudden turn at each colour
		return FLOAT_GLOW_COLORS[i % n + 1]:Lerp(FLOAT_GLOW_COLORS[(i + 1) % n + 1], f)
	end

	----------------------------------------------------------------
	-- ANIMATION LOOP (time-based, so it stays smooth at any FPS; idle when the button is hidden)
	----------------------------------------------------------------
	keepConn(RunService.Heartbeat:Connect(function(dt)
		if not alive or not float.Visible then
			return
		end
		local t = os.clock()
		local p = press

		-- hold feedback: the logo squeezes while you hold, then flares when the tab icons fan out
		local holding = p ~= nil and not p.moved and not p.held
		local follow = math.min(1, dt * 14)
		if holding then
			charge = math.clamp((t - p.t0) / FLOAT_HOLD_TIME, 0, 1)
		else
			charge = charge * (1 - follow)
		end
		lift = lift + ((p ~= nil and p.moved and 1 or 0) - lift) * follow
		kick = math.max(0, kick - dt * 2.8)

		-- glow: breathing size + brightness (it keeps the colors of the Glowing Effect texture)
		local flare = charge * 0.3 + kick * 0.5 + lift * 0.12
		local boost = 1 + charge * 0.1 + kick * 0.3 + lift * 0.08
		local pulseA = 0.5 + 0.5 * math.sin(t * 2.4)
		local str = FLOAT_GLOW_STRENGTH

		local big = HALO_MAIN * (0.92 + 0.16 * pulseA) * boost
		glow.Size = UDim2.fromScale(big, big)
		glow.ImageTransparency = 1 - math.clamp(str * (0.62 + 0.3 * pulseA) + flare, 0, 1)
		local glowColor = FLOAT_GLOW_CYCLE and glowColorAt(t) or nil
		if glowColor then
			glow.ImageColor3 = glowColor
		end

		logoScale.Scale = 1 - 0.18 * charge + 0.22 * kick + 0.1 * lift
		logo.Position = UDim2.fromScale(0.5, 0.5 + 0.015 * math.sin(t * 1.8)) -- gentle idle bob

		-- tab icons fan out / tuck in, one after another, swirling as they go
		if radialT ~= radialGoal or radialT > 0 then
			if radialT ~= radialGoal then
				local step = dt / (radialGoal > radialT and OPEN_TIME or CLOSE_TIME)
				if radialGoal > radialT then
					radialT = math.min(radialGoal, radialT + step)
				else
					radialT = math.max(radialGoal, radialT - step)
				end
			end
			local count = #subs
			local spin = (1 - easeOutExpo(radialT)) * SPIN
			for i, s in ipairs(subs) do
				local offset = (i - 1) / math.max(count - 1, 1) * STAGGER
				local local_p = math.clamp((radialT - offset) / (1 - STAGGER), 0, 1)
				local e = easeOutBack(local_p)
				local a = s.angle + spin
				s.holder.Position = UDim2.fromScale(0.5 + math.cos(a) * FLOAT_RING * e, 0.5 + math.sin(a) * FLOAT_RING * e)
				s.pop.Scale = math.max(e, 0)
				s.holder.Visible = local_p > 0

				local pulse = 0.5 + 0.5 * math.sin(t * 2.6 + i * 0.9)
				local g = HALO_SUB * (0.88 + 0.24 * pulse)
				s.glow.Size = UDim2.fromScale(g, g)
				s.glow.ImageTransparency = 1 - math.clamp(str * (0.5 + 0.3 * pulse) + kick * 0.2, 0, 1)
				if glowColor then
					s.glow.ImageColor3 = glowColor
				end
			end
		end
	end))

	----------------------------------------------------------------
	-- TAP / HOLD / DRAG on the logo
	----------------------------------------------------------------
	hit.InputBegan:Connect(function(input)
		if not isTap(input) or press or not floatShown then
			return
		end
		local p = {
			input = input,
			start = Vector2.new(input.Position.X, input.Position.Y),
			origin = Vector2.new(float.Position.X.Scale, float.Position.Y.Scale),
			t0 = os.clock(),
			moved = false,
			held = false,
		}
		press = p
		task.delay(FLOAT_HOLD_TIME, function()
			if press == p and not p.moved and not p.held and floatShown then
				p.held = true
				kick = 1
				radialGoal = radialGoal == 1 and 0 or 1 -- hold = fan the tab icons out (hold again = tuck them back in)
			end
		end)
	end)

	keepConn(UserInputService.InputChanged:Connect(function(input)
		local p = press
		if not p or not (input == p.input or input.UserInputType == Enum.UserInputType.MouseMovement) then
			return
		end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - p.start
		if not p.moved and delta.Magnitude > DRAG_THRESHOLD then
			p.moved = true -- moving the finger turns it into a drag (no tap, no hold)
		end
		if p.moved then
			local screen = gui.AbsoluteSize
			local mx = math.min(0.45, float.AbsoluteSize.X * 0.6 / screen.X) -- keep the button on screen
			local my = math.min(0.45, float.AbsoluteSize.Y * 0.6 / screen.Y)
			float.Position = UDim2.fromScale(
				math.clamp(p.origin.X + delta.X / screen.X, mx, 1 - mx),
				math.clamp(p.origin.Y + delta.Y / screen.Y, my, 1 - my)
			)
		end
	end))

	keepConn(UserInputService.InputEnded:Connect(function(input)
		local p = press
		if not p then
			return
		end
		local isMouse = p.input.UserInputType == Enum.UserInputType.MouseButton1
		if input == p.input or (isMouse and input.UserInputType == Enum.UserInputType.MouseButton1) then
			press = nil
			if not p.held and not p.moved and floatShown then
				openWindow() -- a quick tap: back to the window
			end
		end
	end))

	----------------------------------------------------------------
	-- called by closeWindow / openWindow
	----------------------------------------------------------------
	showFloat = function()
		floatShown = true
		press, radialT, radialGoal, charge, kick, lift = nil, 0, 0, 0, 0, 0
		for _, s in ipairs(subs) do
			s.holder.Visible = false
			s.pop.Scale = 0
		end
		float.Visible = true
		floatPop.Scale = 0
		tween(floatPop, 0.5, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end

	hideFloat = function()
		if not floatShown then
			return
		end
		floatShown = false
		press = nil
		radialGoal = 0
		tween(floatPop, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
			if not floatShown then
				float.Visible = false
				radialT = 0
			end
		end)
	end
end

