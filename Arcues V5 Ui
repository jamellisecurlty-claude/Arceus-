		-- pencil: uses EDIT_ICON when you set it, otherwise a small drawn pencil
		local function drawPencil(parent)
			if EDIT_ICON then
				new("ImageLabel", {
					Image = EDIT_ICON,
					ScaleType = Enum.ScaleType.Fit,
					BackgroundTransparency = 1,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(0.5, 0.5),
					ZIndex = 4,
					Parent = parent,
				})
				return
			end
			-- thin outline pencil, tip bottom-left like the reference. Line thickness follows the icon size so it stays thin.
			local PEN_RATIO = 0.37 -- width / length
			local PEN_TIP = 0.26 -- tip length (fraction of the length)
			local H = 1 / PEN_RATIO
			local tipDy = PEN_TIP * H
			local tipLen = math.sqrt(0.25 + tipDy * tipDy)
			local tipAngle = math.deg(math.atan2(0.5, tipDy))

			local holder = new("Frame", {
				Name = "Pencil",
				BackgroundTransparency = 1,
				AnchorPoint = CENTER,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.55, 0.55),
				Rotation = 45,
				ZIndex = 4,
				Parent = parent,
			}, { ratio(PEN_RATIO) })

			local stroke = new("UIStroke", { Color = WHITE, Thickness = 0.5 })
			new("Frame", { -- body
				Name = "Body",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1 - PEN_TIP),
				ZIndex = 4,
				Parent = holder,
			}, { corner(0.2), stroke })

			local lines = {}
			local function line(x, rotation)
				local f = new("Frame", {
					Name = "TipLine",
					BackgroundColor3 = WHITE,
					BorderSizePixel = 0,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(x, 1 - PEN_TIP / 2),
					Size = UDim2.new(0, 1, tipLen / H, 0),
					Rotation = rotation,
					ZIndex = 4,
					Parent = holder,
				})
				lines[#lines + 1] = f
			end
			line(0.25, -tipAngle)
			line(0.75, tipAngle)
			lines[#lines + 1] = new("Frame", { -- band near the top end
				Name = "Band",
				BackgroundColor3 = WHITE,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.16),
				Size = UDim2.new(1, 0, 0, 1),
				ZIndex = 4,
				Parent = holder,
			})

			local function fit()
				local size = parent.AbsoluteSize.Y / math.max(popScale.Scale, 0.05)
				local t = math.max(0.4, size * 0.045)
				stroke.Thickness = t
				for _, f in ipairs(lines) do
					if f.Name == "Band" then
						f.Size = UDim2.new(1, 0, 0, t)
					else
						f.Size = UDim2.new(0, t, tipLen / H, 0)
					end
				end
			end
			parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
			fit()
		end

