		})
		-- animated gradient: a soft DARK band glides across the white letters - smooth bell-shaped edges, a slight
		-- diagonal, eased start and stop - then rests a moment and repeats. It is driven from the clock on every
		-- frame (no tween chain), so it stays smooth at any frame rate and never stutters or drifts.
		local LIGHT, DARK = Color3.new(1, 1, 1), Color3.fromRGB(22, 22, 30)
		local BAND_HALF, STEPS = 0.34, 6 -- half-width of the band and how many steps its soft edge has
		local SWEEP, REST = 1.5, 0.9 -- seconds gliding across, seconds resting before the next pass
		local REACH = 0.95 -- travel distance: the band starts and ends fully off the text, so the reset is invisible

		local keys = { ColorSequenceKeypoint.new(0, LIGHT) }
		for i = -STEPS, STEPS do
			local bell = 0.5 + 0.5 * math.cos(math.pi * i / STEPS) -- 0 at the band edges -> 1 in the middle
			keys[#keys + 1] = ColorSequenceKeypoint.new(0.5 + (i / STEPS) * BAND_HALF, LIGHT:Lerp(DARK, bell))
		end
		keys[#keys + 1] = ColorSequenceKeypoint.new(1, LIGHT)

		local nameGradient = new("UIGradient", {
			Name = "NameGradient",
			Color = ColorSequence.new(keys),
			Rotation = 16, -- slight slant so the band cuts across the letters diagonally
			Offset = Vector2.new(REACH, 0), -- resting position: band parked off the text, name fully white
			Parent = nick,
		})

		local gradientClock, lastOffset = os.clock(), nil
		local gradientTimer = 0
		keepConn(game:GetService("RunService").Heartbeat:Connect(function(dt)
			if not nick.Parent or not main.Visible or not homePage.Visible then
				return -- idle while the window or the Home page is hidden
			end
			gradientTimer = gradientTimer + dt
			if gradientTimer < (1 / 30) * Theme.Perf.scale then
				return -- PERFORMANCE: 30 updates a second (the clock drives it, so the speed stays the same)
			end
			gradientTimer = 0
			local t = (os.clock() - gradientClock) % (SWEEP + REST)
			local x = REACH -- resting
			if t < SWEEP then
				local eased = -(math.cos(math.pi * t / SWEEP) - 1) / 2 -- sine in-out: eases out, glides, lands softly
				x = -REACH + 2 * REACH * eased
			end
			if x ~= lastOffset then
				lastOffset = x
				nameGradient.Offset = Vector2.new(x, 0)
			end
		end))

		local run = 0
		local function restart()
			run = run + 1
			local id = run
			task.spawn(function()
