					editable:Destroy()
				end)
				return nil
			end
			return editable
		end

		-- card glow: rounded-rect edge glow, swirling palette, pulsing (same math as the source)
		local function buildGlow(editable)
			local w, h = CFG.GlowW, CFG.GlowH
			local cornerRadius = math.min(w, h) * CFG.CornerRatio
			local glowRadius = CFG.InnerGlowRadius * (math.min(w, h) / 128)
			local rx = math.max(w / 2 - cornerRadius, 0)
			local ry = math.max(h / 2 - cornerRadius, 0)
			local pulseMax = 1 + CFG.PulseAmplitude

			local size = Vector2.new(w, h)
			local buf = buffer.create(w * h * 4)
			local interior = floor(CFG.BackgroundAlpha + 0.5) * 16777216 -- rgb 0, alpha 35%

			local offsets, bases, angles = {}, {}, {}
			local count = 0

			for y = 0, h - 1 do
				for x = 0, w - 1 do
					local cx = (x + 0.5) - w / 2
					local cy = (y + 0.5) - h / 2
					local dx = math.abs(cx) - rx
					local dy = math.abs(cy) - ry
					local outside = math.sqrt(math.max(dx, 0) ^ 2 + math.max(dy, 0) ^ 2)
					local inside = math.min(math.max(dx, dy), 0)
					local d = math.abs(outside + inside - cornerRadius)

					local factor = 0
					if d < glowRadius then
						factor = 1 - d / glowRadius
					end
					local base = factor ^ CFG.GlowExponent
					local offset = (y * w + x) * 4

					writeu32(buf, offset, interior)
					if base * pulseMax * 255 >= 4 then -- pixels that could never become visible are skipped
						count = count + 1
						offsets[count] = offset
						bases[count] = base
						angles[count] = math.atan2(cy, cx) / TWO_PI
					end
				end
			end

			return function(phase) -- phase: 0..1 over one GlowCycle
				local pulse = 1 + CFG.PulseAmplitude * math.sin(phase * TWO_PI)
				for k = 1, count do
					local fade = bases[k] * pulse
					if fade > 1 then
						fade = 1
					end
					local idx = floor(((angles[k] + phase) % 1) * LUT) + 1
					local r = floor(lutR[idx] * fade + 0.5)
					local g = floor(lutG[idx] * fade + 0.5)
					local b = floor(lutB[idx] * fade + 0.5)
					local a = floor(CFG.BackgroundAlpha + fade * CFG.GlowExtraAlpha + 0.5)
					if a > 255 then
						a = 255
					end
					writeu32(buf, offsets[k], r + g * 256 + b * 65536 + a * 16777216)
				end
				editable:WritePixelsBuffer(Vector2.zero, size, buf)
			end
		end

		-- orb: wavy disc + soft glow, four drifting color blobs that rotate (same look as the source).
		-- HIGH RESOLUTION: the orb is painted at CFG.OrbSize pixels (128 now, it was 44 = blocky). To keep that fast, the four
		-- color blobs no longer call exp() for every pixel: because they only rotate, exp(-|p - a|^2 / 2s^2) splits into a
		-- per-pixel constant x a per-column factor x a per-row factor, so each frame only needs 8 x OrbSize exp() calls.
		-- The disc edge is also anti-aliased (about 1 pixel of smoothing) so it has no stair-steps.
		local function buildOrb(editable)
			local n = CFG.OrbSize
			local coordScale = 1.3
			local waveBase, waveRange = 0.9, 0.02
			local glowRange, glowMaxAlpha, bodyMaxAlpha = 0.35, 0.5, 200
			local twoSigma2 = 2 * 0.7 * 0.7
			local expK = 2 / twoSigma2
			local edge = 2 * coordScale / n -- half-width of the anti-aliased disc edge = 1 pixel, in orb coordinates

			local anchors = {
				{ x = -0.6, y = -0.3, r = 1, g = 0, b = 0 },
				{ x = 0.6, y = -0.2, r = 1, g = 0.22, b = 0.41 },
				{ x = -0.4, y = 0.6, r = 0.96, g = 0.45, b = 0.93 },
				{ x = 0.4, y = 0.7, r = 0.08, g = 0.65, b = 1 },
			}
			local axs, ays = { 0, 0, 0, 0 }, { 0, 0, 0, 0 }
			local exs, eys = { {}, {}, {}, {} }, { {}, {}, {}, {} } -- per-column / per-row blob factors (refilled every frame)

			local size = Vector2.new(n, n)
			local buf = buffer.create(n * n * 4)

			-- orb coordinate of pixel column / row i (the same for both axes)
			local coords = {}
			for i = 1, n do
				coords[i] = (((i - 0.5) / n) * 2 - 1) * coordScale
			end

			-- only pixels that can ever be lit (distance < wave + glow) are processed
			local maxReach = waveBase + waveRange + glowRange
			local offs, ixs, iys, dists = {}, {}, {}, {}
			local bw = { {}, {}, {}, {} } -- per-pixel constant part of each blob's weight
			local cos3, sin3, cos2, sin2, cos5, sin5 = {}, {}, {}, {}, {}, {}
			local count = 0
			for py = 0, n - 1 do
				for px = 0, n - 1 do
					local nx, ny = coords[px + 1], coords[py + 1]
					local dist2 = nx * nx + ny * ny
					local dist = math.sqrt(dist2)
					if dist < maxReach then
						local ang = math.atan2(ny, nx)
						count = count + 1
						offs[count] = (py * n + px) * 4
						ixs[count], iys[count], dists[count] = px + 1, py + 1, dist
						cos3[count], sin3[count] = math.cos(ang * 3), math.sin(ang * 3)
						cos2[count], sin2[count] = math.cos(ang * 2), math.sin(ang * 2)
						cos5[count], sin5[count] = math.cos(ang * 5), math.sin(ang * 5)
						for j = 1, 4 do
							local a = anchors[j]
							bw[j][count] = math.exp(-(dist2 + a.x * a.x + a.y * a.y) / twoSigma2)
						end
					end
				end
			end

			return function(phase) -- phase: 0..1 over one OrbCycle
				local tA = phase * TWO_PI
				local cosR, sinR = math.cos(tA), math.sin(tA)
				for j = 1, 4 do
					local a = anchors[j]
					local ax, ay = a.x * cosR - a.y * sinR, a.x * sinR + a.y * cosR
					axs[j], ays[j] = ax, ay
					local ex, ey = exs[j], eys[j]
					for i = 1, n do
						local c = coords[i] * expK
						ex[i] = math.exp(c * ax)
						ey[i] = math.exp(c * ay)
					end
				end
				local ex1, ex2, ex3, ex4 = exs[1], exs[2], exs[3], exs[4]
				local ey1, ey2, ey3, ey4 = eys[1], eys[2], eys[3], eys[4]
				local bw1, bw2, bw3, bw4 = bw[1], bw[2], bw[3], bw[4]
				local cr1, cr2, cr3, cr4 = anchors[1].r, anchors[2].r, anchors[3].r, anchors[4].r
				local cg1, cg2, cg3, cg4 = anchors[1].g, anchors[2].g, anchors[3].g, anchors[4].g
				local cb1, cb2, cb3, cb4 = anchors[1].b, anchors[2].b, anchors[3].b, anchors[4].b

				local mix = 0.8 + 0.2 * (0.5 + 0.5 * math.sin(tA))
				local pulseGlow = 0.5 + 0.5 * math.sin(tA * 0.5)
				local glowPeak = glowMaxAlpha * pulseGlow * 255 -- glow alpha right at the disc edge
				local s1, c1 = math.sin(tA * 2), math.cos(tA * 2)
				local s2, c2 = math.sin(tA), math.cos(tA)
				local s3, c3 = math.sin(tA * 3), math.cos(tA * 3)
				local mix255 = mix * 255

				for k = 1, count do
					-- wavy radius: sin(2t + 3a) / sin(t - 2a) / sin(3t + 5a), expanded so no sin() per pixel
					local waveR = waveBase
						+ waveRange * 0.5 * (s1 * cos3[k] + c1 * sin3[k])
						+ waveRange * 0.3 * (s2 * cos2[k] - c2 * sin2[k])
						+ waveRange * 0.2 * (s3 * cos5[k] + c3 * sin5[k])
					local dist = dists[k]
					local r, g, b, alpha = 0, 0, 0, 0

					if dist < waveR + glowRange then
						local ix, iy = ixs[k], iys[k]
						local w1 = bw1[k] * ex1[ix] * ey1[iy]
						local w2 = bw2[k] * ex2[ix] * ey2[iy]
						local w3 = bw3[k] * ex3[ix] * ey3[iy]
						local w4 = bw4[k] * ex4[ix] * ey4[iy]
						local k255 = mix255 / (w1 + w2 + w3 + w4)
						r = floor((cr1 * w1 + cr2 * w2 + cr3 * w3 + cr4 * w4) * k255 + 0.5)
						g = floor((cg1 * w1 + cg2 * w2 + cg3 * w3 + cg4 * w4) * k255 + 0.5)
						b = floor((cb1 * w1 + cb2 * w2 + cb3 * w3 + cb4 * w4) * k255 + 0.5)
						if r > 255 then
							r = 255
						end
						if g > 255 then
							g = 255
						end
						if b > 255 then
							b = 255
						end

						if dist < waveR - edge then
							alpha = bodyMaxAlpha
						else
							local glowFrac = (dist - waveR) / glowRange
							if glowFrac < 0 then
								glowFrac = 0
							end
							local glowA = (1 - glowFrac) * glowPeak
							if dist < waveR + edge then -- 1-pixel smooth blend between the body and the glow (anti-aliasing)
								local t = (dist - waveR + edge) / (2 * edge)
								t = t * t * (3 - 2 * t)
								alpha = floor(bodyMaxAlpha + (glowA - bodyMaxAlpha) * t + 0.5)
							else
								alpha = floor(glowA + 0.5)
							end
						end
					end

					writeu32(buf, offs[k], r + g * 256 + b * 65536 + alpha * 16777216)
				end
				editable:WritePixelsBuffer(Vector2.zero, size, buf)
			end
		end

