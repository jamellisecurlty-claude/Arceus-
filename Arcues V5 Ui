function Theme.find(name)
	local wanted = string.lower(tostring(name))
	if wanted == "yellow" then
		wanted = "amber" -- the first version of this list had Yellow; the source calls it Amber
	end
	for _, entry in ipairs(Theme.COLORS) do
		if string.lower(entry.Name) == wanted then
			return entry
		end
	end
	return nil
end

Theme.cur = themeState(Theme.COLORS[1])
