		----------------------------------------------------------------
		-- SYNTAX COLORS (Lua highlighter, RichText). Single pass, same-colour runs are merged into one tag (fast).
		-- Handles: comments, --[[ long comments ]], strings, [[ long strings ]], numbers, keywords, builtins,
		-- function names / calls, .properties, :methods, operators and brackets.
		----------------------------------------------------------------
		local KEYWORDS, BUILTINS = {}, {}
		for word in ("and break do else elseif end false for function if in local nil not or repeat return then true until while"):gmatch("[%w_]+") do
			KEYWORDS[word] = true
		end
		for word in ("print warn error assert pcall xpcall require tostring tonumber type typeof pairs ipairs next select unpack rawget rawset rawequal setmetatable getmetatable game workspace script task wait spawn delay tick time self shared Instance Vector2 Vector3 CFrame Color3 UDim UDim2 Enum Font Rect Ray BrickColor TweenInfo NumberRange NumberSequence ColorSequence Random math string table os debug coroutine utf8 bit32 buffer vector number boolean any unknown never thread newproxy collectgarbage gcinfo rawlen _G _VERSION loadstring getgenv getrenv getfenv setfenv"):gmatch("[%w_]+") do
			BUILTINS[word] = true
		end

		local HEX = {}
		for key, color in pairs(COLORS) do
			HEX[key] = string.format("%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
		end

		local function esc(s)
			s = s:gsub("&", "&amp;")
			s = s:gsub("<", "&lt;")
			s = s:gsub(">", "&gt;")
			return s
		end

		local MAX_HIGHLIGHT = 300000 -- bigger than this stays plain text (keeps the label fast)

		-- scans ONE line (Luau). `state` is nil (normal) or "c:<eq>" / "s:<eq>" / "b:" when the line starts inside a long comment / long string / backtick string.
		-- returns the RichText for the line and the state the NEXT line starts in. Tags never cross a line, so the markup is always valid.
		local scanLine
		scanLine = function(line, state)
			local len = #line
			local out, outN = {}, 0
			local curKey, buf, bufN = nil, {}, 0
			local function flush()
				if bufN == 0 then
					return
				end
				local text = esc(table.concat(buf, "", 1, bufN))
				outN = outN + 1
				out[outN] = curKey and ('<font color="#' .. HEX[curKey] .. '">' .. text .. "</font>") or text
				bufN = 0
			end
			local function push(key, s)
				if s == "" then
					return
				end
				if key ~= curKey then
					flush()
					curKey = key
				end
				bufN = bufN + 1
				buf[bufN] = s
			end
			local function raw(html) -- already coloured markup (used for code inside `{ }` of a backtick string)
				flush()
				outN = outN + 1
				out[outN] = html
				curKey = nil
			end

			-- Luau backtick string with {expr} holes. returns next index, closed?
			local function backtick(from, segStart)
				local j = from
				while j <= len do
					local ch = line:sub(j, j)
					if ch == "\\" then
						j = j + 2
					elseif ch == "`" then
						push("String", line:sub(segStart, j))
						return j + 1, true
					elseif ch == "{" then
						push("String", line:sub(segStart, j - 1))
						local depth, k = 1, j + 1
						while k <= len do
							local d = line:sub(k, k)
							if d == "{" then
								depth = depth + 1
							elseif d == "}" then
								depth = depth - 1
								if depth == 0 then
									break
								end
							end
							k = k + 1
						end
						push("Bracket", "{")
						if k <= len then
							raw((scanLine(line:sub(j + 1, k - 1), nil)))
							push("Bracket", "}")
							j = k + 1
						else
							raw((scanLine(line:sub(j + 1), nil)))
							j = len + 1
						end
						segStart = j
					else
						j = j + 1
					end
				end
				push("String", line:sub(segStart, len))
				return len + 1, false
			end

			local i = 1
			if state then
				-- this line continues a long comment / long string / backtick string from above
				local kind, eq = state:sub(1, 1), state:sub(3)
				if kind == "b" then
					local j, closed = backtick(1, 1)
					i = j
					if closed then
						state = nil
					end
				else
					local _, e = line:find("]" .. eq .. "]", 1, true)
					local j = e and (e + 1) or (len + 1)
					push(kind == "c" and "Comment" or "String", line:sub(1, j - 1))
					i = j
					if e then
						state = nil
					end
				end
			end

			local typeMode, typeDepth, typeDecl = false, 0, false -- Luau type expression (after `::`, `->`, `name: `, `type X =`)
			local prevSig, prevWord, prevKw = nil, nil, false -- previous significant token (for .prop / :method / function name / types)
			while i <= len do
				local c = line:sub(i, i)
				if c == "-" and line:sub(i + 1, i + 1) == "-" then
					local eq = line:match("^%-%-%[(=*)%[", i)
					local j
					if eq then
						local _, e = line:find("]" .. eq .. "]", i + 4 + #eq, true)
						if e then
							j = e + 1
						else
							j = len + 1
							state = "c:" .. eq
						end
					else
						j = len + 1
					end
					push("Comment", line:sub(i, j - 1))
					i = j
					prevSig, prevWord, prevKw = "c", nil, false
				elseif c == "[" and line:find("^%[=*%[", i) then
					local eq = line:match("^%[(=*)%[", i)
					local _, e = line:find("]" .. eq .. "]", i + 2 + #eq, true)
					local j
					if e then
						j = e + 1
					else
						j = len + 1
						state = "s:" .. eq
					end
					push("String", line:sub(i, j - 1))
					i = j
					prevSig, prevWord, prevKw = "s", nil, false
				elseif c == "`" then
					local j, closed = backtick(i + 1, i)
					i = j
					if not closed then
						state = "b:"
					end
					prevSig, prevWord, prevKw = "s", nil, false
				elseif c == '"' or c == "'" then
					local j = i + 1
					while true do
						local k = line:find("[\\" .. c .. "]", j)
						if not k then
							j = len + 1
							break
						end
						if line:sub(k, k) == "\\" then
							j = k + 2
						else
							j = k + 1
							break
						end
					end
					if j > len + 1 then
						j = len + 1
					end
					push("String", line:sub(i, j - 1))
					i = j
					prevSig, prevWord, prevKw = "s", nil, false
				elseif c:find("%d") or (c == "." and line:find("^%.%d", i)) then
					-- hex 0xFF_FF, binary 0b0101_0101, decimals with _ separators, exponents
					local num = line:match("^0[xX][%x_]+", i)
						or line:match("^0[bB][01_]+", i)
						or line:match("^%d[%d_]*%.?[%d_]*[eE][%+%-]?%d+", i)
						or line:match("^%d[%d_]*%.?[%d_]*", i)
						or line:match("^%.%d[%d_]*", i)
						or c
					push("Number", num)
					i = i + #num
					prevSig, prevWord, prevKw = "n", nil, false
				elseif c:find("[%a_]") then
					local word = line:match("^[%a_][%w_]*", i)
					local after = line:match("^%s*(.)", i + #word)
					local member = prevSig == "." or prevSig == ":"
					local key = nil
					local kw = false
					if KEYWORDS[word] then
						key, kw = "Keyword", true
					elseif not member and word == "continue" and (after == nil or not after:find("[%(%.=:%[,]")) then
						key, kw = "Keyword", true -- contextual: `continue` is only a keyword when used as a statement
					elseif not member and (word == "type" or word == "export" or word == "const") and after and after:find("[%a_]") then
						key, kw = "Keyword", true -- contextual: type Foo = ... / export type / const x
					elseif member then
						key = (after == "(" or after == '"' or after == "{" or prevSig == ":") and "Func" or "Prop"
					elseif prevSig == "::" or prevSig == "->" or prevSig == ":t" or (prevKw and prevWord == "type") then
						key = "Type" -- after `::`, `->`, `name: ` and `type`
					elseif typeMode and after ~= ":" then
						key = "Type" -- rest of a type expression: string | Foo?, {Bar}, Map<K, V>
					elseif prevWord == "function" then
						key = "Func"
					elseif BUILTINS[word] then
						key = "Builtin"
					elseif after == "(" then
						key = "Func"
					end
					if kw and word ~= "nil" and word ~= "true" and word ~= "false" then
						typeMode, typeDepth = false, 0
					end
					if kw and word == "type" then
						typeDecl = true
					end
					push(key, word)
					i = i + #word
					prevSig, prevWord, prevKw = "w", word, kw
				elseif c:find("%s") then
					local ws = line:match("^%s+", i)
					push(curKey, ws) -- whitespace joins the current run (no extra tag)
					i = i + #ws
				elseif c == "@" and line:find("^@[%a_]", i) then
					local at = line:match("^@[%a_][%w_]*", i) -- attribute: @native @checked @deprecated
					push("Type", at)
					i = i + #at
					prevSig, prevWord, prevKw = "a", nil, false
				else
					local two = line:sub(i, i + 1)
					if two == ".." then
						local dots = line:match("^%.%.%.?", i)
						push("Operator", dots)
						i = i + #dots
						prevSig, prevWord, prevKw = "o", nil, false
					elseif two == "::" or two == "->" then
						push("Operator", two)
						i = i + 2
						typeMode, typeDepth = true, 0
						prevSig, prevWord, prevKw = two, nil, false
					else
						local key = nil
						if c:find("[%(%)%[%]{}]") then
							key = "Bracket"
						elseif c:find("[%+%-%*/%%%^#=<>~|&%?]") then
							key = "Operator"
						end
						push(key, c)
						i = i + 1
						if typeMode then
							if c == "(" or c == "{" or c == "<" then
								typeDepth = typeDepth + 1
							elseif c == ")" or c == "}" or c == ">" then
								if typeDepth == 0 then
									typeMode = false
								else
									typeDepth = typeDepth - 1
								end
							elseif typeDepth == 0 and (c == "," or c == "=" or c == ";") then
								typeMode = false
							end
						end
						if c == "=" and typeDecl then
							typeDecl, typeMode, typeDepth = false, true, 0 -- `type Foo = <type expression>`
						end
						if c == ":" and line:find("^%s", i) then
							prevSig = ":t" -- `name: Type` (annotation), not a method call
							if not typeMode then
								typeMode, typeDepth = true, 0
							end
						else
							prevSig = c
						end
						prevWord, prevKw = nil, false
					end
				end
			end
			flush()
			return table.concat(out, "", 1, outN), state
		end

		-- line cache: a line is only re-scanned when its text (or the long-comment state it starts in) changed,
		-- so typing re-colours ONE line instead of the whole script.
		local lineCache, lineCacheN = {}, 0
		local function highlight(src, shouldAbort)
			src = src:gsub("\r\n?", "\n")
			if #src > MAX_HIGHLIGHT then
				return esc(src)
			end
			local scanned = 0
			local out, outN = {}, 0
			local state = nil
			local pos = 1
			while true do
				local nl = src:find("\n", pos, true)
				local line = nl and src:sub(pos, nl - 1) or src:sub(pos)
				local key = (state or "") .. "|" .. line
				local hit = lineCache[key]
				if not hit then
					local okL, html, nextState = pcall(scanLine, line, state)
					if not okL then
						-- one odd line never costs the whole script its colours: only that line stays plain
						warn("[ArcyHome] highlight skipped a line: " .. tostring(html))
						html, nextState = esc(line), state
					end
					hit = { html, nextState }
					scanned = scanned + 1
					if shouldAbort and scanned % 250 == 0 then
						task.wait() -- big paste: colour in slices so the UI never freezes
						if shouldAbort() then
							return nil
						end
					end
					lineCacheN = lineCacheN + 1
					if lineCacheN > 6000 then
						lineCache, lineCacheN = {}, 1
					end
					lineCache[key] = hit
				end
				outN = outN + 1
				out[outN] = hit[1]
				state = hit[2]
				if not nl then
					break
				end
				pos = nl + 1
			end
			local result = table.concat(out, "\n", 1, outN)
			if #result > 190000 then
				return esc(src) -- the label cannot hold that much markup: plain text instead of a blank editor
			end
			return result
		end

		-- line numbers: rebuilt only when the number of lines changes
		local lastLineCount = -1
		local function updateLineNumbers(text)
			local count, at = 1, 1
			while true do
				local nl = text:find("\n", at, true)
				if not nl then
					break
				end
				count = count + 1
				at = nl + 1
				if count >= 3000 then
					break
				end
			end
			if count == lastLineCount then
				return
			end
			lastLineCount = count
			local numbers = table.create(count)
			for k = 1, count do
				numbers[k] = tostring(k)
			end
			lineNums.Text = table.concat(numbers, "\n")
		end

		-- The coloured label (codeView) sits on top of the invisible text box, so you SEE the colours while typing.
		-- Small scripts are re-coloured instantly on every key (cheap thanks to the line cache). Big ones show plain text while
		-- you type and get coloured 0.12 s after you stop. The label is never rewritten when nothing changed.
		local SYNC_LIMIT = 6000
		local DEBOUNCE = 0.12
		local pendingToken = 0
		local lastShown = nil

		local function refreshView()
			local text = codeBox.Text
			if text ~= lastShown and #text > SYNC_LIMIT then
				-- pasted / opened a big script: show it plain right away, colour it in slices, then swap the colours in
				if FX.asyncText == text then
					return -- already being coloured
				end
				FX.asyncText = text
				pendingToken = pendingToken + 1
				local mine = pendingToken
				codeBox.TextTransparency = 0
				codeView.Visible = false
				updateLineNumbers(text)
				task.spawn(function()
					local ok, html = pcall(highlight, text, function()
						return mine ~= pendingToken or not alive
					end)
					if mine ~= pendingToken or not alive then
						if FX.asyncText == text then
							FX.asyncText = nil
						end
						return
					end
					FX.asyncText = nil
					if not ok or html == nil then
						if not ok then
							warn("[ArcyHome] highlight failed: " .. tostring(html))
						end
						html = esc(text)
					end
					lastShown = text
					codeView.RichText = true
					codeView.Text = html
					updateLineNumbers(text)
					codeBox.TextTransparency = 1
					codeBox.TextStrokeTransparency = 1
					codeView.Visible = true
				end)
				return
			end
			if text ~= lastShown then
				local ok, html = pcall(highlight, text)
				if not ok then
					warn("[ArcyHome] highlight failed: " .. tostring(html))
					html = esc(text)
				end
				lastShown = text
				codeView.RichText = true
				codeView.Text = html
			end
			updateLineNumbers(text)
			codeBox.TextTransparency = 1
			codeBox.TextStrokeTransparency = 1
			codeView.Visible = true
		end

		codeBox.Focused:Connect(function()
			refreshView()
		end)
		-- safety net: whatever way text lands in the editor (keyboard paste, executor, button), the colours catch up within 0.25 s
		task.spawn(function()
			while alive do
				task.wait((main.Visible and page.Visible) and 0.25 or 1) -- slow while the Editor is not on screen
				if not loading and codeBox.Text ~= lastShown and codeBox.Text ~= FX.asyncText then
					pcall(refreshView)
				end
			end
		end)
		codeBox.FocusLost:Connect(function()
			pendingToken = pendingToken + 1
			refreshView()
		end)
		codeBox:GetPropertyChangedSignal("Text"):Connect(function()
			if loading then
				return
			end
			local text = codeBox.Text
			if selected then
				selected.source = text
			end
			if not codeBox:IsFocused() or #text <= SYNC_LIMIT then
				pendingToken = pendingToken + 1
				refreshView()
			else
				codeBox.TextTransparency = 0 -- plain text right now
				codeView.Visible = false
				updateLineNumbers(text)
				pendingToken = pendingToken + 1
				local mine = pendingToken
				task.delay(DEBOUNCE, function()
					if mine == pendingToken and alive then
						refreshView() -- colours the big script in slices
					end
				end)
			end
		end)

		local function setCode(text)
			loading = true
			codeBox.Text = text
			loading = false
			if selected then
				selected.source = text
			end
			refreshView()
		end

