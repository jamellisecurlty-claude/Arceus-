local function aiTrim(value)
	return string.match(tostring(value or ""), "^%s*(.-)%s*$") or ""
end

local function aiDecode(body)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if ok then
		return data
	end
	return nil
end

local function aiErrorText(body)
	if type(body) ~= "string" or body == "" then
		return ""
	end
	local data = aiDecode(body)
	if type(data) == "table" then
		if type(data.error) == "table" and data.error.message then
			return tostring(data.error.message)
		elseif type(data.error) == "string" then
			return data.error
		elseif data.message then
			return tostring(data.message)
		end
	end
	local clean = aiTrim((string.gsub(body, "%s+", " ")))
	return string.sub(clean, 1, 180)
end

-- executor request() is preferred; Roblox HttpService is the fallback.
local function aiPost(url, headers, payload, timeout)
	local json = HttpService:JSONEncode(payload)
	local requestFn
	pcall(function()
		requestFn = request
			or http_request
			or (syn and syn.request)
			or (fluxus and fluxus.request)
			or (http and http.request)
	end)

	local finished = false
	local response, requestError
	task.spawn(function()
		local ok, result
		if type(requestFn) == "function" then
			ok, result = pcall(requestFn, {
				Url = url,
				Method = "POST",
				Headers = headers,
				Body = json,
			})
		end
		-- If an executor transport is missing or itself errors, try Roblox's transport.
		if not ok then
			ok, result = pcall(function()
				return HttpService:RequestAsync({
					Url = url,
					Method = "POST",
					Headers = headers,
					Body = json,
				})
			end)
		end
		if finished then
			return
		end
		finished = true
		if not ok then
			requestError = tostring(result)
			return
		end
		if type(result) ~= "table" then
			requestError = "the HTTP transport returned an invalid response"
			return
		end
		response = result
	end)

	local started = os.clock()
	while not finished and os.clock() - started < (timeout or ArcyAI.Config.Timeout) do
		task.wait(0.1)
	end
	if not finished then
		finished = true
		return nil, "request timed out"
	end
	if not response then
		return nil, requestError or "request failed"
	end
	return response
end

local function aiContent(data)
	if type(data) ~= "table" then
		return nil
	end
	local content
	if type(data.choices) == "table" and type(data.choices[1]) == "table" then
		local choice = data.choices[1]
		if type(choice.message) == "table" then
			content = choice.message.content
		end
		content = content or choice.text
	end
	content = content or (type(data.message) == "table" and data.message.content) or data.output_text
	if type(content) == "table" then
		local parts = {}
		for _, part in ipairs(content) do
			if type(part) == "string" then
				parts[#parts + 1] = part
			elseif type(part) == "table" and type(part.text) == "string" then
				parts[#parts + 1] = part.text
			end
		end
		content = table.concat(parts, "\n")
	end
	if type(content) ~= "string" then
		return nil
	end
	content = string.gsub(content, "<think>.-</think>", "")
	content = aiTrim(content)
	if content == "" then
		return nil
	end
	return content
end

-- Safety net: if the model still writes a markdown fence (```lua ... ```) or a ***lua tag, turn it into the --[[ ... ]] form
-- so the user never sees those tags.
local function aiClean(text)
	text = string.gsub(tostring(text or ""), "\r\n?", "\n")
	-- ```lua ... ```  ->  --[[ ... ]]
	text = string.gsub(text, "```[%w_+%-]*[ \t]*\n?(.-)```", function(body)
		return "--[[\n" .. aiTrim(body) .. "\n]]"
	end)
	-- a fence that was never closed (answer cut off): still wrap what follows
	local open = string.find(text, "```", 1, true)
	if open then
		local rest = string.gsub(string.sub(text, open + 3), "^[%w_+%-]*[ \t]*\n?", "")
		text = string.sub(text, 1, open - 1) .. "--[[\n" .. aiTrim(rest) .. "\n]]"
	end
	text = string.gsub(text, "~~~[%w_+%-]*", "")
	text = string.gsub(text, "%*%*%*[Ll][Uu][Aa][Uu]?", "") -- the ***lua tag
	text = string.gsub(text, "\n%*%*%*[ \t]*\n", "\n")
	return aiTrim(text)
end

