-- Blue button cycles: small -> medium -> FULL SCREEN -> small (the window takes the shape of your screen, nothing is cropped)
local isFull = false
local savedPosition = main.Position
local mainRatio = main:FindFirstChildOfClass("UIAspectRatioConstraint")
local mainCorner = main:FindFirstChildOfClass("UICorner")
local cornerSmall = mainCorner and mainCorner.CornerRadius

local function screenAspect()
	local size = gui.AbsoluteSize
	return size.X / math.max(size.Y, 1)
end

-- the background art and the sidebar shade have their own rounded corners; they follow the window's corner
local extraCorners = {
	{ corner = bgImage:FindFirstChildOfClass("UICorner"), small = UDim.new(0.075, 0) },
	{ corner = sidebarShade:FindFirstChildOfClass("UICorner"), small = UDim.new(0.5, 0) },
}

local function setWindowSize(index)
	local style, time = Enum.EasingStyle.Quart, 0.45 -- fast start, soft landing (like the video)
	if index == #SIZES then -- full screen: centered, aspect = your screen, square corners
		if not isFull then
			savedPosition = main.Position -- remember where you dragged it
		end
		isFull = true
		for _, c in ipairs(extraCorners) do
			tween(c.corner, time, { CornerRadius = UDim.new(0, 0) }, style)
		end
		tween(main, time, { Size = SIZES[index], Position = UDim2.fromScale(0.5, 0.5), Rotation = 0 }, style)
		if mainRatio then
			tween(mainRatio, time, { AspectRatio = screenAspect() }, style)
		end
		if mainCorner then
			tween(mainCorner, time, { CornerRadius = UDim.new(0, 0) }, style)
		end
	else -- small / medium: grows or shrinks around its own center
		local goal = { Size = SIZES[index] }
		if isFull then
			goal.Position = savedPosition -- coming back from full screen: return to where it was
		end
		isFull = false
		for _, c in ipairs(extraCorners) do
			tween(c.corner, time, { CornerRadius = c.small }, style)
		end
		tween(main, time, goal, style)
		if mainRatio then
			tween(mainRatio, time, { AspectRatio = 16 / 9 }, style)
		end
		if mainCorner and cornerSmall then
			tween(mainCorner, time, { CornerRadius = cornerSmall }, style)
		end
	end
end

