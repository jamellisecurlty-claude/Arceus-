						-- Tapping the box opens the glowing "Instant code with Arcy" prompt (typing happens there, like the Arcy orb's box).
						-- Change the two texts below if you want other words.
						local TEXTBOX_PROMPT_TITLE = "Textbox"
						local TEXTBOX_PROMPT_HINT = "Research..."
						box.TextEditable = false
						local boxTap = new("TextButton", {
