		local function refreshStar()
			starImage.Image = (selected and selected.fav) and A.StarOnIcon or A.StarIcon
		end

		-- which scripts the open tab shows
		local function visibleItems()
			local query = search.Text:lower()
			local out = {}
			for _, item in ipairs(items) do
				local inCategory
				if category == "files" then
					inCategory = not item.autorun -- File Scripts: auto-executed scripts live in the Auto-Executed tab
				elseif category == "star" then
					inCategory = item.fav == true -- Favorites: every favourited script
				else
					inCategory = item.autorun == true -- Auto-Executed
				end
				if inCategory and (query == "" or item.name:lower():find(query, 1, true)) then
					out[#out + 1] = item
				end
			end
			return out
		end

		-- the script next to this one in the open tab (it gets selected when this one leaves)
		neighbourOf = function(item)
			local shown = visibleItems()
			local at = table.find(shown, item)
			if not at then
				return nil
			end
			return shown[at + 1] or shown[at - 1]
		end

		-- the selected row fades to red, the others fade out
		highlightRows = function()
			for item, ref in pairs(rowOf) do
				FX.play(ref.row, 0.22, { BackgroundTransparency = item == selected and ROW_SELECTED_TRANSPARENCY or 1 }, Enum.EasingStyle.Sine)
			end
		end

		-- opens a script in the editor. rebuild: nil = just move the highlight, true = rebuild the list,
		-- "cascade" = rebuild with every row sliding in, or an item = rebuild with that row sliding in
		selectItem = function(item, rebuild)
			local changed = item ~= selected
			selected = item
			loading = true
			codeBox.Text = item and item.source or ""
			loading = false
			refreshView()
			refreshStar()
			if rebuild == true then
				refreshList()
			elseif rebuild then
				refreshList(rebuild)
			else
				highlightRows()
			end
			if changed and not codeBox:IsFocused() then
				-- the new script fades in instead of snapping
				codeView.TextTransparency = 1
				lineNums.TextTransparency = 1
				FX.play(codeView, 0.3, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
				FX.play(lineNums, 0.3, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
			end
		end

		-- a row leaves the open tab (deleted, unfavourited, auto-execute toggled): it slides out, the gap closes, then done() runs
		removeRow = function(item, done)
			local ref = rowOf[item]
			if not ref or not ref.slot.Parent then
				done()
				return
			end
			rowOf[item] = nil
			FX.play(ref.row, 0.2, { Position = UDim2.fromScale(1.05, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Once(function()
				if not alive then
					return
				end
				if not ref.slot.Parent then
					done()
					return
				end
				FX.play(ref.slot, 0.16, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quad).Completed:Once(done)
			end)
		end

		-- rebuilds the rows. anim: nil = no animation, "cascade" = every row slides up in turn, or an item = only that row slides in
		refreshList = function(anim)
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("Frame") then
					child:Destroy()
				end
			end
			table.clear(rowOf)
			local shown = visibleItems()

			for order, item in ipairs(shown) do
				local isSelected = item == selected
				-- the slot is what the list lays out; the row inside it is what slides
				local slot = new("Frame", {
					Name = "Slot_" .. order,
					LayoutOrder = order,
					BackgroundTransparency = 1,
					ClipsDescendants = true,
					Size = UDim2.new(1, 0, 0, rowH),
					ZIndex = 4,
					Parent = list,
				})
				local row = new("TextButton", {
					Name = "File_" .. order,
					Text = "",
					AutoButtonColor = false,
					BackgroundColor3 = PRIMARY,
					BackgroundTransparency = isSelected and ROW_SELECTED_TRANSPARENCY or 1,
					BorderSizePixel = 0,
					Size = UDim2.fromScale(1, 1),
					ZIndex = 4,
					Parent = slot,
				}, { corner(0.2) })
				-- green bar that fills while you hold the row (hold = auto-execute on / off)
				local fill = new("Frame", {
					Name = "HoldFill",
					BackgroundColor3 = AUTO_GREEN,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.fromScale(0, 1),
					ZIndex = 4,
					Parent = row,
				}, { corner(0.2) })
				local bullet = " \u{2022}"
				if item.autorun then
					bullet = ' <font color="#' .. AUTO_GREEN:ToHex() .. '">\u{2022}</font>' -- green bullet = auto-executed
				end
				local nameLabel = label({
					Name = "Name",
					Text = esc(item.name) .. bullet,
					RichText = true,
					FontFace = FONT.Body,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.fromScale(0.04, 0.25),
					Size = UDim2.fromScale(0.72, 0.5),
					ZIndex = 5,
					Parent = row,
				})
				local pen = new("TextButton", {
					Name = "Rename",
					Text = "",
					AutoButtonColor = false,
					BackgroundTransparency = 1,
					AnchorPoint = CENTER,
					Position = UDim2.fromScale(0.9, 0.5),
					Size = UDim2.fromScale(1, 0.75),
					ZIndex = 5,
					Parent = row,
				}, { ratio(1) })
				drawPencil(pen)
				rowOf[item] = { slot = slot, row = row }

				if anim == "cascade" then
					local delay = (order - 1) * 0.045
					row.Position = UDim2.fromScale(0, 0.45)
					nameLabel.TextTransparency = 1
					FX.play(row, 0.4, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, delay)
					FX.play(nameLabel, 0.3, { TextTransparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, delay)
				elseif anim == item then
					row.Position = UDim2.fromScale(-1.05, 0)
					FX.play(row, 0.5, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				end

				-- tap = open, hold = auto-execute on / off
				local held = false
				local pressId = 0
				row.Activated:Connect(function()
					if held then
						held = false
						return
					end
					selectItem(item)
				end)
				row.InputBegan:Connect(function(input)
					if not isTap(input) then
						return
					end
					pressId = pressId + 1
					local mine = pressId
					local start = input.Position
					task.delay(0.15, function() -- a plain tap never shows the bar
						if pressId == mine and row.Parent then
							FX.play(fill, AUTO_HOLD_TIME - 0.15, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.55 }, Enum.EasingStyle.Linear)
						end
					end)
					task.delay(AUTO_HOLD_TIME, function()
						if pressId ~= mine or not alive or not row.Parent then
							return
						end
						if input.UserInputState == Enum.UserInputState.End or (input.Position - start).Magnitude > 12 then
							return -- let go, or the finger moved (scrolling the list)
						end
						held = true
						toggleAuto(item)
					end)
				end)
				row.InputEnded:Connect(function(input)
					if isTap(input) then
						pressId = pressId + 1
						FX.play(fill, 0.15, { Size = UDim2.fromScale(0, 1), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
					end
				end)
				pen.Activated:Connect(function()
					renameItem(item)
				end)
			end
		end

		-- hold a row: it moves between File Scripts and Auto-Executed (Favorites shows both kinds)
		toggleAuto = function(item)
			local neighbour = (category ~= "star") and neighbourOf(item) or nil
			item.autorun = not item.autorun
			callHook("OnAutoExecute", item.name, item.source, item.autorun)
			if category == "star" then
				refreshList() -- the row stays in Favorites, only its bullet changes colour
			else
				removeRow(item, function()
					if selected == item and neighbour then
						selectItem(neighbour, true)
					else
						refreshList()
					end
				end)
			end
		end

