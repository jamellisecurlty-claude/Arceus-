end

function Sys.copy(text)
	Sys.clipboard = text
	local ok, fn = pcall(function()
		return setclipboard or toclipboard
	end)
	if ok and type(fn) == "function" then
		return pcall(fn, text)
	end
	return false
end

function Sys.paste()
	local function try(f)
		local ok, v = pcall(f)
		if ok and type(v) == "function" then
			return v
		end
	end
	local reader = try(function() return getclipboard end)
		or try(function() return fromclipboard end)
		or try(function() return readclipboard end)
		or try(function() return get_clipboard end)
	if reader then
		local good, clip = pcall(reader)
		if good and type(clip) == "string" and clip ~= "" then
			return clip
		end
	end
	return Sys.clipboard
end

