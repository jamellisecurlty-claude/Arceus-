do -- load the saved choice (needs readfile / isfile: without them the colour simply starts as Red every time)
	local okLoad, saved = pcall(function()
		if readfile and isfile and isfile(THEME_FILE) then
			return game:GetService("HttpService"):JSONDecode(readfile(THEME_FILE))
		end
		return nil
	end)
	if okLoad and type(saved) == "table" then
		Theme.data = saved
		local savedFps = tonumber(saved.FpsCap)
		if savedFps and savedFps >= 1 then
			Theme.prefs.FpsCap = math.floor(savedFps)
		end
		local savedSize = tonumber(saved.EditorTextSize)
		if savedSize then
			Theme.prefs.EditorTextSize = math.clamp(math.floor(savedSize + 0.5), 8, 32) -- source: Min = 8, Max = 32
		end
		Theme.prefs.DisableIntro = saved.DisableIntro == true
		local entry = type(saved.PrimaryColor) == "string" and Theme.find(saved.PrimaryColor) or nil
		if entry then
			Theme.cur = themeState(entry)
			Theme.sh = Theme.cur.sh
			PRIMARY = entry.Color
		end
	end
end

-- the file is written a moment after the LAST change (the Editor Text Size buttons can change the value many times a second: one write is enough, and no lag)
function Theme.save()
	if Theme.savePending then
		return
	end
	Theme.savePending = true
	task.delay(0.35, function()
		Theme.savePending = false
		pcall(function()
			if not writefile then
				return
			end
			if makefolder and isfolder and not isfolder("ArcyScripts") then
				makefolder("ArcyScripts")
			end
			writefile(THEME_FILE, game:GetService("HttpService"):JSONEncode(Theme.data))
		end)
	end)
end

-- fn(theme) runs after every colour change (theme = { name, color, dim, sh }). PRIMARY already holds the new colour when it runs
function Theme.onChange(fn)
	Theme.listeners[#Theme.listeners + 1] = fn
end

-- swaps: { { oldColor, newColor }, ... } - every colour property that is EXACTLY an old colour becomes the new one
function Theme.repaint(root, swaps)
	local function fix(inst, prop)
		local current = inst[prop]
		for _, pair in ipairs(swaps) do
			if current == pair[1] then
				inst[prop] = pair[2]
				return
			end
		end
	end
	local function walk(node)
		for _, child in ipairs(node:GetChildren()) do
			if child:GetAttribute("NoTheme") ~= true then
				if child:IsA("GuiObject") then
					fix(child, "BackgroundColor3")
					if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
						fix(child, "TextColor3")
					elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
						fix(child, "ImageColor3")
					elseif child:IsA("ScrollingFrame") then
						fix(child, "ScrollBarImageColor3")
					end
				elseif child:IsA("UIStroke") then
					fix(child, "Color")
				end
				walk(child)
			end
		end
	end
	walk(root)
end

-- Theme.uiScaleOf(object): the product of every UIScale that scales this object (its own and the ones of its parents). A pixel OFFSET inside it is drawn that many times
-- bigger / smaller, so a list that wants "this many real pixels" divides by it. (Scale sizes need no fixing - they follow the parent's real size.)
function Theme.uiScaleOf(inst)
	local k = 1
	local node = inst
	while node and node ~= game do
		local sc = node:FindFirstChildOfClass("UIScale")
		if sc then
			k = k * sc.Scale
		end
		node = node.Parent
	end
	return math.max(k, 0.05)
end

-- Theme.apply("Blue") -> true. Unknown names return false. Settings > Primary Color calls this, and so can your own code.
function Theme.apply(name)
	local entry = Theme.find(name)
	if not entry then
		return false
	end
	local old, new = Theme.cur, themeState(entry)
	if old.name == new.name then
		return true
	end
	Theme.cur, Theme.sh = new, new.sh
	PRIMARY = new.color
	local swaps = { { old.color, new.color }, { old.dim, new.dim } }
	for key, oldColor in pairs(old.sh) do
		swaps[#swaps + 1] = { oldColor, new.sh[key] }
	end
	if Theme.root then
		local okPaint, errPaint = pcall(Theme.repaint, Theme.root, swaps)
		if not okPaint then
			warn("[ArcyHome] Primary Color: the repaint stopped early - " .. tostring(errPaint))
		end
	end
	for _, fn in ipairs(Theme.listeners) do
		pcall(fn, new)
	end
	Theme.data.PrimaryColor = new.name
	Theme.save()
	callHook("OnSetting", "PrimaryColor", new.name, new.color)
	return true
end

