-- LOGGING (readable warnings instead of silent failures)
----------------------------------------------------------------
local LOG_TAG = "[ArcyHome] "

local function logWarn(problem, cause, fix)
	local msg = LOG_TAG .. problem
	if cause then
		msg = msg .. " | Likely cause: " .. cause
	end
	if fix then
		msg = msg .. " | Fix: " .. fix
	end
	warn(msg)
end

-- runs one of your Hooks; an error inside it is reported but never breaks the UI
local function callHook(name, ...)
	local fn = Hooks[name]
	if type(fn) ~= "function" then
		return
	end
	local ok, a, b, c = pcall(fn, ...)
	if not ok then
		logWarn(
			"Hooks." .. name .. " raised an error: " .. tostring(a),
			"the code you put inside Hooks." .. name .. " failed",
			"fix that function - the UI itself keeps working"
		)
		return false
	end
	return true, a, b, c -- true + whatever the hook returned (nil when the hook is missing / returned nothing)
end

