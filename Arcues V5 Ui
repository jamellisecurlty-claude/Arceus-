		----------------------------------------------------------------
		-- CAROUSEL (middle card + the cards next to it, like the source's ContentBar)
		-- barGeo is filled in by layout(): w / h = the middle card, cx = the middle of the bar.
		-- arrangeBar puts every card of the carousel in its slot (FLOW above): the middle one big and on top, the ones next to it shorter,
		-- darker and tucked behind it. animate = slide there; steps = how many places it moves (a longer way takes a little longer);
		-- shift = pixels to add on the x axis (the cards follow your finger while you swipe).
		----------------------------------------------------------------
		local barGeo = { w = 0, h = 0, cx = 0 }
		local flowTweens = setmetatable({}, { __mode = "k" }) -- [card] = the tweens that are moving it right now

		local function stopFlow(card)
			local list = flowTweens[card]
			if list then
				for _, tw in ipairs(list) do
					tw:Cancel()
				end
				flowTweens[card] = nil
			end
		end

		arrangeBar = function(animate, steps, shift)
			if barGeo.w < 4 or barGeo.h < 4 then
				return
			end
			local focus = barFeed.focus
			local time = math.min(FLOW_TIME * math.max(steps or 1, 1), 0.6)
			for i, card in ipairs(barFeed.cards) do
				local d = i - focus
				local slot = FLOW[math.min(math.abs(d), 3)]
				local side = d < 0 and -1 or 1
				local goalPos = UDim2.fromOffset(
					math.floor(barGeo.cx + side * slot.x * barGeo.w + (shift or 0)),
					math.floor(barGeo.h / 2)
				)
				local goalSize = UDim2.fromOffset(barGeo.w, math.max(2, math.floor(barGeo.h * slot.h)))
				local shade = card:FindFirstChild("Shade")
				local title = card:FindFirstChild("Title")
				local desc = title and title:FindFirstChild("Description")
				card.ZIndex = slot.z
				card.Visible = math.abs(d) <= 3 -- the cards further away are far outside the bar anyway
				stopFlow(card)
				if animate and card.Visible then
					local list = { tween(card, time, { Position = goalPos, Size = goalSize }) }
					if shade then
						list[#list + 1] = tween(shade, time, { BackgroundTransparency = 1 - slot.dark })
					end
					if title then
						list[#list + 1] = tween(title, time, { TextTransparency = slot.fade })
					end
					if desc then
						list[#list + 1] = tween(desc, time, { TextTransparency = slot.fade })
					end
					flowTweens[card] = list
				else
					card.Position, card.Size = goalPos, goalSize
					if shade then
						shade.BackgroundTransparency = 1 - slot.dark
					end
					if title then
						title.TextTransparency = slot.fade
					end
					if desc then
						desc.TextTransparency = slot.fade
					end
				end
			end
		end

		----------------------------------------------------------------
		-- FEEDS (one for the carousel, one for the grid): load a page, make its cards, load the next page on demand
		----------------------------------------------------------------
		local function createFeed(container, perPage, isBar)
			local feed = {
				container = container,
				perPage = perPage,
				isBar = isBar, -- the carousel feed: its cards sit in the middle / next-to-the-middle slots
				focus = 1, -- carousel: which card is in the middle
				needInit = isBar, -- carousel: the first page picks the starting card (the 2nd one, like the source)
				swipe = nil,
				swipeMoved = false,
				spec = "",
				search = "",
				gen = 0, -- bumps on every reset, so an answer that arrives late for an old filter is thrown away
				page = 0,
				busy = false,
				done = true,
				failed = false,
				state = "idle", -- "idle" | "loading" | "empty" | "error"
				errorText = nil,
				items = {},
				cards = {},
				seen = {},
			}

			local function clearCards()
				for _, card in ipairs(feed.cards) do
					card:Destroy()
				end
				feed.cards, feed.items, feed.seen = {}, {}, {}
			end

			function feed.loadMore()
				if feed.busy or feed.done or feed.failed or not alive then
					return
				end
				if feed.spec == "server" then -- Server Side games: they come from Hooks.GetServerSideGames, not from ScriptBlox
					feed.busy = true
					feed.state = "loading"
					refreshStatus()
					local serverGen = feed.gen
					task.spawn(function()
						local list, more, serverErr = serverPage(feed.page + 1)
						if serverGen ~= feed.gen or not alive then
							return
						end
						feed.busy = false
						if serverErr and #list == 0 and #feed.items == 0 then -- the list could not load: the grey "tap to try again" message
							feed.failed = true
							feed.state = "error"
							feed.errorText = serverErr
							refreshStatus()
							return
						end
						feed.page = feed.page + 1
						feed.done = not more
						for _, data in ipairs(list or {}) do
							if not feed.seen[data.slug] then
								feed.seen[data.slug] = true
								feed.items[#feed.items + 1] = data
								feed.cards[#feed.cards + 1] = makeServerCard(feed, data, #feed.items)
							end
						end
						feed.state = #feed.items == 0 and "empty" or "idle"
						layout()
						refreshStatus()
						task.defer(checkMore)
					end)
					return
				end
				feed.busy = true
				feed.state = "loading"
				refreshStatus()
				local gen = feed.gen
				task.spawn(function()
					local list, err
					local more = false
					if feed.spec == "favs" then
						list = favList(feed.search)
					else
						local url = buildUrl(feed.spec, feed.search, feed.page + 1, feed.perPage)
						local result, reason = fetchResult(url)
						if result and type(result.scripts) == "table" then
							list = result.scripts
							if feed.spec ~= "trending" and #list > 0 then
								if type(result.totalPages) == "number" then
									more = feed.page + 1 < result.totalPages
								elseif type(result.nextPage) == "number" then
									more = true
								end
							end
						else
							err = reason or "no answer"
						end
					end
					if gen ~= feed.gen or not alive then
						return
					end
					feed.busy = false
					if not list then
						feed.failed = true
						feed.state = "error"
						feed.errorText = err
						logWarn(
							"Cloud Scripts could not load (" .. tostring(feed.spec) .. "): " .. tostring(err),
							"no internet, ScriptBlox is down / rate limiting, or this executor has no request() / game:HttpGet",
							"tap the grey message on the page to try again"
						)
						refreshStatus()
						return
					end
					feed.page = feed.page + 1
					feed.done = not more
					for _, raw in ipairs(list) do
						local data = feed.spec == "favs" and raw or normalize(raw)
						if data and not feed.seen[data.slug] then
							feed.seen[data.slug] = true
							feed.items[#feed.items + 1] = data
							feed.cards[#feed.cards + 1] = makeCard(feed, data, #feed.items)
						end
					end
					feed.state = #feed.items == 0 and "empty" or "idle"
					layout()
					refreshStatus()
					task.defer(checkMore)
				end)
			end

			function feed.reset(spec)
				feed.gen = feed.gen + 1
				feed.spec = spec
				feed.page = 0
				feed.busy, feed.done, feed.failed = false, false, false
				feed.state = "idle"
				clearCards()
				feed.focus, feed.needInit = 1, isBar == true
				layout()
				feed.loadMore()
			end

			function feed.retry()
				if feed.spec == "server" then
					resetServerMemo() -- the failed answer is remembered per page: ask again (the carousel and the grid fail together)
					barFeed.reset("server")
					gridFeed.reset("server")
					return
				end
				feed.failed = false
				feed.loadMore()
			end

			function feed.clear() -- empties the feed and loads nothing (the LocalScripts view hides the carousel)
				feed.gen = feed.gen + 1
				feed.spec = ""
				feed.page = 0
				feed.busy, feed.done, feed.failed = false, true, false
				feed.state = "idle"
				clearCards()
				feed.focus, feed.needInit = 1, isBar == true
			end

			if isBar then
				-- bring card i to the middle (animate = slide). Near the end the next page is asked for
				function feed.setFocus(i, animate)
					local n = #feed.cards
					if n == 0 then
						return
					end
					i = math.clamp(i, 1, n)
					local steps = math.abs(i - feed.focus)
					feed.focus = i
					arrangeBar(animate, steps)
					if i >= n - 3 then
						feed.loadMore()
					end
				end

				-- a card was tapped: true = it is the middle card (open it), false = it only moved to the middle / it was a swipe
				function feed.tapCard(card)
					if feed.swipeMoved then
						return false
					end
					local i = table.find(feed.cards, card)
					if not i then
						return false
					end
					if i == feed.focus then
						return true
					end
					feed.setFocus(i, true)
					return false
				end

				-- a finger / the mouse went down on the carousel
				function feed.beginSwipe(input)
					feed.swipeMoved = false
					feed.swipe = { input = input, startX = input.Position.X }
					scroll.ScrollingEnabled = true
				end
			end

			return feed
		end

		barFeed = createFeed(bar, BAR_PER_PAGE, true)
		gridFeed = createFeed(gridHolder, GRID_PER_PAGE, false)

		-- swipe the carousel: the cards follow your finger, then the next / previous card snaps into the middle.
		-- (pressing on the empty part of the bar works too; the page does not scroll up / down while you swipe sideways)
		bar.InputBegan:Connect(function(input)
			if isTap(input) then
				barFeed.beginSwipe(input)
			end
		end)
		keepConn(UserInputService.InputChanged:Connect(function(input)
			local sw = barFeed.swipe
			if not sw or not (input == sw.input or input.UserInputType == Enum.UserInputType.MouseMovement) then
				return
			end
			local dx = input.Position.X - sw.startX
			if not barFeed.swipeMoved and math.abs(dx) > 10 then
				barFeed.swipeMoved = true
				scroll.ScrollingEnabled = false
			end
			if barFeed.swipeMoved then
				local n = #barFeed.cards
				local shift = dx / math.max(popScale.Scale, 0.05) -- screen pixels -> window pixels
				if (barFeed.focus == 1 and dx > 0) or (barFeed.focus == n and dx < 0) then
					shift = shift * 0.35 -- rubber band at the first / last card
				end
				arrangeBar(false, 0, shift * 0.9)
			end
		end))
		keepConn(UserInputService.InputEnded:Connect(function(input)
			local sw = barFeed.swipe
			if sw and (input == sw.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
				barFeed.swipe = nil
				scroll.ScrollingEnabled = true
				if barFeed.swipeMoved then
					local dx = input.Position.X - sw.startX
					local need = bar.AbsoluteSize.X * 0.1
					if dx <= -need then
						barFeed.setFocus(barFeed.focus + 1, true)
					elseif dx >= need then
						barFeed.setFocus(barFeed.focus - 1, true)
					else
						barFeed.setFocus(barFeed.focus, true) -- not far enough: spring back
					end
				end
			end
		end))

		local function statusText(feed, onlyWhenEmpty)
			if onlyWhenEmpty and #feed.items > 0 then
				return ""
			end
			local noun = feed.spec == "server" and "servers" or "scripts"
			if feed.state == "loading" then
				return #feed.items == 0 and ("Loading " .. noun .. "...") or "Loading more..."
			elseif feed.state == "error" then
				return "Couldn't load " .. noun .. " - tap to try again"
			elseif feed.state == "empty" then
				if feed.spec == "favs" then
					return "No favourites yet - tap the star on a script"
				end
				return "No " .. noun .. " found"
			end
			return ""
		end

		refreshStatus = function()
			local barText, footText = statusText(barFeed, true), statusText(gridFeed, false)
			barStatus.Text, barStatus.Visible = barText, barText ~= ""
			footer.Text, footer.Visible = footText, footText ~= ""
		end

		barStatus.Activated:Connect(function()
			if barFeed.state == "error" then
				barFeed.retry()
			end
		end)
		footer.Activated:Connect(function()
			if gridFeed.state == "error" then
				gridFeed.retry()
			end
		end)

		-- the star: add / remove a favourite, refresh every star that shows the same script
		toggleFav = function(data)
			if favs[data.slug] then
				favs[data.slug] = nil
			else
				local meta = {}
				for key, value in pairs(data) do
					if key ~= "script" then
						meta[key] = value
					end
				end
				meta.favTime = os.time()
				favs[data.slug] = meta
			end
			saveFavs()
			for _, feed in ipairs({ barFeed, gridFeed }) do
				for _, card in ipairs(feed.cards) do
					local info = cardInfo[card]
					if info then
						info.icon.Image = favs[info.slug] and A.StarOnIcon or A.StarIcon
					end
				end
			end
			if gridFeed.spec == "favs" then
				gridFeed.reset("favs") -- an un-starred script leaves the Favourites list
			end
			if bridge.onFavChanged then
				pcall(bridge.onFavChanged) -- the stars on the Home Best Scripts cards
			end
		end

		----------------------------------------------------------------
		-- SCRIPT CARD (the picture you get when you tap a script)
		-- Rebuilt from the source's "CloudScriptInfo" popup: layout numbers, fonts and every asset id are the source's.
		--   * background = the script's own picture (stretched over the whole window) under a soft grey / black gradient
		--   * title top-left, the picture in a big rounded frame on a red glow, "Creation date:" + how long ago
		--   * game icon + game name at the bottom-left ("Universal Script 📌" for universal scripts)
		--   * DESCRIPTION box (the script's description is downloaded from ScriptBlox when the card opens, long text scrolls)
		--   * four tiles bottom-right: Favourite (star), Edit (pencil), Copy, Execute (play)
		-- The tiles WORK: Execute runs the script (Hooks.OnRun), Copy puts it on the clipboard, Edit opens it as a new file in the Editor, the star uses the
		-- same favourites as the cards. The red close button closes the card first (a second press closes the window).
		----------------------------------------------------------------
		do
			local DESC_TEXT_SCALE = 1 -- description text size: 1 = like the reference (source: padding * 1.5). 1.3 = bigger
			local OPEN_TIME = 0.35 -- seconds the card takes to fade / pop in
			local CLOSE_TIME = 0.2 -- seconds it takes to fade out
			local CARD_Z = 45 -- above the sidebar / pages / drag strip (40), below the maximize + close buttons (50)
			local ITALIC = font(Enum.FontWeight.Medium, Enum.FontStyle.Italic) -- source: Fonts_HeadingItalic
			local GLOW_RED = Color3.fromHex("#FF0000") -- source: the glow behind the picture

			local detailCache = {}
			local current = nil -- the card that is open right now

			----------------------------------------------------------------
			-- dates: "2026-10-20T12:00:00.000Z" -> "Yesterday" / "3 days ago" ...
			----------------------------------------------------------------
			local function isoToUnix(iso)
				if type(iso) ~= "string" then
					return nil
				end
				local y, m, d, hh, mm, ss = string.match(iso, "^(%d+)-(%d+)-(%d+)[T ](%d+):(%d+):(%d+)")
				if not y then
					return nil
				end
				y, m, d, hh, mm, ss = tonumber(y), tonumber(m), tonumber(d), tonumber(hh), tonumber(mm), tonumber(ss)
				-- days since 1970-01-01 (proleptic Gregorian, UTC)
				if m <= 2 then
					y = y - 1
				end
				local era = math.floor(y / 400)
				local yoe = y - era * 400
				local mp = (m + 9) % 12
				local doy = math.floor((153 * mp + 2) / 5) + d - 1
				local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
				local days = era * 146097 + doe - 719468
				return days * 86400 + hh * 3600 + mm * 60 + ss
			end

			local function agoText(iso)
				local t = isoToUnix(iso)
				if not t then
					return "N/A"
				end
				local days = math.floor((os.time() - t) / 86400)
				if days < 1 then
					return "Today"
				elseif days == 1 then
					return "Yesterday"
				elseif days < 7 then
					return days .. " days ago"
				elseif days < 30 then
					local w = math.floor(days / 7)
					return w == 1 and "1 week ago" or (w .. " weeks ago")
				elseif days < 365 then
					local mo = math.floor(days / 30)
					return mo == 1 and "1 month ago" or (mo .. " months ago")
				end
				local yr = math.floor(days / 365)
				return yr == 1 and "1 year ago" or (yr .. " years ago")
			end

			----------------------------------------------------------------
			-- data: the description (and the real "created" date) come from ScriptBlox /api/script/<slug>
			----------------------------------------------------------------
			local function fetchDetails(slug)
				if detailCache[slug] then
					return detailCache[slug]
				end
				local url = BASE_URL .. "/api/script/" .. slug
				for attempt = 1, 3 do
					local body = httpGet(url)
					if body then
						local ok, decoded = pcall(function()
							return HttpService:JSONDecode(body)
						end)
						if ok and type(decoded) == "table" and type(decoded.script) == "table" then
							local s = decoded.script
							local info = {
								features = type(s.features) == "string" and s.features or "",
								createdAt = s.createdAt,
								updatedAt = s.updatedAt,
								script = s.script,
							}
							detailCache[slug] = info
							return info
						end
					end
					if attempt < 3 then
						task.wait(1)
					end
				end
				return nil
			end

			----------------------------------------------------------------
			-- closing
			----------------------------------------------------------------
			local function destroyCard()
				local card = current
				if not card then
					return
				end
				current = nil
				card.dead = true
				for _, conn in ipairs(card.conns) do
					pcall(function()
						conn:Disconnect()
					end)
				end
				if card.breath then
					pcall(function()
						card.breath:Cancel()
					end)
				end
				pcall(function()
					card.root:Destroy()
				end)
				navBtn.Visible = true
			end

			local function startClose()
				local card = current
				if not card then
					return false
				end
				if card.closing then
					return true
				end
				card.closing = true
				if card.breath then
					pcall(function()
						card.breath:Cancel()
					end)
				end
				for _, f in ipairs(card.fades) do
					TweenService:Create(f.inst, TweenInfo.new(CLOSE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { [f.prop] = 1 }):Play()
				end
				tween(card.inner, CLOSE_TIME, { Position = UDim2.fromScale(0, 0.03) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(CLOSE_TIME + 0.03, function()
					if current == card then
						destroyCard()
					end
				end)
				return true
			end

			popupRefs.close = startClose -- the red close button
			popupRefs.destroy = destroyCard -- the window closing

