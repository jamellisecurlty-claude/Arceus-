				AutoButtonColor = false,
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = overlay,
			})
			local title = new("TextLabel", {
				Name = "Title",
				Text = L.PromptTitle or "Instant code with Arcy",
				FontFace = montserrat(Enum.FontWeight.Bold),
				TextColor3 = WHITE, -- the gradient paints the colours
				TextSize = u * 6,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0.13), -- slides up to 0.1
				Size = UDim2.fromScale(0.8, 0.2),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 3,
				Parent = overlay,
			}, {
				new("UIPadding", { PaddingTop = UDim.new(0, u), PaddingBottom = UDim.new(0, u) }),
				new("UIGradient", { Color = PROMPT_TITLE_COLORS, Rotation = 210 }),
