		})

		local editor = new("Frame", {
			Name = "Editor",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0.03, 0.95),
			Size = UDim2.fromScale(0.65, 0.8),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = page,
		}, { corner(0.05) })

		local files = new("Frame", {
			Name = "Files",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0.702, 0.95),
			Size = UDim2.fromScale(0.27, 0.8),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = page,
		}, { corner(0.08) })

		----------------------------------------------------------------
		-- CODE AREA (line numbers + text box + highlighted view)
		----------------------------------------------------------------
		-- code + line number text size in pixels: Settings > Editor Text Size (8..32, 16 = default). Kept in sync by applyTextSize below.
		local EDITOR_TEXT_SIZE = math.clamp(math.floor((tonumber(Theme.prefs.EditorTextSize) or Theme.TEXT_SIZE.Default) + 0.5), Theme.TEXT_SIZE.Min, Theme.TEXT_SIZE.Max)
		local CODE_X = 42
		local codeScroll = new("ScrollingFrame", {
