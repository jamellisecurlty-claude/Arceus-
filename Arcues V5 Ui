	end

	-- Instance.new + properties + children in one call (Parent is set last)
	local function new(className, props, children)
		local inst = Instance.new(className)
		local parent = props.Parent
		props.Parent = nil
		for k, v in pairs(props) do
			inst[k] = v
		end
		for _, child in ipairs(children or {}) do
			child.Parent = inst
		end
		inst.Parent = parent
		return inst
	end

	-- the default licence check: only the emails in LICENSE.Allowed (no list = any email). Returns accepted, message
	local function checkLicense(email)
		local L = LoadingScreen.LICENSE
		local list = L.Allowed
		if type(list) ~= "table" or #list == 0 then
			return true, nil
		end
		local want = string.lower(email)
		for _, allowed in ipairs(list) do
			if string.lower(tostring(allowed)) == want then
				return true, "Welcome!"
			end
		end
		return false, L.DeniedText or "This email has no license."
	end

