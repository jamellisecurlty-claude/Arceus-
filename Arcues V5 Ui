-- PRIMARY COLOR (Settings tab > Primary Color)
----------------------------------------------------------------
-- PRIMARY (above) is a plain variable. Theme.apply("Blue") changes it, so everything built or repainted afterwards uses the new colour, and it also
-- repaints what is already on screen: every object inside the window whose colour is EXACTLY the old PRIMARY / dim(PRIMARY) / hub red shade gets the new one
-- (see Theme.repaint; anything marked with the attribute NoTheme is skipped). The choice is kept in ArcyScripts/_settings.json and is loaded here, before the UI
-- is built, so the window opens in the saved colour. Things with a colour of their own keep it: the Arcy glow gradient, toasts, the red
-- glow behind a script picture.
local Theme = {
	listeners = {},
	data = {},
	-- the other saved Settings (the source's Setting_Fps / FontSizes_Editor / User_Intro): FPS Cap, Editor Text Size and Disable Intro
	prefs = { FpsCap = 60, EditorTextSize = 16, DisableIntro = false },
	prefListeners = {},
}
local THEME_FILE = "ArcyScripts/_settings.json"

-- PERFORMANCE GOVERNOR: watches the frame rate and tells the animated glows to redraw less often while the game is struggling
-- (Theme.Perf.scale: 1 = normal, 2 = half as often, 3 = a third as often). It goes back to 1 by itself once the frame rate is healthy again.
Theme.Perf = { scale = 1 }
do
	local perf = Theme.Perf
	local avg, clock, slow, fast = 1 / 60, 0, 0, 0
	perf.conn = RunService.Heartbeat:Connect(function(dt)
		if dt > 0.25 then
			return -- a loading hitch, not real load
		end
		avg = avg + (dt - avg) * 0.05
		clock = clock + dt
		if clock < 1 then
			return
		end
		clock = 0
		if avg > 1 / 36 then
			slow, fast = slow + 1, 0
			if slow >= 2 and perf.scale < 3 then
				perf.scale, slow = perf.scale + 1, 0
			end
		elseif avg < 1 / 52 then
			fast, slow = fast + 1, 0
			if fast >= 8 and perf.scale > 1 then
				perf.scale, fast = perf.scale - 1, 0
			end
		else
			slow, fast = 0, 0
		end
	end)
end

