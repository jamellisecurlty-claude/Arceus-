-- Red close button = the window shrinks away and the floating button pops in (see FLOATING BUTTON below).
-- Tapping the floating button (or one of its tab icons) opens the window again. Nothing is destroyed.
local showFloat, hideFloat -- filled in by the FLOATING BUTTON section

local popupRefs = {} -- filled in by the Cloud Scripts page: close() closes the open script card (returns true if there was one), destroy() removes it at once

local function openWindow(tabName)
	if windowState ~= "hidden" then
		return
	end
	windowState = "opening"
	if hideFloat then
		pcall(hideFloat)
	end
	callHook("OnOpen", tabName)
	if tabName then
		callHook("OnTab", tabName) -- the script has a single page, so this is where you would switch pages
	end
	popScale.Scale = 0.3
	main.BackgroundTransparency = 1
	bgImage.ImageTransparency = 1
	main.Visible = true
	tween(main, 0.3, { BackgroundTransparency = BG_BASE_TRANSPARENCY })
	tween(bgImage, 0.3, { ImageTransparency = BG_IMAGE_TRANSPARENCY })
	tween(popScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	task.delay(0.55, function()
		if windowState == "opening" then
			windowState = "open"
		end
	end)
end

local function closeWindow()
	if windowState ~= "open" and windowState ~= "opening" then
		return
	end
	windowState = "closing"
	callHook("OnClose")
	-- the window shrinks away while its background fades (a plain Frame cannot fade as a group)
	tween(main, 0.2, { BackgroundTransparency = 1 })
	tween(bgImage, 0.2, { ImageTransparency = 1 })
	local finished = false
	local function finish()
		if finished or not alive then
			return
		end
		finished = true
		main.Visible = false
		if popupRefs.destroy then
			pcall(popupRefs.destroy) -- an open script card is gone when the window comes back
		end
		windowState = "hidden"
		-- the floating button is the only way back, so if it ever fails the window simply stays open
		local ok, err = pcall(showFloat)
		if not ok then
			logWarn(
				"The floating button failed: " .. tostring(err),
				"something it needs was renamed or removed",
				"the window is reopened instead"
			)
			openWindow()
		end
	end
	tween(popScale, 0.22, { Scale = 0.05 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(finish)
	task.delay(0.6, finish) -- safety net in case the fade never reports completion
end

