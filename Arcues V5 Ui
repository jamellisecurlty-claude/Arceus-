				----------------------------------------------------------------
				-- TILE ANIMATIONS (no text: the tile itself answers the tap)
				----------------------------------------------------------------
				local function iconScale(icon)
					local sc = icon:FindFirstChild("FxScale")
					if not sc then
						sc = new("UIScale", { Name = "FxScale", Parent = icon })
					end
					return sc
				end

				-- the icon squashes and springs back
				local function squash(icon, low, high)
					if not icon or card.dead then
						return
					end
					local sc = iconScale(icon)
					sc.Scale = low or 0.6
					local tw = tween(sc, 0.18, { Scale = high or 1.28 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					tw.Completed:Once(function()
						if not card.dead then
							tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
						end
					end)
				end

				-- a glow grows out of the tile and fades away (glow only: no ring / stroke)
				local function burst(icon, glowImage, delay)
					local tile = icon and icon.Parent
					if not tile or card.dead then
						return
					end
					task.delay(delay or 0, function()
						if card.dead or not tile.Parent then
							return
						end
						local glow = new("ImageLabel", {
							Name = "FxGlow",
							Image = glowImage,
							ImageTransparency = 0.1,
							ScaleType = Enum.ScaleType.Fit,
							AnchorPoint = Vector2.new(0.5, 0.5),
							Position = UDim2.fromScale(0.5, 0.5),
							Size = UDim2.fromScale(1.1, 1.1),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							ZIndex = 98,
							Parent = tile,
						})
						tween(glow, 0.7, { Size = UDim2.fromScale(2.7, 2.7), ImageTransparency = 1 })
						task.delay(0.8, function()
							pcall(function()
								glow:Destroy()
							end)
						end)
					end)
				end

				-- a copy of the icon drifts away from the tile and fades out (dx / dy = how far, as a fraction of the tile)
				local function ghost(icon, dx, dy, grow)
					local tile = icon and icon.Parent
					if not tile or card.dead then
						return
					end
					local g = icon:Clone()
					g.Name = "FxGhost"
					g.ZIndex = 102
					for _, child in ipairs(g:GetChildren()) do
						if child:IsA("UIScale") then
							child:Destroy()
						end
					end
					g.Parent = tile
					local sc = new("UIScale", { Scale = 1, Parent = g })
					tween(g, 0.55, {
						Position = UDim2.fromScale(0.5 + dx, 0.5 + dy),
						ImageTransparency = 1,
					}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					tween(sc, 0.55, { Scale = grow or 1.3 })
					task.delay(0.65, function()
						pcall(function()
							g:Destroy()
						end)
					end)
				end

				-- the icon lights up for a moment and fades back to its own colour
				local function flashIcon(icon, color)
					if not icon or card.dead then
						return
					end
					local base = icon:GetAttribute("BaseColor")
					if not base then
						base = icon.ImageColor3
						icon:SetAttribute("BaseColor", base)
					end
					icon.ImageColor3 = color
					tween(icon, 0.7, { ImageColor3 = base }, Enum.EasingStyle.Quad)
				end

				-- COPY: the icon squashes, a green glow spreads out of the tile and a copy of the icon floats up
				local function fxCopy(icon)
					flashIcon(icon, GREEN)
					squash(icon, 0.6, 1.25)
					burst(icon, A.ToastGlowSuccess, 0)
					ghost(icon, 0, -0.9, 1.35)
				end

				-- EXECUTE: the play icon winds up and launches, blue glow waves leave the tile and a copy of the icon shoots to the right.
				-- (the whole window glows too - see glowWindow - exactly like the Editor's Execute)
				local function fxExecute(icon)
					flashIcon(icon, RUN_BLUE)
					squash(icon, 0.55, 1.35)
					burst(icon, A.ToastGlow, 0)
					burst(icon, A.ToastGlow, 0.18)
					ghost(icon, 0.75, 0, 1.5)
				end

				-- a problem: the icon shakes and a red glow flashes
				local function fxFail(icon)
					if not icon or card.dead then
						return
					end
					flashIcon(icon, BAD)
					burst(icon, A.ToastGlowError, 0)
					task.spawn(function()
						for _, rot in ipairs({ -14, 12, -8, 5, 0 }) do
							if card.dead then
								return
							end
							icon.Rotation = rot
							task.wait(0.055)
						end
					end)
				end

				-- the script's Lua code: already in the card's data, else downloaded from ScriptBlox (favourites do not keep the code)
				local function getSource()
					if type(data.script) == "string" and string.find(data.script, "%S") then
						return data.script
					end
					local info = fetchDetails(data.slug)
					if info and type(info.script) == "string" and string.find(info.script, "%S") then
						data.script = info.script
						return info.script
					end
					return nil
				end

				-- runs a tile's work off the UI thread (it may download the script), and ignores a second tap on the same tile for half a second
				local busy = {}
				local function perform(name, icon, work)
					if busy[name] or card.dead then
						return
					end
					busy[name] = true
					task.spawn(function()
						local ok, err = pcall(work)
						if not ok then
							logWarn(
								"The script card tile '" .. name .. "' failed: " .. tostring(err),
								"the script could not be downloaded or something it needs is missing",
								"tap the tile again; if it keeps failing check your connection"
							)
							fxFail(icon)
						end
						task.wait(0.5)
						busy[name] = nil
					end)
				end

				local starIcon, editIcon, copyIcon, runIcon

				-- FAVOURITE: the same favourites as the cards (saved in ArcyScripts/_cloudfavs.json)
				starIcon = makeTile("FavouriteTile", UDim2.fromScale(0.675, 1), UDim2.fromScale(0.112, 0.133), 1.125, A.SmallTile,
					favs[data.slug] and A.StarOnIcon or A.StarIcon, UDim2.fromScale(0.75, 0.75), STAR_YELLOW, function()
						toggleFav(data)
						starIcon.Image = favs[data.slug] and A.StarOnIcon or A.StarIcon
						action("favourite")
					end)

				-- EDIT: the script becomes a new file in the Executor tab's File Scripts and the editor opens on it
				editIcon = makeTile("EditTile", UDim2.fromScale(0.78, 1), UDim2.fromScale(0.112, 0.133), 1.125, A.SmallTile,
					A.EditIcon, UDim2.fromScale(0.75, 0.75), nil, function()
						perform("edit", editIcon, function()
							local src = getSource()
							if card.dead then
								return
							end
							if not src then
								fxFail(editIcon)
								errorToast("Edit", "Couldn't get the script. Check your connection")
								return
							end
							if not homeRefs.openInEditor then
								fxFail(editIcon)
								errorToast("Edit", "The editor is not available")
								return
							end
							flashIcon(editIcon, GREEN)
							action("edit")
							startClose() -- the card fades away ...
							homeRefs.openInEditor(data.title, src) -- ... and the editor opens behind it
						end)
					end)

				-- COPY: the script goes to the clipboard (the editor's Paste button can use it too)
				copyIcon = makeTile("CopyTile", UDim2.fromScale(0.885, 1), UDim2.fromScale(0.112, 0.133), 1.125, A.SmallTile,
					A.CopyIcon, UDim2.fromScale(0.75, 0.75), nil, function()
						perform("copy", copyIcon, function()
							local src = getSource()
							if card.dead then
								return
							end
							if not src then
								fxFail(copyIcon)
								errorToast("Copy", "Couldn't get the script. Check your connection")
								return
							end
							Sys.copy(src)
							fxCopy(copyIcon)
							action("copy")
						end)
					end)

				-- EXECUTE: runs the script through Hooks.OnRun (the same path as the Editor's play button).
				--   * a compile problem or a script error in the first 3 seconds shows the red toast and shakes the tile
				--   * if the copy that came with the list does not compile (lists can cut long scripts), the script is downloaded
				--     again from its own page and tried once more
				runIcon = makeTile("ExecuteTile", UDim2.fromScale(1.06, 1.1075), UDim2.fromScale(0.35, 0.35), 1.117, A.RunTile,
					A.RunIcon, UDim2.fromScale(0.3, 0.3), nil, function()
						perform("execute", runIcon, function()
							local src = getSource()
							if not src then
								fxFail(runIcon)
								errorToast("Execute", "Couldn't get the script. Check your connection")
								return
							end
							local title = data.title or "Cloud Script"
							local started = os.clock()
							local opts = {
								quiet = true,
								onError = function(msg)
									if os.clock() - started < 3 then -- it died right away: tell the person (later errors only go to the Output)
										fxFail(runIcon)
										errorToast("Execute", "Script error: " .. string.sub(msg, 1, 90))
									end
								end,
							}
							local called, ok, why, kind = callHook("OnRun", title, src, opts)
							if called and ok == false and kind == "syntax" then
								local info = fetchDetails(data.slug)
								if info and type(info.script) == "string" and info.script ~= src and string.find(info.script, "%S") then
									data.script = info.script
									called, ok, why, kind = callHook("OnRun", title, info.script, opts)
								end
							end
							if not called then
								fxFail(runIcon)
								errorToast("Execute", "Execute is not available (Hooks.OnRun)")
								return
							end
							if ok == false then
								fxFail(runIcon)
								errorToast("Execute", tostring(why or "The script could not run"))
								return
							end
							fxExecute(runIcon)
							pcall(glowWindow) -- the whole window lights up, like the Editor's Execute
							action("execute")
						end)
					end)

				-- PLAY IN
				for _, f in ipairs(card.fades) do
					TweenService:Create(f.inst, TweenInfo.new(OPEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, f.delay), { [f.prop] = f.target }):Play()
				end
				TweenService:Create(inner, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0, 0) }):Play()
				TweenService:Create(glowScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.05), { Scale = 1 }):Play()
				for _, t in ipairs(tiles) do
					TweenService:Create(t.scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, t.delay), { Scale = 1 }):Play()
				end
				task.delay(OPEN_TIME + 0.2, function() -- the red glow breathes
					if card.dead or card.closing then
						return
					end
					card.breath = TweenService:Create(glow, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { ImageTransparency = 0.4 })
					card.breath:Play()
				end)

				-- PICTURE: the one the card already downloaded, else download it, else the game's own icon
				local function setPicture(asset, url)
					if card.dead or type(asset) ~= "string" then
						return
					end
					bg.Image = asset -- the window backdrop keeps the whole picture (the blur looks fine behind the shade)
					thumb.Image = asset
					applyTrim(thumb, url)
					if thumbDeer.Parent then
						thumbDeer:Destroy()
					end
				end
				task.spawn(function()
					local asset = data.imageUrl and imageAssets[data.imageUrl]
					if not asset and data.imageUrl then
						local ok, result = pcall(loadAsset, data.imageUrl, data.imageName, data.imageExt)
						asset = ok and result or nil
					end
					local usedUrl = asset and data.imageUrl or nil
					if not asset and not data.universal then
						asset = gameIconFor(data.gameId)
					end
					if asset and alive then
						setPicture(asset, usedUrl)
					end
				end)

				-- DESCRIPTION (+ the exact created date) from ScriptBlox
				task.spawn(function()
					local info = fetchDetails(data.slug)
					if card.dead or not alive then
						return
					end
					if info then
						data.features = info.features
						data.updatedAt = data.updatedAt or info.updatedAt
						data.script = data.script or info.script
						if not data.createdAt and info.createdAt then
							data.createdAt = info.createdAt
							createdValue.Text = agoText(info.createdAt)
						end
						descText.Text = info.features ~= "" and info.features or "No description."
					else
						descText.Text = "Couldn't load the description. Check your connection and open the script again."
					end
				end)
			end
		end

		----------------------------------------------------------------
		-- LAYOUT (everything is placed from the scroll area's height, so it follows small / medium / full screen)
		----------------------------------------------------------------
		layout = function()
			local size = unscaledSize(scroll)
			local W, H = size.X, size.Y
			if W < 40 or H < 40 then
				return
			end
			local padX = math.floor(W * 0.03)
			local innerW = W - padX * 2
			local fs = math.max(8, math.floor(H * 0.034)) -- filter / status text size
			local lift = scriptMode == "local" and math.floor(H * 0.58) or 0 -- LocalScripts hides the carousel: the categories move up into its place

			-- header
			lets.Position = UDim2.fromOffset(0, 0)
			lets.Size = UDim2.fromOffset(math.floor(innerW * 0.4), math.floor(H * 0.05))
			title.Position = UDim2.fromOffset(0, math.floor(H * 0.05))
			title.Size = UDim2.fromOffset(math.floor(innerW * 0.45), math.floor(H * 0.085))
			topFilters.row.Position = UDim2.fromOffset(0, math.floor(H * 0.15))
			topFilters.row.Size = UDim2.fromOffset(math.floor(innerW * 0.5), math.floor(H * 0.09))

			local logoH = math.floor(H * 0.11)
			local logoW = math.floor(logoH * 2.098)
			logo.Position = UDim2.fromOffset(innerW, 0)
			logo.Size = UDim2.fromOffset(logoW, logoH)
			powered.Position = UDim2.fromOffset(innerW - logoW - math.floor(W * 0.008), math.floor(logoH / 2))
			powered.Size = UDim2.fromOffset(math.floor(innerW * 0.2), math.floor(H * 0.06))

			search.Position = UDim2.fromOffset(innerW, math.floor(H * 0.175))
			search.Size = UDim2.fromOffset(math.floor(innerW * 0.25), math.floor(H * 0.08))
			search.TextSize = math.max(8, math.floor(H * 0.034))

			-- carousel: the middle card is 16:9, the cards next to it stick out 1.15 card widths to each side (so the card must fit in 1/2.3 of the width)
			local barTop = math.floor(H * 0.27)
			local cardH = math.floor(H * 0.43)
			local barCardW = math.floor(cardH / CARD_RATIO)
			local maxCardW = math.floor(innerW / 2.3)
			if barCardW > maxCardW then
				barCardW = maxCardW
				cardH = math.floor(barCardW * CARD_RATIO)
			end
			bar.Position = UDim2.fromOffset(0, barTop)
			bar.Size = UDim2.fromOffset(innerW, cardH)
			barGeo.w, barGeo.h, barGeo.cx = barCardW, cardH, math.floor(innerW / 2)
			if barFeed.needInit and #barFeed.cards > 0 then
				barFeed.needInit = false
				barFeed.focus = #barFeed.cards >= 3 and 2 or 1 -- source: with 3 or more cards the 2nd one starts in the middle
			end
			arrangeBar(false)
			barStatus.Position = UDim2.fromOffset(0, barTop)
			barStatus.Size = UDim2.fromOffset(innerW, cardH)

			-- categories
			subtitle.Position = UDim2.fromOffset(0, math.floor(H * 0.75) - lift)
			subtitle.Size = UDim2.fromOffset(math.floor(innerW * 0.3), math.floor(H * 0.045))
			allLabel.Position = UDim2.fromOffset(0, math.floor(H * 0.795) - lift)
			allLabel.Size = UDim2.fromOffset(math.floor(innerW * 0.3), math.floor(H * 0.08))
			gridFilters.row.AnchorPoint = Vector2.new(1, 0)
			gridFilters.row.Position = UDim2.fromOffset(innerW, math.floor(H * 0.79) - lift)
			gridFilters.row.Size = UDim2.fromOffset(math.floor(innerW * 0.6), math.floor(H * 0.09))

			for _, group in ipairs({ topFilters, gridFilters }) do
				for _, entry in pairs(group.buttons) do
					entry.button.TextSize = fs
					local d = math.max(3, math.floor(fs * 0.3))
					entry.dot.Size = UDim2.fromOffset(d, d)
					entry.dot.Position = UDim2.new(0.5, 0, 0.5, math.floor(fs * 0.95))
				end
			end

			-- grid
			local gridTop = math.floor(H * 0.9) - lift
			local gap = math.floor(W * 0.027)
			local cellW = math.floor((innerW - gap * (COLUMNS - 1)) / COLUMNS)
			local cellH = math.floor(cellW * CARD_RATIO)
			local rows = math.ceil(#gridFeed.cards / COLUMNS)
			local gridH = rows > 0 and (rows * cellH + (rows - 1) * gap) or 0
			gridLayout.CellSize = UDim2.fromOffset(cellW, cellH)
			gridLayout.CellPadding = UDim2.fromOffset(gap, gap)
			gridHolder.Position = UDim2.fromOffset(0, gridTop)
			gridHolder.Size = UDim2.fromOffset(innerW, gridH)

			-- footer ("Loading more...", errors) and the scroll length
			local footerH = math.floor(H * 0.12)
			footer.Position = UDim2.fromOffset(0, gridTop + gridH + math.floor(H * 0.01))
			footer.Size = UDim2.fromOffset(innerW, footerH)
			barStatus.TextSize = fs
			footer.TextSize = fs

			local total = gridTop + gridH + math.floor(H * 0.01) + footerH + math.floor(H * 0.05)
			inner.Position = UDim2.fromOffset(padX, 0)
			inner.Size = UDim2.fromOffset(innerW, total)
			scroll.CanvasSize = UDim2.fromOffset(0, total)
		end

		-- the next page loads when you get close to the end of the grid (down) or the carousel (sideways)
		checkMore = function()
			if not page.Visible or not alive then
				return
			end
			local s = unscaledSize(scroll)
			if scroll.CanvasPosition.Y + s.Y >= scroll.CanvasSize.Y.Offset - s.Y * MORE_MARGIN then
				gridFeed.loadMore()
			end
			if barFeed.focus >= #barFeed.cards - 3 then -- the middle card is close to the last one: ask for the next page
				barFeed.loadMore()
			end
		end

		scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
		scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(checkMore)

		-- search (like the source: the keywords apply to the carousel and the grid; Trending ignores them)
		-- Tapping the box opens the Instant-code prompt titled "Search Some Script"; the window is invisible while it is open.
		do
			local lastSearch = ""
			local function runSearch(raw)
				local text = string.match(raw or "", "^%s*(.-)%s*$") or ""
				search.Text = text -- the box shows what was searched
				if text == lastSearch then
					return
				end
				lastSearch = text
				barFeed.search = text
				gridFeed.search = text
				serverSearch = text
				if not loaded then
					return
				end
				if scriptMode == "local" then
					gridFeed.reset("favs")
				elseif scriptMode == "cloud" then
					if barSpec ~= "trending" then
						barFeed.reset(barSpec)
					end
					gridFeed.reset(gridSpec)
				elseif scriptMode == "server" then -- Find server: the search applies to the carousel and the grid, Popular / Trending keep working
					resetServerMemo()
					barFeed.reset("server")
					gridFeed.reset("server")
				end
			end
			-- empties the box and every search (the Server view and the other views do not share a search)
			resetSearch = function()
				lastSearch = ""
				search.Text = ""
				barFeed.search, gridFeed.search = "", ""
				serverSearch = ""
			end
			local tap = inner:FindFirstChild("CloudSearchTap")
			if tap then
				tap.Activated:Connect(function()
					local findingServer = scriptMode == "server"
					openInstantCode({
						title = findingServer and "Find Server" or "Search Some Script",
						placeholder = findingServer and "Find server..." or nil, -- nil = the prompt's normal hint
						text = lastSearch,
						allowEmpty = true, -- clearing the text and closing shows all scripts again
						hideGui = true, -- the whole GUI is invisible while you type
						onSubmit = runSearch,
					})
				end)
			end
		end

		topFilters.select(barSpec, true)
		gridFilters.select(gridSpec, true)
		task.defer(layout)

		----------------------------------------------------------------
		-- SCRIPT TYPE SWITCH (tap the pill: CloudScripts / Server / LocalScripts)
		-- Source: ScriptsSwitch + ScriptsSwitchDropdown. The drag strip of the window (ZIndex 40) sits on top of the pill, so the tap area
		-- and the dropdown live in a small layer above it (ZIndex 44, below the script card 45 and the window buttons 50). The layer has the same
		-- box as the page, so the pill's page positions work in it too.
		--   CloudScripts  -> Best Scripts (ScriptBlox), the normal view
		--   Server        -> "Find server": Powered-by logo, Popular / Trending, the search box, cards with "N Plrs" you can join (Hooks.GetServerSideGames / Hooks.OnServerSideGame)
		--   LocalScripts  -> "Favourite Scripts": your starred scripts, the carousel is hidden
		----------------------------------------------------------------
		do
			local MODES = {
				{ key = "cloud", text = "CloudScripts ☁️" },
				{ key = "server", text = "Server 🌐" },
				{ key = "local", text = "LocalScripts 📂" },
			}
			local VIEW = {
				cloud = { header = "Best Scripts", subtitle = "Explore categories" },
				server = { header = "Server", subtitle = "Find server" },
				["local"] = { header = "Favourite Scripts", subtitle = "Explore your saved scripts" },
			}
			local MODE_TEXT = {}
			for _, m in ipairs(MODES) do
				MODE_TEXT[m.key] = m.text
			end

			local layer = new("Frame", {
				Name = "ScriptsSwitchLayer",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.925, 1), -- the same box as `content`
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Visible = page.Visible,
				ZIndex = 44,
				Parent = main,
			})

			-- invisible button that follows the pill (position, size and its slide-in animation)
			local tap = new("TextButton", {
				Name = "ScriptsSwitchTap",
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 1,
				Parent = layer,
			})
			local function syncTap()
				tap.AnchorPoint = pill.AnchorPoint
				tap.Position = pill.Position
				tap.Size = pill.Size
			end
			for _, prop in ipairs({ "Position", "Size", "AnchorPoint" }) do
				pill:GetPropertyChangedSignal(prop):Connect(syncTap)
			end
			syncTap()

			-- the pill squashes a little while you press it (the pill's own button sits under the drag strip, so the tap button drives it)
			local pressScale = pillButton:FindFirstChildOfClass("UIScale")
			tap.InputBegan:Connect(function(input)
				if pressScale and isTap(input) then
					tween(pressScale, 0.08, { Scale = 0.9 })
				end
			end)
			tap.InputEnded:Connect(function(input)
				if pressScale and isTap(input) then
					tween(pressScale, 0.12, { Scale = 1 })
				end
			end)

			-- a tap anywhere else closes the dropdown
			local blocker = new("TextButton", {
				Name = "ScriptsSwitchBlocker",
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				Visible = false,
				ZIndex = 2,
				Parent = layer,
			})

			local dropScale = new("UIScale", { Scale = 1 })
			local dropdown = new("Frame", {
				Name = "ScriptsSwitchDropdown",
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				Active = true,
				Visible = false,
				ZIndex = 3,
				Parent = layer,
			}, {
				corner(0.15),
				new("UIPadding", {
					PaddingTop = UDim.new(0.05, 0),
					PaddingBottom = UDim.new(0.05, 0),
					PaddingLeft = UDim.new(0.05, 0),
					PaddingRight = UDim.new(0.05, 0),
				}),
				new("UIListLayout", {
					FillDirection = Enum.FillDirection.Vertical,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0.02, 0),
				}),
				dropScale,
			})

			local rows = {}
			local isOpen = false
			local dropTween

			local function placeDropdown()
				local px, py = pill.Position.X, pill.Position.Y
				dropdown.AnchorPoint = Vector2.new(0, 0)
				dropdown.Position = UDim2.new(px.Scale, px.Offset, py.Scale + pill.Size.Y.Scale / 2 + 0.012, py.Offset)
				dropdown.Size = UDim2.fromScale(pill.Size.X.Scale * 1.18, pill.Size.Y.Scale * 3.2)
			end

			local function setOpen(open)
				if open == isOpen then
					return
				end
				isOpen = open
				if dropTween then
					dropTween:Cancel()
					dropTween = nil
				end
				if open then
					placeDropdown()
					blocker.Visible = true
					dropdown.Visible = true
					dropScale.Scale = 0.85
					dropdown.BackgroundTransparency = 1
					tween(dropdown, 0.15, { BackgroundTransparency = 0.2 })
					dropTween = tween(dropScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				else
					blocker.Visible = false
					dropdown.Visible = false
				end
			end

			-- show one view: pill text, header, subtitle, logo, filters, search box, and the feeds that fill the cards
			local function applyMode(key)
				local view = VIEW[key]
				if not view then
					return
				end
				local isCloud, isServer, isLocal = key == "cloud", key == "server", key == "local"
				if (isServer or scriptMode == "server") and resetSearch then
					resetSearch() -- Find server and the other views do not share a search
				end
				scriptMode = key

				pillButton.Text = MODE_TEXT[key]
				title.Text = view.header
				subtitle.Text = view.subtitle
				allLabel.Text = isCloud and (gridFilters.texts[gridSpec] or "All") or "All"

				topFilters.row.Visible = isCloud or isServer -- Find server has Popular / Trending too (no Newest)
				local newestFilter = topFilters.buttons.newest
				if newestFilter then
					newestFilter.button.Visible = not isServer
				end
				topFilters.select(isServer and serverSort or barSpec, true)
				gridFilters.row.Visible = isCloud
				bar.Visible = not isLocal
				search.Visible = true
				search.PlaceholderText = isServer and "Find server..." or "Search..."
				local searchTap = inner:FindFirstChild("CloudSearchTap")
				if searchTap then
					searchTap.Visible = true
				end
				logo.Visible = not isLocal
				powered.Visible = not isLocal
				logo.Image = isServer and A.ServerLogo or A.ScriptBloxLogo
				powered.TextColor3 = isServer and SERVER_POWERED_COLOR or POWERED_COLOR

				for rowKey, row in pairs(rows) do
					row.FontFace = rowKey == key and FONT.Title or FONT.Heading
				end

				loaded = true -- the views start their own downloads, so the first-open load must not run on top of them
				scroll.CanvasPosition = Vector2.new(0, 0)
				if isServer then
					resetServerMemo() -- opening Server always asks for the list again
				end
				if isCloud then
					barFeed.reset(barSpec)
					gridFeed.reset(gridSpec)
				elseif isServer then
					barFeed.reset("server")
					gridFeed.reset("server")
				else
					barFeed.clear()
					gridFeed.reset("favs")
				end
				layout()
				callHook("OnScriptHubMode", key)
			end

			for i, m in ipairs(MODES) do
				local row = new("TextButton", {
					Name = "Option_" .. m.key,
					Text = m.text,
					FontFace = m.key == scriptMode and FONT.Title or FONT.Heading,
					TextColor3 = TEXT,
					TextScaled = true,
					AutoButtonColor = false,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.fromScale(1, 0.3),
					LayoutOrder = i,
					ZIndex = 4,
					Parent = dropdown,
				})
				pressFx(row)
				rows[m.key] = row
				row.Activated:Connect(function()
					setOpen(false)
					if scriptMode ~= m.key then
						applyMode(m.key)
					end
				end)
			end

			tap.Activated:Connect(function()
				setOpen(not isOpen)
			end)
			blocker.Activated:Connect(function()
				setOpen(false)
			end)

			-- the layer only exists while the Cloud page is showing; leaving the page or hiding the window closes the dropdown
			page:GetPropertyChangedSignal("Visible"):Connect(function()
				layer.Visible = page.Visible
				if not page.Visible then
					setOpen(false)
				end
			end)
			main:GetPropertyChangedSignal("Visible"):Connect(function()
				if not main.Visible then
					setOpen(false)
				end
			end)
		end

		----------------------------------------------------------------
		-- HAND OVER TO THE TAB SWITCHER
		----------------------------------------------------------------
		cloudRefs.page = page
		cloudRefs.pill = pill
		cloudRefs.scroll = scroll
		cloudRefs.onShow = function()
			task.defer(layout)
			if loaded then
				return
			end
			loaded = true
			barFeed.reset(barSpec)
			gridFeed.reset(gridSpec)
		end
	end

	local okCloud, errCloud = pcall(buildCloudPage)
	if not okCloud then
		logWarn(
			"The Cloud Scripts page failed to build: " .. tostring(errCloud),
			"something it needs (the content frame, a font or an asset id) was renamed or removed",
			"the rest of the UI keeps working - the cloud tab stays empty until that is fixed"
		)
	end
end

