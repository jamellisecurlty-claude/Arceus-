	hubTap.Activated:Connect(function()
		callHook("OnTab", "Extensions") -- switches to the Extensions page (and tells your own OnTab hook)
	end)

	homeRefs.profile = profile
	homeRefs.hubTile = hubTile -- (homeRefs.hub is the Arceus Hub settings state)
	homeRefs.best = best
	homeRefs.sliders = sliderPanel
end

----------------------------------------------------------------
-- WINDOW GLOW (Execute and "Ask Arcy" light the whole window up)
----------------------------------------------------------------
-- Source (framework.execution.OnExecuted, and every Arcy reply): the tint of the window's glow texture (BackgroundGlow = A.Background,
-- the same picture as bgImage) goes from black to a light tint in 0.25 s (Quad Out), stays lit for 3 s, then fades back to black in 0.5 s.
-- On top of that the lit window "breathes" (the tint swells and settles) so it looks alive instead of a flat flash.
-- Calling it again while it is lit just restarts the 3 seconds.
--
-- COLOUR: the glow is no longer white / grey. A purple -> red -> blue gradient (GlowFx.Colors) sits on the glow image and slowly spins
-- while it is lit. The image tint (LIT / PEAK) only sets how bright the gradient is: it is multiplied with the gradient colours, and
-- black (the idle tint) times any colour is still black, so the window looks exactly the same as before when it is not glowing.
-- (The Confirm toast glow and the "Instant code with Arcy" glow below use their original glow textures from the source again.)
local GlowFx = {}
do
	local function key(at, hex)
		return ColorSequenceKeypoint.new(at, Color3.fromHex(hex))
	end

	-- first and last colour are the same, so the spinning gradient never shows a seam
	GlowFx.Colors = ColorSequence.new({
		key(0, "#2A87FF"), -- blue
		key(0.25, "#9B4DFF"), -- purple
		key(0.5, "#FF2D55"), -- red
		key(0.75, "#9B4DFF"), -- purple
		key(1, "#2A87FF"), -- blue
	})
	GlowFx.SpinTime = 3.5 -- seconds for one full turn of the gradient (bigger = slower)

	-- puts the purple / red / blue gradient on an ImageLabel (it multiplies with the image's own colour)
	function GlowFx.paint(target)
		local gradient = target:FindFirstChild("GlowGradient")
		if not gradient then
			gradient = new("UIGradient", { Name = "GlowGradient", Parent = target })
		end
		gradient.Color = GlowFx.Colors
		gradient.Rotation = 0
		return gradient
	end

	-- turns the gradient round and round; returns the tween so the caller can :Cancel() it
	function GlowFx.spin(gradient)
		gradient.Rotation = 0
		local spin = TweenService:Create(
			gradient,
			TweenInfo.new(GlowFx.SpinTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
			{ Rotation = 360 }
		)
		spin:Play()
		return spin
	end
end

local glowWindow
do
	local LIT = Color3.fromRGB(140, 140, 140) -- how bright the gradient is while lit (it multiplies the purple / red / blue)
	local PEAK = Color3.fromRGB(205, 205, 205) -- top of the breathing swell
	local RAMP_UP, HOLD, RAMP_DOWN = 0.25, 3, 0.5 -- seconds (source)
	local token = 0
	local breath, spin
	local windowGradient = GlowFx.paint(bgImage)

	local function stopBreath()
		if breath then
			breath:Cancel()
			breath = nil
		end
	end

	glowWindow = function()
		if not alive then
			return
		end
		token += 1
		local mine = token
		stopBreath()
		if not spin then
			spin = GlowFx.spin(windowGradient) -- the colours drift round while the window is lit
		end
		tween(bgImage, RAMP_UP, { ImageColor3 = LIT }).Completed:Once(function()
			if mine ~= token or not alive then
				return
			end
			breath = TweenService:Create(
				bgImage,
				TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageColor3 = PEAK }
			)
			breath:Play()
		end)
		task.delay(HOLD, function()
			if mine ~= token or not alive then
				return
			end
			stopBreath()
			tween(bgImage, RAMP_DOWN, { ImageColor3 = BG_TINT })
			task.delay(RAMP_DOWN, function()
				if mine == token and spin then
					spin:Cancel() -- dark again: stop turning the gradient (nothing is visible)
					spin = nil
				end
			end)
		end)
	end
end

----------------------------------------------------------------
-- TOAST (Execute / Clear ask for permission first)
----------------------------------------------------------------
-- Rebuilt from the source's ButtonToast:
--   * the whole screen goes dark (black, 0.25 transparency); tapping ANYWHERE except the pill just closes the toast and does nothing
--   * a big title painted with the style's gradient (blue for confirm / info, red for error, green for success, rotation 210), the question under it
--   * a glass "Confirm" pill (white, 0.8 transparency) with a pulsing glow texture behind it: 2x the pill width, 4x its height,
--     ImageTransparency 0 -> 0.5 -> 0 (1.5 s, Sine InOut, forever). Tapping the pill runs opts.onConfirm.
--   * glow textures (all from the source): confirm / info = A.ToastGlow, error = A.ToastGlowError, success = A.ToastGlowSuccess
-- showToast{ title = "Execute", text = "Execute Script n.1?", style = "confirm", onConfirm = function() end }
-- style "confirm" (default) shows "Confirm"; "info" / "error" / "success" show "Ok" (they only inform, onConfirm is optional there)
local showToast
do
	local UNIT = 12 / 1080 -- the source's "padding": 12 px on a 1080 px tall screen (scaled to the shorter side of yours)
	local RISE = 0.03 -- the title and the question slide up this far (fraction of the screen height) while they fade in
	local WHITE = Color3.new(1, 1, 1)

	local function gradient(a, b, c, d)
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHex(a)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHex(b)),
			ColorSequenceKeypoint.new(0.66, Color3.fromHex(c)),
			ColorSequenceKeypoint.new(1, Color3.fromHex(d)),
		})
	end
	local BLUE = gradient("#449EF8", "#73A5F4", "#3894FF", "#2A87FF")
	local STYLES = {
		confirm = { glow = A.ToastGlow, colors = BLUE, button = "Confirm" },
		info = { glow = A.ToastGlow, colors = BLUE, button = "Ok" },
		error = { glow = A.ToastGlowError, colors = gradient("#FA3232", "#F47373", "#FF3838", "#FF2929"), button = "Ok" },
		success = { glow = A.ToastGlowSuccess, colors = gradient("#17FD4D", "#73F591", "#38FF67", "#1DFF52"), button = "Ok" },
	}

	local isOpen = false
	local TOAST_HIDES_WINDOW = true -- the window is invisible while a toast is open (nothing shows through behind the text)
	local TOAST_DIM = 0.25 -- darkness of the backdrop behind the toast: 1 = no dim at all, 0 = black

	showToast = function(opts)
		if isOpen or not alive or not main.Visible then
			return
		end
		isOpen = true
		local hidMain = false
		if TOAST_HIDES_WINDOW then
			main.Visible = false
			hidMain = true
		end
		local style = STYLES[opts.style or "confirm"] or STYLES.confirm
		local closing = false
		local glowLoop

		local function unit()
			local s = gui.AbsoluteSize
			return math.max(4, math.min(s.X, s.Y) * UNIT)
		end
		local u = unit()

		----------------------------------------------------------------
		-- build
		----------------------------------------------------------------
		-- the dark backdrop IS a button: any tap on it (outside the pill) closes the toast without doing anything
		local overlay = new("TextButton", {
			Name = "Toast",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1, -- fades to 0.25
			BorderSizePixel = 0,
			ZIndex = 1499,
			Parent = gui,
		})

		-- title + question stack (so a long title that wraps never overlaps the question)
		local column = new("Frame", {
			Name = "Texts",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.1 + RISE),
			Size = UDim2.fromScale(0.7, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = overlay,
		}, {
			new("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})

		local title = new("TextLabel", {
			Name = "Title",
			LayoutOrder = 1,
			Text = opts.title or "",
			FontFace = FONT.Title,
			TextColor3 = WHITE, -- the gradient below paints the colours
			TextSize = math.min(100, u * 10),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.fromScale(1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = column,
		}, {
			new("UIPadding", { PaddingTop = UDim.new(0, u), PaddingBottom = UDim.new(0, u) }),
			new("UIGradient", { Color = style.colors, Rotation = 210 }),
		})

		local body = new("TextLabel", {
			Name = "Question",
			LayoutOrder = 2,
			Text = opts.text or "",
			FontFace = FONT.Title,
			TextColor3 = WHITE,
			TextSize = math.min(100, u * 6),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.fromScale(1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = column,
		}, {
			new("UIPadding", { PaddingTop = UDim.new(0, u), PaddingBottom = UDim.new(0, u) }),
		})

		-- the glass pill: it sizes itself around its text
		local button = new("TextButton", {
			Name = "ConfirmButton",
			Text = style.button,
			FontFace = FONT.Title,
			TextColor3 = WHITE,
			TextSize = math.min(100, u * 4),
			TextTransparency = 1,
			AutoButtonColor = false,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.6),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1, -- fades to 0.8
			BorderSizePixel = 0,
			ZIndex = 9,
			Parent = overlay,
		}, {
			new("UIPadding", {
				PaddingLeft = UDim.new(0, u * 3.5),
				PaddingRight = UDim.new(0, u * 3.5),
				PaddingTop = UDim.new(0, u * 3),
				PaddingBottom = UDim.new(0, u * 3),
			}),
			corner(0.5), -- fully rounded pill
		})
		pressFx(button)

		-- the glow texture: 2x the pill width, 4x its height, a third of the extra height sits above the pill (source numbers); drawn above the pill
		local glow = new("ImageLabel", {
			Name = "ConfirmGlow",
			Image = style.glow,
			ImageTransparency = 1, -- fades to 0, then pulses 0 <-> 0.5
			ScaleType = Enum.ScaleType.Stretch,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 10,
			Parent = overlay,
		})
		local function placeGlow()
			if closing or not glow.Parent then
				return
			end
			local size = button.AbsoluteSize
			local pos = button.AbsolutePosition - overlay.AbsolutePosition
			local gw, gh = size.X * 2, size.Y * 4
			glow.Size = UDim2.fromOffset(gw, gh)
			glow.Position = UDim2.fromOffset(pos.X - (gw - size.X) / 2, pos.Y - (gh - size.Y) / 3)
		end
		button:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeGlow)
		button:GetPropertyChangedSignal("AbsolutePosition"):Connect(placeGlow)
		task.defer(placeGlow)

		-- keep the text sizes right if the screen is turned
		local sizeConn = gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if closing then
				return
			end
			local nu = unit()
			title.TextSize = math.min(100, nu * 10)
			body.TextSize = math.min(100, nu * 6)
			button.TextSize = math.min(100, nu * 4)
		end)

		----------------------------------------------------------------
		-- close: onConfirm runs only when the pill was tapped
		----------------------------------------------------------------
		local function close(confirmed)
			if closing then
				return
			end
			closing = true
			isOpen = false -- a follow-up toast (e.g. an error) may open right away
			if hidMain then
				hidMain = false
				if alive then
					main.Visible = true -- the window comes back
				end
			end
			sizeConn:Disconnect()
			if glowLoop then
				glowLoop:Cancel()
				glowLoop = nil
			end
			tween(overlay, 0.2, { BackgroundTransparency = 1 })
			tween(title, 0.2, { TextTransparency = 1 })
			tween(body, 0.2, { TextTransparency = 1 })
			tween(button, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
			tween(glow, 0.2, { ImageTransparency = 1 })
			task.delay(0.25, function()
				overlay:Destroy()
			end)
			if confirmed and alive and opts.onConfirm then
				local ok, err = pcall(opts.onConfirm)
				if not ok then
					logWarn(
						"The toast's confirm action raised an error: " .. tostring(err),
						"the code behind the Confirm button failed",
						"check the Hooks you set - the UI itself keeps working"
					)
				end
			end
		end

		overlay.Activated:Connect(function()
			close(false)
		end)
		button.Activated:Connect(function()
			close(true)
		end)

		----------------------------------------------------------------
		-- play in
		----------------------------------------------------------------
		tween(overlay, 0.25, { BackgroundTransparency = TOAST_DIM })
		tween(title, 0.3, { TextTransparency = 0 })
		tween(body, 0.3, { TextTransparency = 0 })
		tween(column, 0.4, { Position = UDim2.fromScale(0.5, 0.1) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tween(button, 0.3, { BackgroundTransparency = 0.8, TextTransparency = 0 })
		tween(glow, 0.3, { ImageTransparency = 0 }).Completed:Once(function()
			if closing or not glow.Parent then
				return
			end
			glowLoop = TweenService:Create(
				glow,
				TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageTransparency = 0.5 }
			)
			glowLoop:Play()
		end)
	end
end

----------------------------------------------------------------
-- INSTANT CODE WITH ARCY (opened by the Arcy orb at the bottom-left of the Editor)
----------------------------------------------------------------
-- Rebuilt from the source's InputToast with Style = "ai" (what the source shows when you tap the Arcy orb):
--   * the window fades away (source: GroupTransparency 0.9) and a black shade drops from the top of the screen
--   * the title "Instant code with Arcy" is painted with the Arcy colours (red / pink / magenta / blue, rotation 210)
--   * a glass prompt pill (white, 0.8 transparency) with the placeholder "Walkspeed script..."
--   * the GLOW behind the pill is the texture rbxassetid://93050869167661 (A.AIPromptGlow). Same numbers as the source:
--     1.96x the pill width, 4x its height, pulsing ImageTransparency 0 -> 0.5 -> 0 (1.5 s, Sine InOut, forever)
-- Type your idea, then tap outside the pill (or press Enter / Done): Hooks.OnAI(prompt) gets the text. Empty text just closes it.
--
-- The same prompt is reused for RENAMING: the pencil on a file row calls openInstantCode{ title = ..., placeholder = ..., onSubmit = fn }.
-- With onSubmit the typed text goes to that function (after the window is back) instead of Hooks.OnAI, and the window does not glow.
-- openInstantCode() with no options is still "Instant code with Arcy" (the Arcy orb).
-- The Cloud Scripts search box uses it too: openInstantCode{ title = "Search Some Script", ... }.
local openInstantCode
do
	local TITLE_TEXT = "Instant code with Arcy" -- default title (opts.title replaces it)
	local PLACEHOLDER = "Walkspeed script..." -- default placeholder (opts.placeholder replaces it)
	local WINDOW_KEEP = 0 -- the window keeps this much of its opacity while the prompt is open: 0 = completely invisible (the source ghosts it at 0.1)
	local UNIT = 6 / 720 -- the source's "padding" unit as a fraction of the screen's shorter side (6 px on a 720 px tall screen)
	local TITLE_COLORS = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)), -- #FF0000
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 56, 105)), -- #FF3869
		ColorSequenceKeypoint.new(0.7, Color3.fromRGB(244, 115, 236)), -- #F473EC
		ColorSequenceKeypoint.new(1, Color3.fromRGB(21, 166, 254)), -- #15A6FE
	})
	-- opts.style = "info" is the source's InputToast with no Style (what the Install extension prompt shows): blue title, the blue glow
	-- texture and a glow 1.4x the pill wide. Without it (the Arcy orb) the prompt is the "ai" one above: Arcy colours, 1.96x glow.
	local INFO_COLORS = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHex("#449EF8")),
		ColorSequenceKeypoint.new(0.33, Color3.fromHex("#73A5F4")),
		ColorSequenceKeypoint.new(0.66, Color3.fromHex("#3894FF")),
		ColorSequenceKeypoint.new(1, Color3.fromHex("#2A87FF")),
	})
	local WHITE = Color3.new(1, 1, 1)
	local CENTER = Vector2.new(0.5, 0.5)

	local isOpen = false

	-- every transparency inside the window is remembered, so the window can fade as a group and come back exactly as it was
	-- (the window is a plain Frame, not a CanvasGroup, so there is no GroupTransparency to use)
	local function collectWindow()
		local list = {}
		local function add(inst, prop)
			list[#list + 1] = { inst, prop, inst[prop] }
		end
		add(main, "BackgroundTransparency")
		for _, d in ipairs(main:GetDescendants()) do
			if d:IsA("GuiObject") then
				add(d, "BackgroundTransparency")
				if d:IsA("ImageLabel") or d:IsA("ImageButton") then
					add(d, "ImageTransparency")
				elseif d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					add(d, "TextTransparency")
				end
			elseif d:IsA("UIStroke") then
				add(d, "Transparency")
			end
		end
		return list
	end

	local function setFade(list, k) -- k: 0 = the window as it was, 1 = faded away
		for i = 1, #list do
			local e = list[i]
			local o = e[3]
			e[1][e[2]] = o + ((1 - (1 - o) * WINDOW_KEEP) - o) * k
		end
	end

	-- opts (all optional):
	--   title = string, placeholder = string
	--   onSubmit = function(text)  (text is trimmed; never empty unless allowEmpty is on)
	--   text = string              (starts in the box, so the old text can be edited)
	--   allowEmpty = true          (onSubmit also runs with "" - used to clear a search)
	--   style = "info"             (blue prompt like the source's Install extension toast; default = the Arcy "ai" prompt)
	--   hideGui = true             (the window is invisible AT ONCE, no fade-out and no ghost, while the prompt is open)
	--   reasoning = "Reasoning"    (the prompt stays open after the text is sent and its text box shows "Reasoning..." until the answer is ready;
	--                               the code that answers calls homeRefs.finishInstantReasoning(). Used by the Arcy orb on the Editor.)
	openInstantCode = function(opts)
		if isOpen or not alive or not main.Visible then
			return
		end
		opts = opts or {}
		isOpen = true
		main:SetAttribute("ArcyInstantOpen", true)

		local closing = false
		local glowLoop
		local fade = { list = collectWindow(), k = 0, conn = nil }

		local function fadeWindowTo(target, duration, onDone)
			if fade.conn then
				fade.conn:Disconnect()
			end
			local from, t0 = fade.k, os.clock()
			fade.conn = RunService.Heartbeat:Connect(function()
				local a = math.clamp((os.clock() - t0) / duration, 0, 1)
				local s = a * a * (3 - 2 * a)
				fade.k = from + (target - from) * s
				pcall(setFade, fade.list, fade.k)
				if a >= 1 then
					if fade.conn then
						fade.conn:Disconnect()
						fade.conn = nil
					end
					if onDone then
						onDone()
					end
				end
			end)
		end

		local function unit()
			local s = gui.AbsoluteSize
			return math.max(4, math.min(s.X, s.Y) * UNIT)
		end
		local u = unit()

		----------------------------------------------------------------
		-- build
		----------------------------------------------------------------
		local overlay = new("Frame", {
			Name = "InstantCodeOverlay",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = true, -- blocks taps from reaching the window behind it
			ZIndex = 200,
			Parent = gui,
		})

		-- black shade, darkest at the top (source: UIGradient 0.25 -> 1, rotation 90)
		local shade = new("Frame", {
			Name = "Shade",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = overlay,
		}, {
			new("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.25),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})

		-- tap anywhere outside the pill = done
		local dismiss = new("TextButton", {
			Name = "Dismiss",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = overlay,
		})

		local title = new("TextLabel", {
			Name = "Title",
			Text = opts.title or TITLE_TEXT,
			FontFace = FONT.Title,
			TextColor3 = WHITE, -- the gradient below paints the colours
			TextSize = u * 6,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.13), -- slides up to 0.1
			Size = UDim2.fromScale(0.8, 0.2),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = overlay,
		}, {
			new("UIPadding", { PaddingTop = UDim.new(0, u), PaddingBottom = UDim.new(0, u) }),
			new("UIGradient", { Color = opts.style == "info" and INFO_COLORS or TITLE_COLORS, Rotation = 210 }),
		})

		local box = new("TextBox", {
			Name = "PromptBox",
			Text = opts.text or "",
			PlaceholderText = opts.placeholder or PLACEHOLDER,
			PlaceholderColor3 = Color3.fromRGB(225, 225, 225),
			ClearTextOnFocus = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			FontFace = FONT.Title,
			TextColor3 = WHITE,
			TextSize = u * 4,
			TextTransparency = 1,
			AnchorPoint = CENTER,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = nil,
		})

		local pill = new("Frame", {
			Name = "PromptPill",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.25),
			Size = UDim2.fromScale(0.85, 0.115),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1, -- fades to 0.8
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = overlay,
		}, {
			new("UIPadding", {
				PaddingTop = UDim.new(0, u * 2),
				PaddingBottom = UDim.new(0, u * 2),
				PaddingLeft = UDim.new(0, u * 2),
				PaddingRight = UDim.new(0, u * 3.5),
			}),
			new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		})
		box.Parent = pill

		-- the glow texture: 1.96x the pill width (1.4x for the "info" prompt), 4x its height, sitting a third of the extra height above the pill
		-- (source: Size = (pillW * 1.4 * 1.4, pillH * 4), Position = pill - (extra / 2 across, extra / 3 down)); drawn above the pill
		local isInfo = opts.style == "info"
		local glow = new("ImageLabel", {
			Name = "PromptGlow",
			Image = isInfo and A.ToastGlow or A.AIPromptGlow,
			ImageTransparency = 1, -- fades to 0, then pulses 0 <-> 0.5
			ScaleType = Enum.ScaleType.Stretch,
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromScale(0.85 * (isInfo and 1.4 or 1.96), 0.115 * 4), -- source: width * 1.4 * (1.4 for "ai")
			Position = UDim2.fromScale(0.5, 0.25 - (0.115 * 4 - 0.115) / 3),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = overlay,
		})

		-- keep the text sizes right if the screen is turned
		local sizeConn = gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if closing then
				return
			end
			local nu = unit()
			title.TextSize = nu * 6
			box.TextSize = nu * 4
		end)

		----------------------------------------------------------------
		-- close (hands the typed text to opts.onSubmit, or to Hooks.OnAI when there is no onSubmit)
		----------------------------------------------------------------
		local function close(text)
			if closing then
				return
			end
			closing = true
			homeRefs.finishInstantReasoning = nil
			sizeConn:Disconnect()
			main.Visible = true -- the window comes back (it fades in from invisible)
			pcall(function()
				box:ReleaseFocus()
			end)
			if glowLoop then
				glowLoop:Cancel()
				glowLoop = nil
			end
			tween(shade, 0.25, { BackgroundTransparency = 1 })
			tween(title, 0.25, { TextTransparency = 1 })
			tween(pill, 0.25, { BackgroundTransparency = 1 })
			tween(box, 0.25, { TextTransparency = 1 })
			tween(glow, 0.25, { ImageTransparency = 1 })
			local prompt = string.match(text or "", "^%s*(.-)%s*$") or ""
			fadeWindowTo(0, 0.3, function()
				for _, e in ipairs(fade.list) do
					pcall(function()
						e[1][e[2]] = e[3] -- exactly the values the window had before
					end)
				end
				main:SetAttribute("ArcyInstantOpen", nil)
				overlay:Destroy()
				isOpen = false
				-- rename (or any other onSubmit): runs once the window is fully back, so a rebuilt list does not pop in half-faded
				if (prompt ~= "" or opts.allowEmpty) and opts.onSubmit and alive then
					local ok, err = pcall(opts.onSubmit, prompt)
					if not ok then
						logWarn(
							"The prompt's onSubmit raised an error: " .. tostring(err),
							"the code behind this prompt failed",
							"check the function passed as onSubmit - the UI itself keeps working"
						)
					end
				end
			end)
			if prompt ~= "" and not opts.onSubmit then
				glowWindow() -- "Ask Arcy": the whole window lights up while it fades back in
				callHook("OnAI", prompt)
			end
		end

		-- REASONING (opts.reasoning): sending the text does NOT close the prompt. The text box turns into "Reasoning..." (dots moving)
		-- and stays that way until homeRefs.finishInstantReasoning() is called by the code that answers (or 3 minutes pass).
		-- Tapping outside while it reasons just closes the prompt; the answer still arrives afterwards.
		local reasoning = false
		local reasoningAt = 0
		local function beginReasoning(prompt)
			reasoning = true
			reasoningAt = os.clock()
			pcall(function()
				box:ReleaseFocus()
			end)
			box.TextEditable = false
			local word = type(opts.reasoning) == "string" and opts.reasoning or "Reasoning"
			box.Text = word .. "..."
			task.spawn(function()
				local n = 0
				while reasoning and not closing and box.Parent do
					task.wait(0.35)
					if closing or not box.Parent then
						break
					end
					n = n % 3 + 1
					box.Text = word .. string.rep(".", n)
				end
			end)
			local function finishNow()
				if closing then
					return
				end
				pcall(glowWindow) -- the whole window lights up while it fades back in
				close("")
			end
			homeRefs.finishInstantReasoning = finishNow
			task.delay(180, function()
				if homeRefs.finishInstantReasoning == finishNow then
					finishNow()
				end
			end)
			callHook("OnAI", prompt)
		end

		local function submit()
			if closing then
				return
			end
			if reasoning then
				if os.clock() - reasoningAt > 0.6 then
					close("")
				end
				return
			end
			local prompt = string.match(box.Text, "^%s*(.-)%s*$") or ""
			if opts.reasoning and not opts.onSubmit and prompt ~= "" then
				beginReasoning(prompt)
			else
				close(box.Text)
			end
		end

		box.FocusLost:Once(submit)
		dismiss.Activated:Connect(submit)

		----------------------------------------------------------------
		-- play in
		----------------------------------------------------------------
		if opts.hideGui then
			-- completely invisible at once: nothing of the window (not even a fading ghost) shows behind the prompt
			fade.k = 1
			pcall(setFade, fade.list, 1)
			main.Visible = false
		else
			fadeWindowTo(1, 0.35, function()
				if not closing then
					main.Visible = false -- fully gone while the prompt is open, nothing of it can show through
				end
			end)
		end
		tween(shade, 0.35, { BackgroundTransparency = 0 })
		tween(title, 0.4, { TextTransparency = 0 })
		tween(title, 0.5, { Position = UDim2.fromScale(0.5, 0.1) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tween(pill, 0.4, { BackgroundTransparency = 0.8 })
		tween(box, 0.4, { TextTransparency = 0 })
		tween(glow, 0.4, { ImageTransparency = 0 }).Completed:Once(function()
			if closing or not glow.Parent then
				return
			end
			glowLoop = TweenService:Create(
				glow,
				TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageTransparency = 0.5 }
			)
			glowLoop:Play()
		end)

		-- open the keyboard (a moment after the tap that opened this, so the tap itself does not unfocus it)
		task.delay(0.15, function()
			if not closing and box.Parent then
				pcall(function()
					box:CaptureFocus()
				end)
			end
		end)
	end
end

----------------------------------------------------------------
-- CLOUD SCRIPTS PAGE (the cloud icon = the "ScriptHub" tab)
-- Scripts come from ScriptBlox (https://scriptblox.com/api/script/fetch, plus /search and /trending).
--   * header: "Let's explore / Best Scripts", Popular / Newest / Trending, search box, "Powered by" ScriptBlox logo
--   * a sideways carousel (swipe left / right, the next page loads near the end)
--   * "Explore categories": All / Verified / Suggested / Favourites grid, 3 columns, scroll down = the next page loads
--   * thumbnails are downloaded once and cached in ArcyScripts/cache (needs writefile + getcustomasset). A card whose picture
--     cannot be downloaded falls back to the game's own icon; with nothing at all it keeps a clean dark card with the Arcy deer
--     (no more red "IMAGE NOT FOUND" art)
--   * NO script is added or run yet: a tap on a card only calls Hooks.OnCloudScript(data), which is empty
-- The cloud grid / carousel request nothing until the cloud tab is opened for the first time. The only request made at start is
-- the Home page "Best Scripts" card: it shows the best + most popular scripts (it no longer looks for the game you are in).
----------------------------------------------------------------
local cloudRefs = {} -- filled in by the block below: page / pill / scroll (the tab switcher uses them) and onShow (first open loads the scripts)

do
	local function buildCloudPage()
		local HttpService = game:GetService("HttpService")

		----------------------------------------------------------------
		-- SETTINGS
		----------------------------------------------------------------
		local BASE_URL = "https://scriptblox.com"
		local CACHE_DIR = "ArcyScripts/cache" -- downloaded thumbnails
		local FAV_FILE = "ArcyScripts/_cloudfavs.json" -- starred cloud scripts (metadata only)
		local COLUMNS = 3 -- cards per row in the grid
		local CARD_RATIO = 9 / 16 -- card height / card width (the reference cards are 16:9)
		local BAR_PER_PAGE = 12 -- scripts per request for the carousel
		local GRID_PER_PAGE = 20 -- scripts per request for the grid
		local MORE_MARGIN = 0.8 -- load the next page when you are this close to the end (in screens)
		local CACHE_SECONDS = 120 -- the same request is answered from memory for this long
		local IMAGE_WORKERS = 3 -- thumbnails downloading at the same time
		-- ScriptBlox pictures are a sharp 16:9 image sitting on a blurred copy of itself, with a "reviewed by humans" strip at the bottom.
		-- Cards crop to the sharp part so the blur and the strip never show. Values are fractions of the picture (0.08 = 8%).
		-- Set all four to 0 to show the whole picture again.
		local THUMB_TRIM = { left = 0.08, top = 0.09, right = 0.08, bottom = 0.14 }
		-- CAROUSEL (source: ContentBar, the "Popular / Newest / Trending" row and the Server Side games row).
		-- The middle card is 16:9. The cards next to it are shorter, darker and tucked BEHIND it; a tap on a side card brings it to the middle,
		-- a tap on the middle card opens it. Slot [n] = the card n places away from the middle (same on the left and the right):
		--   h = its height as a fraction of the middle card   x = distance of its centre from the middle (in card widths)
		--   z = layer (3 = on top)   dark = 0 normal ... 1 black   fade = how faded its text is (0 = solid, 1 = gone)
		local FLOW = {
			[0] = { h = 1, x = 0, z = 3, dark = 0, fade = 0 },
			{ h = 0.8, x = 0.65, z = 2, dark = 1 / 3, fade = 1 / 3 },
			{ h = 0.6, x = 1, z = 1, dark = 2 / 3, fade = 2 / 3 },
			{ h = 0.4, x = 3, z = 1, dark = 2 / 3, fade = 2 / 3 },
		}
		local FLOW_TIME = 0.25 -- seconds for the cards to slide one place (source: TweenTime .25)
		local POWERED_COLOR = Color3.fromHex("#8C7DFF")
		local SERVER_POWERED_COLOR = Color3.fromRGB(220, 220, 220) -- "Powered by:" colour on the Server Side view (source)
		local SERVER_SIDE_DEMO = false -- Server view: true = if the list cannot load (no internet) show 9 sample cards so you can see the layout. false = the grey "Couldn't load servers - tap to try again" message
		local DIM_TEXT = Color3.fromRGB(190, 190, 190)
		local STAR_YELLOW = Color3.fromRGB(253, 196, 27)
		local PLACEHOLDER_TINTS = { -- the placeholder card colour (darkened) comes from the source's Arcy colours
			Color3.fromRGB(255, 0, 0),
			Color3.fromRGB(255, 56, 105),
			Color3.fromRGB(244, 115, 236),
			Color3.fromRGB(21, 166, 254),
			Color3.fromRGB(255, 56, 105),
		}

		-- what each filter asks ScriptBlox for (same filters as the source: unpatched, verified, sorted by views ...)
		local SPECS = {
			popular = { mode = "free", verified = 1, patched = 0, sortBy = "views", order = "desc" },
			newest = { mode = "free", verified = 1, patched = 0, sortBy = "createdAt", order = "desc" },
			all = { patched = 0, sortBy = "views" },
			verified = { verified = 1, patched = 0, sortBy = "views" },
			suggested = { verified = 1, patched = 0, universal = 0, sortBy = "views" },
		}
		local SPEC_PARAMS = { "mode", "verified", "universal", "patched", "sortBy", "order" }

		----------------------------------------------------------------
		-- ENVIRONMENT (executor functions, every one is optional and wrapped so a missing one never breaks the UI)
		----------------------------------------------------------------
		local function pick(...)
			for _, getter in ipairs({ ... }) do
				local ok, fn = pcall(getter)
				if ok and type(fn) == "function" then
					return fn
				end
			end
			return nil
		end

		local requestFn = pick(
			function() return request end,
			function() return http_request end,
			function() return syn.request end,
			function() return http.request end,
			function() return fluxus.request end
		)
		local writeFn = pick(function() return writefile end)
		local readFn = pick(function() return readfile end)
		local isFileFn = pick(function() return isfile end)
		local makeFolderFn = pick(function() return makefolder end)
		local isFolderFn = pick(function() return isfolder end)
		local assetFn = pick(function() return getcustomasset end, function() return getsynasset end)

		local function ensureFolders()
			if not (makeFolderFn and isFolderFn) then
				return
			end
			for _, dir in ipairs({ "ArcyScripts", CACHE_DIR }) do
				local ok, exists = pcall(isFolderFn, dir)
				if ok and not exists then
					pcall(makeFolderFn, dir)
				end
			end
		end

		-- GET a url: executor request() first, then game:HttpGet, then HttpService. Returns body, or nil + a reason
		local function httpGet(url)
			local reason = "no HTTP function is available here"
			if requestFn then
				local ok, res = pcall(requestFn, { Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
				if ok and type(res) == "table" then
					local code = tonumber(res.StatusCode or res.Status)
					if type(res.Body) == "string" and (code == nil or (code >= 200 and code < 300)) then
						return res.Body
					end
					reason = "HTTP " .. tostring(code or res.StatusMessage or "error")
				elseif not ok then
					reason = tostring(res)
				end
			end
			local okG, bodyG = pcall(function()
				return game:HttpGet(url)
			end)
			if okG and type(bodyG) == "string" then
				return bodyG
			end
			local okS, bodyS = pcall(function()
				return HttpService:GetAsync(url)
			end)
			if okS and type(bodyS) == "string" then
				return bodyS
			end
			return nil, reason
		end

		-- one ScriptBlox request (3 tries, answers are remembered for CACHE_SECONDS). Returns the "result" table, or nil + a reason
		local fetchCache = {}
		local function fetchResult(url)
			local cached = fetchCache[url]
			if cached and os.clock() - cached.at < CACHE_SECONDS then
				return cached.result
			end
			local lastError = "no answer"
			for attempt = 1, 3 do
				local body, err = httpGet(url)
				if body then
					local ok, data = pcall(function()
						return HttpService:JSONDecode(body)
					end)
					if ok and type(data) == "table" and type(data.result) == "table" then
						fetchCache[url] = { at = os.clock(), result = data.result }
						return data.result
					end
					lastError = "ScriptBlox answered with something unexpected"
				else
					lastError = err or lastError
				end
				if attempt < 3 then
					task.wait(1)
				end
			end
			return nil, lastError
		end

		local function buildUrl(spec, search, page, perPage)
			if spec == "trending" then
				return BASE_URL .. "/api/script/trending"
			end
			local url = BASE_URL .. "/api/script/"
			if search ~= "" then
				url = url .. "search?q=" .. HttpService:UrlEncode(search) .. "&"
			else
				url = url .. "fetch?"
			end
			url = url .. "page=" .. tostring(page) .. "&max=" .. tostring(perPage)
			local params = SPECS[spec] or {}
			for _, key in ipairs(SPEC_PARAMS) do
				if params[key] ~= nil then
					url = url .. "&" .. key .. "=" .. tostring(params[key])
				end
			end
			return url
		end

		----------------------------------------------------------------
		-- SCRIPT DATA + THUMBNAILS
		----------------------------------------------------------------
		-- which image a card can show: the script's own picture, else (non universal) the game's picture. Only png / jpg work
		local function imageInfo(path)
			if type(path) ~= "string" or path == "" then
				return nil
			end
			local url, ext
			local lower = string.lower(path)
			if string.sub(path, 1, 8) == "/images/" then
				url = BASE_URL .. path
			elseif string.sub(path, 1, #BASE_URL + 8) == BASE_URL .. "/images/" then
				url = path
			elseif string.find(path, "^https://t[%w]*%.rbxcdn%.com/") then
				url = path
				if string.find(path, "/Png") then
					ext = "png"
				elseif string.find(path, "/Jpeg") then
					ext = "jpg"
				elseif string.find(path, "/Webp") then
					url = (string.gsub(path, "/Webp", "/Png", 1)) -- Roblox cannot draw webp: the CDN serves the same picture as png
					ext = "png"
				else
					return nil
				end
			else
				return nil
			end
			if not ext then
				if string.sub(lower, -4) == ".png" then
					ext = "png"
				elseif string.sub(lower, -4) == ".jpg" or string.sub(lower, -5) == ".jpeg" then
					ext = "jpg"
				else
					return nil
				end
			end
			local clean = string.gsub(url, "^https?://", "")
			clean = string.gsub(clean, "[^%w_%-]", "_")
			if #clean > 90 then
				clean = string.sub(clean, -90)
			end
			return url, clean .. "." .. ext, ext
		end

		local function pickImage(scr)
			local url, name, ext = imageInfo(scr.image)
			if not url and not scr.isUniversal and type(scr.game) == "table" then
				url, name, ext = imageInfo(scr.game.imageUrl)
			end
			return url, name, ext
		end

		-- the API's script -> the small table the cards (and Hooks.OnCloudScript) use
		local function normalize(scr)
			if type(scr) ~= "table" then
				return nil
			end
			local slug = scr.slug or scr._id
			if type(slug) ~= "string" or slug == "" then
				return nil
			end
			local gm = type(scr.game) == "table" and scr.game or {}
			local imageUrl, imageName, imageExt = pickImage(scr)
			return {
				slug = slug,
				title = tostring(scr.title or "Script"),
				gameName = gm.name,
				gameId = gm.gameId,
				universal = scr.isUniversal == true,
				verified = scr.verified == true,
				key = scr.key == true,
				patched = scr.isPatched == true,
				views = scr.views,
				scriptType = scr.scriptType,
				createdAt = scr.createdAt,
				imageUrl = imageUrl,
				imageName = imageName,
				imageExt = imageExt,
				script = scr.script, -- the Lua code itself (nothing uses it yet)
			}
		end

		local function describe(data)
			if data.universal then
				return "Universal Script 📌"
			end
			return data.gameName or "Unknown game"
		end

		local function tintFor(slug)
			local sum = 0
			for i = 1, #slug do
				sum = (sum * 31 + string.byte(slug, i)) % 100003
			end
			return PLACEHOLDER_TINTS[sum % #PLACEHOLDER_TINTS + 1]
		end

		-- the card art while a picture loads (and for scripts that have none): a dark tint of the card's colour + the Arcy deer
		local function placeholderColor(slug)
			return tintFor(slug):Lerp(Color3.new(0, 0, 0), 0.72)
		end

		-- the game's own icon (works without any executor function) - used when the script has no downloadable picture
		local MarketplaceService = game:GetService("MarketplaceService")
		local gameIcons = {}
		local function gameIconFor(gameId)
			gameId = tonumber(gameId)
			if not gameId or gameId <= 0 then
				return nil
			end
			if gameIcons[gameId] ~= nil then
				return gameIcons[gameId] or nil
			end
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(gameId)
			end)
			local icon = ok and type(info) == "table" and tonumber(info.IconImageAssetId)
			gameIcons[gameId] = (icon and icon > 0) and ("rbxassetid://" .. tostring(icon)) or false
			return gameIcons[gameId] or nil
		end

		local function looksLikeImage(body, ext)
			if type(body) ~= "string" or #body < 100 then
				return false
			end
			if ext == "png" then
				return string.sub(body, 1, 4) == "\137PNG"
			end
			return string.sub(body, 1, 2) == "\255\216"
		end

		-- reads the pixel size of a png / jpg straight from its bytes (needed to crop to the sharp part of a ScriptBlox picture)
		local function readImageSize(body, ext)
			if type(body) ~= "string" then
				return nil
			end
			local function u16(i)
				return string.byte(body, i) * 256 + string.byte(body, i + 1)
			end
			if ext == "png" then
				if #body < 24 then
					return nil
				end
				return u16(17) * 65536 + u16(19), u16(21) * 65536 + u16(23)
			end
			local i, n = 3, #body
			while i < n - 9 do
				if string.byte(body, i) ~= 255 then
					i = i + 1
				else
					local marker = string.byte(body, i + 1)
					if marker == 255 then
						i = i + 1
					elseif marker == 216 or marker == 1 or (marker >= 208 and marker <= 215) then
						i = i + 2
					elseif marker >= 192 and marker <= 207 and marker ~= 196 and marker ~= 200 and marker ~= 204 then
						return u16(i + 7), u16(i + 5) -- width, height
					else
						i = i + 2 + u16(i + 2)
					end
				end
			end
			return nil
		end

		local imageDims = {} -- [url] = Vector2 (pixels)

		-- crops an image object to the sharp part of a ScriptBlox picture (other pictures, like the game's own icon, are left whole)
		local function applyTrim(inst, url)
			local dims = url and imageDims[url]
			local t = THUMB_TRIM
			if dims and url and string.sub(url, 1, #BASE_URL + 8) == BASE_URL .. "/images/" and (t.left + t.top + t.right + t.bottom) > 0 then
				local x0, y0 = math.floor(dims.X * t.left), math.floor(dims.Y * t.top)
				local w = dims.X - x0 - math.floor(dims.X * t.right)
				local h = dims.Y - y0 - math.floor(dims.Y * t.bottom)
				if w > 8 and h > 8 then
					inst.ImageRectOffset = Vector2.new(x0, y0)
					inst.ImageRectSize = Vector2.new(w, h)
					return
				end
			end
			inst.ImageRectOffset = Vector2.new(0, 0)
			inst.ImageRectSize = Vector2.new(0, 0) -- 0,0 = the whole picture
		end

		-- downloads a thumbnail once, keeps it in ArcyScripts/cache and turns it into an asset the ImageLabel can show
		local imageAssets = {}
		local function loadAsset(url, name, ext)
			if imageAssets[url] then
				return imageAssets[url]
			end
			if not (writeFn and assetFn) then
				return nil
			end
			local path = CACHE_DIR .. "/" .. name
			local have = false
			if isFileFn then
				local ok, exists = pcall(isFileFn, path)
				have = ok and exists == true
			end
			if not have then
				local body = httpGet(url)
				if not looksLikeImage(body, ext) then
					return nil
				end
				ensureFolders()
				if not pcall(writeFn, path, body) then
					return nil
				end
				local okS, w, h = pcall(readImageSize, body, ext)
				if okS and w and h and w > 0 and h > 0 then
					imageDims[url] = Vector2.new(w, h)
				end
			elseif readFn and not imageDims[url] then -- already cached on disk from an earlier run: read the size from the file
				local okR, body = pcall(readFn, path)
				if okR then
					local okS, w, h = pcall(readImageSize, body, ext)
					if okS and w and h and w > 0 and h > 0 then
						imageDims[url] = Vector2.new(w, h)
					end
				end
			end
			local ok, asset = pcall(assetFn, path)
			if ok and type(asset) == "string" and asset ~= "" then
				imageAssets[url] = asset
				return asset
			end
			return nil
		end

		-- a picture arrived: show it and drop the placeholder deer
		local function showPicture(card, asset, url)
			if not (alive and card.Parent) then
				return
			end
			card.Image = asset
			applyTrim(card, url)
			card.ImageColor3 = Color3.new(1, 1, 1)
			card.ScaleType = Enum.ScaleType.Crop
			card.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
			card.BackgroundTransparency = card:GetAttribute("Flow") and 0 or 0.5 -- carousel cards overlap, so they stay solid
			local deer = card:FindFirstChild("Placeholder")
			if deer then
				deer:Destroy()
			end
		end

		-- thumbnails are fetched a few at a time so the UI and the connection stay smooth.
		-- order: the script's picture (one retry if the download hiccups) -> the game's own icon -> the clean placeholder card
		local imageQueue, imageBusy = {}, 0
		local function pumpImages()
			while imageBusy < IMAGE_WORKERS and #imageQueue > 0 do
				local job = table.remove(imageQueue, 1)
				if job.card.Parent then -- skip cards that were already thrown away (filter changed)
					imageBusy = imageBusy + 1
					task.spawn(function()
						local asset
						local usedUrl -- set only when the script's own picture is what ends up on the card
						local data = job.data
						if data.imageUrl then
							local ok, res = pcall(loadAsset, data.imageUrl, data.imageName, data.imageExt)
							asset = ok and res or nil
							if not asset and writeFn and assetFn and alive and job.card.Parent then
								task.wait(1.5) -- one more try: a hiccup in the download must not leave the card empty
								local ok2, res2 = pcall(loadAsset, data.imageUrl, data.imageName, data.imageExt)
								asset = ok2 and res2 or nil
							end
							if asset then
								usedUrl = data.imageUrl
							end
						end
						if not asset and not data.universal and alive and job.card.Parent then
							asset = gameIconFor(data.gameId)
						end
						imageBusy = imageBusy - 1
						if asset then
							showPicture(job.card, asset, usedUrl)
						end
						pumpImages()
					end)
				end
			end
		end

		local function queueImage(card, data)
			if not data.imageUrl then
				if not data.universal and data.gameId then -- no downloadable picture: the game's own icon
					imageQueue[#imageQueue + 1] = { card = card, data = data }
					pumpImages()
				end
				return -- universal scripts without a picture keep the clean placeholder card
			end
			local cached = imageAssets[data.imageUrl]
			if cached then
				showPicture(card, cached, data.imageUrl)
				return
			end
			imageQueue[#imageQueue + 1] = { card = card, data = data }
			pumpImages()
		end

