----------------------------------------------------------------
-- UI TEXT SIZE (Settings > Editor Text Size also resizes the text of the whole UI - with a LIMIT)
----------------------------------------------------------------
-- The editor text is exactly the number you pick (8..32). The rest of the UI follows the same "-  16  +" buttons as a FACTOR:
--   factor = pick / 16, then HELD BETWEEN Theme.UI_TEXT.Min and Theme.UI_TEXT.Max, so the layout can never break.
--   16 = factor 1 = nothing is touched at all (no cost at the normal size).
-- How the text changes: text with a fixed TextSize gets TextSize x factor (and keeps following when the script resizes it itself);
-- TextScaled text (most labels) gets its text area made smaller / bigger with a UIPadding named "ArcyTextScale" (or the label's own UIPadding).
-- A label that holds other GuiObjects (icons, knobs) or uses AutomaticSize is left alone, because a padding would move those too.
-- Opt out: obj:SetAttribute("NoTextScale", true) (the editor code text, its line numbers and the +/- buttons of this setting already do).
Theme.UI_TEXT = { Min = 0.8, Max = 1.3 } -- THE LIMIT: the UI text is never smaller than 80% or bigger than 130% (change the two numbers if you want)

do
	local textState = setmetatable({}, { __mode = "k" }) -- text object -> what was changed on it (so it can be put back exactly)
	local factor = 1
	local running = false
	local added = nil
	local token = 0

	local function currentFactor()
		local size = tonumber(Theme.prefs.EditorTextSize) or Theme.TEXT_SIZE.Default
		return math.clamp(size / Theme.TEXT_SIZE.Default, Theme.UI_TEXT.Min, Theme.UI_TEXT.Max)
	end
	Theme.uiTextFactor = currentFactor

	local function isText(inst)
		return inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")
	end

	local function hasGuiChild(inst)
		for _, child in ipairs(inst:GetChildren()) do
			if child:IsA("GuiObject") then
				return true
			end
		end
		return false
	end

	local function sizeFor(base)
		return math.clamp(math.floor(base * factor + 0.5), 4, 100)
	end

	-- puts the object back exactly like the script made it
	local function putBack(inst, st)
		if st.conn then
			st.conn:Disconnect()
			st.conn = nil
		end
		if st.mode == "size" and st.base and inst.TextSize ~= st.base then
			inst.TextSize = st.base
		end
		if st.pad then
			if st.padOwn then
				st.pad:Destroy()
			else
				local b = st.basePad
				st.pad.PaddingLeft, st.pad.PaddingRight, st.pad.PaddingTop, st.pad.PaddingBottom = b.Left, b.Right, b.Top, b.Bottom
			end
			st.pad = nil
		end
		if st.cons then
			pcall(function()
				st.cons.MinTextSize = st.consMin
				st.cons.MaxTextSize = st.consMax
			end)
			st.cons = nil
		end
		st.mode = nil
	end

	-- starts to change an object (mode stays nil when the object cannot be changed safely)
	local function engage(inst, st)
		if inst.TextScaled then
			if inst.AutomaticSize ~= Enum.AutomaticSize.None or hasGuiChild(inst) then
				return
			end
			local pad = inst:FindFirstChildOfClass("UIPadding")
			if pad then
				st.padOwn = false
				st.basePad = { Left = pad.PaddingLeft, Right = pad.PaddingRight, Top = pad.PaddingTop, Bottom = pad.PaddingBottom }
			else
				pad = Instance.new("UIPadding")
				pad.Name = "ArcyTextScale"
				st.padOwn = true
				st.basePad = { Left = UDim.new(), Right = UDim.new(), Top = UDim.new(), Bottom = UDim.new() }
				pad.Parent = inst
			end
			st.pad = pad
			local cons = inst:FindFirstChildOfClass("UITextSizeConstraint")
			if cons then
				st.cons, st.consMax, st.consMin = cons, cons.MaxTextSize, cons.MinTextSize
			end
			st.mode = "scaled"
		else
			st.mode = "size"
			st.base = inst.TextSize
			st.applied = nil
			st.conn = inst:GetPropertyChangedSignal("TextSize"):Connect(function()
				if inst.TextSize == st.applied then
					return -- that was our own change
				end
				st.base = inst.TextSize -- the script gave it a new size: that is the new base, the factor is applied on top
				local v = sizeFor(st.base)
				st.applied = v
				if inst.TextSize ~= v then
					inst.TextSize = v
				end
			end)
		end
	end

	-- applies the current factor to one object
	local function applyOne(inst, st)
		if st.mode == "scaled" then
			-- shrink: padding on the sides away from the text alignment. grow: the same with a negative padding (the text area gets bigger than the label)
			local d = 1 - factor
			local l, r, t, b = 0, 0, 0, 0
			local ax, ay = inst.TextXAlignment, inst.TextYAlignment
			if ax == Enum.TextXAlignment.Left then
				r = d
			elseif ax == Enum.TextXAlignment.Right then
				l = d
			else
				l, r = d / 2, d / 2
			end
			if ay == Enum.TextYAlignment.Top then
				b = d
			elseif ay == Enum.TextYAlignment.Bottom then
				t = d
			else
				t, b = d / 2, d / 2
			end
			local base, pad = st.basePad, st.pad
			pad.PaddingLeft = UDim.new(base.Left.Scale + l, base.Left.Offset)
			pad.PaddingRight = UDim.new(base.Right.Scale + r, base.Right.Offset)
			pad.PaddingTop = UDim.new(base.Top.Scale + t, base.Top.Offset)
			pad.PaddingBottom = UDim.new(base.Bottom.Scale + b, base.Bottom.Offset)
			if st.cons then
				pcall(function()
					st.cons.MaxTextSize = math.clamp(math.floor(st.consMax * factor + 0.5), 1, 100)
					st.cons.MinTextSize = math.clamp(math.floor(st.consMin * factor + 0.5), 1, 100)
				end)
			end
		elseif st.mode == "size" then
			local v = sizeFor(st.base)
			st.applied = v
			if inst.TextSize ~= v then
				inst.TextSize = v
			end
		end
	end

	local function track(inst)
		if textState[inst] or not isText(inst) or inst:GetAttribute("NoTextScale") == true or not inst:IsDescendantOf(gui) then
			return
		end
		local st = {}
		textState[inst] = st
		engage(inst, st)
		if st.mode then
			applyOne(inst, st)
		end
	end

	local function deactivate()
		running = false
		if added then
			added:Disconnect()
			added = nil
		end
		for inst, st in pairs(textState) do
			pcall(putBack, inst, st)
			textState[inst] = nil
		end
	end

	local function activate(sync)
		running = true
		added = gui.DescendantAdded:Connect(function(inst)
			if isText(inst) then
				task.defer(function() -- one step later: the script has finished building the object (its children, its attributes)
					if running and inst.Parent then
						pcall(track, inst)
					end
				end)
			end
		end)
		local all = gui:GetDescendants()
		for i, inst in ipairs(all) do
			if isText(inst) then
				pcall(track, inst)
			end
			if not sync and i % 250 == 0 then
				task.wait() -- a big UI is handled in small pieces: no freeze
			end
		end
	end

	-- brings everything in line with Settings > Editor Text Size
	local function update(sync)
		local f = currentFactor()
		if f == factor and (running or f == 1) then
			return
		end
		factor = f
		if f == 1 then
			if running then
				deactivate()
			end
		elseif not running then
			activate(sync)
		else
			for inst, st in pairs(textState) do
				if inst.Parent then
					pcall(function()
						if not st.mode then
							engage(inst, st)
						end
						if st.mode then
							applyOne(inst, st)
						end
					end)
				end
			end
		end
	end

	-- the editor text changes at once (see the Editor page); the rest of the UI follows a moment after the LAST press of + / - (hold = one update, no lag)
	Theme.onPref("EditorTextSize", function()
		token = token + 1
		local mine = token
		task.delay(0.15, function()
			if mine == token then
				pcall(update, false)
			end
		end)
	end)

	-- called once when the window is built: a saved size other than 16 is applied before the window pops in
	function Theme.startTextScale()
		pcall(update, true)
	end
end

