function Sys.getLoadstring()
	local function try(f)
		local ok, v = pcall(f)
		if ok and type(v) == "function" then
			return v
		end
	end
	return try(function() return getgenv().loadstring end)
		or try(function() return loadstring end)
		or try(function() return getfenv(0).loadstring end)
		or try(function() return getfenv(1).loadstring end)
		or try(function() return getrenv().loadstring end)
		or try(function() return _G.loadstring end)
		or try(function() return shared.loadstring end)
end

Sys.notify = nil -- set by the Editor page: shows an error toast

-- opts.quiet = do not show the red toast (the caller shows its own). Returns: ok, message, kind ("empty" | "noload" | "syntax")
function Sys.fail(name, msg, short, quiet, kind)
	sysWarn(msg)
	if Sys.notify and not quiet then
		pcall(Sys.notify, "Execute", short or msg)
	end
	return false, short or msg, kind
end

-- compiles first (syntax errors are reported), then runs in its own thread so the UI never freezes.
-- opts (optional): { quiet = true -> no red toast for compile problems, onError = function(message) -> called when the script raises an error while running }
function Sys.run(name, source, opts)
	opts = type(opts) == "table" and opts or {}
	local quiet = opts.quiet == true
	if type(source) ~= "string" or not string.find(source, "%S") then
		return false, "nothing to run", "empty"
	end
	source = string.gsub(source, "^\239\187\191", "") -- a byte order mark at the start breaks loadstring
	source = string.gsub(source, "\r\n?", "\n")
	local ls = Sys.getLoadstring()
	if not ls then
		return Sys.fail(name, "Cannot run " .. tostring(name) .. " | Likely cause: loadstring does not exist here (normal Roblox clients block it) | Fix: run this from an executor that provides loadstring", "loadstring is not available in this environment", quiet, "noload")
	end
	local called, fn, err = pcall(ls, source, "=" .. tostring(name or "script"))
	if not called then
		-- some loadstring versions reject the chunk name or throw: try again with the source only
		called, fn, err = pcall(ls, source)
		if not called then
			return Sys.fail(name, "loadstring failed for " .. tostring(name) .. ": " .. tostring(fn), "loadstring failed: " .. string.sub(tostring(fn), 1, 90), quiet, "syntax")
		end
	end
	if type(fn) ~= "function" then
		return Sys.fail(name, "Syntax error in " .. tostring(name) .. ": " .. tostring(err), "Syntax error: " .. string.sub(tostring(err), 1, 90), quiet, "syntax")
	end
	task.spawn(function()
		local ok, runErr = pcall(fn)
		if not ok then
			sysWarn("Runtime error in " .. tostring(name) .. ": " .. tostring(runErr))
			if type(opts.onError) == "function" then
				pcall(opts.onError, tostring(runErr))
			end
		end
	end)
	return true
end

function Sys.writeState(json)
	pcall(function()
		if not writefile then
			return
		end
		if makefolder and isfolder and not isfolder("ArcyScripts") then
			makefolder("ArcyScripts")
		end
		writefile("ArcyScripts/_state.json", json)
	end)
end

function Sys.save(name, source)
	name = tostring(name or "Script")
	source = tostring(source or "")
	savedScripts[name] = source
	local wrote = false
	local okW, wf = pcall(function()
		return writefile
	end)
	if okW and type(wf) == "function" then
		pcall(function()
			if makefolder and isfolder and not isfolder("ArcyScripts") then
				makefolder("ArcyScripts")
			end
		end)
		local safe = name:gsub("[^%w%-_ ]", "_")
		wrote = pcall(wf, "ArcyScripts/" .. safe .. ".lua", source)
	end
end

function Sys.openConsole()
