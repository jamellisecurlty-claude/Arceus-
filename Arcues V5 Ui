				return camera and camera.ViewportSize.X or 640, camera and camera.ViewportSize.Y or 360
			end
			return s.X, s.Y
		end
		-- the layout stage: as wide as the screen, but never wider than MaxAspect and never narrower than 16:9. Every position below is a fraction of the
		-- stage, so the licence screen keeps the source's proportions on any phone / tablet instead of stretching with the screen.
		local function stageAspect()
			local w, h = screenSize()
			return math.clamp(w / h, 16 / 9, tonumber(L.MaxAspect) or 2.1)
		end
		local sw, sh = screenSize()
		local pad = math.max(4, math.floor(math.min(sh, sw / stageAspect()) / 90)) -- source: "padding"
		local height = sh

		local root = Instance.new("Frame")
