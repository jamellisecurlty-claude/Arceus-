local Sys = {}
local function sysWarn(problem, cause, fix)
	warn("[ArcyHome] " .. problem .. (cause and (" | Likely cause: " .. cause) or "") .. (fix and (" | Fix: " .. fix) or ""))
end
local DEFAULT_GRAVITY = Workspace.Gravity
local SLIDER_STATE = {
	Gravity = { enabled = false, value = 196.2 },
	Jump = { enabled = false, value = 7.2 },
	Speed = { enabled = false, value = 16 },
}
local savedScripts = {}
