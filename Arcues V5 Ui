		root.Size = UDim2.fromScale(1, 1)
		root.ZIndex = 500
		root.Parent = gui
		local stageRatio = Instance.new("UIAspectRatioConstraint")
		stageRatio.AspectRatio = stageAspect()
		stageRatio.Parent = root
		local stageConn = gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			stageRatio.AspectRatio = stageAspect()
		end)

		-- every visible piece fades in one after another (source: AnimateCascade)
		local pieces = {}
		local function piece(inst, finals)
			for prop in pairs(finals) do
				inst[prop] = 1
			end
			pieces[#pieces + 1] = { inst = inst, finals = finals }
			return inst
		end
		local function fade(visible, duration, stagger)
			for i, item in ipairs(pieces) do
				local goal = {}
				for prop, final in pairs(item.finals) do
					goal[prop] = visible and final or 1
				end
				local info = TweenInfo.new(
					duration,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out,
					0,
					false,
					visible and (i - 1) * (stagger or 0.05) or 0
				)
				tween(item.inst, info, goal)
			end
		end

