			local sizeConn = gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if closing then
					return
				end
				local nu = unit()
				title.TextSize = nu * 6
				input.TextSize = nu * 4
			end)

			local function close(text)
				if closing then
					return
				end
				closing = true
				sizeConn:Disconnect()
				pcall(function()
					input:ReleaseFocus()
				end)
				if glowLoop then
					glowLoop:Cancel()
					glowLoop = nil
				end
				tween(shade, quick, { BackgroundTransparency = 1 })
				tween(title, quick, { TextTransparency = 1 })
				tween(pill, quick, { BackgroundTransparency = 1 })
				tween(input, quick, { TextTransparency = 1 })
				tween(glow, quick, { ImageTransparency = 1 })
				tween(pillScale, quick, { Scale = 0.95 })

				local value = string.match(text or "", "^%s*(.-)%s*$") or ""
				task.delay(0.2, function()
					if not alive() then
						return
					end
					if value ~= "" then
						box.Text = value -- the typed email goes into the Email box
					end
					fade(true, 0.35, 0.02) -- the licence texts come back
					task.delay(0.3, function()
						if alive() and not self._licenseOk then
							box.PlaceholderText = L.Placeholder
						end
					end)
					if value ~= "" then
						-- a moment later: changing box.Text makes the Text listener clear the message (its event can run after this line)
						task.delay(0.1, function()
							if not alive() or self._licenseOk or busy then
								return
