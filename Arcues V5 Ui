		local CATEGORIES = {
			{ key = "files", label = "Files", icon = A.FilesIcon, tint = Color3.fromRGB(78, 172, 252), pill = Color3.fromRGB(30, 62, 95), text = Color3.fromRGB(88, 178, 255) },
			{ key = "star", label = "Favs", icon = A.StarIcon, tint = STAR_YELLOW, pill = Color3.fromRGB(91, 71, 10), text = STAR_YELLOW },
			{ key = "run", label = "Auto", icon = A.RunIcon, tint = nil, pill = Color3.fromRGB(11, 72, 54), text = Color3.fromRGB(30, 201, 151) },
		}

		----------------------------------------------------------------
		-- DATA (three starter scripts, like the screenshot)
		----------------------------------------------------------------
		local items = {
			{ name = "Script n.1", source = 'print("Hello")', fav = false, autorun = false },
			{ name = "Script n.2", source = 'print("Lol")', fav = false, autorun = false },
			{ name = "Script n.3", source = "", fav = false, autorun = false },
		}
		local nextNumber = 3
		local selected = nil

		-- SAVED SCRIPTS: sources, favourites and auto-execute flags are kept in ArcyScripts/_state.json (writefile / readfile),
		-- so Auto-Executed scripts are still there - and run - the next time the UI starts.
		do
			local HttpService = game:GetService("HttpService")
			local okR, raw = pcall(function()
				if isfile and readfile and isfile("ArcyScripts/_state.json") then
					return readfile("ArcyScripts/_state.json")
				end
			end)
			if okR and type(raw) == "string" and raw ~= "" then
				local okJ, data = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if okJ and type(data) == "table" and type(data.items) == "table" then
					local loaded = {}
					for _, it in ipairs(data.items) do
						if type(it) == "table" and type(it.name) == "string" then
							loaded[#loaded + 1] = {
								name = it.name,
								source = type(it.source) == "string" and it.source or "",
								fav = it.fav == true,
								autorun = it.autorun == true,
							}
						end
					end
					if #loaded > 0 then
						items = loaded
						nextNumber = math.max(3, tonumber(data.nextNumber) or 3)
					end
				end
			end
			local function snapshot()
				local list = {}
				for _, it in ipairs(items) do
					list[#list + 1] = { name = it.name, source = it.source or "", fav = it.fav == true, autorun = it.autorun == true }
				end
				return HttpService:JSONEncode({ items = list, nextNumber = nextNumber })
			end
			task.spawn(function()
				local okS, last = pcall(snapshot)
				-- PERFORMANCE: the files are only JSON-encoded when something really changed (comparing strings is nearly free, encoding every file every 2 s was a hitch)
				local sigN, sigNext, sigName, sigSource, sigFav, sigAuto = -1, -1, {}, {}, {}, {}
				local function isDirty()
					if sigN ~= #items or sigNext ~= nextNumber then
						return true
					end
					for i, it in ipairs(items) do
						if sigName[i] ~= it.name or sigSource[i] ~= (it.source or "") or sigFav[i] ~= (it.fav == true) or sigAuto[i] ~= (it.autorun == true) then
							return true
						end
					end
					return false
				end
				local function rememberSig()
					sigN, sigNext = #items, nextNumber
					table.clear(sigName)
					table.clear(sigSource)
					table.clear(sigFav)
					table.clear(sigAuto)
					for i, it in ipairs(items) do
						sigName[i], sigSource[i], sigFav[i], sigAuto[i] = it.name, it.source or "", it.fav == true, it.autorun == true
					end
				end
				rememberSig()
				while alive do
					task.wait(windowState == "hidden" and 5 or 2)
					if isDirty() then
						rememberSig()
						local ok2, json = pcall(snapshot)
						if ok2 and json ~= last then
							last = json
							Sys.writeState(json)
						end
					end
				end
			end)
		end

		-- "files" = File Scripts (every script that is NOT auto-executed) | "star" = Favorites | "run" = Auto-Executed
