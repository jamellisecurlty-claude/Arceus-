		---------------- EditableImage helpers ----------------
		local function makeEditable(w, h, target)
			local ok, editable = pcall(function()
				return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
			end)
			if not ok or not editable then
				return nil
			end
