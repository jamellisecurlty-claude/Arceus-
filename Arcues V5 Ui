			end
		end

		----------------------------------------------------------------
		-- DRAG EFFECT ("slime")  -  source: utils.AddSlimeEffect(MainFrame, { All = {...}, [page] = {...} })
		-- While you drag the window, everything inside it moves the OPPOSITE way a little (movementFactor of the distance the
		-- window travelled, scaled by 1920x1080 / your screen). When you let go, every piece springs back to its spot with a
		-- Back tween, one after another (cascadeDelay apart). Same numbers as the source.
		-- "All" = the sidebar tab buttons, Maximize, Close and the top logo (+ the Extension Back / Detach pills).
		-- Per page = the panels of the page that is showing (every direct piece of it).
		-- If anything in here fails, the window still drags normally (it is wrapped in a pcall).
		----------------------------------------------------------------
		do
			local ok, err = pcall(function()
				local SLIME = {
					returnTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					referenceSize = Vector2.new(1920, 1080),
					movementFactor = 0.15,
					cascadeDelay = 0.0075,
				}

				local base = {} -- gui -> the Position it belongs at
				local displaced = {} -- gui -> true while it is away from its spot (a return tween is running or a drag is on)
				local returning = {} -- the running return tweens
				local targets = {} -- the gui objects of the current drag
				local dragging = false
				local owner = nil -- the input that started the drag
				local startPos = main.Position -- where the window was when the press began
				local pressConn = nil -- source: input.Changed -> End also lets the pieces go
				local releaseSlime -- defined below (beginSlime needs it)

				local function collect()
					local list, seen = {}, {}
					local function add(gui)
						if gui and not seen[gui] and gui:IsA("GuiObject") and gui.Visible then
							seen[gui] = true
							list[#list + 1] = gui
						end
					end
					-- All
					for _, tab in ipairs(TABS) do
						add(sidebar:FindFirstChild("SideBtn_" .. tab.Name))
					end
					add(main:FindFirstChild("MaximizeButton"))
					add(main:FindFirstChild("CloseButton"))
					add(main:FindFirstChild("MainLogo"))
					add(main:FindFirstChild("ExtensionBackButton"))
					add(main:FindFirstChild("ExtensionDetachButton"))
					-- the page that is showing
					local frames = { homePage, page, cloudRefs.page, intelRefs.page, homeRefs.ext and homeRefs.ext.page, homeRefs.settings and homeRefs.settings.page }
					for i = 1, 6 do
						local frame = frames[i]
						if frame and frame.Visible then
							for _, child in ipairs(frame:GetChildren()) do
								add(child)
							end
						end
					end
					return list
				end

				local function beginSlime(input)
					if dragging or isFull or not isTap(input) then
						return
					end
					dragging = true
					owner = input
					if pressConn then
						pressConn:Disconnect()
					end
					pressConn = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
							releaseSlime()
						end
					end)
					for _, tw in ipairs(returning) do
						pcall(function()
							tw:Cancel()
						end)
					end
					table.clear(returning)
					targets = collect()
					for _, gui in ipairs(targets) do
						local r = rest[gui]
						if r then
							-- a page slide-in is still running on this panel: finish it so the two do not fight
							if pageTweens[gui] then
								pageTweens[gui]:Cancel()
								pageTweens[gui] = nil
								gui.BackgroundTransparency = r.bg
							end
							base[gui] = r.pos
						elseif not displaced[gui] then
							base[gui] = gui.Position
						end
					end
					startPos = main.Position
				end

				releaseSlime = function()
					if not dragging then
						return
					end
					dragging = false
					owner = nil
					if pressConn then
						pressConn:Disconnect()
						pressConn = nil
					end
					local list = targets
					task.spawn(function()
						RunService.Heartbeat:Wait()
						for i, gui in ipairs(list) do
							task.delay((i - 1) * SLIME.cascadeDelay, function()
								local goal = base[gui]
								if dragging or not alive or not goal or not gui.Parent or not displaced[gui] then
									return -- a new drag took over / this piece never left its spot (slow device, quick tap)
								end
								local tw = TweenService:Create(gui, SLIME.returnTweenInfo, { Position = goal })
								returning[#returning + 1] = tw
								tw.Completed:Once(function(state)
									if state == Enum.PlaybackState.Completed then
										displaced[gui] = nil
									end
								end)
								tw:Play()
							end)
						end
					end)
				end

				local function onPress(input)
					beginSlime(input)
				end
				main.InputBegan:Connect(onPress)
				local strip = main:FindFirstChild("DragHandle")
				if strip then
					strip.InputBegan:Connect(onPress)
				end

				keepConn(UserInputService.InputEnded:Connect(function(input)
					if dragging and (input == owner or input.UserInputType == Enum.UserInputType.MouseButton1) then
						releaseSlime()
					end
				end))

				keepConn(RunService.RenderStepped:Connect(function()
					if not dragging or not alive then
						return
					end
					-- screen size: the camera's viewport like the source, or the gui's own size if there is no camera
					local camera = workspace.CurrentCamera
					local parent = main.Parent
					local screen = parent and parent.AbsoluteSize or Vector2.new(0, 0)
					local vp = camera and camera.ViewportSize or screen
					if vp.X <= 0 or vp.Y <= 0 then
						return
					end
					local scaleX, scaleY = SLIME.referenceSize.X / vp.X, SLIME.referenceSize.Y / vp.Y
					-- how far the window has travelled, read from its Position: exact in this very frame
					-- (AbsolutePosition can still hold last frame's value, which made the lag come late or not at all)
					local now = main.Position
					local moveX = (now.X.Scale - startPos.X.Scale) * screen.X + (now.X.Offset - startPos.X.Offset)
					local moveY = (now.Y.Scale - startPos.Y.Scale) * screen.Y + (now.Y.Offset - startPos.Y.Offset)
					local invX = -moveX * SLIME.movementFactor * scaleX
					local invY = -moveY * SLIME.movementFactor * scaleY
					for _, gui in ipairs(targets) do
						local orig = base[gui]
						if orig and gui.Parent then
							gui.Position = UDim2.new(orig.X.Scale, orig.X.Offset + invX, orig.Y.Scale, orig.Y.Offset + invY)
							displaced[gui] = true
						end
					end
				end))
			end)
			if not ok then
				logWarn(
					"The drag effect failed: " .. tostring(err),
					"something it needs was renamed or removed",
					"the window still drags, only the inside-lag effect is off"
				)
			end
		end

		----------------------------------------------------------------
		-- SIDEBAR GLOW ANIMATION (time based, idle while the window is hidden)
		-- The Arcy orb glow is STATIC now: nothing about the orb animates.
		----------------------------------------------------------------
		local indicatorBreath = indicator and new("UIScale", { Name = "Breath", Parent = indicator }) or nil

		local breathTimer = 0
		keepConn(RunService.Heartbeat:Connect(function(dt)
			if not alive or not main.Visible or not indicatorBreath then
				return
			end
			if main:GetAttribute("ArcyInstantOpen") then -- the window is faded while "Instant code with Arcy" is open
				return
			end
			breathTimer = breathTimer + dt
			if breathTimer < (1 / 30) * Theme.Perf.scale then
				return -- PERFORMANCE: a slow breathing glow looks the same at 30 updates a second and costs half as much as every frame
			end
			breathTimer = 0
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * 2.2)
			indicatorBreath.Scale = 0.97 + 0.06 * pulse
			indicator.ImageTransparency = 0.1 * (1 - pulse)
		end))

		-- used by the script card's Edit tile: the cloud script becomes a file in File Scripts and the Executor tab opens on it.
		-- Opening the same script again just jumps to the file that is already there.
		homeRefs.openInEditor = function(name, source)
			name = tostring(name or "Cloud Script")
			source = tostring(source or "")
			local target
			for _, it in ipairs(items) do
				if it.name == name and it.source == source then
					target = it
					break
				end
			end
			if not target then
				local function taken(candidate)
					for _, it in ipairs(items) do
						if it.name == candidate then
							return true
						end
					end
					return false
				end
				local unique, n = name, 1
				while taken(unique) do
					n = n + 1
					unique = name .. " (" .. n .. ")"
				end
				target = { name = unique, source = source, fav = false, autorun = false }
				table.insert(items, target)
			end
			local wanted = target.autorun and "run" or "files"
			if category ~= wanted then
				category = wanted
				renderCategories(true)
			end
			if search.Text ~= "" then
				search.Text = ""
			end
			selectItem(target, target)
			callHook("OnTab", "Executor") -- switches the page (and tells your own OnTab hook)
			task.delay(0.1, function() -- scroll the file list down to the new row
				if alive and list.Parent then
					local maxY = math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y)
					FX.play(list, 0.35, { CanvasPosition = Vector2.new(0, maxY) })
				end
			end)
		end

		renderCategories(false)
		updateSizes()
		selectItem(items[2] or items[1], true)
		selectTab(START_TAB)
		task.defer(updateSizes)

		-- auto-executed scripts run once when the UI is built (this script runs nothing itself - Hooks.OnRun does the work)
		task.defer(function()
			for _, item in ipairs(items) do
				if item.autorun and type(item.source) == "string" and string.find(item.source, "%S") then
					task.spawn(callHook, "OnRun", item.name, item.source)
				end
			end
		end)
	end
	buildEditorPage()
end

----------------------------------------------------------------
-- POP-UP ANIMATION (window pops in, sidebar + Home panels slide in one after another, slider bars fill up)
----------------------------------------------------------------
do
	local BACK = Enum.EasingStyle.Back
	local OUT = Enum.EasingDirection.Out

	local function playOpen()
		local pieces = {
			{ inst = homeRefs.profile, dx = 0, dy = 0.06 },
			{ inst = homeRefs.best, dx = 0, dy = 0.06 },
			{ inst = homePage:FindFirstChild("AIPanelBackground"), dx = 0, dy = 0.1 },
			{ inst = homeRefs.sliders, dx = 0.06, dy = 0 },
			{ inst = homeRefs.hubTile, dx = 0, dy = 0.06 },
		}
		-- park every piece a little off its spot while the window is still invisible
		for _, p in ipairs(pieces) do
			if p.inst then
				p.final = p.inst.Position
				p.inst.Position = UDim2.new(p.final.X.Scale + p.dx, p.final.X.Offset, p.final.Y.Scale + p.dy, p.final.Y.Offset)
			end
		end
		local sidebarFinal = sidebar.Position
		sidebar.Position = UDim2.new(sidebarFinal.X.Scale - 0.075, sidebarFinal.X.Offset, sidebarFinal.Y.Scale, sidebarFinal.Y.Offset)

		local bars = {}
		for _, d in ipairs(homeRefs.sliders:GetDescendants()) do
			if d:IsA("Frame") and string.sub(d.Name, -4) == "_Bar" then
				table.insert(bars, { inst = d, final = d.Size })
				d.Size = UDim2.new(d.Size.X.Scale, d.Size.X.Offset, 0, 0)
			end
		end

		task.wait() -- let the layout settle for one frame
		if not alive then
			return
		end

		-- show the window: it starts faded and small, then the background fades in while it pops up
		main.BackgroundTransparency = 1
		bgImage.ImageTransparency = 1
		main.Visible = true
		tween(main, 0.3, { BackgroundTransparency = BG_BASE_TRANSPARENCY })
		tween(bgImage, 0.3, { ImageTransparency = BG_IMAGE_TRANSPARENCY })
		TweenService:Create(popScale, TweenInfo.new(0.55, BACK, OUT), { Scale = 1 }):Play()
		TweenService:Create(sidebar, TweenInfo.new(0.5, BACK, OUT, 0, false, 0.1), { Position = sidebarFinal }):Play()
		for i, p in ipairs(pieces) do
			if p.inst then
				TweenService:Create(p.inst, TweenInfo.new(0.55, BACK, OUT, 0, false, 0.12 + (i - 1) * 0.08), { Position = p.final }):Play()
			end
		end
		for i, b in ipairs(bars) do
			TweenService:Create(b.inst, TweenInfo.new(0.7, Enum.EasingStyle.Quint, OUT, 0, false, 0.5 + (i - 1) * 0.1), { Size = b.final }):Play()
		end
	end

	Theme.startTextScale() -- a saved Editor Text Size other than 16 also sizes the UI text before the window shows

	task.spawn(function()
		local ok, err = pcall(playOpen)
		if not ok then
			logWarn(
				"The pop-up animation failed: " .. tostring(err),
				"a panel it animates was renamed or removed",
				"the window is shown without the animation"
			)
			main.Visible = true
			main.BackgroundTransparency = BG_BASE_TRANSPARENCY
			bgImage.ImageTransparency = BG_IMAGE_TRANSPARENCY
			popScale.Scale = 1
		end
	end)
end

----------------------------------------------------------------
-- ASSET CHECK (tells you which image ids failed to load)
----------------------------------------------------------------
task.spawn(function()
	local names, ids = {}, {}
	for key, id in pairs(A) do
		names[id] = key
		table.insert(ids, id)
	end
	local ok, err = pcall(function()
		ContentProvider:PreloadAsync(ids, function(contentId, status)
			if status ~= Enum.AssetFetchStatus.Success then
				logWarn(
					string.format("Image '%s' (%s) did not load: %s", tostring(names[contentId] or "?"), tostring(contentId), tostring(status)),
					"the asset id is wrong, deleted, or not usable in this experience (private or not approved)",
					"check that id in the A table at the top of the script - that image stays blank until it is fixed"
				)
			end
		end)
	end)
	if not ok then
		logWarn(
			"The image check could not run: " .. tostring(err),
			"ContentProvider:PreloadAsync is unavailable in this context",
			"safe to ignore - it only reports broken image ids"
		)
	end
end)
